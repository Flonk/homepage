---
/**
 * The three cone response curves, drawn against wavelength.
 *
 * This is the picture the whole of trichromacy rests on: three overlapping
 * humps, and the fact that a wavelength arriving at the eye is reduced, right
 * there, to exactly three numbers. Everything downstream — every colour space,
 * every screen, every argument about what pink is — is working with what
 * survives that.
 *
 * The curves are measurements rather than a model; see lib/cones.ts for where
 * they come from. The mark is the reader's: it can be dragged along the axis,
 * and it says what each cone makes of the light it is standing on.
 */
interface Props {
	/** Where the mark rests, in nanometres. */
	wavelength?: number;
	/**
	 * Walk the mark back and forth between these two wavelengths instead of
	 * holding one, at a constant rate. Low first.
	 */
	sweep?: [number, number];
	/** How long one round trip of that walk takes, in seconds. */
	sweepSeconds?: number;
	/** Let the reader take the mark and put it where they like. */
	drag?: boolean;
	/** Seconds a reader's pick is held before the walk takes over again. */
	idleResume?: number;
	/**
	 * Whose eye this is. Anything but "normal" takes the missing cone's curve
	 * off the graph and its reading off the tally, and remaps the rainbow, the
	 * disc and the swatch to what is left — all three, because a rainbow that
	 * still had colours the missing cone was needed to tell apart would be
	 * showing something the graph beneath it says cannot be seen.
	 *
	 * "filtered" is the odd one out: a pair of eyes behind a short-pass and a
	 * long-pass filter, which splits L in two and hands the brain a fourth
	 * reading. The rainbow is left alone there, because what such a pair would
	 * see is not something this strip can show — see lib/cones.ts for what the
	 * arrangement does and does not amount to.
	 */
	vision?: 'normal' | 'deuteranopia' | 'protanopia' | 'mirrored' | 'filtered';
	/**
	 * Wavelengths to keep marked, whatever the moving mark is doing. For a card
	 * arguing about particular lights — two of them arriving together, say —
	 * rather than about the shape of the curves in general. They are read off,
	 * not taken hold of: nothing here moves them.
	 *
	 * Give one a weight and it is drawn as a bar of that height instead of a
	 * hairline, so a card can show how much of each light there is and not only
	 * where it is. Heights are relative to the tallest bar the card ever puts
	 * up, so nothing is silently rescaled underneath the reader.
	 */
	marks?: (number | { nm: number; weight: number })[];
	/**
	 * Hand the reader the line of mixtures of the marks that all look exactly
	 * alike, instead of the wavelength axis. The bars rise and fall, one goes
	 * out altogether and another takes its place, and the disc and the three
	 * readings do not stir — which is metamerism, and is the whole point of
	 * such a card. Needs one more weighted mark than there are cones.
	 */
	metamer?: boolean;
	/**
	 * The reader's own mark — the one that walks the band and can be taken hold
	 * of. Turn it off for a card that is about particular wavelengths rather
	 * than about any one you like: the disc and the tally then report on the
	 * marks instead, added together, which is the question such a card is
	 * asking. With neither a probe nor any marks there is nothing left to
	 * report, and the head goes.
	 *
	 * Not to be confused with `marks`, which are the card's and do not move.
	 */
	probe?: boolean;
}

const {
	wavelength = 550,
	sweep,
	sweepSeconds = 22,
	drag = true,
	idleResume = 6,
	vision = 'normal',
	marks,
	metamer = false,
	probe = true,
} = Astro.props;

/* "460:0.53" for a weighted mark, plain "650" for a hairline one. The same
   string a card can send through vizProps, so the authored value and a
   card's override go down one road. */
const markList = marks
	?.map((m) => (typeof m === 'number' ? String(m) : `${m.nm}:${m.weight}`))
	.join(' ');
---

<div
	class="cones"
	data-cones
	data-wavelength={wavelength}
	data-sweep={sweep ? sweep.join(' ') : undefined}
	data-sweep-seconds={sweepSeconds}
	data-drag={drag ? 'true' : 'false'}
	data-idle-resume={idleResume}
	data-vision={vision}
	data-marks={markList}
	data-metamer={metamer ? 'true' : 'false'}
	data-probe={probe ? 'true' : 'false'}
>
	<canvas data-canvas></canvas>

	{/* The light on the left, and on the right the only three numbers that
	    survive it reaching the eye. Short wavelengths first, so the order
	    matches the axis underneath. A list, so the three read in that order to
	    a screen reader too. */}
	<div class="head">
		<div class="swatch-disc" data-swatch></div>
		<dl class="tally" data-tally>
			<div class="tally-row" data-cone="s">
				<dt>S</dt>
				<dd><span class="tally-bar"><i data-bar="s"></i></span><b data-val="s">0.00</b></dd>
			</div>
			<div class="tally-row" data-cone="m">
				<dt>M</dt>
				<dd><span class="tally-bar"><i data-bar="m"></i></span><b data-val="m">0.00</b></dd>
			</div>
			<div class="tally-row" data-cone="l">
				<dt>L</dt>
				<dd><span class="tally-bar"><i data-bar="l"></i></span><b data-val="l">0.00</b></dd>
			</div>
			{/* The far half of a split L. Nothing but the filtered eye has it, and
			    on every other card it is faded out along with its row. */}
			<div class="tally-row" data-cone="l2">
				<dt>L'</dt>
				<dd><span class="tally-bar"><i data-bar="l2"></i></span><b data-val="l2">0.00</b></dd>
			</div>
		</dl>
	</div>

	{/* The deck reads a horizontal drag as a swipe to the next card, which is
	    the gesture this wants for itself. */}
	<input
		class="pick"
		data-no-swipe
		data-pick
		type="range"
		min="0"
		max="1000"
		step="1"
		value="500"
		aria-label="Wavelength"
	/>
</div>

<style>
	.cones {
		position: relative;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		font-family: var(--font-mono);
		--ink: var(--deck-ink, #35302a);
		--ink-dim: var(--deck-ink-dim, #7a7264);
		--l: #ff6b6b;
		--m: #64d98a;
		--s: #6fa8ff;
		--l2: #ffb020;
		color: var(--ink);
	}

	.cones canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* The top half of the pane. The graph has the bottom half, and the two do
	   not overlap, so neither has to be laid out around the other. */
	/* Nothing above the graph reports on anything once the reader's mark is
	   gone, so it goes too. */
	.cones[data-head='false'] .head {
		display: none;
	}

	.head {
		position: absolute;
		inset: 0 0 50% 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.25rem, 5cqw, 3rem);
		pointer-events: none;
	}

	/* The light itself. A ring, because towards the ends of the band the colour
	   goes very dark and a disc with no edge would simply vanish. */
	.swatch-disc {
		width: clamp(3rem, 26cqh, 7.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: #000;
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--ink) 22%, transparent),
			0 0 22px 2px rgb(0 0 0 / 0.35);
	}

	.tally {
		margin: 0;
		display: grid;
		gap: 0.35rem;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
	}

	.tally-row {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tally dt {
		width: 1ch;
		font-weight: 700;
	}

	/* All four together, so the one card with a primed name on it keeps its
	   column and the other ten are left exactly as they were. */
	.cones[data-vision='filtered'] .tally dt {
		width: 2ch;
	}

	.tally dd {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	/* A bar each, so the three can be compared at a glance rather than read. */
	.tally-bar {
		display: block;
		width: clamp(4rem, 14cqw, 9rem);
		height: 0.45rem;
		border-radius: 2px;
		background: color-mix(in srgb, var(--ink) 14%, transparent);
		overflow: hidden;
	}

	.tally-bar i {
		display: block;
		height: 100%;
		width: 0;
		border-radius: 2px;
	}

	/* The letter takes the cone's colour as ink; the bar takes it as fill.
	   Setting both on both painted each letter out in a block of its own
	   colour. */
	.tally-row[data-cone='l'] dt {
		color: var(--l);
	}

	.tally-row[data-cone='m'] dt {
		color: var(--m);
	}

	.tally-row[data-cone='s'] dt {
		color: var(--s);
	}

	.tally-row[data-cone='l2'] dt {
		color: var(--l2);
	}

	.tally-row[data-cone='l'] .tally-bar i {
		background: var(--l);
	}

	.tally-row[data-cone='m'] .tally-bar i {
		background: var(--m);
	}

	.tally-row[data-cone='s'] .tally-bar i {
		background: var(--s);
	}

	.tally-row[data-cone='l2'] .tally-bar i {
		background: var(--l2);
	}

	/* Faded rather than removed. The bars that remain do not move, so the two
	   cards can be read against each other, and the gap is the point being
	   made. */
	.tally-row {
		transition: opacity 0.5s ease;
	}

	.cones[data-vision='deuteranopia'] .tally-row[data-cone='m'],
	.cones[data-vision='protanopia'] .tally-row[data-cone='l'] {
		opacity: 0;
	}

	/* The other way round, and taken out of the flow rather than faded: a
	   missing cone leaves a gap worth seeing, but a reading no ordinary eye has
	   would only push the three that every card does show off centre. It fades
	   in on arrival, since it cannot fade in from nothing. */
	.tally-row[data-cone='l2'] {
		display: none;
	}

	.cones[data-vision='filtered'] .tally-row[data-cone='l2'] {
		display: flex;
		animation: tally-in 0.5s ease;
	}

	@keyframes tally-in {
		from {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cones[data-vision='filtered'] .tally-row[data-cone='l2'] {
			animation: none;
		}
	}

	.tally b {
		width: 4ch;
		font-weight: 400;
		color: var(--ink-dim);
	}

	/* Above the tally rather than down in the corner, which is where the
	   wavelength axis and its numbers are. */
	/* Laid over the plot, so the mark can be taken anywhere along it. Its own
	   thumb is a transparent hairline; what the reader sees is drawn on the
	   canvas. */
	.pick {
		display: none;
		position: absolute;
		inset: 0 auto 0 var(--plot-left, 0px);
		width: var(--plot-w, 100%);
		margin: 0;
		padding: 0;
		appearance: none;
		-webkit-appearance: none;
		background: transparent;
		cursor: grab;
		touch-action: none;
	}

	.cones[data-drag='true'] .pick {
		display: block;
	}

	.pick:active {
		cursor: grabbing;
	}

	.pick:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -4px;
		border-radius: 4px;
	}

	/* Vendor pseudo-elements go in rules of their own: one browser not knowing
	   a selector throws out the whole rule. */
	.pick::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 1px;
		height: 100%;
		background: transparent;
		border: 0;
	}

	.pick::-moz-range-thumb {
		width: 1px;
		height: 100%;
		background: transparent;
		border: 0;
	}

	.pick::-webkit-slider-runnable-track {
		background: transparent;
	}

	.pick::-moz-range-track {
		background: transparent;
	}

	@container viz (max-width: 30rem) {
		.tally {
			font-size: 0.7rem;
			gap: 0.25rem;
		}
	}
</style>

<script>
	import { metamerLine, mixCones, mixRgb, wavelengthRgb, type Vision } from '../lib/spectrum';
	import {
		CONE_FIRST_NM,
		CONE_LAST_NM,
		MIRRORED_LAPS,
		coneResponse,
		eyeResponse,
		splitL,
		mirroredStandIn,
	} from '../lib/cones';

	/* The plot runs the length of the measured range. Not the visible band:
	   where the curves give out is itself the answer to where the visible band
	   comes from, and cropping to one would be assuming the other. */
	const LO_NM = CONE_FIRST_NM;
	const HI_NM = CONE_LAST_NM;

	/* Room around the plot: the top half of the pane for the light and what
	   the cones make of it, the rainbow strip and its numbers underneath, and a
	   little air above the curves so a peak at 1 is not drawn against the head.

	   No room at the left for a scale. Every one of these curves is normalised
	   to its own peak, so the height axis has no unit to label — what it is
	   worth reading off is the shape, and where one curve crosses another. */
	const PAD = { top: 14, right: 18, bottom: 50, left: 18 };
	/* And a limit on how wide it is allowed to get. Given a whole wide display
	   the curves flatten out into three long ridges and the shape stops being
	   readable — which is the one thing this graph is for. Past this the plot
	   is centred and the pane keeps the rest. 46rem, the same as the metamer
	   plot in post 4, so the two read at the same scale. */
	const MAX_PLOT_W = 736;
	const HEAD_FRAC = 0.5; // of the pane, given over to the swatch and the tally
	const NO_HEAD_FRAC = 0.1; // and what is left above the curves without them
	const STRIP_H = 20; // the rainbow along the wavelength axis
	const STRIP_GAP = 7;
	const SLIDER_ROOM = 34; // and below the numbers, when there is a line to walk

	/* In the order they are shown, shortest wavelength first, which is the
	   order they sit in along the axis. `at` is where each one is in the triple
	   coneResponse hands back, which is the order the published table uses. */
	const CONES = [
		{ key: 's', name: 'S', at: 2, css: '#6fa8ff' },
		{ key: 'm', name: 'M', at: 1, css: '#64d98a' },
		{ key: 'l', name: 'L', at: 0, css: '#ff6b6b' },
		/* Only on the filtered eye, and drawn last so it lies over L where the
		   two overlap. Amber rather than another red: the two long-wavelength
		   readings are the whole point of that card and have to be tellable
		   apart at a glance. */
		{ key: 'l2', name: "L'", at: 3, css: '#ffb020' },
	] as const;

	const RANGE_STEPS = 1000;

	/** Which cone each kind of dichromacy is short of. */
	const MISSING: Record<string, string | null> = {
		normal: null,
		deuteranopia: 'm',
		protanopia: 'l',
		mirrored: null,
		filtered: null,
	};

	/** A hypothetical eye, rather than one missing a cone: L moved, not lost. */
	type Eyes = Vision | 'mirrored' | 'filtered';
	const readVision = (v: unknown): Eyes =>
		v === 'deuteranopia' || v === 'protanopia' || v === 'mirrored' || v === 'filtered'
			? v
			: 'normal';

	/* The second L exists on one eye and no other; every other curve exists
	   unless that eye is short of it. */
	const present = (key: string, eye: Eyes) =>
		key === 'l2' ? eye === 'filtered' : MISSING[eye] !== key;

	function initCones(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const pickEl = root.querySelector<HTMLInputElement>('[data-pick]')!;
		const swatchEl = root.querySelector<HTMLElement>('[data-swatch]')!;
		const bars = Object.fromEntries(
			CONES.map((c) => [c.key, root.querySelector<HTMLElement>(`[data-bar='${c.key}']`)!]),
		);
		const vals = Object.fromEntries(
			CONES.map((c) => [c.key, root.querySelector<HTMLElement>(`[data-val='${c.key}']`)!]),
		);

		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ??
			root.closest<HTMLElement>('[data-viz-stage]');
		const gate = root.closest<HTMLElement>('[data-viz-phase]');

		const clampNm = (nm: number) => Math.min(HI_NM, Math.max(LO_NM, nm));

		/** A pair of wavelengths, low first, or null for anything else. */
		const parseSweep = (v: unknown): [number, number] | null => {
			const raw = typeof v === 'string' ? v.split(/[\s,]+/) : Array.isArray(v) ? v : null;
			if (!raw || raw.length !== 2) return null;
			const [a, b] = raw.map(Number);
			if (!Number.isFinite(a) || !Number.isFinite(b) || a === b) return null;
			return [clampNm(Math.min(a, b)), clampNm(Math.max(a, b))];
		};

		const AUTHORED_NM = clampNm(Number(root.dataset.wavelength) || 550);
		const AUTHORED_SWEEP = parseSweep(root.dataset.sweep);
		const AUTHORED_DRAG = root.dataset.drag !== 'false';
		const AUTHORED_VISION = readVision(root.dataset.vision);
		/* A mark is a wavelength, and optionally how much of it there is. Written
		   "460:0.53" in the attribute, or as {nm, weight} when a card sends one
		   through vizProps; a bare number is a mark with no amount attached, which
		   is drawn as a hairline rather than a bar. */
		type Mark = { nm: number; weight: number | null };
		const readMark = (v: unknown): Mark | null => {
			if (typeof v === 'object' && v !== null) {
				const o = v as { nm?: unknown; weight?: unknown };
				const at = Number(o.nm);
				if (!Number.isFinite(at) || at <= 0) return null;
				const wt = Number(o.weight);
				return { nm: clampNm(at), weight: Number.isFinite(wt) ? wt : null };
			}
			const [a, b] = String(v).split(':');
			const at = Number(a);
			if (!Number.isFinite(at) || at <= 0) return null;
			const wt = Number(b);
			return { nm: clampNm(at), weight: b !== undefined && Number.isFinite(wt) ? wt : null };
		};
		const readMarks = (v: unknown): Mark[] => {
			const raw = typeof v === 'string' ? v.split(/[\s,]+/) : Array.isArray(v) ? v : [];
			return raw.map(readMark).filter((m): m is Mark => m !== null);
		};
		const AUTHORED_MARKS = readMarks(root.dataset.marks);
		const AUTHORED_METAMER = root.dataset.metamer === 'true';
		const AUTHORED_PROBE = root.dataset.probe !== 'false';
		const SWEEP_SECS = Math.max(1, Number(root.dataset.sweepSeconds) || 22);
		const RESUME_MS = Math.max(0, Number(root.dataset.idleResume) || 6) * 1000;

		let nm = AUTHORED_NM;
		let resting = AUTHORED_NM;
		let sweeping = AUTHORED_SWEEP;
		let canDrag = AUTHORED_DRAG;
		let marks = AUTHORED_MARKS;
		let probe = AUTHORED_PROBE;
		/* Something is worth saying above the graph if the reader has a mark of
		   their own, or if the card has put any down to be added up. */
		const hasHead = () => probe || marks.length > 0;
		/* A mark with no amount attached is one whole light of it: a card that
		   only names wavelengths is asking what they come to together. */
		const markLights = () => marks.map((m, i) => ({ nm: m.nm, weight: weights[i] ?? 1 }));

		/* ---- the line of mixtures that all look alike -----------------------
		   The weights a card authors are one mixture; with a light more than
		   there are cones they are also one point on a line of mixtures the eye
		   cannot tell apart, and `walk` is how far along it the reader has gone.
		   See metamerLine in lib/spectrum.ts for which three numbers are being
		   held still, and why it has to be those. */
		let metamer = AUTHORED_METAMER;
		let walk = 0;
		let dir: number[] = [];
		let span: [number, number] = [0, 0];
		let weights: (number | null)[] = [];
		/* Fixed from the tallest bar anywhere along the line, so the bars are not
		   quietly rescaled underneath a reader who is dragging. */
		let ceiling = 1;
		const walkable = () => span[1] > span[0];

		/* Left to itself the handle goes back and forth along the line, because
		   the whole claim of the card is that the mixture can change and the
		   colour cannot, and a still picture makes only half of it. Sinusoidal
		   rather than linear: the ends of the line are where a light has just
		   gone out or is about to, which is the part worth dwelling on, and a
		   constant rate arrives at the turn and reverses with a jolt. */
		const WALK_SECS = 12;
		let walkT = 0;
		const walkAt = (t: number) => (1 - Math.cos((2 * Math.PI * t) / WALK_SECS)) / 2;
		/* Where in the cycle to start so that it carries on upward from wherever
		   the reader let go, rather than jumping back to where it would have got
		   to on its own. */
		const walkEntry = (at: number) =>
			(WALK_SECS * Math.acos(1 - 2 * Math.min(1, Math.max(0, at)))) / (2 * Math.PI);

		const setWalk = (t: number) => {
			walk = Math.min(1, Math.max(0, t));
			const at = span[0] + (span[1] - span[0]) * walk;
			weights = marks.map((m, i) =>
				m.weight === null ? null : Math.max(0, m.weight + at * (dir[i] ?? 0)),
			);
		};

		const rebuildLine = () => {
			const base = marks.map((m) => m.weight ?? 0);
			/* More lights than the three numbers a colour is, which is what leaves
			   one weight free. Three, not CONES.length: that list is however many
			   curves are being drawn, and the filtered eye has four of them
			   without there being a fourth number for metamerLine to hold still. */
			const enough = metamer && marks.length > 3 && marks.every((m) => m.weight !== null);
			const line = enough
				? metamerLine(
						marks.map((m) => m.nm),
						base,
					)
				: { dir: marks.map(() => 0), lo: 0, hi: 0 };
			dir = line.dir;
			span = [line.lo, line.hi];
			ceiling = Math.max(
				...[span[0], span[1], 0].flatMap((t) => base.map((b, i) => Math.max(0, b + t * dir[i]))),
				1e-6,
			);
			setWalk(walk);
		};
		rebuildLine();

		let sweepT = 0;
		let manual = false;
		let manualUntil = 0;

		/* ---- whose eye ------------------------------------------------------
		   Crossed rather than switched. The rainbow is mixed from where it was
		   towards where it is going, so a card that takes a cone away shows the
		   colours it can no longer tell apart running together, instead of
		   simply presenting a different picture. `shown` is held after a return
		   to normal vision, because it is still the far end of the mix on the
		   way back. */
		let vision: Eyes = AUTHORED_VISION;
		let shown: Exclude<Eyes, 'normal'> =
			AUTHORED_VISION === 'normal' ? 'deuteranopia' : AUTHORED_VISION;
		let mix = AUTHORED_VISION === 'normal' ? 0 : 1;

		/** Each cone's presence, so one leaving the graph fades rather than cuts. */
		const alpha: Record<string, number> = { s: 1, m: 1, l: 1 };
		for (const c of CONES) alpha[c.key] = present(c.key, AUTHORED_VISION) ? 1 : 0;

		/* The colour of light of this wavelength, part way between two eyes.
		   Cached per column: at one call per pixel per frame this was the most
		   expensive thing on the canvas, and it only changes when the mix, the
		   vision or the width does. */
		let stripKey = '';
		let strip: string[] = [];
		/* Faked, and only for the mirrored strip: a wind-down over the last
		   stretch of the band so it does not run to the edge as bright as the
		   middle. The stand-in colours out there are borrowed from the green and
		   cyan end, which are bright where the reds they are standing for are
		   dark, and the strip ends up glaring exactly where it should be giving
		   out. This is a drawing convenience for one card and nothing is being
		   claimed by it — the honest version, matching the brightness of the
		   wavelength each colour stands for, was tried and looked worse. */
		const FALLOFF_FROM = 670;
		const FALLOFF_TO = 740;
		const falloff = (at: number) => {
			if (at <= FALLOFF_FROM) return 1;
			const t = Math.min(1, (at - FALLOFF_FROM) / (FALLOFF_TO - FALLOFF_FROM));
			return 1 - 0.88 * t * t * (3 - 2 * t);
		};

		/* What the eye on show makes of this wavelength. For a missing cone that
		   is a colour; for the mirrored eye it is a stand-in, and the lap it came
		   from is what the hatching below announces. */
		const eyeRgb = (at: number): [number, number, number] => {
			/* Nothing to remap: a pair of filtered eyes does not lose colours the
			   way a missing cone does, and what its fourth reading would add is
			   not something a strip of ours can show. */
			if (shown === 'filtered') return wavelengthRgb(at);
			if (shown !== 'mirrored') return wavelengthRgb(at, shown);
			const k = falloff(at);
			const rgb = wavelengthRgb(mirroredStandIn(at).nm);
			return [Math.round(rgb[0] * k), Math.round(rgb[1] * k), Math.round(rgb[2] * k)];
		};

		const colourAt = (at: number): string => {
			const a = wavelengthRgb(at);
			if (mix <= 0) return `rgb(${a[0]} ${a[1]} ${a[2]})`;
			const b = eyeRgb(at);
			if (mix >= 1) return `rgb(${b[0]} ${b[1]} ${b[2]})`;
			return `rgb(${Math.round(a[0] + (b[0] - a[0]) * mix)} ${Math.round(
				a[1] + (b[1] - a[1]) * mix,
			)} ${Math.round(a[2] + (b[2] - a[2]) * mix)})`;
		};

		/* Linear in wavelength, because that is the axis these curves are always
		   drawn against and the one their shapes are read from. */
		const sweepAt = (t: number, [lo, hi]: [number, number]) => {
			const lap = (t / SWEEP_SECS) % 1;
			const ping = lap <= 0.5 ? 2 * lap : 2 - 2 * lap;
			return lo + (hi - lo) * ping;
		};

		/* Where to start the clock so the walk is passing through `at` on its way
		   up, so it carries on from wherever the mark already is. */
		const sweepEntry = (at: number, [lo, hi]: [number, number]) => {
			const ping = Math.min(1, Math.max(0, (at - lo) / (hi - lo)));
			return (ping * SWEEP_SECS) / 2;
		};

		const setSweep = (next: [number, number] | null) => {
			const same =
				(!next && !sweeping) ||
				(next && sweeping && next[0] === sweeping[0] && next[1] === sweeping[1]);
			if (same) return;
			if (next) sweepT = sweepEntry(nm, next);
			sweeping = next;
		};

		/* ---- geometry -------------------------------------------------------
		   Worked out on resize and kept, so the frame does not recompute what has
		   not changed. */
		let w = 0;
		let h = 0;
		let dpr = 1;
		let plot = { x: 0, y: 0, w: 0, h: 0 };

		const xOf = (v: number) => plot.x + ((v - LO_NM) / (HI_NM - LO_NM)) * plot.w;
		const yOf = (v: number) => plot.y + (1 - v) * plot.h;
		const nmOf = (x: number) => LO_NM + ((x - plot.x) / plot.w) * (HI_NM - LO_NM);

		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = Math.max(1, Math.round(h * dpr));
			const top = h * (hasHead() ? HEAD_FRAC : NO_HEAD_FRAC) + PAD.top;
			const pw = Math.min(Math.max(1, w - PAD.left - PAD.right), MAX_PLOT_W);
			const bottom = PAD.bottom + (walkable() ? SLIDER_ROOM : 0);
			plot = {
				x: Math.round((w - pw) / 2),
				y: top,
				w: pw,
				h: Math.max(1, h - top - bottom),
			};
			/* The mark is dragged along the plot, so its track has to be the
			   plot and not the pane — otherwise the mark sits a little away from
			   the finger, by more and more as the pane gets wider. */
			root.style.setProperty('--plot-left', `${plot.x}px`);
			root.style.setProperty('--plot-w', `${plot.w}px`);
		};
		/* Redrawn on the spot, not on the next frame. The curves are the same
		   whether anything is moving or not, and a pane that is holding still —
		   or one the browser has stopped animating — still has to show them. */
		new ResizeObserver(() => {
			resize();
			readInk();
			tally();
			draw();
		}).observe(canvas);
		resize();

		/* Read once and kept. These come from the deck's ground, which a post
		   picks and does not then change, and getComputedStyle in a frame loop is
		   a style recalculation for an answer that is already known. */
		let inkC = '#e6e9ef';
		let dimC = '#8891a0';
		let accentC = '#f0a020';
		const readInk = () => {
			const cs = getComputedStyle(root);
			inkC = cs.getPropertyValue('--ink').trim() || inkC;
			dimC = cs.getPropertyValue('--ink-dim').trim() || dimC;
			accentC = cs.getPropertyValue('--accent').trim() || accentC;
		};

		/* The response the graph is drawing. Both of the eyes that are not ours
		   differ from it only in L — moved, in one case, and cut in two in the
		   other — and that curve slides from ours to theirs with the mix. The
		   fourth reading is the far half of the split, and is nothing at all on
		   any other eye. */
		const responseAt = (at: number): [number, number, number, number] => {
			const h = coneResponse(at);
			if (mix <= 0) return [h[0], h[1], h[2], 0];
			if (shown === 'mirrored') {
				const m = eyeResponse(at, 'mirrored');
				return [h[0] + (m[0] - h[0]) * mix, h[1], h[2], 0];
			}
			if (shown === 'filtered') {
				const [near, far] = splitL(at);
				return [h[0] + (near - h[0]) * mix, h[1], h[2], far * mix];
			}
			return [h[0], h[1], h[2], 0];
		};

		const tally = () => {
			if (!probe) {
				/* The marks, arriving together. Both readings come out of the same
				   pair of functions the light mixer uses, so the disc and the bars
				   are two readings of one mixture rather than two mixtures. */
				const lights = markLights();
				const sum = lights.length ? mixCones(lights) : ([0, 0, 0] as [number, number, number]);
				for (const c of CONES) {
					const v = sum[c.at] ?? 0;
					bars[c.key].style.width = `${(Math.min(1, v) * 100).toFixed(1)}%`;
					vals[c.key].textContent = v.toFixed(2);
				}
				if (lights.length) {
					const [mr, mg, mb] = mixRgb(lights);
					swatchEl.style.background = `rgb(${mr} ${mg} ${mb})`;
				}
				return sum;
			}

			const r = responseAt(nm);
			for (const c of CONES) {
				bars[c.key].style.width = `${(r[c.at] * 100).toFixed(1)}%`;
				vals[c.key].textContent = r[c.at].toFixed(2);
			}
			swatchEl.style.background = colourAt(nm);
			if (canDrag) {
				pickEl.setAttribute(
					'aria-valuetext',
					`${Math.round(nm)} nanometres. ` +
						CONES.filter((c) => present(c.key, vision))
							.map((c) => `${c.name} ${r[c.at].toFixed(2)}`)
							.join(', '),
				);
			}
			return r;
		};

		/* The handle does one of two jobs. On a card about the band it takes the
		   mark along the wavelength axis; on a card about a mixture it walks the
		   line of look-alike mixtures instead. Never both, since only one of them
		   is what the card is asking. */
		const applyDrag = () => {
			const usable = canDrag && (probe || walkable());
			root.dataset.drag = usable ? 'true' : 'false';
			root.dataset.probe = probe ? 'true' : 'false';
			root.dataset.metamer = walkable() ? 'true' : 'false';
			root.dataset.head = hasHead() ? 'true' : 'false';
			pickEl.disabled = !usable;
			pickEl.setAttribute('aria-label', walkable() ? 'Which of the mixtures that make this colour' : 'Wavelength');
		};

		const syncPick = () => {
			const v = walkable()
				? String(Math.round(RANGE_STEPS * walk))
				: String(Math.round((RANGE_STEPS * (nm - LO_NM)) / (HI_NM - LO_NM)));
			if (pickEl.value !== v) pickEl.value = v;
		};

		const draw = () => {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);

			ctx.font = '10px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace';
			ctx.textBaseline = 'middle';

			/* ---- the wavelength axis ----------------------------------------
			   The rainbow is the axis: the reader should not have to convert a
			   number into a colour in their head to see which cone is looking at
			   what. It runs out at both ends on its own, which is the same fact
			   the curves are showing. */
			const stripY = plot.y + plot.h + STRIP_GAP;
			const key = `${Math.round(plot.w)}|${shown}|${Math.round(mix * 255)}`;
			if (key !== stripKey) {
				stripKey = key;
				strip = Array.from({ length: Math.round(plot.w) }, (_, x) =>
					colourAt(nmOf(plot.x + x)),
				);
			}
			for (let x = 0; x < strip.length; x++) {
				ctx.fillStyle = strip[x];
				ctx.fillRect(plot.x + x, stripY, 1.5, STRIP_H);
			}

			/* Where the rainbow has started over, hatch it. These colours are a
			   second helping of ours standing in for ones of theirs we have run
			   out of, and the strip should say so rather than let the repeat pass
			   for a coincidence. */
			if (shown === 'mirrored' && mix > 0.5) {
				let from = -1;
				for (let x = 0; x <= strip.length; x++) {
					const on = x < strip.length && mirroredStandIn(nmOf(plot.x + x)).lap > 0;
					if (on && from < 0) from = x;
					if (!on && from >= 0) {
						ctx.save();
						ctx.beginPath();
						ctx.rect(plot.x + from, stripY, x - from, STRIP_H);
						ctx.clip();
						ctx.globalAlpha = 0.35 * Math.min(1, (mix - 0.5) * 2);
						ctx.strokeStyle = '#000';
						ctx.lineWidth = 1.5;
						/* Both diagonals in one path and one stroke: stroked
						   separately, the alpha would double wherever they cross and
						   the crossings would be the loudest thing on the strip. */
						ctx.beginPath();
						for (let d = -STRIP_H; d < x - from + STRIP_H; d += 9) {
							ctx.moveTo(plot.x + from + d, stripY + STRIP_H);
							ctx.lineTo(plot.x + from + d + STRIP_H, stripY);
							ctx.moveTo(plot.x + from + d, stripY);
							ctx.lineTo(plot.x + from + d + STRIP_H, stripY + STRIP_H);
						}
						ctx.stroke();
						ctx.restore();
						from = -1;
					}
				}
			}
			ctx.textAlign = 'center';
			ctx.fillStyle = dimC;
			for (let v = 400; v <= HI_NM; v += 50) {
				ctx.fillText(String(v), xOf(v), stripY + STRIP_H + 10);
			}

			/* ---- the curves -------------------------------------------------
			   Sampled per pixel, so the shape is the data's rather than a
			   polyline's idea of it. */
			for (const cone of CONES) {
				const a = alpha[cone.key];
				if (a <= 0.002) continue;
				ctx.beginPath();
				for (let x = 0; x <= plot.w; x++) {
					const v = responseAt(nmOf(plot.x + x))[cone.at];
					const px = plot.x + x;
					const py = yOf(v);
					if (x === 0) ctx.moveTo(px, py);
					else ctx.lineTo(px, py);
				}
				// A wash underneath, so three overlapping curves still read as
				// three rather than as a tangle of lines.
				ctx.save();
				ctx.lineTo(plot.x + plot.w, yOf(0));
				ctx.lineTo(plot.x, yOf(0));
				ctx.closePath();
				ctx.globalAlpha = 0.1 * a;
				ctx.fillStyle = cone.css;
				ctx.fill();
				ctx.restore();

				ctx.beginPath();
				for (let x = 0; x <= plot.w; x++) {
					const v = responseAt(nmOf(plot.x + x))[cone.at];
					const px = plot.x + x;
					const py = yOf(v);
					if (x === 0) ctx.moveTo(px, py);
					else ctx.lineTo(px, py);
				}
				ctx.save();
				ctx.globalAlpha = a;
				ctx.strokeStyle = cone.css;
				ctx.lineWidth = 2;
				ctx.lineJoin = 'round';
				ctx.stroke();
				ctx.restore();
			}

			/* ---- the fixed marks --------------------------------------------
			   Wavelengths a card wants kept in view. Drawn before the moving one
			   and quieter than it — a solid hairline rather than the dashes, a
			   smaller dot, a narrower swatch — so that at a glance it is obvious
			   which mark is the reader's and which are the card's. */
			for (let i = 0; i < marks.length; i++) {
				const at = marks[i].nm;
				const fx = xOf(at);
				const fr = responseAt(at);

				/* A mark with an amount attached is a bar of that height, standing
				   on the axis under the curves that are reading it. Nothing else is
				   drawn for it: the dots and the label belong to a mark that is
				   asking about one wavelength, and these are asking about how much
				   of each. */
				const weight = weights[i];
				if (weight !== null && weight !== undefined) {
					const bh = Math.max(0, (weight / ceiling) * plot.h);
					if (bh > 0.5) {
						ctx.fillStyle = colourAt(at);
						ctx.fillRect(fx - 5, yOf(0) - bh, 10, bh);
						ctx.lineWidth = 1;
						ctx.strokeStyle = 'rgba(0,0,0,0.5)';
						ctx.strokeRect(fx - 5.5, yOf(0) - bh - 0.5, 11, bh + 1);
					}
					continue;
				}

				ctx.save();
				ctx.strokeStyle = `color-mix(in srgb, ${inkC} 30%, transparent)`;
				ctx.lineWidth = 1;
				ctx.beginPath();
				ctx.moveTo(fx, plot.y);
				ctx.lineTo(fx, plot.y + plot.h);
				ctx.stroke();
				ctx.restore();

				ctx.fillStyle = colourAt(at);
				ctx.fillRect(fx - 3, stripY - 2, 6, STRIP_H + 4);
				ctx.lineWidth = 1;
				ctx.strokeStyle = 'rgba(0,0,0,0.65)';
				ctx.strokeRect(fx - 3.5, stripY - 2.5, 7, STRIP_H + 5);

				for (const cone of CONES) {
					const a = alpha[cone.key];
					if (a <= 0.002) continue;
					ctx.save();
					ctx.globalAlpha = a;
					ctx.beginPath();
					ctx.arc(fx, yOf(fr[cone.at]), 3, 0, Math.PI * 2);
					ctx.fillStyle = cone.css;
					ctx.fill();
					ctx.strokeStyle = 'rgba(0,0,0,0.55)';
					ctx.lineWidth = 1;
					ctx.stroke();
					ctx.restore();
				}

				ctx.textAlign = 'center';
				ctx.fillStyle = dimC;
				ctx.fillText(`${Math.round(at)} nm`, fx, plot.y - 6);
			}

			/* ---- the walk ---------------------------------------------------
			   Where along the line of look-alike mixtures the reader has got to.
			   Drawn rather than left to the range input, like every other handle
			   here, so it sits on the same axis as the bars it is moving. */
			if (walkable()) {
				const sy = stripY + STRIP_H + SLIDER_ROOM - 6;
				const kx = plot.x + plot.w * walk;
				ctx.save();
				ctx.lineCap = 'round';
				ctx.lineWidth = 4;
				ctx.strokeStyle = `color-mix(in srgb, ${inkC} 16%, transparent)`;
				ctx.beginPath();
				ctx.moveTo(plot.x + 2, sy);
				ctx.lineTo(plot.x + plot.w - 2, sy);
				ctx.stroke();
				ctx.strokeStyle = accentC;
				ctx.beginPath();
				ctx.moveTo(plot.x + 2, sy);
				ctx.lineTo(Math.max(plot.x + 2, kx), sy);
				ctx.stroke();
				ctx.beginPath();
				ctx.arc(kx, sy, 6, 0, Math.PI * 2);
				ctx.fillStyle = accentC;
				ctx.fill();
				ctx.restore();
			}

			/* ---- the mark ---------------------------------------------------
			   One wavelength, and what the three of them make of it. Absent on a
			   card that is about particular wavelengths and not about any one the
			   reader likes. */
			if (!probe) return;

			const r = responseAt(nm);
			const mx = xOf(nm);
			ctx.save();
			ctx.strokeStyle = `color-mix(in srgb, ${inkC} 55%, transparent)`;
			ctx.lineWidth = 1;
			ctx.setLineDash([3, 3]);
			ctx.beginPath();
			ctx.moveTo(mx, plot.y);
			ctx.lineTo(mx, plot.y + plot.h);
			ctx.stroke();
			ctx.restore();

			/* A swatch of the light itself where the mark meets its own axis. Wide
			   enough that the colour is the thing you see: at six pixels with a
			   pale outline either side there was more outline than light. */
			ctx.fillStyle = colourAt(nm);
			ctx.fillRect(mx - 5, stripY - 3, 10, STRIP_H + 6);
			ctx.lineWidth = 1;
			ctx.strokeStyle = 'rgba(0,0,0,0.65)';
			ctx.strokeRect(mx - 5.5, stripY - 3.5, 11, STRIP_H + 7);
			ctx.strokeStyle = `color-mix(in srgb, ${inkC} 70%, transparent)`;
			ctx.strokeRect(mx - 6.5, stripY - 4.5, 13, STRIP_H + 9);

			for (const cone of CONES) {
				const a = alpha[cone.key];
				if (a <= 0.002) continue;
				ctx.save();
				ctx.globalAlpha = a;
				ctx.beginPath();
				ctx.arc(mx, yOf(r[cone.at]), 4, 0, Math.PI * 2);
				ctx.fillStyle = cone.css;
				ctx.fill();
				ctx.strokeStyle = 'rgba(0,0,0,0.55)';
				ctx.lineWidth = 1;
				ctx.stroke();
				ctx.restore();
			}
		};

		/* ---- the reader's hand --------------------------------------------- */
		const hold = () => {
			manual = true;
			manualUntil = performance.now() + RESUME_MS;
		};
		pickEl.addEventListener('pointerdown', hold);
		pickEl.addEventListener('input', () => {
			hold();
			const v = Math.min(RANGE_STEPS, Math.max(0, Number(pickEl.value) || 0));
			if (walkable()) setWalk(v / RANGE_STEPS);
			else nm = LO_NM + ((HI_NM - LO_NM) * v) / RANGE_STEPS;
			// Answered here rather than on the next frame: these are the parts the
			// hand is moving, and they should not lag behind it.
			tally();
			draw();
		});

		host?.addEventListener('viz:props', (e) => {
			const p = (e as CustomEvent).detail ?? {};
			resting = 'wavelength' in p ? clampNm(Number(p.wavelength) || AUTHORED_NM) : AUTHORED_NM;
			canDrag = 'drag' in p ? Boolean(p.drag) : AUTHORED_DRAG;
			marks = 'marks' in p ? readMarks(p.marks) : AUTHORED_MARKS;
			metamer = 'metamer' in p ? Boolean(p.metamer) : AUTHORED_METAMER;
			probe = 'probe' in p ? Boolean(p.probe) : AUTHORED_PROBE;
			// A card's mixture is its own, and starts where the card put it.
			walk = 0;
			walkT = 0;
			rebuildLine();
			// The graph's share of the pane depends on both of them.
			resize();
			vision = 'vision' in p ? readVision(p.vision) : AUTHORED_VISION;
			if (vision !== 'normal') shown = vision;
			root.dataset.vision = vision;
			setSweep('sweep' in p ? parseSweep(p.sweep) : AUTHORED_SWEEP);
			// A pick belongs to the card it was made on.
			manual = false;
			applyDrag();
			/* Repainted here rather than left to the next frame. Some of what a
			   card changes is eased and needs frames anyway, but some of it —
			   where the fixed marks are, whether the handle is offered — is
			   simply true as soon as the card says so, and a pane that is not
			   animating would otherwise never show it. */
			tally();
			draw();
		});

		applyDrag();
		setSweep(AUTHORED_SWEEP);
		readInk();
		tally();
		syncPick();
		draw();

		let last = 0;
		host?.addEventListener('viz:enter', () => {
			last = 0;
		});

		function frame(now: number) {
			requestAnimationFrame(frame);
			if (gate && gate.dataset.vizActive === 'false') return;
			if (!w || !h) return;

			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;

			if (manual && now >= manualUntil) {
				manual = false;
				// Picked up where the reader left it, not where it would have got to.
				if (sweeping) sweepT = sweepEntry(nm, sweeping);
				if (walkable()) walkT = walkEntry(walk);
			}

			// Towards the eye this card is asking for, and each cone towards
			// being there or not.
			const k = 1 - Math.exp(-4.5 * dt);
			const wantMix = vision === 'normal' ? 0 : 1;
			if (mix !== wantMix) {
				mix += (wantMix - mix) * k;
				if (Math.abs(wantMix - mix) < 0.002) mix = wantMix;
			}
			for (const c of CONES) {
				const want = present(c.key, vision) ? 1 : 0;
				if (alpha[c.key] === want) continue;
				alpha[c.key] += (want - alpha[c.key]) * k;
				if (Math.abs(want - alpha[c.key]) < 0.002) alpha[c.key] = want;
			}

			if (manual) {
				// Held exactly where it was put.
			} else if (walkable() && !reduceMotion) {
				walkT += dt;
				setWalk(walkAt(walkT));
			} else if (sweeping && !reduceMotion) {
				sweepT += dt;
				nm = sweepAt(sweepT, sweeping);
			} else if (nm !== resting) {
				const k = 1 - Math.exp(-4 * dt);
				nm += (resting - nm) * k;
				if (Math.abs(resting - nm) < 0.05) nm = resting;
			}

			tally();
			draw();
			if (canDrag && !manual) syncPick();
		}

		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-cones]').forEach(initCones);
</script>
