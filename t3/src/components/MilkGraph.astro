	mildButter: { label: 'Mildly soured butter', aka: ['Mildgesäuerte Butter'], from: 'butter', step: 'work in culture' },
	// Desi ghee is boiled from butter churned from dahi.
	butterfat: { label: 'Ghee', aka: ['Desi ghee'], from: 'butter', alsoFrom: ['culturedButter'], step: 'simmer until brown' },
	clarified: { label: 'Clarified butter', aka: ['Butterschmalz', 'Geklärte Butter', 'Samneh'], from: 'butter', step: 'melt, lift off solids' },
	amf: { label: 'Anhydrous milk fat', aka: ['AMF', 'Butter oil', 'Butterreinfett'], from: 'butter', alsoFrom: ['cream'], step: 'remove water and solids' },
	smen: { label: 'Smen', aka: ['Aged butter', 'Semn'], from: 'clarified', step: 'salt, age in jars' },
	bogButter: { label: 'Bog butter', aka: ['Im portaigh'], from: 'butter', step: 'bury in peat' },
	nitirKibbeh: { label: 'Spiced butter\n(niter kibbeh)', aka: ['Niter kibbeh', 'Niter qibe', 'Tesmi'], from: 'clarified', step: 'simmer with spices' },
	churn: { label: 'Churning liquid', aka: ['Sweet buttermilk', 'Süßrahmbuttermilch'], from: 'cream', step: 'the rest' },
	buttermilk: { label: 'Buttermilk', aka: ['Buttermilch'], from: 'churn', step: 'sour' },
	// The buttermilk of butter churned from soured milk or yoghurt rather than
	// cream, as across North Africa, the Middle East, Ethiopia and South Asia.
	// What is left of butter churned from the whole soured milk.
	fermButtermilk: {
		label: 'Fermented buttermilk',
		aka: ['Leben', 'Mattha'],
		examples: ['Lben', 'Chaas', 'Rob', 'Arera'],
		from: 'soured',
		alsoFrom: ['yoghurt'],
		step: 'churn',
		byproducts: { culturedButter: 'butter churned out' },
	},

	// Pasteurising kills the milk's own lactic bacteria, so it is soured with
	// a culture added back; traditionally, raw milk was left to sour by itself.
	soured: {
		label: 'Soured milk',
		aka: ['Sauermilch', 'Maas'],
		examples: ['Dickmilch', 'Filmjölk', 'Prostokvasha', 'Clabber', 'Piimä', 'Filbunke', 'Laban rayeb', 'Raib', 'Ergo', 'Amasi'],
		from: 'pasteurised',
		alsoFrom: ['raw'],
		step: 'ferment',
	},
	ropy: { label: 'Ropy milk', examples: ['Långfil', 'Viili', 'Tätmjölk'], from: 'pasteurised', step: 'ferment' },
	ryazhenka: { label: 'Ryazhenka', aka: ['Baked fermented milk', 'Ряженка'], examples: ['Varenets'], from: 'bakedMilk', step: 'ferment baked milk' },
	kefir: { label: 'Kefir', from: 'pasteurised', step: 'ferment with grains' },
	mildYoghurt: {
		label: 'Mild & probiotic\nyoghurt',
		aka: ['Joghurt mild', 'Joghurt probiotisch'],
		examples: ['Bioghurt', 'Actimel'],
		from: 'pasteurised',
		step: 'ferment with probiotics',
	},
	// Not yoghurt: one probiotic strain on its own, without the yoghurt cultures.
	probioticDrink: {
		label: 'Probiotic\nmilk drink',
		aka: ['Fermented milk drink'],
		examples: ['Yakult', 'Acidophilus milk'],
		from: 'skimmed',
		step: 'ferment',
	},
	yoghurt: { label: 'Yoghurt', aka: ['Yogurt', 'Joghurt', 'Matzoon'], examples: ['Dahi', 'Tarag', 'Matsoni'], from: 'pasteurised', step: 'ferment' },
	mishtiDoi: { label: 'Mishti doi', aka: ['Sweet yoghurt', 'Misti dahi'], from: 'fresh', step: 'sweeten, ferment' },
	creamYoghurt: { label: 'Cream yoghurt', aka: ['Sahnejoghurt'], from: 'yoghurt', step: 'ferment cream' },
	greek: { label: 'Greek yoghurt', aka: ['Strained yoghurt', 'Griechischer Joghurt'], examples: ['Labneh', 'Chakka', 'Suzma'], from: 'yoghurt', step: 'strain', byproducts: { acidWhey: 'whey strained off' } },
