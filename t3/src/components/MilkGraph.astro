	}
	/* Milk, where it all starts: large, and white, whiter than the pills,
	   with their edge. */
	.nodes :global(.node.is-root circle:not(.grain)) {
		fill: color-mix(in oklab, var(--pill), white 70%);
		stroke: var(--pill-rim);
		stroke-width: 2;
