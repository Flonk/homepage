		}
		.milk-about :global(.milk-about-credit) {
			margin-bottom: 0.8rem;
		}
		.milk-about :global(header.has-image img) {
			order: 1;
			align-self: center;
			/* The width of what is said over it, however small the photograph
			   itself; a tall one cut down to a band rather than a column. */
			width: 100%;
			height: auto;
			max-height: 12rem;
			object-fit: cover;
