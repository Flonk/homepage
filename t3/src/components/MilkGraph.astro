	colostrumPudding: {
		label: 'Colostrum pudding',
		aka: ['Råmjölkspudding', 'Beestings pudding'],
		examples: ['Kalvdans', 'Ábrystir', 'Junnu', 'Kharvas'],
		from: 'colostrum',
		step: 'bake or steam until set',
	},
	colostrumPowder: { label: 'Colostrum powder', from: 'colostrum', step: 'skim, dry gently' },
	travelan: { label: 'Hyperimmune\ncolostrum', aka: ['Travelan', 'Immune milk'], from: 'colostrumPowder', step: 'from immunised cows' },

	milkDrugs: {
		label: 'Drugs from\ntransgenic milk',
		aka: ['Antithrombin alfa', 'Conestat alfa', 'Pharming'],
		examples: ['ATryn', 'Ruconest'],
		from: 'raw',
		step: 'express in transgenic milk, purify',
	},

	rawCream: { label: 'Raw cream', aka: ['Rahm'], from: 'raw', step: 'the fat' },
	cream: { label: 'Cream', aka: ['Sahne', 'Crème liquide'], from: 'rawCream', step: 'pasteurise' },
