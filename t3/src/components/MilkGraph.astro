		aka: ['Getrockneter Joghurt', 'Kurt', 'Aarul'],
		examples: ['Kashk', 'Jameed', 'Qurut', 'Chortan', 'Aaruul'],
		from: 'yoghurt',
		alsoFrom: ['fermButtermilk'],
		step: 'churn, dry',
	},
	kishk: { label: 'Kishk', aka: ['Kishk shami', 'Keshk'], from: 'yoghurt', step: 'ferment, dry' },
	qaraqurut: { label: 'Qaraqurut', from: 'acidWhey', step: 'boil, dry' },
	dadiah: { label: 'Dadiah', aka: ['Dadih', 'Buffalo milk in bamboo'], from: 'raw', step: 'ferment in bamboo' },
	mursik: { label: 'Mursik', aka: ['Kule naoto', 'Gourd-fermented milk'], from: 'raw', step: 'ferment in gourd' },
	choormog: {
		label: 'Fermented\ncamel milk',
		aka: ['Khoormog', 'Chal'],
		examples: ['Choormog', 'Shubat', 'Gariss', 'Suusac', 'Dhanaan'],
		from: 'raw',
		step: 'ferment camel milk',
	},
	kumis: { label: 'Kumis / airag\n(mare\'s milk)', aka: ['Kumis', 'Koumiss', 'Kymyz', 'Airag', 'Kumys'], from: 'raw', step: 'ferment mare\'s milk' },
	arkhi: { label: 'Arkhi', aka: ['Milk vodka', 'Yark', 'Darasun', 'Araky'], examples: ['Shimiin arkhi', 'Araka', 'Tarasun', 'Araga'], from: 'yoghurt', alsoFrom: ['soured', 'kumis'], step: 'distil', byproducts: { stillCheese: 'left in the still' } },
	arkhiGrades: {
		label: 'Re-distilled arkhi\n(artz, khorz)',
		aka: ['Arz', 'Arza'],
		examples: ['Artz', 'Khorz'],
		from: 'arkhi',
		step: 'distil again',
	},
	// Cheese made from what the still leaves behind.
	stillCheese: { label: 'Still-residue\ncheese (shuurmg)', aka: ['Bozo', 'Khurskh', 'Shuurmg', 'Arsa', 'Aadmg'], from: 'arkhi', step: 'dry the still residue' },

	// Set by acid: the milk soured until it curdles.
	curd: { label: 'Acid curd', aka: ['Curd', 'Gallerte', 'Dickete'], from: 'soured', step: 'ferment, drain', byproducts: { acidWhey: 'whey drains off' } },
	quark: { label: 'Quark', aka: ['Topfen', 'Tvorog', 'Twaróg'], from: 'curd', step: 'drain', byproducts: { acidWhey: 'whey drains off' } },
	sourMilkCheese: { label: 'Sour milk cheese', aka: ['Sauermilchkäse'], examples: ['Harzer', 'Olmützer Quargel', 'Tiroler Graukäse', 'Handkäse', 'Mainzer'], from: 'quark', step: 'ripen' },
	cookedCheese: { label: 'Cooked cheese', aka: ['Kochkäse'], from: 'quark', step: 'cook' },
	mish: { label: 'Mish', aka: ['Mish cheese'], from: 'sourMilkCheese', step: 'pickle for years' },
	eezgii: { label: 'Eezgii', aka: ['Ээзгий', 'Browned curd'], from: 'curd', step: 'cook in its whey till brown' },
	rushan: { label: 'Rushan', aka: ['Milk fan', '乳扇'], from: 'chhena', step: 'stretch into sheets, dry' },
	// Set by heat and acid together, straight from hot milk.
	chhena: { label: 'Chhena', aka: ['Chhana', 'Chena'], from: 'pasteurised', step: 'curdle hot with acid', byproducts: { acidWhey: 'whey drains off' } },
	paneer: { label: 'Paneer', aka: ['Queso blanco'], examples: ['Rubing'], from: 'chhena', step: 'press' },
	chhenaSweets: { label: 'Chhena sweets', aka: ['Rosogolla'], examples: ['Rasgulla', 'Sandesh', 'Rasmalai'], from: 'chhena', step: 'knead, cook in syrup' },
	// Set by an enzyme from a plant: a third way, after rennet and acid.
	plantCheese: {
		label: 'Plant-set cheese',
		aka: ['Thistle-rennet cheese', '薑撞奶'],
		examples: ['Wagashi', 'Dangke', 'Ginger milk curd'],
		from: 'raw',
		step: 'set with a plant enzyme',
	},

	// Set by rennet: the enzyme from a calf's stomach, or a microbial one.
	rennetCurd: { label: 'Rennet curd', aka: ['Bruch', 'Käsebruch'], from: 'raw', alsoFrom: ['pasteurised'], step: 'set with rennet', byproducts: { sweetWhey: 'whey drains off' } },
	freshCheese: { label: 'Fresh cheese', aka: ['Frischkäse'], examples: ['Queso fresco', 'Panela', 'Stracchino', 'Robiola', 'Tomino'], from: 'rennetCurd', step: 'drain fresh' },
	soft: { label: 'Soft cheese', aka: ['Weichkäse'], examples: ['Bel Paese', 'Cuartirolo'], from: 'rennetCurd', step: 'drain unpressed' },
	semiHard: { label: 'Semi-hard cheese', aka: ['Schnittkäse'], examples: ['Manchego', 'Tilsiter', 'Appenzeller', 'Butterkäse', 'Morbier', 'Havarti', 'Saint-Paulin', 'Monterey Jack'], from: 'rennetCurd', step: 'press, brine' },
	hard: { label: 'Hard cheese', aka: ['Hartkäse', 'Extra-Hartkäse', 'Grana'], examples: ['Parmigiano Reggiano', 'Grana Padano', 'Pecorino Romano', 'Sbrinz', 'Mahón', 'Kefalotyri', 'Double Gloucester'], from: 'rennetCurd', step: 'scald, press' },
	bloomy: { label: 'Bloomy-rind cheese', aka: ['Weißschimmelkäse'], examples: ['Brie de Meaux', 'Camembert de Normandie', 'Coulommiers', 'Chaource', 'Brillat-Savarin'], from: 'soft', step: 'grow white mould' },
	blue: { label: 'Blue cheese', aka: ['Blauschimmelkäse'], examples: ['Roquefort', 'Gorgonzola', 'Stilton', 'Danish Blue', 'Cabrales'], from: 'rennetCurd', step: 'pierce, grow blue' },
	washed: { label: 'Washed-rind cheese', aka: ['Smear-ripened cheese', 'Rotschmierkäse'], examples: ['Époisses', 'Munster', 'Limburger', 'Taleggio', 'Herve'], from: 'soft', step: 'smear the rind' },
	alpine: { label: 'Alpine cheese', aka: ['Bergkäse'], examples: ['Emmentaler', 'Gruyère', 'Comté', 'Beaufort'], from: 'hard', step: 'scald, ripen' },
	cheddared: { label: 'Cheddared cheese', examples: ['Cheddar', 'Red Leicester', 'Dunlop', 'Cheese curds'], from: 'hard', step: 'cheddar' },
	washedCurd: { label: 'Washed-curd cheese', examples: ['Gouda', 'Edam', 'Colby', 'Leyden', 'Maasdam'], from: 'semiHard', step: 'wash the curd' },
