---
import { graph, herd } from './milk/graph';

/**
 * What milk becomes: every product as a node and every making-of as an arrow,
 * milk itself large in the middle and what is made from it pulled out round
 * it in rings, one ring a step of making further out. Redrawn from
 * Wikimedia Commons' "Milch.svg" (Milchprodukte und deren Herstellung), in
 * English, without its fat percentages or its coloured regions, and filled
 * out from a diagram of my own: homogenising, the strained yoghurts, the
 * fermented milks of the steppe, and whey protein.
 *
 *   <DeckViz><MilkGraph /></DeckViz>
 *   <DeckViz><MilkGraph focus="rawCream" /></DeckViz>
 *
 * With `focus`, a product's id, it opens on that product and everything
 * made from it, framed and lit, rather than on the whole tree; a card can
 * move it with `vizProps={{ focus: … }}`, or back to the whole with null.
 *
 * Laid out in the browser as a tree on a grid, worked out once so that no
 * two nodes overlap, each arrow saying how the one is made from the other.
 * The data is in milk/: the products a plain list in products.ts, each
 * saying what it is made from, and graph.ts putting it all together and
 * checking it; a product left out by deleting its line is reported at build
 * time by anything still made from it.
 */

interface Props {
	/** A product to open on, with everything made from it, framed and lit. */
	focus?: string;
}

const { focus } = Astro.props;
---

<figure class="milk-graph" data-milk-graph={JSON.stringify(graph)} data-focus={focus}>
	<div class="milk-search" data-no-swipe data-deck-tool>
		<svg class="milk-search-icon" viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="6.75" cy="6.75" r="4.75"></circle>
			<path d="M10.25 10.25L14 14"></path>
		</svg>
		<input
			type="search"
			role="combobox"
			placeholder="Search in Diagram…"
			aria-label="Search in the diagram"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			spellcheck="false"
		/>
		<div class="milk-beasts" role="group" aria-label="Only what is made from the milk of">
			{
				herd.map(({ mark, milk }) => (
					<button type="button" aria-pressed="false" data-milk={milk} title={`${milk[0].toUpperCase()}${milk.slice(1)} milk`}>
						{mark}
					</button>
				))
			}
		</div>
		<ul role="listbox" hidden></ul>
	</div>
	<div class="milk-note" role="tooltip" hidden></div>
	<section class="milk-map-card" aria-label="The map's cheeses" data-no-swipe hidden>
		<strong>Cheeses of the world</strong>
		<p>Filters to come.</p>
	</section>
	<canvas class="milk-canvas" role="img" aria-label="Milk products and how each is made from another" data-no-swipe></canvas>
	<aside class="milk-about" data-no-swipe inert>
		<button type="button" class="milk-about-close" aria-label="Close">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4L12 12M12 4L4 12"></path></svg>
		</button>
		<div class="milk-about-body"></div>
	</aside>
</figure>

<style>
	.milk-graph {
		/* Wider than a picture is let be (see DeckViz): it is a whole map. */
		--viz-max: 80rem;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		position: relative;
	}

	/* The search: a small field in the top left, over the picture, and what
	   it finds in a list under it; as the pills are on a light ground, on
	   glass on a dark one. */
	.milk-search {
		--field: var(--pill);
		--field-rim: var(--pill-rim);
		--found: var(--pill);
		--found-on: color-mix(in oklab, var(--deck-ground), white 30%);
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 2;
		width: min(16rem, calc(100% - 1.5rem));
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	/* A magnifying glass at the field's left, in the words' quieter ink. */
	.milk-search-icon {
		position: absolute;
		top: calc(0.6em + 2px);
		left: 0.65em;
		width: 1.1em;
		height: 1.1em;
		fill: none;
		stroke: var(--deck-ink-dim);
		stroke-width: 1.6;
		stroke-linecap: round;
		pointer-events: none;
		/* Over the field, whose glass is a layer of its own. */
		z-index: 1;
	}
	.milk-search input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.45em 0.7em 0.45em 2.1em;
		font: inherit;
		color: var(--deck-ink);
		background: var(--field);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
		backdrop-filter: blur(8px);
		outline: none;
	}
	.milk-search input:focus {
		border-color: var(--flb);
	}
	/* The animals, a row of them under the field: pressed, the tree shows
	   only what is made from their milk; the rest faded while any is. */
	.milk-beasts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.35rem;
	}
	.milk-beasts button {
		padding: 0.1em 0.25em;
		font-size: 0.95rem;
		line-height: 1.2;
		background: var(--field);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
		backdrop-filter: blur(8px);
		cursor: pointer;
	}
	.milk-beasts button[aria-pressed='true'] {
		border-color: var(--deck-ink);
		box-shadow: inset 0 0 0 1px var(--deck-ink);
	}
	.milk-beasts:has([aria-pressed='true']) button[aria-pressed='false'] {
		opacity: 0.45;
	}
	.milk-search ul {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0.25rem 0;
		max-height: 16rem;
		overflow-y: auto;
		background: var(--found);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
	}
	:global(.deck-dark) .milk-search {
		--field: var(--viz-glass);
		--field-rim: var(--viz-glass-rim);
		--found: var(--ground-300);
		--found-on: var(--ground-400);
	}
	/* Written by the script as it finds things, so out of the scoping. */
	.milk-search :global(li) {
		padding: 0.4em 0.7em;
		color: var(--deck-ink);
		cursor: pointer;
	}
	.milk-search :global(li small) {
		display: block;
		color: var(--deck-ink-dim);
		font-size: 0.85em;
	}
	.milk-search :global(li[aria-selected='true']) {
		background: var(--found-on);
		color: var(--lit);
	}
	/* The graph's own colours, by the ground it is on (the post's `ground`).
	   On the light one, the pills stand out of it a little whiter, edged in
	   a faint dark line, and the arrows are darker than the pills, the ink
	   they are drawn in; a lit arrow is the ink itself. On the dark one, the
	   pills are a rung up the ground's ladder, edged in the FLB, and a lit
	   arrow is the accent. */
	.milk-graph {
		--pill: color-mix(in oklab, var(--deck-ground), white 70%);
		--pill-rim: rgb(0 0 0 / 0.14);
		--line: color-mix(in oklab, var(--deck-ink-dim) 70%, var(--deck-ground));
		--lit: var(--deck-ink);
	}
	:global(.deck-dark) .milk-graph {
		--pill: var(--ground-300);
		--pill-rim: var(--flb);
		--line: color-mix(in oklab, var(--deck-ink-dim) 55%, var(--deck-ground));
		--lit: var(--ink-accent);
	}

	/* The card telling of what was clicked: a panel on the pills' own white,
	   slid in over the left of the picture, edge to edge, top to bottom; most
	   of the pane where it is too narrow for the card and the picture side
	   by side (below). */
	.milk-graph {
		container-type: inline-size;
	}
	/* A remark, under its mark and centred on it: small, as a footnote is. */
	.milk-note {
		position: absolute;
		z-index: 2;
		transform: translateX(-50%);
		margin-top: 0.3rem;
		padding: 0.25rem 0.55rem;
		max-width: 16rem;
		color: var(--deck-ink);
		background: var(--pill);
		border: 1px solid var(--pill-rim);
		border-radius: var(--radius-medium);
		box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 0.12);
		font-family: var(--font-sans);
		font-size: 0.8rem;
		line-height: 1.4;
		pointer-events: none;
	}
	.milk-note[hidden] {
		display: none;
	}
	/* The map's card: in its top left, over the far north of the Americas,
	   and kept in the pane's top left once that corner is out of sight, as
	   long as any of the map is in it (see placeCard). Under the search. */
	.milk-map-card {
		position: absolute;
		top: 0;
		left: 0;
		z-index: 1;
		box-sizing: border-box;
		width: 15rem;
		padding: 0.6rem 0.75rem;
		color: var(--deck-ink);
		background: var(--pill);
		border: 1px solid var(--pill-rim);
		border-radius: var(--radius-medium);
		box-shadow: 0 0.25rem 0.75rem rgb(0 0 0 / 0.08);
		/* Moved each frame the picture is: on a layer of its own. No blur
		   behind it, its ground being opaque: a blur over a canvas drawn
		   anew each frame is worked out anew each frame. */
		will-change: transform;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		line-height: 1.4;
	}
	.milk-map-card[hidden] {
		display: none;
	}
	.milk-map-card strong {
		display: block;
		margin: 0 0 0.35rem;
		font: inherit;
		font-weight: 600;
	}
	.milk-map-card p {
		margin: 0;
		color: var(--deck-ink-dim);
	}
	.milk-about {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 3;
		box-sizing: border-box;
		width: min(23rem, 100%);
		color: var(--deck-ink);
		background: var(--pill);
		border-right: 1px solid var(--pill-rim);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.5;
		/* Out of sight to the left until opened, and gone once it is out. */
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform 0.25s ease,
			visibility 0s 0.25s;
	}
	.milk-about.is-open {
		transform: none;
		visibility: visible;
		box-shadow: 0.5rem 0 1.5rem rgb(0 0 0 / 0.1);
		transition: transform 0.25s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.milk-about,
		.milk-about.is-open {
			transition: none;
		}
	}
	/* Where the pane is too narrow for the card and the picture side by
	   side, the card takes most of it but not all: a strip of the picture
	   is left at its side to tap, which shuts it. */
	@container (max-width: 40rem) {
		.milk-about {
			width: 80%;
		}
	}
	/* What scrolls, under the close button, which stays put. */
	.milk-about-body {
		box-sizing: border-box;
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1rem 1.1rem 0.9rem;
	}
	.milk-about-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 1;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0.35rem;
		color: var(--deck-ink-dim);
		background: none;
		border: 0;
		border-radius: var(--radius-medium);
		cursor: pointer;
	}
	.milk-about-close:hover {
		color: var(--deck-ink);
	}
	.milk-about-close svg {
		display: block;
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.6;
		stroke-linecap: round;
	}
	/* Written by the script as it tells of each, so out of the scoping. */
	.milk-about :global(header) {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		margin-bottom: 0.8rem;
	}
	/* The photograph in the panel's corner, out to its edges, the name and
	   other names beside it. */
	.milk-about :global(header.has-image) {
		margin: -1rem 0 0.8rem -1.1rem;
	}
	/* Clear of the close button. */
	.milk-about :global(header > div) {
		padding-right: 1.5rem;
	}
	/* Without the frame and the "###" the site gives an image and a heading in a post. */
	.milk-about :global(header img) {
		flex: none;
		width: 8rem;
		height: 8rem;
		padding: 0;
		border: 0;
		/* Rounded where it meets the panel, as the pane round it is (see DeckViz). */
		border-radius: 0 0 var(--viz-corner, 10px) 0;
		object-fit: cover;
	}
	.milk-about :global(header .milk-about-aka) {
		margin: 0.3rem 0 0;
	}
	.milk-about :global(h3) {
		margin: 0;
		font-size: 1.15rem;
		line-height: 1.25;
	}
	.milk-about :global(h3::before) {
		content: none;
	}
	.milk-about :global(p) {
		margin: 0 0 0.6rem;
	}
	.milk-about :global(.milk-about-kind),
	.milk-about :global(.milk-about-aka),
	.milk-about :global(.milk-about-source),
	.milk-about :global(.milk-about-credit),
	.milk-about :global(dt) {
		color: var(--deck-ink-dim);
		font-size: 0.9em;
	}
	.milk-about :global(.milk-about-kind) {
		margin: 0 0 0.1rem;
	}
	.milk-about :global(dl) {
		margin: 0.8rem 0 0.6rem;
		padding-top: 0.6rem;
		border-top: 1px solid var(--pill-rim);
	}
	.milk-about :global(.milk-about-fact) {
		display: grid;
		grid-template-columns: 6.5rem 1fr;
		gap: 0.6rem;
		margin-bottom: 0.3rem;
	}
	.milk-about :global(dd) {
		margin: 0;
	}
	.milk-about :global(a),
	.milk-about :global(.milk-about-to) {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, currentColor 35%, transparent);
		text-underline-offset: 0.15em;
	}
	.milk-about :global(.milk-about-to) {
		padding: 0;
		font: inherit;
		background: none;
		border: 0;
		cursor: pointer;
	}
	.milk-about :global(a:hover),
	.milk-about :global(.milk-about-to:hover) {
		text-decoration-color: currentColor;
	}
	.milk-about :global(.milk-about-credit) {
		margin: 0;
		font-size: 0.8em;
	}
	/* On a wide screen the panel is tall and has the room: the photograph
	   leaves the name's side for the foot of the panel, under everything
	   said, its credit just above, within the panel's padding and centred.
	   The header's own box goes, so its picture can be placed apart from the
	   rest of it; the name keeps the room the header gave it. */
	@media (min-width: 1100px) {
		/* And the panel only the upper half of the picture's left, so the
		   picture below it stays in sight: a card of its own, set in from the
		   corner and rounded as the panel round the picture is (DeckViz's
		   corner), its words clipped to that round. Slid out past the inset. */
		.milk-about {
			top: 0.75rem;
			left: 0.75rem;
			bottom: auto;
			height: calc(50% - 0.75rem);
			border: 1px solid var(--pill-rim);
			border-radius: var(--viz-corner, 10px);
			overflow: hidden;
			transform: translateX(calc(-100% - 0.75rem));
		}
		/* Lifted well off the picture, a close shadow under its edge and a
		   long soft one round it. */
		.milk-about.is-open {
			transform: none;
			box-shadow:
				0 4px 12px rgb(0 0 0 / 0.35),
				0 12px 32px rgb(0 0 0 / 0.45),
				0 32px 80px rgb(0 0 0 / 0.55);
		}
		.milk-about-body {
			display: flex;
			flex-direction: column;
		}
		.milk-about :global(header.has-image) {
			display: contents;
		}
		.milk-about :global(header.has-image > div) {
			margin-bottom: 0.8rem;
		}
		.milk-about :global(.milk-about-credit) {
			margin-bottom: 0.8rem;
		}
		.milk-about :global(header.has-image img) {
			order: 1;
			align-self: center;
			/* The width of what is said over it, however small the photograph
			   itself; a tall one cut down to a band rather than a column. */
			width: 100%;
			height: auto;
			max-height: 12rem;
			object-fit: cover;
			margin-top: auto;
			border-radius: var(--radius-large);
		}
	}

	/* The picture, drawn by the script (see paint) in the colours above. */
	canvas.milk-canvas {
		display: block;
		width: 100%;
		height: 100%;
		touch-action: none;
		cursor: grab;
	}
	canvas.milk-canvas:active {
		cursor: grabbing;
	}
</style>

<script>
	import { select } from 'd3-selection';
	import 'd3-transition';
	import { zoom, zoomIdentity } from 'd3-zoom';
	import type { Sourcing } from './milk-schema';
	import { eachPage } from '../lib/page';

	type Node = {
		id: string;
		x: number;
		y: number;
		label: string;
		// How it is made from what it hangs from, written on the arrow into it.
		step?: string;
		// Its photograph, if it has one, and whose it is.
		image?: { src: string; credit: string; author: string; license: string; source: string };
		// What it is, said when it is clicked, and where that was said first.
		about?: { text: string; sources: Sourcing };
		// All a product's examples, the drawn and the rest.
		named?: string[];
		// The countries it comes from, if it is regional.
		regions?: string[];
		// How the step into it is done, and the sources (see steps.json).
		how?: {
			label?: string;
			table?: { k: string; v: string }[];
			facts?: { k: string; v: string }[];
			text?: string;
			// A cheese on the map's are with its paragraph (see about).
			sources?: Sourcing;
		};
		// How much of the world's milk goes its way, in Mt a year and in percent, and how that was worked out (see SHARES).
		shareMt?: number;
		share?: number;
		shareSources?: Sourcing;
		// A kind measured along a ruler, and where on its parent's ruler a product hangs (see Product).
		scale?: { name: string; unit: string; to: number; every: number };
		at?: number;
		// A family drawn as a panel, and where a cheese goes in one (see Product and EXAMPLE_AXES).
		panel?: boolean;
		axes?: { firm: string; days: [number, number] };
		// A map's header, and a cheese on it, with the country it is put in (see WORLD).
		map?: boolean;
		onMap?: boolean;
		place?: string;
		// The region of its country it is from, where on the map that is, and whether that is a guess.
		area?: string;
		spot?: [number, number];
		guessed?: boolean;
		// The family of cheese it is of, the family itself drawn only as the map (see mapped).
		family?: string;
		// A protected name (PDO, PGI or TSG), and why its place is a guess, if it is.
		protected?: string;
		unsure?: string;
		below?: string;
		// The product this one is drawn again of (see Product).
		link?: string;
		// Its remark, behind the info mark (see Product).
		note?: string;
		// The animals it is made from the milk of, if not a cow (see MILK_OF).
		beasts?: { mark: string; milk: string }[];
		// Which family's slice it is held in; milk, in the middle, is in none.
		group: number;
		// 0 a staple, 1 well known, 2 niche (see STAPLE and KNOWN).
		niche: number;
		hub?: boolean;
		// Found by the search, though not drawn.
		aka?: string[];
		// An example of its parent, not made from it, kept in the order they are listed.
		example?: boolean;
		rank?: number;
		// Steps of making from milk, a treatment counting light (see TREATED).
		dist: number;
		w: number;
		h: number;
	};
	type Made = { source: string; target: string; weight: number };
	type Edge = { source: Node; target: Node; made: boolean };

	const ROOT = 'raw';
	const NODE_H = 40;
	const LINE = 15;
	const PAD_X = 14;
	// The words' size at 1×, matching the stylesheet.
	const FONT = 13;
	// How much of milk's width its word runs across.
	const ROOT_WORD = 0.7;
	// The gap between one column and the next, where the lines turn.
	const GAP_X = 56;
	// The steps' words at 1×, and the room either side of them (both growing
	// with the product the arrow makes).
	const STEP_FONT = 10;
	const STEP_PAD = 16;
	// A pill's corners at 1×: half the design system's --radius-medium.
	const RADIUS = 2;
	// How tall on the screen a product found by the search is zoomed to, in px.
	const FOUND_HEIGHT = 44;
	// How far products' branches are packed together, from 0 (each below the
	// whole of the one before) to 1 (as close as their outlines allow).
	const PACKING = 0.8;
	// The room between a pill's photograph and its words.
	const PICTURE_GAP = 6;
	// The link mark at the right end of a product drawn again (see Product), and the room it takes.
	const LINK_MARK = 11;
	const LINK_ROOM = LINK_MARK + 6;
	// The least room between a pill and anything not its sibling.
	const APART = 40;
	// The room left under each pill, between it and the next row.
	const ROW_GAP = 8;
	/* A product is drawn the bigger the more is made from it, all the way
	   down: as a little more than the square root of one more than that, so
	   a product with nothing under it is 1×, three under it about 2.7×,
	   fifteen 7.4×. Milk is twice what that makes it. The picture is meant to be zoomed into: the great
	   branch points read from afar, the ends of the branches close up. */
	const sizeOf = (made: number) => (1 + made) ** 0.72;
	const MILK = 2;
	/* How thick a line is for each thing at the end of it: a line carries
	   everything made down its branch, so it is this many times as thick as
	   that is many, and a line out of a product splits into its children's
	   as a river does, each strand as thick as its own branch (see draw). */
	const STRAND = 1.5;
	/* An arrowhead: the line's own end, tapering to a point, as wide as the
	   line, or as a small head's width where the line is thinner than that. */
	const headWidth = (line: number) => Math.max(line, 7);
	const headLength = (line: number) => 0.8 * headWidth(line) + 4;
	// How round a line's corners are.
	const CORNER = 8;
	// The room round the whole, framed, in pixels on the screen.
	const MARGIN = 16;
	/* How far in it can be zoomed: until the smallest words, a step's table
	   on a thin arrow, read. */
	const MAX_ZOOM = 2000;
	// How big a cheese is drawn on the map (see layMap), against a product's least.
	const MAP_PILL = 0.06;
	/* A ruler in a kind (see Product), along the bottom of its pill: this
	   long a unit, room either end for what it measures; its products this far under it and their rows this far apart, and products
	   side by side this far apart. */
	const RULE_PX = 20;
	const RULER_END = 4 * PAD_X + 48;
	const DROP = 36;
	const TIER_GAP = 28;
	const SIDE_GAP = 10;

	/* Words measured on a canvas, in the graph's own font, rather than asked
	   of the SVG, which lays the whole page out again for every one asked: a
	   text's width is its widest line. The font is loaded before anything is
	   drawn (see eachPage), as a canvas measures in whatever it has. */
	// Looked up once: asking the page's styles for it is not free.
	let sans = '';
	const SANS = () => (sans ||= getComputedStyle(document.documentElement).getPropertyValue('--font-sans').trim() || 'sans-serif');
	// And the site's mono, the pills' names in it.
	let mono = '';
	const MONO = () => (mono ||= getComputedStyle(document.documentElement).getPropertyValue('--font-mono').trim() || 'monospace');
	// The prose's face, for the info mark's i.
	let serif = '';
	const SERIF = () => (serif ||= getComputedStyle(document.documentElement).getPropertyValue('--font-prose').trim() || 'serif');
	const FACES = ['400', 'italic 400', '600'];
	const ruler = document.createElement('canvas').getContext('2d')!;
	let rulerFont = '';
	const measure = (said: string, px: number, face = '400', family = SANS()) => {
		/* At a size where it measures true, and scaled to the one it is drawn
		   at: words a few pixels high, as a step's table's are, measure wide
		   of what they are drawn, as their widths are rounded at that size.
		   The font set only when it changes, as setting it is not free. */
		const font = `${face} 100px ${family}`;
		if (font !== rulerFont) ruler.font = rulerFont = font;
		/* And the page's letter spacing, which the words inherit as so many
		   pixels a letter whatever their size, and which on the smallest of
		   them is a good part of their width. */
		return Math.max(...said.split('\n').map((l) => (ruler.measureText(l).width * px) / 100 + spacing * [...l].length));
	};
	let spacing = 0;

	// How many have been drawn, to name each one's own parts apart.
	let drawn = 0;
	type Graph = {
		light: number;
		groups: { name: string; hub: string | null }[];
		splits: { from: string; step: string; ids: string[] }[];
		kinds: { step: string; ids: string[]; how: Node['how'] }[];
		nodes: Node[];
		links: Made[];
		map: { height: number; countries: Record<string, { name: string; label: [number, number]; rings: number[][] }> };
	};
	/* Only what is made from the milk of the animals chosen, and what that
	   is made from, so the tree still reads down to it. A product with no
	   animal marked is a cow's; one drawn again goes as the one it is of. */
	const only = (data: Graph, milks: Set<string>): Graph => {
		if (!milks.size) return data;
		const byId = new Map(data.nodes.map((n) => [n.id, n]));
		const fits = (n: Node) => ((n.link && byId.get(n.link)) || n).beasts?.map((b) => b.milk) ?? ['cow'];
		const parent = new Map(data.links.map((l) => [l.target, l.source]));
		const kept = new Set([ROOT]);
		for (const n of data.nodes)
			if (fits(n).some((m) => milks.has(m))) for (let id: string | undefined = n.id; id && !kept.has(id); id = parent.get(id)) kept.add(id);
		return {
			...data,
			nodes: data.nodes.filter((n) => kept.has(n.id)),
			links: data.links.filter((l) => kept.has(l.source) && kept.has(l.target)),
			splits: data.splits.map((p) => ({ ...p, ids: p.ids.filter((id) => kept.has(id)) })).filter((p) => p.ids.length > 1),
			kinds: data.kinds.map((k) => ({ ...k, ids: k.ids.filter((id) => kept.has(id)) })).filter((k) => k.ids.length),
		};
	};

	/* Drawn from the graph given, the whole of it or what a filter left of
	   it; framed whole, not on the card's product, when it is filtered. */
	function draw(figure: HTMLElement, signal: AbortSignal, data: Graph, whole = false) {
		// As the words in it have it (see measure).
		spacing = parseFloat(getComputedStyle(figure).letterSpacing) || 0;
		const { light, groups, links } = data;
		// The search's list named for it alone, as another graph on the page would name its own the same.
		const uid = `milk-${++drawn}`;
		const products = data.nodes;
		const byId = new Map(products.map((n) => [n.id, n]));

		/* How far each is from milk, by the shortest way there with each step
		   counted at its weight. The other milks nothing is made from,
		   colostrum and the other animals', count as a light step out from
		   milk; a product neither reaches sits out past the rest. */
		const roots = products.filter((n) => n.id !== ROOT && !links.some((l) => l.target === n.id));
		const dist = new Map<string, number>([[ROOT, 0], ...roots.map((n) => [n.id, light] as [string, number])]);
		for (let changed = true; changed; ) {
			changed = false;
			for (const { source, target, weight } of links) {
				const via = (dist.get(source) ?? Infinity) + weight;
				if (via < (dist.get(target) ?? Infinity)) {
					dist.set(target, via);
					changed = true;
				}
			}
		}
		const deepest = Math.max(...dist.values());
		for (const n of products) n.dist = dist.get(n.id) ?? deepest + 1;

		const root = byId.get(ROOT)!;

		/* The tree that is drawn is the data's: each product hangs from the one
		   it is made from, the others milks from milk. Where a product has two
		   or more children of one family that is not its own, and that family
		   has a hub, the hub goes in between, a kind rather than a product:
		   fresh milk, then cooked-down milk, then the five made by boiling it
		   down. So a family comes off its parent as one branch, and every node
		   still has the one line in. */
		const treeParent = new Map<Node, Node>();
		for (const { source, target } of links) treeParent.set(byId.get(target)!, byId.get(source)!);
		for (const n of products) if (n !== root && !treeParent.has(n)) treeParent.set(n, root);
		const hubs: Node[] = [];
		const under = new Map<Node, Node[]>();
		for (const [n, p] of treeParent) under.set(p, [...(under.get(p) ?? []), n]);
		// Those made together by one step count as one, being one branch already (see SPLITS).
		const splitOf = new Map(data.splits.flatMap(({ from, ids }) => ids.map((id) => [id, `${from}:${ids}`])));
		for (const [p, kids] of under) {
			groups.forEach(({ hub }, g) => {
				const family = kids.filter((k) => k.group === g);
				if (!hub || p.group === g || new Set(family.map((k) => splitOf.get(k.id) ?? k.id)).size < 2) return;
				const h: Node = {
					id: `hub:${p.id}:${g}`,
					label: '',
					// Not a product: a point where one arrow splits, its name on that arrow.
					step: hub,
					group: g,
					niche: 0,
					hub: true,
					// A little further out than its parent, nearer than any of its own.
					dist: p.dist + 0.3,
					x: 0,
					y: 0,
					w: 0,
					h: 0,
				};
				hubs.push(h);
				treeParent.set(h, p);
				for (const k of family) treeParent.set(k, h);
			});
		}
		/* And under each parent, or hub, those of one kind as a branch of
		   their own, if there are two or more of it there (see KINDS). */
		data.kinds.forEach(({ step, ids, how }, i) => {
			const by = new Map<Node, Node[]>();
			for (const id of ids) {
				const n = byId.get(id)!;
				const p = treeParent.get(n)!;
				by.set(p, [...(by.get(p) ?? []), n]);
			}
			for (const [p, kind] of by) {
				if (kind.length < 2) continue;
				const h: Node = {
					id: `kind:${p.id}:${i}`,
					label: '',
					step,
					how,
					group: kind[0].group,
					niche: 0,
					hub: true,
					dist: p.dist + 0.3,
					x: 0,
					y: 0,
					w: 0,
					h: 0,
				};
				hubs.push(h);
				treeParent.set(h, p);
				for (const k of kind) treeParent.set(k, h);
			}
		});
		/* And a step making several at once, as separating milk does (see
		   SPLITS): from the hub they would be under, if their family has one
		   there, so it keeps them as one branch with the rest of it. */
		for (const { from, step, ids } of data.splits) {
			const made = ids.map((id) => byId.get(id)!);
			const p = treeParent.get(made[0])!;
			const h: Node = {
				id: `split:${from}:${ids.join(':')}`,
				label: '',
				step,
				group: made[0].group,
				niche: 0,
				hub: true,
				dist: p.dist + 0.3,
				x: 0,
				y: 0,
				w: 0,
				h: 0,
			};
			hubs.push(h);
			treeParent.set(h, p);
			for (const k of made) treeParent.set(k, h);
		}
		const nodes = [...products, ...hubs];

		/* Who hangs from whom: the families in the order they are listed,
		   and within a family the more everyday first, then the nearer milk. */
		const children = new Map<Node, Node[]>();
		for (const [n, p] of treeParent) children.set(p, [...(children.get(p) ?? []), n]);
		for (const kids of children.values())
			kids.sort(
				(a, b) =>
					Number(!!a.example) - Number(!!b.example) ||
					(a.example && b.example ? a.rank! - b.rank! : 0) ||
					a.group - b.group ||
					a.niche - b.niche ||
					a.dist - b.dist ||
					a.label.localeCompare(b.label),
			);

		/* How much is made from each, all the way down, counting products
		   and not the hubs among them, and a map's cheeses; on a log scale,
		   so the great branch points stand out without swamping the rest. */
		const made = new Map<Node, number>();
		const tally = (n: Node): number => {
			const v = (children.get(n) ?? []).reduce((s, k) => s + (k.hub ? 0 : 1) + tally(k), 0);
			made.set(n, v);
			return v;
		};
		tally(root);

		/* Siblings by size, the biggest branch at the top and the small ones
		   gathered at the bottom. Branches as big as each other keep the order
		   above; examples stay together after the products. Milk's own are
		   left as they are, and ordered when they are placed. A kind with a
		   ruler goes last, below the rest, as all it hangs reaches down. */
		for (const [p, kids] of children) {
			if (p === root) continue;
			const products = kids.filter((k) => !k.example);
			const examples = kids.filter((k) => k.example);
			const biggest = [...products].sort((a, b) => Number(!!a.scale) - Number(!!b.scale) || made.get(b)! - made.get(a)!);
			kids.splice(0, kids.length, ...biggest, ...examples);
			// One drawn below a sibling moved there, after that sibling's branch, a split's included.
			for (const k of [...kids].filter((k) => k.below)) {
				const leads = (n: Node): boolean => n.id === k.below || (!!n.hub && (children.get(n) ?? []).some(leads));
				const kin = kids.find((n) => n !== k && leads(n));
				if (!kin) continue;
				kids.splice(kids.indexOf(k), 1);
				kids.splice(kids.indexOf(kin) + 1, 0, k);
			}
		}
		// Each drawing of it again counts as one more thing made from it.
		const drawnAgain = new Map<Node, number>();
		for (const n of nodes) if (n.link) drawnAgain.set(byId.get(n.link)!, (drawnAgain.get(byId.get(n.link)!) ?? 0) + 1);
		/* One drawn again is as big as the product it is, but no bigger than
		   the biggest beside it, so it does not swamp what it is drawn with. */
		const beside = (n: Node) => (children.get(treeParent.get(n)!) ?? []).filter((k) => k !== n && !k.example && !k.link);
		const linked = (n: Node, of: (n: Node) => number) => Math.min(of(byId.get(n.link!)!), Math.max(...beside(n).map(of), 0) || Infinity);
		const grown = (n: Node): number =>
			n.link ? linked(n, grown) : sizeOf(made.get(n)! + (drawnAgain.get(n) ?? 0)) * (n === root ? MILK : 1);
		/* A kind with a ruler no bigger than the products beside it with any
		   of their own are, middling among them: it is as wide as its ruler
		   already, and what hangs under it is drawn at its own size. */
		const size = (n: Node): number => {
			if (n.onMap) return MAP_PILL;
			if (!n.scale) return grown(n);
			const beside = (children.get(treeParent.get(n)!) ?? [])
				.filter((k) => !k.scale && !k.example && made.get(k)! > 0)
				.map(grown)
				.sort((a, b) => a - b);
			return beside.length ? Math.min(grown(n), beside[Math.floor(beside.length / 2)]) : grown(n);
		};
		/* How much a line into each carries: itself, and all made from it
		   (a branch point is no product, so only what it splits into). */
		const carried = new Map<Node, number>();
		const carry = (n: Node): number => {
			// One drawn again carries as much as it is big (see grown).
			if (n.link) {
				const v = linked(n, carry);
				carried.set(n, v);
				return v;
			}
			const v = (n.hub ? 0 : 1) + (children.get(n) ?? []).reduce((sum, k) => sum + carry(k), 0);
			carried.set(n, v);
			return v;
		};
		carry(root);
		/* Where how much of the world's milk goes is known for every one of a
		   product's children (see SHARES), they are as big, and their lines
		   as thick, as that share of all milk carries, and all they make
		   with them, each as big against the others as it was: milk's own
		   by how much goes each way, not by how much is made of it. A step
		   that splits, or a branch point, has the shares of what it leads to. */
		const shareOf = (n: Node): number | undefined => {
			if (!n.hub) return n.share;
			const shares = (children.get(n) ?? []).filter((k) => !k.example).map(shareOf);
			return shares.every((v) => v !== undefined) ? shares.reduce((t, v) => t! + v!, 0) : undefined;
		};
		const scaleBy = (n: Node, f: number) => {
			carried.set(n, carried.get(n)! * f);
			made.set(n, made.get(n)! * f);
			for (const k of children.get(n) ?? []) scaleBy(k, f);
		};
		const allMilk = carried.get(root)!;
		const apportion = (p: Node) => {
			const kids = (children.get(p) ?? []).filter((k) => !k.example);
			if (kids.length && kids.every((k) => shareOf(k) !== undefined)) {
				const shareTo = (k: Node) => {
					if (!k.hub) return scaleBy(k, ((k.share! / 100) * allMilk) / carried.get(k)!);
					const theirs = (children.get(k) ?? []).filter((g) => !g.example);
					theirs.forEach(shareTo);
					carried.set(k, theirs.reduce((t, g) => t + carried.get(g)!, 0));
				};
				kids.forEach(shareTo);
			}
			for (const k of kids) apportion(k);
		};
		apportion(root);
		/* What hangs under a ruler is laid out there, not out to the right as
		   a branch is: taken out of the tree's layout once it has counted
		   towards the sizes and lines above. */
		const hanging = new Map<Node, Node[]>();
		for (const [p, kids] of children)
			if (p.scale) {
				hanging.set(p, kids);
				children.delete(p);
			}
		// A panel's cheeses are laid out in it, not as leaves of the tree (see Product); its products stay.
		const paneled = new Map<Node, Node[]>();
		for (const [p, kids] of children)
			if (p.panel || p.map) {
				const mine = (k: Node) => (p.map ? !!k.onMap : k.example);
				paneled.set(p, kids.filter(mine));
				children.set(p, kids.filter((k) => !mine(k)));
				if (!children.get(p)!.length) children.delete(p);
			}
		const panelOf = (n: Node) => {
			const p = treeParent.get(n);
			return p && paneled.has(p) ? p : null;
		};
		// What hangs under a ruler, by value: those at one value are one list.
		const listsOf = (r: Node) => {
			const at = new Map<number, Node[]>();
			for (const k of hanging.get(r)!) at.set(k.at!, [...(at.get(k.at!) ?? []), k]);
			return at;
		};
		const hangsFrom = (n: Node) => {
			const p = treeParent.get(n);
			return p && hanging.has(p) ? p : null;
		};
		// The line into a product, and how long its arrowhead is.
		const line = (n: Node) => STRAND * carried.get(n)!;
		const arrow = (n: Node) => headLength(line(n));
		// Milk is a circle half as wide again as a pill of its size is tall.
		const rootR = 1.5 * (NODE_H / 2) * size(root);

		// A photograph is square, as tall as its pill.
		const picture = (d: Node) => NODE_H * size(d);
		const radius = (d: Node) => RADIUS * size(d);

		/* Each pill measured round its own words, with room at its left for
		   its photograph; milk a circle. A kind's pill is its ruler: as wide
		   as the ruler and a margin either end. */
		const shown = nodes.filter((n) => !n.hub);
		for (const d of shown) {
			if (d === root) {
				d.w = d.h = rootR * 2;
				continue;
			}
			d.w = measure(d.label, FONT * size(d), '400', MONO()) + 2 * PAD_X * size(d);
			d.h = NODE_H * size(d);
			if (d.image) d.w += picture(d) + PICTURE_GAP * size(d);
			if (d.link) d.w += LINK_ROOM * size(d);
			if (d.scale) d.w = Math.max(d.w, d.scale.to * RULE_PX + RULER_END);
		}
		// A list under a ruler as wide as the widest in it.
		for (const r of hanging.keys())
			for (const ks of listsOf(r).values()) {
				const wide = Math.max(...ks.map((k) => k.w));
				for (const k of ks) k.w = wide;
			}
		const countryName = new Intl.DisplayNames(['en'], { type: 'region' });
		/* A regional one's flags: on its top right corner, a little over it,
		   round, edged as the pill is; two to four side by side leftwards from
		   there, each a little over the one before. Each one's middle, and how
		   big. */
		const flagsOf = (d: Node) => {
			const r = d.h * 0.2;
			const n = d.regions!.length;
			return d.regions!.map((c, i) => ({ c, r, x: d.x + d.w / 2 - r * 0.35 - (n - 1 - i) * r * 1.4, y: d.y - d.h / 2 + r * 0.35 }));
		};

		/* Laid out as a tree on a grid, as a diagram on paper is: milk at the
		   left and its branches off to the right of it; each step of making a
		   column further out from what it is made from; each product at the
		   end of a branch a row of its own, and every parent level with the
		   middle of what hangs from it. Nothing can overlap, and no line has
		   to cross a pill. */

		/* The steps, written on the last stretch of each arrow, just before
		   the product it makes; measured here, so each parent leaves room
		   enough for its children's. A hub's own arrow is a kind, not a
		   step, and has none. */
		// At the same scale as the product the arrow makes, as its own words are.
		/* Larger on an arrow whose step is told of in full, a title, whether or
		   not it has a table under it, so siblings read alike. */
		const stepFont = (n: Node) => STEP_FONT * size(n) * (n.how?.facts?.length || n.how?.table?.length ? 1.6 : 1);
		const stepped = nodes.filter((n) => n.step && n !== root && !panelOf(n));
		/* A step in as many lines as it is written in, the last just over its
		   arrow and the rest stacked up from there; inside an arrow, all of
		   them centred on it. */
		const lines = (n: Node) => n.step!.split('\n');
		const LEADING = 1.15;
		// How much taller than one line its words are.
		const extra = (n: Node) => (n.step ? (lines(n).length - 1) * LEADING * stepFont(n) : 0);
		const stepWidth = new Map<Node, number>();
		for (const n of stepped) stepWidth.set(n, measure(n.step!, stepFont(n), 'italic 400'));
		/* A step's table, under the step's name and laid over its arrow: a row a
		   fact, what it is on the left and its value on the right, a value in
		   as many lines as it is written in; small, a footnote to the name. */
		const ROW = 1.3;
		/* None under a ruler, where the arrows in are its own and have no step
		   written on them. An example's arrow may have no words and still its
		   table, of what it is fermented with, say. */
		const rows = (n: Node) => (hangsFrom(n) || panelOf(n) ? [] : (n.how?.table ?? []));
		// An example's a little bigger, its pill and arrow being small, so it reads zoomed out as far as a product's.
		const tableFont = (n: Node) => STEP_FONT * size(n) * (n.example ? 0.5 : 0.35);
		/* Its words broken onto lines no wider than so many of its letters
		   high, a key narrower than a value, so a long list of cultures reads
		   down the table and not off across the graph. Kept, as measuring is
		   not free and the size does not change what breaks where. */
		const KEY_WIDE = 9;
		const VALUE_WIDE = 18;
		const broken = new Map<string, string[]>();
		const wrap = (said: string, wide: number, face: string) => {
			const kept = broken.get(`${face}${wide}${said}`);
			if (kept) return kept;
			const out: string[] = [];
			for (const given of said.split('\n')) {
				let at = '';
				for (const word of given.split(' ')) {
					const tried = at ? `${at} ${word}` : word;
					if (at && measure(tried, 100, face) / 100 > wide) {
						out.push(at);
						at = word;
					} else at = tried;
				}
				out.push(at);
			}
			broken.set(`${face}${wide}${said}`, out);
			return out;
		};
		const keyLines = (k: string) => wrap(k, KEY_WIDE, '600');
		const rowLines = (v: string) => wrap(v, VALUE_WIDE, '400');
		const tabled = nodes.filter((n) => rows(n).length > 0);
		const columns = new Map<Node, { key: number; value: number }>();
		for (const n of tabled) {
			const widest = (said: string[], face: string) => Math.max(...said.map((t) => measure(t, tableFont(n), face)));
			columns.set(n, { key: widest(rows(n).flatMap(({ k }) => keyLines(k)), '600'), value: widest(rows(n).flatMap(({ v }) => rowLines(v)), '400') });
		}
		// The room in a cell round its words.
		const pad = (n: Node) => tableFont(n) * 0.6;
		const tableWidth = (n: Node) => {
			const c = columns.get(n);
			return c ? c.key + c.value + 4 * pad(n) : 0;
		};
		// A row as tall as its key's lines or its value's, and its padding.
		const rowHeight = (n: Node, { k, v }: { k: string; v: string }) =>
			Math.max(keyLines(k).length, rowLines(v).length) * ROW * tableFont(n) + pad(n);
		// How tall it is, with a little air under it.
		const tableHeight = (n: Node) =>
			rows(n).length ? rows(n).reduce((sum, row) => sum + rowHeight(n, row), 0) + tableFont(n) * 0.6 : 0;
		// Inside its arrow, centred on it, where the arrow is that thick.
		const tableInside = (n: Node) => line(n) >= tableHeight(n) + tableFont(n);
		/* Where it begins, from the middle of its arrow: in the arrow, or just
		   under the step's words, laid over it. */
		const tableTop = (n: Node) =>
			tableInside(n) ? -(tableHeight(n) - tableFont(n) * 0.6) / 2 : -line(n) / 2 - stepFont(n) * 0.45 + stepFont(n) * 0.3;
		// How far under the middle of its arrow it reaches, laid over the arrow.
		const tableBottom = (n: Node) => (rows(n).length ? tableTop(n) + tableHeight(n) : 0);

		/* Across: each product just past the edge of what it is made from,
		   by a gap as wide as that parent wants, the bigger the wider; not in
		   columns shared with the rest of the tree, where one great pill would
		   push every small one's children far off. A branch keeps its own
		   rows, so nothing it shares a column with can be in its way. */
		/* From a parent's edge out to its trunk, then from the trunk on to each
		   child: a distance that goes by the parent and the child's size, so
		   that its children drawn the same size line up, as far out as the
		   longest step written into any of them needs, so every step still
		   fits; and a small child is not pushed out by a great sibling's
		   words, nor by any other parent's. Siblings are in rows of their own,
		   so they cannot meet. */
		// A branch point turns at once: it has no pill to clear.
		// Milk keeps a margin of half its own size, its radius, all round it.
		const toTrunk = (n: Node) => (n === root ? rootR : n.hub ? GAP_X / 4 : (GAP_X / 2) * Math.sqrt(size(n)));
		/* Half as wide as the trunk out of a product, the line into the
		   biggest of its children: kept clear of on both sides, so neither the
		   parent nor a step's words beside it are under it. */
		const halfTrunk = (n: Node) => (children.get(n) ?? []).reduce((sum, k) => sum + line(k), 0) / 2;
		const needs = (k: Node) =>
			Math.max(
				(GAP_X / 2) * Math.sqrt(size(k)),
				Math.max(stepWidth.get(k) ?? 0, tableWidth(k)) + 2 * STEP_PAD * size(k) + arrow(k),
			);
		const key = (k: Node) => `${treeParent.get(k)!.id} ${size(k)}`;
		const out = new Map<string, number>();
		for (const k of nodes) if (k !== root) out.set(key(k), Math.max(out.get(key(k)) ?? 0, needs(k)));
		const fromTrunk = (k: Node) => out.get(key(k))!;
		// How far a product reaches out to the right.
		const outer = (n: Node) => n.x + n.w / 2;
		/* A ruler: the arrows off it leave from its pill's bottom edge, this
		   far under its middle, each where its value is along the ruler, which
		   is centred in the pill. */
		const axisY = (r: Node) => r.h / 2;
		const tickX = (r: Node, v: number) => r.x + (v - r.scale!.to / 2) * RULE_PX;
		/* Each product centred straight under its value, its arrow straight
		   down into its middle; those at one value as one list, stacked one on
		   another as wide as each other, the arrow into the top of it. In rows, no two values' lists meeting in one: of every way to put them
		   in rows, the one with the fewest arrows passing under a pill in a row
		   above, then the fewest rows, then the most in the upper ones. An arrow
		   may pass under a pill here, and only here, as the arrows are drawn
		   under the pills; but one that splits under another product reads as
		   made from it, so that is the last thing chosen. How far under its
		   kind each comes. */
		const hangY = new Map<Node, number>();
		// And how far under it the top of each one's list is, where its arrow comes in.
		const listTop = new Map<Node, number>();
		const hang = (r: Node) => {
			const values = [...listsOf(r)].sort(([a], [b]) => a - b).map(([v, ks]) => {
				const tick = tickX(r, v);
				for (const k of ks) k.x = tick;
				const wide = ks[0].w;
				return { ks, tick, x0: tick - wide / 2, x1: tick + wide / 2, tall: ks.reduce((sum, k) => sum + k.h, 0) };
			});
			const meet = (a: (typeof values)[number], b: (typeof values)[number]) => a.x1 + SIDE_GAP > b.x0 && b.x1 + SIDE_GAP > a.x0;
			// Under a pill: the arrow down to b passes behind a, in a row above it.
			const under = (a: (typeof values)[number], b: (typeof values)[number]) => b.tick > a.x0 - 2 && b.tick < a.x1 + 2;
			const most = Math.min(values.length, 5);
			const row: number[] = [];
			let best: number[] = values.map((_, i) => i);
			let bestCost = Infinity;
			/* Built up a value at a time, its cost so far carried along, and
			   given up as soon as that is no better than the best found, which
			   only grows as more are placed; so it is quick, rows tried from the
			   top. */
			const fit = (i: number, hidden: number, deepest: number, sum: number) => {
				const cost = hidden * 1e4 + deepest * 100 + sum;
				if (cost >= bestCost) return;
				if (i === values.length) {
					[bestCost, best] = [cost, [...row]];
					return;
				}
				for (let t = 0; t < most; t++) {
					let meets = false;
					let more = 0;
					for (let j = 0; j < i && !meets; j++) {
						if (row[j] === t) meets = meet(values[j], values[i]);
						else if (row[j] < t ? under(values[j], values[i]) : under(values[i], values[j])) more++;
					}
					if (meets) continue;
					row[i] = t;
					fit(i + 1, hidden + more, Math.max(deepest, t), sum + t);
				}
			};
			fit(0, 0, 0, 0);
			// Each row as tall as its tallest list, and the rows down from the ruler.
			const rows = Math.max(0, ...best) + 1;
			const tallest = Array.from({ length: rows }, (_, t) => Math.max(0, ...values.filter((_, i) => best[i] === t).map((v) => v.tall)));
			const rowTop = tallest.map((_, t) => axisY(r) + DROP + tallest.slice(0, t).reduce((sum, h) => sum + h + TIER_GAP, 0));
			values.forEach(({ ks }, i) => {
				let y = rowTop[best[i]];
				for (const k of ks) {
					listTop.set(k, rowTop[best[i]]);
					hangY.set(k, y + k.h / 2);
					y += k.h;
				}
			});
		};
		/* A panel: ripening across, on a log scale, as a week and a month are
		   as far apart as a month and four; firmness down, a row for each
		   class from the softest to the firmest of its cheeses. Each cheese at
		   the middle of its ripening, a line behind it from the least to the
		   most; those in one row that would meet stacked one under another, so
		   each stays at its own time, as a pill is far wider than it is tall.
		   Hung straight under its family, its pill as wide as the panel: the
		   pill's bottom edge is the panel's ruler of time, as a kind's is of
		   fat, and the column under its photograph holds the rows' names. */
		const FIRM_ORDER = ['fresh', 'soft', 'semi-soft', 'semi-hard', 'hard', 'extra-hard'];
		const PANEL_DECADE = 10 * NODE_H;
		const PANEL_PAD = 18;
		const TIMES: [number, string][] = [
			[1, '1 day'], [7, '1 wk'], [14, '2 wk'], [30, '1 mo'], [60, '2 mo'], [90, '3 mo'], [180, '6 mo'], [365, '1 yr'], [730, '2 yr'], [1095, '3 yr'], [1825, '5 yr'],
		];
		// A map's pin: a country's, or closer in a region's, where its cheeses are and how many.
		/* A map's pin: a region's cheeses, or those of a country whose region is
		   not known, where they are and how many; zoomed out, the pins of a
		   country near each other made one (see pinsAt). */
		type Pin = { iso: string; areas: (string | undefined)[]; name: string; x: number; y: number; r: number; n: number };
		type Panel = {
			kind: 'grid' | 'map';
			pins?: Pin[];
			w: number;
			h: number;
			rows: { firm: string; y: number; h: number }[];
			times: [number, string][];
			xOf: (days: number) => number;
			at: Map<Node, { x: number; y: number }>;
		};
		const panels = new Map<Node, Panel>();
		const ripe = (k: Node) => Math.sqrt(Math.max(1, k.axes!.days[0]) * Math.max(1, k.axes!.days[1]));
		const lay = (p: Node) => {
			const ks = paneled.get(p)!;
			const least = Math.min(...ks.map((k) => Math.max(1, k.axes!.days[0])));
			const most = Math.max(...ks.map((k) => k.axes!.days[1]));
			const from = [...TIMES].reverse().find(([d]) => d <= least) ?? TIMES[0];
			const to = TIMES.find(([d]) => d >= most) ?? TIMES.at(-1)!;
			const times = TIMES.filter(([d]) => d >= from[0] && d <= to[0]);
			// Room at the left for the widest cheese to sit at the very start.
			const lead = picture(p) + PANEL_PAD + Math.max(...ks.map((k) => k.w)) / 2;
			const xOf = (days: number) => lead + (Math.log10(Math.max(1, days)) - Math.log10(from[0])) * PANEL_DECADE;
			/* A cheese whose time is a guess is not stacked on the one point its
			   family's usual time is, but spread evenly with the others like it
			   across that span, from its usual least to its usual most: somewhere
			   in there, as its question mark says. */
			const sure = ks.filter((k) => !k.unsure);
			const logs = (i: 0 | 1) => (sure.length ? sure : ks).map((k) => Math.log10(Math.max(1, k.axes!.days[i]))).sort((a, b) => a - b);
			const mid = (xs: number[]) => xs[Math.floor(xs.length / 2)];
			const [lo, hi] = [mid(logs(0)), mid(logs(1))];
			const guessed = ks.filter((k) => k.unsure);
			const at0 = (k: Node) => {
				if (!k.unsure) return ripe(k);
				const i = guessed.indexOf(k);
				return 10 ** (lo + ((hi - lo) * (i + 0.5)) / guessed.length);
			};
			const firms = ks.map((k) => FIRM_ORDER.indexOf(k.axes!.firm));
			const at = new Map<Node, { x: number; y: number }>();
			const rows: Panel['rows'] = [];
			let y = PANEL_PAD;
			for (let c = Math.min(...firms); c <= Math.max(...firms); c++) {
				const mine = ks.filter((k) => FIRM_ORDER.indexOf(k.axes!.firm) === c).sort((a, b) => at0(a) - at0(b));
				const tall = Math.max(...ks.map((k) => k.h)) + ROW_GAP;
				const lanes: number[] = [];
				for (const k of mine) {
					const x = xOf(at0(k));
					let lane = lanes.findIndex((right) => right + SIDE_GAP <= x - k.w / 2);
					if (lane < 0) lane = lanes.push(-Infinity) - 1;
					lanes[lane] = x + k.w / 2;
					at.set(k, { x, y: y + ROW_GAP / 2 + lane * tall + k.h / 2 });
				}
				const h = Math.max(1, lanes.length) * tall;
				rows.push({ firm: FIRM_ORDER[c], y, h });
				y += h + PANEL_PAD;
			}
			const w = Math.max(xOf(to[0]), ...[...at].map(([k, { x }]) => x + k.w / 2)) + PANEL_PAD;
			p.w = Math.max(p.w, w);
			panels.set(p, { kind: 'grid', w: p.w, h: y, rows, times, xOf, at });
		};
		/* The map: the world on Mercator's projection, as wide as MAP_W, its
		   cheeses small on it (see MAP_PILL), each in its country, as near
		   its middle as there is room: the nearest free place inside the
		   country, or once there is none the nearest free place at all. The countries with most first, so each keeps its own
		   ground. Zoomed into, a country's cheeses read one by one. */
		const MAP_W = 9000;
		/* A pin's head, round, the count in it, its point on the country's
		   middle: bigger the more cheeses it has. Shown zoomed out, until the
		   cheeses themselves can be read. */
		const PIN = 6;
		const PIN_GROWS = 1.2;
		// The screen's pixels to one of the picture's with the map about framed.
		const PIN_FRAMED = 700 / MAP_W;
		/* Pills or pins, never both: decided at the zoom to a doubling the
		   map's tiles are drawn at (see drawTiles), not the zoom itself. */
		const pillsShown = (s: number) => FONT * MAP_PILL * 2 ** Math.round(Math.log2(s)) >= 5;
		// A rim as fine as the pill it is on, for the small ones on the map.
		const rim = (d: Node) => Math.min(1, size(d));
		const insideOf = (rings: number[][], x: number, y: number) => {
			let inside = false;
			for (const r of rings)
				for (let i = 0, j = r.length - 2; i < r.length; j = i, i += 2)
					if (r[i + 1] > y !== r[j + 1] > y && x < ((r[j] - r[i]) * (y - r[i + 1])) / (r[j + 1] - r[i + 1]) + r[i]) inside = !inside;
			return inside;
		};
		const layMap = (p: Node) => {
			const ks = paneled.get(p)!;
			const at = new Map<Node, { x: number; y: number }>();
			const top = PANEL_PAD;
			const h = data.map.height * MAP_W + 2 * PANEL_PAD;
			// What is placed already, in cells, so a place is checked against what is near it only.
			const CELL = 40;
			const cells = new Map<string, Box[]>();
			const cellsOf = (b: Box) => {
				const keys: string[] = [];
				for (let i = Math.floor(b.x0 / CELL); i <= Math.floor(b.x1 / CELL); i++)
					for (let j = Math.floor(b.y0 / CELL); j <= Math.floor(b.y1 / CELL); j++) keys.push(`${i},${j}`);
				return keys;
			};
			const GAP = 0.6;
			const free = (b: Box) =>
				cellsOf(b).every((key) => (cells.get(key) ?? []).every((o) => b.x1 + GAP <= o.x0 || o.x1 + GAP <= b.x0 || b.y1 + GAP <= o.y0 || o.y1 + GAP <= b.y0));
			const take = (b: Box) => cellsOf(b).forEach((key) => cells.set(key, [...(cells.get(key) ?? []), b]));
			const widths = ks.map((k) => k.w).sort((a, b) => a - b);
			const dx = widths[Math.floor(widths.length / 2)] / 2;
			const dy = ks[0]?.h * 1.15;
			// Steps out from a country's middle, nearest first, as far as any country needs.
			const NEAR: [number, number][] = [];
			for (let i = -120; i <= 120; i++) for (let j = -120; j <= 120; j++) NEAR.push([i, j]);
			NEAR.sort(([a, b], [c, d]) => Math.hypot(a * dx, b * dy) - Math.hypot(c * dx, d * dy));
			const byPlace = new Map<string, Node[]>();
			const spotOf = (k: Node, lx: number, ly: number) => (k.spot ? [k.spot[0] * MAP_W, top + k.spot[1] * MAP_W] : [lx, ly]);
			for (const k of ks) byPlace.set(k.place!, [...(byPlace.get(k.place!) ?? []), k]);
			const order = [...byPlace].sort((a, b) => b[1].length - a[1].length);
			for (const [iso, list] of order) {
				const country = data.map.countries[iso];
				if (!country) continue;
				const [lx, ly] = [country.label[0] * MAP_W, top + country.label[1] * MAP_W];
				const rings = country.rings.map((r) => r.map((v, i) => (i % 2 ? top + v * MAP_W : v * MAP_W)));
				// Those whose place is known first, nearest it; the protected first of those; the rest about the country's middle.
				list.sort((a, b) => Number(!!b.spot) - Number(!!a.spot) || Number(!!b.protected) - Number(!!a.protected) || a.label.localeCompare(b.label));
				for (const k of list) {
					const [sx, sy] = spotOf(k, lx, ly);
					// The nearest free place inside the country, else the nearest free place at all.
					const place = (inside: boolean) => {
						for (const [i, j] of NEAR) {
							const x = sx + i * dx;
							const y = sy + j * dy;
							const b = { x0: x - k.w / 2, x1: x + k.w / 2, y0: y - k.h / 2, y1: y + k.h / 2 };
							if ((!inside || insideOf(rings, x, y)) && free(b)) {
								take(b);
								return { x, y };
							}
						}
						return null;
					};
					at.set(k, (rings.length ? place(true) : null) ?? place(false) ?? { x: sx, y: sy });
				}
			}
			p.w = Math.max(p.w, MAP_W);
			/* A pin for each country, zoomed far out; closer in, one for each
			   region, at the middle of its cheeses' places, and one at the
			   country's middle for those of it whose region is not known. */
			const pins: Pin[] = [];
			for (const [iso, list] of order) {
				const country = data.map.countries[iso];
				if (!country) continue;
				const [lx, ly] = [country.label[0] * MAP_W, top + country.label[1] * MAP_W];
				const pin = (area: string | undefined, ks: Node[], x: number, y: number) =>
					pins.push({ iso, areas: [area], name: area ? `${area}, ${country.name}` : country.name, x, y, r: PIN + PIN_GROWS * Math.sqrt(ks.length), n: ks.length });
				const areas = new Map<string | undefined, Node[]>();
				for (const k of list) areas.set(k.area, [...(areas.get(k.area) ?? []), k]);
				for (const [area, ks] of areas) {
					const at = ks.map((k) => spotOf(k, lx, ly));
					const placed = area ? at : [[lx, ly]];
					pin(area, ks, placed.reduce((s, [x]) => s + x, 0) / placed.length, placed.reduce((s, [, y]) => s + y, 0) / placed.length);
				}
			}
			panels.set(p, { kind: 'map', w: p.w, h, rows: [], times: [], xOf: () => 0, at, pins });
		};
		for (const p of paneled.keys()) (p.map ? layMap : lay)(p);
		// Its box, its family at 0, under its family's pill.
		const panelBox = (p: Node): Box => {
			const P = panels.get(p)!;
			return { x0: p.x - p.w / 2, x1: p.x + p.w / 2, y0: p.h / 2, y1: p.h / 2 + P.h };
		};
		// And where it is.
		const panelArea = (p: Node): Box => {
			const b = panelBox(p);
			return { ...b, y0: b.y0 + p.y, y1: b.y1 + p.y };
		};
		root.x = 0;
		const across = (n: Node) => {
			if (hanging.has(n)) hang(n);
			for (const k of paneled.get(n) ?? []) k.x = n.x - n.w / 2 + panels.get(n)!.at.get(k)!.x;
			for (const k of children.get(n) ?? []) {
				k.x = outer(n) + toTrunk(n) + 2 * halfTrunk(n) + fromTrunk(k) + k.w / 2;
				across(k);
			}
		};
		across(root);

		/* Down: each branch packed as close to the one before as their outlines
		   let them, not their bands: a branch is the boxes its pills, its lines
		   and its steps' words take up, and the next one comes down only as far
		   as it must to clear them, wherever they are side by side. So a small
		   product by the trunk tucks in just above a great branch whose far end
		   reaches up past it, as kefir does over soured milk. A parent sits
		   level with the middle of its first and last child. Worked out within
		   each branch, then milk's branches stacked down and centred on it. */
		// `own`: the box is a sibling's own pill or arrow, not something further down its branch.
		type Box = { x0: number; x1: number; y0: number; y1: number; own?: boolean };
		// The middle of the trunk out of a product.
		const trunkAt = (p: Node) => outer(p) + toTrunk(p) + halfTrunk(p);
		// For packing, milk's lines are taken from its middle.
		const trunkX = (p: Node) => (p === root ? 0 : trunkAt(p));
		const pillBox = (n: Node): Box => ({ x0: n.x - n.w / 2, x1: n.x + n.w / 2, y0: -n.h / 2, y1: n.h / 2 });
		/* The line into a product, from the trunk, taken as a band as tall as
		   the product it leads to (or its step's words, if taller), so that
		   nothing tucks in right along an arrow, only past its branch's pills. */
		const inBox = (n: Node): Box => {
			const p = treeParent.get(n)!;
			const t = trunkX(p);
			const edge = n.x - n.w / 2;
			// Over the arrow, which is as thick as it carries.
			const words = n.step ? stepFont(n) * 1.7 + extra(n) + line(n) / 2 : 0;
			return { x0: Math.min(t, edge), x1: Math.max(t, edge), y0: -Math.max(words, n.h / 2), y1: Math.max(n.h / 2, tableBottom(n)) };
		};
		const moved = (b: Box, dy: number): Box => ({ ...b, y0: b.y0 + dy, y1: b.y1 + dy });
		// All that hangs under a ruler, with the arrows down to it, its kind at 0.
		const hangBoxes = (r: Node): Box[] => [
			...hanging.get(r)!.flatMap((k) => {
				const y = hangY.get(k)!;
				const t = tickX(r, k.at!);
				return [
					{ x0: k.x - k.w / 2, x1: k.x + k.w / 2, y0: y - k.h / 2, y1: y + k.h / 2 },
					{ x0: t - 3, x1: t + 3, y0: axisY(r), y1: listTop.get(k)! },
				];
			}),
		];
		/* How far down `next` must go to clear everything in `above`: tucked in
		   as close as their outlines allow for an example, and for anything
		   else only PACKING of the way there from below the whole of `above`,
		   so the products keep a little air between their branches. */
		const clear = (above: Box[], next: Box[], snug: boolean) => {
			let dy = -Infinity;
			for (const b of next)
				for (const a of above)
					// Side by side counts as in the way unless as far apart as rows are.
					if (b.x0 < a.x1 + APART / 2 && a.x0 < b.x1 + APART / 2)
						// Siblings close together; anything else, cousins and trunks, further apart.
						dy = Math.max(dy, a.y1 + (a.own && b.own ? ROW_GAP : APART) - b.y0);
			if (snug) return dy;
			const below = Math.max(...above.map((a) => a.y1)) + ROW_GAP - Math.min(...next.map((b) => b.y0));
			return dy + (1 - PACKING) * (below - dy);
		};
		// Each node's place below its parent, and the boxes of the whole branch,
		// with the branch's own root at 0.
		const rel = new Map<Node, number>();
		const shape = (n: Node): Box[] => {
			const own = [pillBox(n), ...(n === root || !treeParent.has(n) ? [] : [inBox(n)])].map((b) => ({
				...b,
				own: true,
			}));
			const kids = children.get(n) ?? [];
			if (hanging.has(n)) return [...own, ...hangBoxes(n).map((b) => ({ ...b, own: false }))];
			// A panel under its family, as much the family's own as its pill.
			if (paneled.has(n)) own.push({ ...panelBox(n), own: true });
			if (!kids.length) return own;
			let packed: Box[] = [];
			const at = new Map<Node, number>();
			// Never above the sibling before it, so the order reads down.
			let last = 0;
			for (const k of kids) {
				const branch = shape(k);
				const dy = packed.length ? Math.max(clear(packed, branch, !!k.example), last) : 0;
				last = dy;
				at.set(k, dy);
				packed = packed.concat(branch.map((b) => moved(b, dy)));
			}
			const mid = (at.get(kids[0])! + at.get(kids.at(-1)!)!) / 2;
			for (const k of kids) rel.set(k, at.get(k)! - mid);
			const t = trunkX(n);
			// As wide as the line out is: its strands turn down anywhere across it.
			const trunk: Box = { x0: t - halfTrunk(n) - 1, x1: t + halfTrunk(n) + 1, y0: at.get(kids[0])! - mid, y1: at.get(kids.at(-1)!)! - mid };
			// Its own pill and arrow stay its own, for packing it against its
			// siblings; all that hangs from it is no sibling of theirs.
			return [...own, { ...trunk, own: false }, ...packed.map((b) => ({ ...moved(b, -mid), own: false }))];
		};
		const place = (n: Node, y: number) => {
			n.y = y;
			for (const k of children.get(n) ?? []) place(k, y + rel.get(k)!);
			for (const k of hanging.get(n) ?? []) k.y = y + hangY.get(k)!;
			const P = panels.get(n);
			for (const k of paneled.get(n) ?? []) k.y = y + n.h / 2 + P!.at.get(k)!.y;
		};
		/* Milk's branches, cheese at the top and cream at the bottom, the
		   rest between from the biggest down, centred on milk. */
		// Whatever leads to them, as the split that makes raw cream does.
		const leads = (n: Node, id: string): boolean => n.id === id || (!!n.hub && (children.get(n) ?? []).some((k) => leads(k, id)));
		const pinned = (n: Node) => (leads(n, 'rennetCurd') ? -1 : leads(n, 'rawCream') ? 1 : 0);
		const tops = [...(children.get(root) ?? [])].sort((a, b) => pinned(a) - pinned(b) || made.get(b)! - made.get(a)!);
		let packed: Box[] = [];
		const at = new Map<Node, number>();
		let last = 0;
		for (const k of tops) {
			const branch = shape(k);
			const dy = packed.length ? Math.max(clear(packed, branch, false), last) : 0;
			last = dy;
			at.set(k, dy);
			packed = packed.concat(branch.map((b) => moved(b, dy)));
		}
		const mid = tops.length ? (at.get(tops[0])! + at.get(tops.at(-1)!)!) / 2 : 0;
		for (const k of tops) place(k, at.get(k)! - mid);

		/* A jog too short for a strand to turn down and back with two corners
		   and a clear stretch between, rather than a kink; and one so short
		   it is less than the strand is thick, which is no jog at all. */
		const cramped = (k: Node, by: number) => Math.abs(by) < line(k) + 4 * CORNER;
		const level = (k: Node, by: number) => Math.abs(by) < line(k);
		/* Where each child's strand is in the line out of its parent: the line
		   as thick as all of theirs together, on the parent's middle, and
		   theirs side by side in it in the order they go down. */
		const slots = (p: Node) => {
			let edge = p.y - halfTrunk(p);
			return new Map(
				[...(children.get(p) ?? [])]
					.sort((a, b) => a.y - b.y)
					.map((k) => {
						edge += line(k);
						return [k, edge - line(k) / 2] as const;
					}),
			);
		};
		/* What a product takes up where it is: its pill, the line into it with
		   its step's words over it, and the line out of it to its trunk and
		   down the trunk; or the line down into it from a ruler. */
		const family = (n: Node): Node[] => [n, ...[...(children.get(n) ?? []), ...(hanging.get(n) ?? []), ...(paneled.get(n) ?? [])].flatMap(family)];
		const room = (n: Node, own = true): Box[] => {
			const boxes: Box[] = [moved(pillBox(n), n.y)];
			// In a panel, only its pill; the panel is its family's.
			if (panelOf(n)) return boxes;
			if (paneled.has(n)) boxes.push(moved(panelBox(n), n.y));
			const p = treeParent.get(n);
			// Under a ruler: the arrow straight down into it.
			const r = hangsFrom(n);
			if (r) {
				const t = tickX(r, n.at!);
				boxes.push({ x0: t - 3, x1: t + 3, y0: r.y + axisY(r), y1: r.y + listTop.get(n)! });
			} else if (p) {
				const words = n.step ? stepFont(n) * 1.3 + extra(n) : 0;
				const reach = Math.max(n.h / 2, line(n) / 2);
				boxes.push({ x0: trunkAt(p) - halfTrunk(p), x1: n.x - n.w / 2, y0: n.y - reach - words, y1: n.y + Math.max(reach, tableBottom(n)) });
			}
			const kids = children.get(n) ?? [];
			if (kids.length && own) {
				const ys = kids.map((k) => k.y);
				const t = trunkAt(n);
				boxes.push({ x0: outer(n), x1: t + halfTrunk(n), y0: n.y - halfTrunk(n), y1: n.y + halfTrunk(n) });
				boxes.push({ x0: t - halfTrunk(n), x1: t + halfTrunk(n), y0: Math.min(...ys), y1: Math.max(...ys) });
			}
			return boxes;
		};
		const clash = (a: Box, b: Box) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 + ROW_GAP && b.y0 < a.y1 + ROW_GAP;
		/* Products moved up or down by `by`, if that brings them near nothing
		   they were not near already and keeps them between the siblings
		   either side; or left where they are. A child is moved with all
		   made from it. */
		const move = (mine: Node[], by: number) => {
			const p = treeParent.get(mine[0]);
			// Not the lines into what they make, which they are meant to meet.
			const rest = nodes
				.filter((n) => !mine.includes(n))
				.flatMap((n) => room(n, n !== p).filter((_, i) => !(i === 1 && mine.includes(treeParent.get(n)!))));
			const order = () => [...(children.get(p!) ?? [])].sort((a, b) => a.y - b.y).join();
			const was = order();
			const before = mine.flatMap((n) => room(n));
			for (const n of mine) n.y += by;
			const after = mine.flatMap((n) => room(n));
			// And never a pill onto another, however near they were before.
			const pills = mine.map((n) => moved(pillBox(n), n.y));
			const others = nodes.filter((n) => !mine.includes(n)).map((n) => moved(pillBox(n), n.y));
			const onto = pills.some((a) => others.some((b) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1));
			if (order() === was && !onto && !after.some((a, i) => rest.some((b) => clash(a, b) && !clash(before[i], b)))) return true;
			for (const n of mine) n.y -= by;
			return false;
		};
		const shift = (k: Node, by: number) => move(family(k), by);
		/* A child its strand runs into nearly level would be met by a jog too
		   short to draw well: its parent moved up or down instead, so the
		   strand meets it square on; of several, the thickest. Only a parent
		   that is not itself met that way, so as not to undo it. Any others
		   met short are moved level with their strands themselves, with all
		   made from them, where there is room; a branch point, with no pill,
		   at least by itself. Down from milk. */
		root.y = 0;
		const squared = new Set<Node>();
		const square = (p: Node) => {
			if (!squared.has(p)) {
				const near = [...slots(p)]
					.map(([k, at]) => ({ k, by: k.y - at }))
					.filter(({ k, by }) => cramped(k, by))
					.sort((a, b) => line(b.k) - line(a.k) || Math.abs(a.by) - Math.abs(b.by))[0];
				// Itself alone, where that brings it near nothing either.
				if (near && move([p], near.by)) squared.add(near.k);
			}
			for (const [k, at] of slots(p)) {
				if (squared.has(k) || !cramped(k, k.y - at)) continue;
				if (shift(k, at - k.y)) squared.add(k);
				else if (k.hub && level(k, k.y - at)) {
					k.y = at;
					squared.add(k);
				}
			}
			for (const k of children.get(p) ?? []) square(k);
		};
		square(root);
		/* Milk's word as big as fits across it; and the chrome's grain over
		   it, as the page round it has: its dots blended over it, and its noise
		   over that as many times as the post asks. */
		const rootWord = root.label.toUpperCase();
		const rootFont = (FONT * size(root) * ROOT_WORD * 2 * rootR) / measure(rootWord, FONT * size(root), '700');
		const grains = ['dots', ...Array.from({ length: Number(document.documentElement.dataset.grain ?? 1) }, () => 'noise')];

		/* The tree's edges, with an arrowhead into every product; the arrow
		   into a branch point has none, its head is on the arrows it splits into. */
		const edges: Edge[] = [...treeParent].filter(([n]) => !panelOf(n)).map(([n, p]) => ({
			source: p,
			target: n,
			made: !n.hub && (!n.example || !!n.step),
		}));

		/* Every line runs straight across or straight up and down, never
		   slantwise: out of the parent's side that faces the child, halfway
		   across the gap to its children, round a corner, up or down to the
		   child's row, and round again into it. The trunk is the same for
		   every child, so a family reads as one bracket off what it is made
		   from. */
		/* Where each child's strand runs in the line out of its parent: the
		   line out is as thick as all its children's together, and holds them
		   side by side in the order they go down, each at its own height in
		   it. They turn off it one by one into the gap before the children:
		   those that go up, the topmost first, and those that go down, the
		   lowest first, so a strand turns only once all on its far side have,
		   and none crosses another. Each bends round the one that turned
		   before it, on the same middle, so the two meet all the way round
		   the corner; the first round as tight a bend as any line has. */
		const strands = new Map<Node, { at: number; turn: number; bends: number[] }>();
		const split = (p: Node) => {
			const at = slots(p);
			const kids = [...at.keys()];
			// The gap's near edge, where the first strand turns.
			const start = trunkAt(p) - halfTrunk(p);
			const up = kids.filter((k) => k.y < at.get(k)!);
			const down = kids.filter((k) => k.y >= at.get(k)!).reverse();
			for (const group of [up, down]) {
				let past = 0;
				// The bend of the one before, as it was drawn, and how thick it is.
				let inner = CORNER;
				let before = 0;
				for (const k of group) {
					strands.set(k, { at: at.get(k)!, turn: start + past + line(k) / 2, bends: [] });
					past += line(k);
					const q = elbowPoints(p, k);
					if (q.length < 4) continue;
					const w = line(k) / 2;
					const out = q[1][0] - q[0][0];
					const jog = Math.abs(q[2][1] - q[1][1]);
					const into = q[3][0] - q[2][0];
					// Round the one before, on its middle; then into the product.
					let first = inner + (before + line(k)) / 2;
					let last = CORNER + w;
					/* Too short a jog for both: still round the one before, and into the
					   product the tighter; and only with no room even for that, two
					   tight corners, an S. */
					if (first + last > jog) last = Math.max(w, jog - first);
					if (first + last > jog) first = last = Math.min(CORNER + w, jog / 2);
					// No further round than the stretches either side reach, leaving the head its own.
					first = Math.min(first, out);
					last = Math.min(last, Math.max(into - (k.hub ? 0 : arrow(k)), into / 2), jog - first);
					strands.get(k)!.bends = [0, first, last];
					inner = first;
					before = line(k);
				}
			}
		};
		const elbowPoints = (s: Node, t: Node): [number, number][] => {
			// Out of the parent's edge; out of milk, from where its round edge is as high as the line.
			const x1 = s === root ? s.x + Math.sqrt(Math.max(0, rootR ** 2 - halfTrunk(s) ** 2)) - 1 : s.x + (s.w - 2) / 2;
			/* Into a product, to its edge; into a branch point, just past it,
			   where the strands out of it begin. */
			const x2 = t.hub ? t.x + 1 : t.x - t.w / 2;
			const { at, turn } = strands.get(t)!;
			// Its strand level with it already: straight on in its place in the line.
			if (level(t, t.y - at))
				return [
					[x1, at],
					[x2, at],
				];
			return [
				[x1, at],
				[turn, at],
				[turn, t.y],
				[x2, t.y],
			];
		};
		// Off a ruler, straight down from the product's value into its top.
		const pointsOf = (s: Node, t: Node): [number, number][] => {
			if (!hanging.has(s)) return elbowPoints(s, t);
			// Into the top of its list, which one at a value alone is.
			const x = tickX(s, t.at!);
			return [
				[x, s.y + axisY(s)],
				[x, s.y + listTop.get(t)!],
			];
		};
		const elbow = (s: Node, t: Node) => rounded(pointsOf(s, t), strands.get(t)?.bends);
		/* An arrow drawn as one shape, filled: both edges of a line as wide as
		   the product it leads to is big, round its corners, and, for a product
		   made, in to a point at the product's edge. Not a stroked line with a
		   head put on its end, which shows a hairline seam between the two. */
		type Pt = [number, number];
		const arrowShape = (s: Node, t: Node, made: boolean) => {
			const p = pointsOf(s, t);
			const w = line(t) / 2;
			const n = p.length - 1;
			const dir = (i: number): Pt => {
				const [ax, ay] = p[i];
				const [bx, by] = p[i + 1];
				const len = Math.hypot(bx - ax, by - ay) || 1;
				return [(bx - ax) / len, (by - ay) / len];
			};
			const len = (i: number) => Math.hypot(p[i + 1][0] - p[i][0], p[i + 1][1] - p[i][1]);
			// Round its corners as its strand was given room for (see split).
			const bends = strands.get(t)?.bends ?? [];
			const radius = (i: number) => Math.min(bends[i] ?? CORNER, len(i - 1), len(i));
			/* One edge, `way` 1 the left and -1 the right: each point, and the
			   control point of the curve into it if it is one. */
			const edgeOf = (way: number) => {
				const at = (q: Pt, d: Pt, by: number): Pt => [q[0] - d[1] * by, q[1] + d[0] * by];
				const out: { p: Pt; c?: Pt }[] = [{ p: at(p[0], dir(0), way * w) }];
				for (let i = 1; i < n; i++) {
					const din = dir(i - 1);
					const dout = dir(i);
					const r = radius(i);
					// The corner of the edge, and how far from it each way its curve begins.
					const corner = at(at(p[i], din, way * w), dout, way * w);
					const offIn = [-dout[1] * way * w, dout[0] * way * w];
					const offOut = [-din[1] * way * w, din[0] * way * w];
					const before = r + offIn[0] * din[0] + offIn[1] * din[1];
					const after = r - (offOut[0] * dout[0] + offOut[1] * dout[1]);
					if (before <= 0 || after <= 0) out.push({ p: corner });
					else {
						out.push({ p: [corner[0] - din[0] * before, corner[1] - din[1] * before] });
						out.push({ p: [corner[0] + dout[0] * after, corner[1] + dout[1] * after], c: corner });
					}
				}
				const d = dir(n - 1);
				if (made) {
					// The head: from as far back as it is long, out to its width, in to the point.
					const back = Math.max(0, Math.min(headLength(2 * w), len(n - 1) - (n > 1 ? radius(n - 1) : 0)));
					const base: Pt = [p[n][0] - d[0] * back, p[n][1] - d[1] * back];
					out.push({ p: at(base, d, way * w) });
					out.push({ p: at(base, d, (way * headWidth(2 * w)) / 2) });
				} else out.push({ p: at(p[n], d, way * w) });
				return out;
			};
			const left = edgeOf(1);
			const right = edgeOf(-1);
			const to = ({ p: [x, y], c }: { p: Pt; c?: Pt }) => (c ? `Q${c[0]},${c[1]} ${x},${y}` : `L${x},${y}`);
			let d = `M${left[0].p[0]},${left[0].p[1]}` + left.slice(1).map(to).join('');
			if (made) d += `L${p[n][0]},${p[n][1]}`;
			// Back along the other edge, each curve now from its other end.
			for (let i = right.length - 1; i >= 0; i--) d += i === right.length - 1 ? `L${right[i].p[0]},${right[i].p[1]}` : to({ p: right[i].p, c: right[i + 1].c });
			return d + 'Z';
		};
		/* A run of straight segments with its corners rounded off, each by
		   as much as both segments meeting there have room for. */
		const rounded = (p: [number, number][], bends: number[] = []) => {
			let d = `M${p[0][0]},${p[0][1]}`;
			for (let i = 1; i < p.length - 1; i++) {
				const [px, py] = p[i - 1];
				const [cx, cy] = p[i];
				const [nx, ny] = p[i + 1];
				const inLen = Math.hypot(cx - px, cy - py);
				const outLen = Math.hypot(nx - cx, ny - cy);
				const r = Math.min(bends[i] ?? CORNER, inLen, outLen);
				if (r < 0.5) {
					d += `L${cx},${cy}`;
					continue;
				}
				const ax = cx - ((cx - px) / inLen) * r;
				const ay = cy - ((cy - py) / inLen) * r;
				const bx = cx + ((nx - cx) / outLen) * r;
				const by = cy + ((ny - cy) / outLen) * r;
				d += `L${ax},${ay}Q${cx},${cy} ${bx},${by}`;
			}
			const [lx, ly] = p[p.length - 1];
			return d + `L${lx},${ly}`;
		};
		/* Each step in the middle of its arrow's last stretch: just above it,
		   or, on an arrow fat enough to hold its words, inside it. */
		const leg = (n: Node) => {
			const strand = strands.get(n);
			return strand && level(n, n.y - strand.at) ? strand.at : n.y;
		};
		// Not with a table to go under it.
		const inside = (n: Node) => !rows(n).length && line(n) >= stepFont(n) * 1.3 + extra(n);
		const stepY = (n: Node) =>
			inside(n) ? leg(n) + stepFont(n) * 0.35 : leg(n) - line(n) / 2 - stepFont(n) * 0.45;
		const stepX = (n: Node) => {
			const p = treeParent.get(n)!;
			// From the trunk's far side.
			const trunk = trunkAt(p) + halfTrunk(p);
			const edge = n.x - n.w / 2;
			return (trunk + edge - arrow(n)) / 2;
		};
		/* Every arrow with something to tell, how its step is done, to be
		   pointed at and clicked; the rest are only drawn. */
		const told = (n: Node) => !!(n.how?.facts?.length || n.how?.text);
		const hittable = edges.filter((e) => told(e.target));

		// The step looked at, its words and table in the ink; and the one clicked, held so.
		let stepShown: Node | null = null;
		let heldStep: Node | null = null;
		const showStep = (n: Node | null) => {
			stepShown = n;
			parts = null;
			repaint();
		};

		/* Where every arrow goes, worked out once: down from milk, so a line in
		   is placed before the lines out of it. Each arrow kept as a shape to
		   fill, and the line along it to point at. */
		strands.clear();
		const down = (p: Node) => {
			split(p);
			for (const k of children.get(p) ?? []) down(k);
		};
		down(root);
		const edgeShape = new Map(edges.map((e) => [e, new Path2D(arrowShape(e.source, e.target, e.made))]));
		const edgeLine = new Map(edges.map((e) => [e, new Path2D(elbow(e.source, e.target))]));
		const boxOf = (p: [number, number][], pad: number): Box => ({
			x0: Math.min(...p.map(([x]) => x)) - pad,
			x1: Math.max(...p.map(([x]) => x)) + pad,
			y0: Math.min(...p.map(([, y]) => y)) - pad,
			y1: Math.max(...p.map(([, y]) => y)) + pad,
		});
		const edgeBox = new Map(edges.map((e) => [e, boxOf(pointsOf(e.source, e.target), line(e.target) + headWidth(line(e.target)))]));
		// A step's words: where each line of them sits, and the box round them.
		const stepLines = (n: Node) => {
			const font = stepFont(n);
			const first = -(lines(n).length - 1) * LEADING * (inside(n) ? 0.5 : 1);
			return lines(n).map((said, i) => ({ said, y: stepY(n) + font * (first + i * LEADING) }));
		};
		const stepBox = (n: Node): Box => {
			const at = stepLines(n);
			const w = stepWidth.get(n)! / 2;
			return { x0: stepX(n) - w, x1: stepX(n) + w, y0: at[0].y - stepFont(n), y1: at.at(-1)!.y + stepFont(n) * 0.3 };
		};
		// A step's table: where it is, its rows, and the area round it and the step's name, to point at.
		const tableOf = (n: Node) => {
			const { key } = columns.get(n)!;
			const font = tableFont(n);
			const left = stepX(n) - tableWidth(n) / 2;
			const top = leg(n) + tableTop(n);
			const wide = Math.max(stepWidth.get(n) ?? 0, tableWidth(n)) + 2 * font;
			// Up to the top of its step's words, if it has any.
			const named = n.step ? stepY(n) - stepFont(n) * (0.9 + (lines(n).length - 1) * LEADING) : top;
			return {
				font,
				left,
				top,
				split: left + key + 2 * pad(n),
				height: tableHeight(n) - font * 0.6,
				area: { x0: stepX(n) - wide / 2, x1: stepX(n) + wide / 2, y0: named, y1: top + tableHeight(n) } as Box,
			};
		};
		// A pill and its shadow, which reaches a quarter of its height round it.
		const pillBoxOf = (d: Node): Box => {
			const s = d.h * 0.25;
			return { x0: d.x - d.w / 2 - s, x1: d.x + d.w / 2 + s, y0: d.y - d.h / 2 - s, y1: d.y + d.h / 2 + s };
		};

		/* Framed whole: the great branch points read from there, and the rest
		   is a zoom away. All it covers, with a margin round it as wide on the
		   screen as the frame's gutter is, however big the pane. */
		const all: Box[] = [
			...shown.map(pillBoxOf),
			...edgeBox.values(),
			...stepped.map(stepBox),
			...tabled.map((n) => tableOf(n).area),
			...[...panels.keys()].map(panelArea),
		];
		const bounds = {
			x: Math.min(...all.map((b) => b.x0)),
			y: Math.min(...all.map((b) => b.y0)),
			width: Math.max(...all.map((b) => b.x1)) - Math.min(...all.map((b) => b.x0)),
			height: Math.max(...all.map((b) => b.y1)) - Math.min(...all.map((b) => b.y0)),
		};
		const canvas = figure.querySelector<HTMLCanvasElement>('canvas.milk-canvas')!;
		const surface = select(canvas);
		const ctx = canvas.getContext('2d')!;
		let paneW = canvas.clientWidth || 1;
		let paneH = canvas.clientHeight || 1;
		const m = MARGIN / (Math.min((paneW - 2 * MARGIN) / bounds.width, (paneH - 2 * MARGIN) / bounds.height) || 1);
		const box = { x: bounds.x - m, y: bounds.y - m, width: bounds.width + 2 * m, height: bounds.height + 2 * m };
		/* From the picture's own units to the pane's pixels, unzoomed: the
		   whole fitted in and centred, as a viewBox would. The zoom is in the
		   pane's pixels on top of that. */
		let fit = 1;
		let offX = 0;
		let offY = 0;
		let dpr = 1;
		let shownAt = zoomIdentity;
		const fitTo = () => {
			fit = Math.min(paneW / box.width, paneH / box.height) || 1;
			offX = (paneW - box.width * fit) / 2 - fit * box.x;
			offY = (paneH - box.height * fit) / 2 - fit * box.y;
		};
		fitTo();
		const toPane = (x: number, y: number) => [fit * x + offX, fit * y + offY] as const;
		const fromScreen = (sx: number, sy: number) => ({
			x: ((sx - shownAt.x) / shownAt.k - offX) / fit,
			y: ((sy - shownAt.y) / shownAt.k - offY) / fit,
		});

		/* The graph's colours, as the page has them, worked out to what a
		   canvas can take: a colour asked of a hidden element of its own. */
		const probe = document.createElement('span');
		probe.hidden = true;
		figure.append(probe);
		const colourOf = (css: string) => {
			probe.style.color = css;
			return getComputedStyle(probe).color;
		};
		let ink: Record<string, string> = {};
		const readInk = () => {
			ink = {
				pill: colourOf('var(--pill)'),
				rim: colourOf('var(--pill-rim)'),
				line: colourOf('var(--line)'),
				lit: colourOf('var(--lit)'),
				litLine: colourOf('color-mix(in oklab, var(--lit) 90%, var(--deck-ground))'),
				text: colourOf('var(--deck-ink)'),
				dim: colourOf('var(--deck-ink-dim)'),
				ground: colourOf('var(--deck-ground)'),
				accent: colourOf('var(--ink-accent)'),
				names: colourOf('color-mix(in oklab, var(--deck-ink) 6%, var(--pill))'),
				milk: colourOf('color-mix(in oklab, var(--pill), white 70%)'),
				// An info mark's blue, half way to the ground.
				info: colourOf('color-mix(in oklab, #2f6fdb 50%, var(--deck-ground))'),
				// A guess's amber, as far towards the ground.
				unsure: colourOf('color-mix(in oklab, #d98a10 55%, var(--deck-ground))'),
				// The map's land, a shade off the ground.
				land: colourOf('color-mix(in oklab, var(--deck-ink) 7%, var(--deck-ground))'),
				// A panel's ground, a shade off the graph's, and its lines of time fainter than the arrows.
				panel: colourOf('color-mix(in oklab, var(--deck-ink) 4%, var(--deck-ground))'),
				grid: colourOf('color-mix(in oklab, var(--line) 35%, var(--deck-ground))'),
			};
		};
		readInk();

		/* The photographs and flags, fetched once each is first in sight, and
		   the picture drawn again as each comes in. */
		const images = new Map<string, HTMLImageElement>();
		const imageOf = (src: string) => {
			let im = images.get(src);
			if (!im) {
				im = new Image();
				im.decoding = 'async';
				im.addEventListener('load', repaint, { once: true });
				im.src = src;
				images.set(src, im);
			}
			return im.complete && im.naturalWidth ? im : null;
		};
		// The grain's tiles, as patterns to fill milk with.
		const GRAIN_TILE: Record<string, [string, number]> = { dots: ['/assets/chrome-dots.png', 26], noise: ['/assets/chrome-noise.png', 128] };
		const patterns = new Map<string, CanvasPattern>();
		const patternOf = (grain: string) => {
			if (patterns.has(grain)) return patterns.get(grain)!;
			const im = imageOf(GRAIN_TILE[grain][0]);
			const p = im && ctx.createPattern(im, 'repeat');
			if (p) patterns.set(grain, p);
			return p;
		};

		const font = (px: number, face = '400') => `${face} ${px}px ${SANS()}`;
		// Drawing for the overview (see below): plain, with nothing lit or held.
		let unlit = false;
		/* How each part is drawn, onto the picture's canvas or one of its own,
		   in the picture's units at a scale of so many of the screen's pixels
		   to a unit: words too small to read there left out. Each says whether
		   it was drawn whole, as a photograph not yet fetched leaves it not. */
		type Pen = CanvasRenderingContext2D | OffscreenCanvasRenderingContext2D;
		const roundRect = (g: Pen, x: number, y: number, w: number, h: number, r: number | number[]) => {
			g.beginPath();
			g.roundRect(x, y, w, h, r);
		};
		const legible = (px: number, s: number) => px * s >= 2.5;

		// The steps' words, on their arrows; white inside one, the ink when looked at.
		const drawStep = (g: Pen, n: Node, s: number) => {
			if (!legible(stepFont(n), s)) return true;
			g.font = font(stepFont(n), 'italic 400');
			g.textAlign = 'center';
			g.textBaseline = 'alphabetic';
			g.fillStyle = !unlit && n === stepShown ? (rows(n).length ? ink.lit : ink.accent) : inside(n) ? '#fff' : ink.dim;
			for (const { said, y } of stepLines(n)) g.fillText(said, stepX(n), y);
			return true;
		};

		// A step's table: on the pills' white, the names' column a shade darker, ruled, framed.
		const drawTable = (g: Pen, n: Node, s: number) => {
			const t = tableOf(n);
			if (!legible(t.font, s)) return true;
			const w = tableWidth(n);
			const r = t.font * (4 / 16) * 1.5;
			const on = !unlit && n === stepShown;
			roundRect(g, t.left, t.top, w, t.height, r);
			g.fillStyle = ink.pill;
			g.fill();
			roundRect(g, t.left, t.top, t.split - t.left, t.height, [r, 0, 0, r]);
			g.fillStyle = ink.names;
			g.fill();
			g.lineWidth = t.font * 0.08;
			g.strokeStyle = on ? ink.lit : ink.dim;
			g.globalAlpha = on ? 1 : 0.5;
			g.beginPath();
			g.moveTo(t.split, t.top);
			g.lineTo(t.split, t.top + t.height);
			let y = t.top;
			rows(n).forEach((row, i) => {
				if (i) {
					g.moveTo(t.left, y);
					g.lineTo(t.left + w, y);
				}
				y += rowHeight(n, row);
			});
			g.stroke();
			roundRect(g, t.left, t.top, w, t.height, r);
			g.stroke();
			g.globalAlpha = 1;
			const p = pad(n);
			g.fillStyle = on ? ink.lit : ink.dim;
			g.textBaseline = 'alphabetic';
			y = t.top;
			for (const { k, v } of rows(n)) {
				const baseline = y + p / 2 + t.font * 0.95;
				g.font = font(t.font, '600');
				g.textAlign = 'right';
				keyLines(k).forEach((said, j) => g.fillText(said, t.split - p, baseline + j * ROW * t.font));
				g.font = font(t.font);
				g.textAlign = 'left';
				rowLines(v).forEach((said, j) => g.fillText(said, t.split + p, baseline + j * ROW * t.font));
				y += rowHeight(n, { k, v });
			}
			return true;
		};

		// Milk: whiter than the pills, edged as they are, in the chrome's grain, its word across it.
		const drawMilk = (g: Pen, d: Node, s: number) => {
			g.beginPath();
			g.arc(d.x, d.y, rootR, 0, Math.PI * 2);
			g.fillStyle = ink.milk;
			g.fill();
			g.save();
			g.clip();
			for (const grain of grains) {
				const p = patternOf(grain);
				if (!p) continue;
				// Its tiles their own size on the screen, at this zoom.
				p.setTransform(new DOMMatrix().scale(1 / s));
				g.globalCompositeOperation = grain === 'dots' ? 'overlay' : 'soft-light';
				g.fillStyle = p;
				g.fillRect(d.x - rootR, d.y - rootR, 2 * rootR, 2 * rootR);
			}
			g.restore();
			g.beginPath();
			g.arc(d.x, d.y, rootR, 0, Math.PI * 2);
			g.lineWidth = 2;
			g.strokeStyle = ink.rim;
			g.stroke();
			g.font = font(rootFont, '700');
			g.fillStyle = '#000';
			g.textAlign = 'center';
			g.textBaseline = 'middle';
			g.fillText(rootWord, d.x, d.y);
		};

		// A pill: its shadow, its white, its photograph, its words, its edge, and a kind's ruler.
		const drawPill = (g: Pen, d: Node, s: number) => {
			// A map's cheese only once it can be read; a pin for its country till then (see drawPins).
			if (d.onMap && !pillsShown(s)) return true;
			let whole = true;
			const x = d.x - d.w / 2;
			const y = d.y - d.h / 2;
			const r = radius(d);
			/* Lifted off the ground by a soft shadow, as deep as the pill is big:
			   blurred, as it is drawn only once, into the part kept (see stamp).
			   A canvas blurs in the screen's pixels whatever it is scaled by, so
			   the shadow is sized for the zoom it is drawn at. */
			const px = s * dpr;
			roundRect(g, x, y, d.w, d.h, d.panel || d.map ? [r, r, 0, 0] : r);
			g.fillStyle = ink.pill;
			// Too small to see a shadow under, and a thousand of them on a map: none.
			g.shadowColor = d.h * px < 16 ? 'transparent' : 'rgb(0 0 0 / 0.12)';
			g.shadowBlur = d.h * 0.1 * px;
			g.shadowOffsetY = d.h * 0.04 * px;
			g.fill();
			g.shadowColor = 'transparent';
			// The photograph filling its left end, edge to edge, its outer corners rounded as the pill's are.
			let room = 0;
			if (d.image) {
				room = picture(d) + PICTURE_GAP * size(d);
				const side = picture(d);
				// Fetched once it is a few pixels across on the screen.
				const im = side * s >= 6 ? imageOf(d.image.src) : null;
				if (im) {
					const crop = Math.min(im.naturalWidth, im.naturalHeight);
					g.save();
					roundRect(g, x, y, side, side, [r, 0, 0, r]);
					g.clip();
					g.drawImage(im, (im.naturalWidth - crop) / 2, (im.naturalHeight - crop) / 2, crop, crop, x, y, side, side);
					g.restore();
				} else if (side * s >= 6) whole = false;
			}
			g.textAlign = 'center';
			g.textBaseline = 'middle';
			if (legible(FONT * size(d), s)) {
				g.font = `400 ${FONT * size(d)}px ${MONO()}`;
				g.fillStyle = d.example ? ink.dim : ink.text;
				const said = d.label.split('\n');
				const mark = d.link ? LINK_ROOM * size(d) : 0;
				said.forEach((l, i) => g.fillText(l, d.x + (room - mark) / 2, d.y + (i - (said.length - 1) / 2) * LINE * size(d)));
				g.globalAlpha = 1;
				// Two links of a chain, slanted, before its right end.
				if (d.link) {
					const u = LINK_MARK * size(d);
					g.save();
					g.translate(x + d.w - PAD_X * size(d) - u / 2, d.y);
					g.rotate(-Math.PI / 4);
					g.lineWidth = 0.15 * u;
					g.strokeStyle = ink.dim;
					for (const at of [-0.62 * u, -0.08 * u]) {
						roundRect(g, at, -0.22 * u, 0.7 * u, 0.44 * u, 0.22 * u);
						g.stroke();
					}
					g.restore();
				}
			}
			roundRect(g, x, y, d.w, d.h, d.panel || d.map ? [r, r, 0, 0] : r);
			g.lineWidth = (!unlit && d === held ? 2 : 1.2) * rim(d);
			g.strokeStyle = !unlit && d === held ? ink.lit : ink.rim;
			g.stroke();
			// A panel's ruler of time: its bottom edge grooved at each time, the time over it.
			if (d.panel && panels.has(d) && legible(10, s)) {
				const P = panels.get(d)!;
				const edge = d.y + d.h / 2;
				g.textBaseline = 'alphabetic';
				g.textAlign = 'center';
				for (const [days, said] of P.times) {
					const x = d.x - d.w / 2 + P.xOf(days);
					g.beginPath();
					g.moveTo(x, edge - 8);
					g.lineTo(x, edge);
					g.lineWidth = 1.5;
					g.strokeStyle = ink.text;
					g.stroke();
					g.font = font(10);
					g.fillStyle = ink.dim;
					g.fillText(said, x, edge - 12);
				}
			}
			// A kind's ruler: its bottom edge grooved every unit, deeper every step, the value over each.
			if (d.scale && legible(10, s)) {
				const { to, every, unit, name: measures } = d.scale;
				const edge = d.y + d.h / 2;
				const tick = (v: number) => d.x + (v - to / 2) * RULE_PX;
				g.lineCap = 'round';
				g.textBaseline = 'alphabetic';
				for (let v = 0; v <= to; v++) {
					const major = v % every === 0;
					g.beginPath();
					g.moveTo(tick(v), edge - (major ? 8 : 4));
					g.lineTo(tick(v), edge);
					g.lineWidth = major ? 1.5 : 1;
					g.strokeStyle = major ? ink.text : ink.dim;
					g.stroke();
					if (!major) continue;
					g.font = font(10);
					g.fillStyle = ink.dim;
					if (v) {
						g.textAlign = 'center';
						g.fillText(`${v} ${unit}`, tick(v), edge - 12);
						continue;
					}
					// What it measures, before its nought, ending over the groove.
					g.textAlign = 'right';
					g.fillText(' 0', tick(0) + 3, edge - 12);
					const zero = g.measureText(' 0').width;
					g.font = font(11, '600');
					const spaced = g.letterSpacing;
					g.letterSpacing = '0.14em';
					g.fillStyle = ink.text;
					g.fillText(measures.toUpperCase(), tick(0) + 3 - zero, edge - 12);
					g.letterSpacing = spaced;
				}
				g.lineCap = 'butt';
			}
			return whole;
		};

		/* A panel, on the ground itself: each time a faint line down from the
		   ruler on its family's pill; each row's class right-aligned under the
		   photograph; and behind each cheese a line from the least of its
		   ripening to the most. */
		// Each country's outline as a path, made once where the map is.
		const countryPaths = new Map<Node, Path2D[]>();
		const drawMap = (g: Pen, p: Node, left: number, top: number) => {
			if (!countryPaths.has(p))
				countryPaths.set(
					p,
					Object.values(data.map.countries).map(({ rings }) => {
						const path = new Path2D();
						for (const r of rings) {
							path.moveTo(left + r[0] * MAP_W, top + PANEL_PAD + r[1] * MAP_W);
							for (let i = 2; i < r.length; i += 2) path.lineTo(left + r[i] * MAP_W, top + PANEL_PAD + r[i + 1] * MAP_W);
							path.closePath();
						}
						return path;
					}),
				);
			g.fillStyle = ink.land;
			g.strokeStyle = ink.grid;
			g.lineWidth = 0.6;
			g.lineJoin = 'round';
			for (const path of countryPaths.get(p)!) {
				g.fill(path);
				g.stroke(path);
			}
		};
		/* Where a pin is, in the picture: its point. Its size at a zoom: so
		   many pixels on the screen with the map framed, and from there it
		   grows only a little, by the fourth root of the zoom. `r` is its
		   size in pixels, framed. */
		const pinsOf = (p: Node) => {
			const left = p.x - p.w / 2;
			const top = p.y + p.h / 2;
			return (panels.get(p)?.pins ?? []).map((pin) => ({ ...pin, x: left + pin.x, y: top + pin.y }));
		};
		/* The pins shown at a zoom, to a doubling: the biggest first, each
		   that would overlap one already there taken into it if of the same
		   country, its count added and the pin moved to the middle of them
		   all, else left out, the bigger one standing for the place. One that
		   has taken in all its country's is named for the country. */
		const clusters = new Map<string, Pin[]>();
		const pinsAt = (p: Node, s: number) => {
			const level = 2 ** Math.round(Math.log2(s));
			const key = `${p.id}@${level}`;
			if (clusters.has(key)) return clusters.get(key)!;
			const all = pinsOf(p);
			const each = new Map<string, number>();
			for (const pin of all) each.set(pin.iso, (each.get(pin.iso) ?? 0) + 1);
			// How far apart on the screen two pins must be, at this zoom, not to overlap.
			const apart = (a: Pin, b: Pin) => Math.hypot(a.x - b.x, a.y - b.y) * level < (a.r + b.r) * (level / PIN_FRAMED) ** 0.25 * 1.1;
			const shown: (Pin & { from: Pin[] })[] = [];
			for (const pin of [...all].sort((a, b) => b.n - a.n)) {
				const over = shown.find((o) => apart(o, pin));
				if (!over) {
					shown.push({ ...pin, from: [pin] });
					continue;
				}
				if (over.iso !== pin.iso) continue;
				over.from.push(pin);
				over.n += pin.n;
				over.x = over.from.reduce((t, q) => t + q.x * q.n, 0) / over.n;
				over.y = over.from.reduce((t, q) => t + q.y * q.n, 0) / over.n;
				over.r = PIN + PIN_GROWS * Math.sqrt(over.n);
				over.areas = over.from.flatMap((q) => q.areas);
				const country = data.map.countries[over.iso].name;
				const [first] = over.from;
				over.name = over.from.length === each.get(over.iso) ? country : `${first.name} and ${over.from.length - 1} more`;
			}
			clusters.set(key, shown);
			return shown;
		};
		const pinAt = (pin: ReturnType<typeof pinsOf>[number], s: number) => {
			// Zoomed out past the map framed, as small as the map gets.
			const r = (pin.r / s) * Math.min(1, s / PIN_FRAMED) * Math.max(1, s / PIN_FRAMED) ** 0.25;
			return { r, head: pin.y - r * 1.6 };
		};
		// Room for it as big as it gets in the picture, zoomed out as far as can be.
		const pinBox = (pin: ReturnType<typeof pinsOf>[number]): Box => {
			const { r, head } = pinAt(pin, fit * 0.5);
			return { x0: pin.x - r * 1.2, x1: pin.x + r * 1.5, y0: head - r * 1.5, y1: pin.y + r * 0.2 };
		};
		const drawPin = (g: Pen, pin: ReturnType<typeof pinsOf>[number], s: number) => {
			if (pillsShown(s)) return true;
			const { x, y, n } = pin;
			const { r, head } = pinAt(pin, s);
			/* A teardrop: the head's circle, drawn down to its point; over a
			   shadow of itself a little lower, unblurred, as pins are drawn
			   afresh at every frame, too big to keep, and a blur takes long. */
			const reach = Math.asin(r / (y - head));
			const drop = (dy: number) => {
				g.beginPath();
				g.moveTo(x, y + dy);
				g.arc(x, head + dy, r, Math.PI / 2 + reach, Math.PI / 2 - reach + Math.PI * 2);
				g.closePath();
			};
			drop(r * 0.12);
			g.fillStyle = 'rgb(0 0 0 / 0.18)';
			g.fill();
			drop(0);
			g.fillStyle = ink.text;
			g.fill();
			// Its country's flag in its head, on white, as the flags on the pills are.
			let whole = true;
			const flag = r * 0.8;
			g.beginPath();
			g.arc(x, head, flag, 0, Math.PI * 2);
			g.fillStyle = '#fff';
			g.fill();
			const im = flag * s >= 2 ? imageOf(`/assets/flags/${pin.iso.toLowerCase()}.webp`) : null;
			if (im) g.drawImage(im, x - flag, head - flag, 2 * flag, 2 * flag);
			else if (flag * s >= 2) whole = false;
			// How many, in a little round on its shoulder.
			const badge = r * 0.5;
			const bx = x + r * 0.78;
			const by = head - r * 0.78;
			g.beginPath();
			g.arc(bx, by, badge, 0, Math.PI * 2);
			g.fillStyle = ink.text;
			g.fill();
			g.lineWidth = r * 0.08;
			g.strokeStyle = ink.ground;
			g.stroke();
			if (legible(badge * 0.9, s)) {
				g.font = font(badge * (n > 99 ? 0.85 : 1.05), '600');
				g.textAlign = 'center';
				g.textBaseline = 'middle';
				g.fillStyle = ink.ground;
				g.fillText(String(n), bx, by + badge * 0.05);
			}
			return whole;
		};
		const drawPanel = (g: Pen, p: Node, s: number) => {
			const P = panels.get(p)!;
			const top = p.y + p.h / 2;
			const left = p.x - p.w / 2;
			// Edged down its sides and along its bottom as the pill is, rounded there; open at the top, where the pill is.
			const r = radius(p);
			g.beginPath();
			g.moveTo(left, top);
			g.lineTo(left, top + P.h - r);
			g.arcTo(left, top + P.h, left + r, top + P.h, r);
			g.lineTo(left + P.w - r, top + P.h);
			g.arcTo(left + P.w, top + P.h, left + P.w, top + P.h - r, r);
			g.lineTo(left + P.w, top);
			g.lineWidth = 1.2;
			g.strokeStyle = ink.rim;
			g.stroke();
			// A map's land and cheeses are drawn in tiles of their own (see drawTiles).
			if (P.kind === 'map') return true;
			for (const [d] of P.times) {
				const x = left + P.xOf(d);
				g.beginPath();
				g.moveTo(x, top);
				g.lineTo(x, top + P.h);
				g.lineWidth = 0.75;
				g.strokeStyle = ink.grid;
				g.stroke();
			}
			if (legible(11, s)) {
				g.textBaseline = 'middle';
				g.textAlign = 'right';
				g.font = font(11, '600');
				const spaced = g.letterSpacing;
				g.letterSpacing = '0.14em';
				g.fillStyle = ink.text;
				for (const { firm, y, h } of P.rows) g.fillText(firm.toUpperCase(), left + picture(p), top + y + h / 2);
				g.letterSpacing = spaced;
			}
			g.lineCap = 'round';
			for (const [k] of P.at) {
				// A guess has no span to show.
				if (k.unsure) continue;
				g.beginPath();
				g.moveTo(left + P.xOf(k.axes!.days[0]), k.y);
				g.lineTo(left + P.xOf(k.axes!.days[1]), k.y);
				g.lineWidth = 3;
				g.strokeStyle = ink.line;
				g.stroke();
			}
			g.lineCap = 'butt';
			return true;
		};

		// A regional one's flags, on its top right corner.
		const flagBox = (d: Node): Box => {
			const f = flagsOf(d);
			const r = f[0].r * 1.5;
			return { x0: f[0].x - r, x1: f.at(-1)!.x + r, y0: f[0].y - r, y1: f[0].y + r * 1.1 };
		};
		const drawFlags = (g: Pen, d: Node, s: number) => {
			// A map's cheese only once it can be read; a pin for its country till then (see drawPins).
			if (d.onMap && !pillsShown(s)) return true;
			let whole = true;
			for (const { c, r, x, y } of flagsOf(d)) {
				// On white, for a flag that does not fill its square, as Nepal's does not; with the pills' soft shadow.
				g.beginPath();
				g.arc(x, y, r, 0, Math.PI * 2);
				g.fillStyle = '#fff';
				g.shadowColor = 'rgb(0 0 0 / 0.18)';
				g.shadowBlur = r * 0.2 * s * dpr;
				g.shadowOffsetY = r * 0.08 * s * dpr;
				g.fill();
				g.shadowColor = 'transparent';
				// Round already in its file, so it needs no clipping here.
				const im = r * s >= 2 ? imageOf(`/assets/flags/${c.toLowerCase()}.webp`) : null;
				if (im) g.drawImage(im, x - r, y - r, 2 * r, 2 * r);
				else if (r * s >= 2) whole = false;
				g.beginPath();
				g.arc(x, y, r, 0, Math.PI * 2);
				g.lineWidth = 1.2 * rim(d);
				g.strokeStyle = ink.rim;
				g.stroke();
			}
			return whole;
		};

		/* The animals whose milk it is, on the bottom left corner, as the
		   flags are on the top right: bare, bigger than a flag, with a soft
		   shadow under each, each a little in from the one before. */
		const beastsAt = (d: Node) => {
			const r = d.h * 0.2;
			return d.beasts!.map((b, i) => ({ ...b, r, x: d.x - d.w / 2 + r * 0.3 + i * r * 1.5, y: d.y + d.h / 2 - r * 0.3 }));
		};
		const beastBox = (d: Node): Box => {
			const b = beastsAt(d);
			const r = b[0].r * 1.5;
			return { x0: b[0].x - r, x1: b.at(-1)!.x + r, y0: b[0].y - r, y1: b[0].y + r * 1.2 };
		};
		const drawBeasts = (g: Pen, d: Node, s: number) => {
			// A map's cheese only once it can be read; a pin for its country till then (see drawPins).
			if (d.onMap && !pillsShown(s)) return true;
			for (const { mark, r, x, y } of beastsAt(d)) {
				if (!legible(r * 2, s)) continue;
				g.font = `${r * 2}px "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif`;
				g.textAlign = 'center';
				g.textBaseline = 'middle';
				g.fillStyle = '#000';
				g.shadowColor = 'rgb(0 0 0 / 0.35)';
				g.shadowBlur = r * 0.25 * s * dpr;
				g.shadowOffsetY = r * 0.1 * s * dpr;
				g.fillText(mark, x, y);
				g.shadowColor = 'transparent';
			}
			return true;
		};

		/* Its marks on the bottom right corner, a little over it, as big and
		   edged as a flag is on the top right: a remark's info mark at the
		   corner, and left of it a question mark where its place is a guess.
		   Each says what it is in a tip. */
		type Mark = { d: Node; kind: 'note' | 'unsure'; said: string; r: number; x: number; y: number };
		const marksOf = (d: Node): Mark[] => {
			const r = d.h * 0.2;
			const said = [
				...(d.unsure ? [{ kind: 'unsure' as const, said: d.unsure }] : []),
				...(d.note ? [{ kind: 'note' as const, said: d.note }] : []),
			];
			return said.map((m, i) => ({ ...m, d, r, x: d.x + d.w / 2 - r * 0.35 - (said.length - 1 - i) * r * 1.4, y: d.y + d.h / 2 - r * 0.35 }));
		};
		const sameMark = (a: Mark | null, b: Mark | null) => a?.d === b?.d && a?.kind === b?.kind;
		const infoBox = (d: Node): Box => {
			const m = marksOf(d);
			const { r, y } = m[0];
			return { x0: m[0].x - r * 1.5, x1: m.at(-1)!.x + r * 1.5, y0: y - r * 1.5, y1: y + r * 1.6 };
		};
		const drawInfo = (g: Pen, d: Node, s: number) => {
			// A map's cheese only once it can be read; a pin for its country till then (see drawPins).
			if (d.onMap && !pillsShown(s)) return true;
			for (const { kind, r, x, y } of marksOf(d)) {
				g.beginPath();
				g.arc(x, y, r, 0, Math.PI * 2);
				// Blue, as an info mark is, with a white italic i; amber for a guess, with a ?.
				g.fillStyle = kind === 'note' ? ink.info : ink.unsure;
				g.shadowColor = 'rgb(0 0 0 / 0.18)';
				g.shadowBlur = r * 0.2 * s * dpr;
				g.shadowOffsetY = r * 0.08 * s * dpr;
				g.fill();
				g.shadowColor = 'transparent';
				// Edged as a flag is.
				g.lineWidth = 1.2 * rim(d);
				g.strokeStyle = ink.rim;
				g.stroke();
				if (!legible(r * 1.4, s)) continue;
				g.textAlign = 'center';
				g.textBaseline = 'middle';
				g.fillStyle = '#fff';
				if (kind === 'note') {
					g.font = `italic 600 ${r * 1.4}px ${SERIF()}`;
					// A little low of the middle, as an italic i sits; 1 px at the pill's own size.
					g.fillText('i', x, y + r * 0.05 + size(d));
				} else {
					g.font = `600 ${r * 1.3}px ${SERIF()}`;
					g.fillText('?', x, y + r * 0.08);
				}
			}
			return true;
		};

		/* A protected name's seal on the top left corner, as the flags are on
		   the top right: red ringed in gold for a PDO, blue for a PGI, as the
		   EU's are, with a gold star; said on hover. */
		const SEAL_SAID: Record<string, string> = {
			PDO: 'Protected designation of origin (PDO)',
			PGI: 'Protected geographical indication (PGI)',
			TSG: 'Traditional speciality guaranteed (TSG)',
		};
		const sealOf = (d: Node) => {
			const r = d.h * 0.2;
			return { r, x: d.x - d.w / 2 + r * 0.35, y: d.y - d.h / 2 + r * 0.35 };
		};
		const sealBox = (d: Node): Box => {
			const { r, x, y } = sealOf(d);
			return { x0: x - r * 1.5, x1: x + r * 1.5, y0: y - r * 1.5, y1: y + r * 1.6 };
		};
		const drawSeal = (g: Pen, d: Node, s: number) => {
			// A map's cheese only once it can be read; a pin for its country till then (see drawPins).
			if (d.onMap && !pillsShown(s)) return true;
			const { r, x, y } = sealOf(d);
			g.beginPath();
			g.arc(x, y, r, 0, Math.PI * 2);
			g.fillStyle = d.protected === 'PDO' ? '#b8102a' : d.protected === 'PGI' ? '#1d4f9c' : '#c08a00';
			g.shadowColor = 'rgb(0 0 0 / 0.18)';
			g.shadowBlur = r * 0.2 * s * dpr;
			g.shadowOffsetY = r * 0.08 * s * dpr;
			g.fill();
			g.shadowColor = 'transparent';
			g.beginPath();
			g.arc(x, y, r * 0.78, 0, Math.PI * 2);
			g.lineWidth = r * 0.16;
			g.strokeStyle = '#f2c200';
			g.stroke();
			g.beginPath();
			g.arc(x, y, r, 0, Math.PI * 2);
			g.lineWidth = 1.2 * rim(d);
			g.strokeStyle = ink.rim;
			g.stroke();
			if (legible(r, s)) {
				g.font = `${r * 1.05}px ${SANS()}`;
				g.textAlign = 'center';
				g.textBaseline = 'middle';
				g.fillStyle = '#f2c200';
				g.fillText('★', x, y + r * 0.05);
			}
			return true;
		};

		/* Each part drawn once into a little canvas of its own at each zoom it
		   is seen at, a zoom to every doubling, and stamped from there: drawing
		   words, photographs and shadows afresh at every step of a zoom takes
		   longer than a frame. A part drawn at a zoom not yet kept is drawn as
		   it was at the nearest, a little soft, and kept a few at a time, as
		   many as there is time for in a frame. One too big to keep, close in,
		   is drawn as it is. */
		const kept = new Map<string, ImageBitmap>();
		const levelOf = (s: number) => 2 ** Math.round(Math.log2(s));
		type Part = { key: string; box: Box; draw: (g: Pen, s: number) => boolean | void };
		// Too big to keep at a zoom, close in: drawn as it is.
		const tooBig = (box: Box, level: number) => Math.max(box.x1 - box.x0, box.y1 - box.y0) * level * dpr > 2048;
		/* A part drawn at a zoom and kept: as an image the screen holds on to,
		   not one handed over at every stamp; and only drawn whole. */
		const keep = ({ key, box, draw }: Part, level: number) => {
			const made = new OffscreenCanvas(
				Math.max(1, Math.ceil((box.x1 - box.x0) * level * dpr)),
				Math.max(1, Math.ceil((box.y1 - box.y0) * level * dpr)),
			);
			const g = made.getContext('2d')!;
			g.setTransform(level * dpr, 0, 0, level * dpr, -box.x0 * level * dpr, -box.y0 * level * dpr);
			g.letterSpacing = `${spacing}px`;
			if (draw(g, level) === false) return made;
			const bitmap = made.transferToImageBitmap();
			kept.set(`${key}@${level}`, bitmap);
			return bitmap;
		};
		/* While the picture moves nothing is kept, as keeping takes longer than
		   a frame has; once it is still, what is in sight is kept at this zoom,
		   as much as there is time for in a frame, and then, when the page has
		   nothing else to do, at the zooms either side of it, ready for the next. */
		let moving = false;
		let unkept = false;
		let until = 0;
		let inSightNow: Part[] = [];
		// The parts, worked out again when one looks different: lit, or held.
		let parts: Part[] | null = null;
		let warming = 0;
		/* Every part, in the order they are drawn: the steps' words, their
		   tables, the pills, the flags over them; each named for how it looks,
		   so one drawn lit is kept apart from one drawn unlit. */
		/* A pill's parts: the pill, the flags, the marks, the animals and the
		   seal over it; a map's cheeses' are drawn into the map's tiles. */
		const partsOf = (list: Node[]): Part[] => [
			...list.filter((d) => d !== root).map((d) => ({ key: `p:${d.id}:${d === held ? 1 : 0}`, box: pillBoxOf(d), draw: (g: Pen, at: number) => drawPill(g, d, at) })),
			...list.filter((d) => d.regions?.length).map((d) => ({ key: `f:${d.id}`, box: flagBox(d), draw: (g: Pen, at: number) => drawFlags(g, d, at) })),
			...list.filter((d) => d.note || d.unsure).map((d) => ({ key: `i:${d.id}`, box: infoBox(d), draw: (g: Pen, at: number) => drawInfo(g, d, at) })),
			...list.filter((d) => d.beasts?.length).map((d) => ({ key: `b:${d.id}`, box: beastBox(d), draw: (g: Pen, at: number) => drawBeasts(g, d, at) })),
			...list.filter((d) => d.protected).map((d) => ({ key: `seal:${d.id}`, box: sealBox(d), draw: (g: Pen, at: number) => drawSeal(g, d, at) })),
		];
		const pinParts = (s: number): Part[] =>
			pillsShown(s)
				? []
				: [...panels.keys()].flatMap((p) =>
						pinsAt(p, s).map((pin) => ({ key: `pin:${p.id}:${pin.iso}:${pin.areas.join()}:${pin.n}`, box: pinBox(pin), draw: (g: Pen, at: number) => drawPin(g, pin, at) })),
					);
		const everyPart = (): Part[] => [
			...[...panels.keys()].map((p) => ({ key: `panel:${p.id}`, box: panelArea(p), draw: (g: Pen, at: number) => drawPanel(g, p, at) })),
			...stepped.map((n) => {
				const box = stepBox(n);
				const wide = (box.x1 - box.x0) * 0.1 + stepFont(n) * 0.3;
				return { key: `s:${n.id}:${n === stepShown ? 1 : 0}`, box: { ...box, x0: box.x0 - wide, x1: box.x1 + wide }, draw: (g: Pen, at: number) => drawStep(g, n, at) };
			}),
			...tabled.map((n) => ({ key: `t:${n.id}:${n === stepShown ? 1 : 0}`, box: tableOf(n).area, draw: (g: Pen, at: number) => drawTable(g, n, at) })),
			...partsOf(shown.filter((d) => !d.onMap)),
		];

		/* A map, cut into tiles as a map on the web is: its land and every
		   cheese on it drawn once into each tile at each zoom it is seen at,
		   a zoom to every doubling, and only the tiles in sight stamped. A
		   thousand cheeses stamped one part at a time take longer than a
		   frame. A tile not yet drawn is shown as a bigger one of the zoom
		   below has it, a little soft, or as the smaller ones of the zoom
		   above; and drawn, a few a frame, as there is time. */
		const TILE = 512;
		const tiles = new Map<string, { bitmap: ImageBitmap; whole: boolean; tries: number }>();
		const mapParts = new Map<Node, Part[]>();
		const overlaps = (a: Box, b: Box) => a.x1 >= b.x0 && a.x0 <= b.x1 && a.y1 >= b.y0 && a.y0 <= b.y1;
		// The zoom it is all in one tile at: drawn first, so there is always something to show.
		const baseLevel = (p: Node) => levelOf(TILE / ((panelArea(p).x1 - panelArea(p).x0) * dpr)) / 2;
		const drawTile = (p: Node, level: number, tx: number, ty: number) => {
			const area = panelArea(p);
			const span = TILE / (level * dpr);
			const t = { x0: area.x0 + tx * span, y0: area.y0 + ty * span, x1: area.x0 + (tx + 1) * span, y1: area.y0 + (ty + 1) * span };
			const made = new OffscreenCanvas(TILE, TILE);
			const g = made.getContext('2d')!;
			g.setTransform(level * dpr, 0, 0, level * dpr, -t.x0 * level * dpr, -t.y0 * level * dpr);
			g.letterSpacing = `${spacing}px`;
			drawMap(g, p, p.x - p.w / 2, p.y + p.h / 2);
			if (!mapParts.has(p)) mapParts.set(p, partsOf((paneled.get(p) ?? []).filter((k) => k.onMap)));
			let whole = true;
			unlit = true;
			for (const part of mapParts.get(p)!) if (overlaps(part.box, t) && part.draw(g, level) === false) whole = false;
			unlit = false;
			const key = `${p.id}@${level}/${tx}/${ty}`;
			const was = tiles.get(key);
			was?.bitmap.close();
			const tile = { bitmap: made.transferToImageBitmap(), whole, tries: (was?.tries ?? 0) + 1 };
			tiles.set(key, tile);
			return tile;
		};
		const drawTiles = (p: Node, s: number, a: { x: number; y: number }, b: { x: number; y: number }) => {
			const area = panelArea(p);
			const base = baseLevel(p);
			const level = Math.max(base, levelOf(s));
			const span = TILE / (level * dpr);
			const last = (n: number) => Math.ceil(n / span) - 1;
			const clamp = (v: number, hi: number) => Math.max(0, Math.min(hi, v));
			const cols = last(area.x1 - area.x0);
			const rows = last(area.y1 - area.y0);
			// The zoom it is all in a tile or two at, always there to fall back on.
			for (let ty = 0; ty <= Math.ceil((area.y1 - area.y0) / (TILE / (base * dpr))) - 1; ty++)
				for (let tx = 0; tx <= Math.ceil((area.x1 - area.x0) / (TILE / (base * dpr))) - 1; tx++) if (!tiles.has(`${p.id}@${base}/${tx}/${ty}`)) drawTile(p, base, tx, ty);
			for (let ty = clamp(Math.floor((a.y - area.y0) / span), rows); ty <= clamp(Math.floor((b.y - area.y0) / span), rows); ty++)
				for (let tx = clamp(Math.floor((a.x - area.x0) / span), cols); tx <= clamp(Math.floor((b.x - area.x0) / span), cols); tx++) {
					const x0 = area.x0 + tx * span;
					const y0 = area.y0 + ty * span;
					let tile = tiles.get(`${p.id}@${level}/${tx}/${ty}`);
					// A photograph or flag not yet in when it was drawn: drawn again, once it may be.
					if ((!tile || (!tile.whole && tile.tries < 4 && !moving)) && performance.now() < until) tile = drawTile(p, level, tx, ty);
					if (tile) {
						ctx.drawImage(tile.bitmap, x0, y0, span, span);
						continue;
					}
					unkept = true;
					// The smaller ones of the zoom above, where they are all there.
					const fine = [0, 1].flatMap((j) => [0, 1].map((i) => tiles.get(`${p.id}@${level * 2}/${tx * 2 + i}/${ty * 2 + j}`)));
					if (fine.every(Boolean) && pillsShown(level * 2) === pillsShown(level)) {
						fine.forEach((f, k) => ctx.drawImage(f!.bitmap, x0 + (k % 2) * (span / 2), y0 + Math.floor(k / 2) * (span / 2), span / 2, span / 2));
						continue;
					}
					// Or the part of a bigger one of the zooms below.
					for (let up = level / 2; up >= base; up /= 2) {
						const wide = TILE / (up * dpr);
						const ux = Math.floor((x0 - area.x0) / wide);
						const uy = Math.floor((y0 - area.y0) / wide);
						const coarse = tiles.get(`${p.id}@${up}/${ux}/${uy}`);
						if (!coarse || pillsShown(up) !== pillsShown(level)) continue;
						const k = up * dpr;
						ctx.drawImage(coarse.bitmap, (x0 - area.x0 - ux * wide) * k, (y0 - area.y0 - uy * wide) * k, span * k, span * k, x0, y0, span, span);
						break;
					}
				}
			// Those at zooms far from this one let go, so they do not pile up.
			if (tiles.size > 400)
				for (const [key, tile] of tiles) {
					const at = Number(key.slice(key.indexOf('@') + 1, key.indexOf('/')));
					if (at !== base && Math.abs(Math.log2(at / level)) > 1) {
						tile.bitmap.close();
						tiles.delete(key);
					}
				}
		};
		/* Kept, when there is nothing else to do: everything at this zoom, the
		   nearest first, then what is in sight at the zooms either side. */
		const warm = () => {
			cancelIdleCallback(warming);
			const level = levelOf(shownAt.k * fit);
			const middle = fromScreen(paneW / 2, paneH / 2);
			const far = (p: Part) => Math.hypot((p.box.x0 + p.box.x1) / 2 - middle.x, (p.box.y0 + p.box.y1) / 2 - middle.y);
			const todo = [
				...[...inSightNow].reverse().flatMap((p) => [level * 2, level / 2].map((at) => [p, at] as const)),
				...everyPart()
					.sort((a, b) => far(b) - far(a))
					.map((p) => [p, level] as const),
			].filter(([p, at]) => !kept.has(`${p.key}@${at}`) && !tooBig(p.box, at));
			const step = (deadline: IdleDeadline) => {
				while (todo.length && deadline.timeRemaining() > 2 && !moving) {
					const [p, at] = todo.pop()!;
					keep(p, at);
				}
				if (todo.length && !moving) warming = requestIdleCallback(step);
			};
			warming = requestIdleCallback(step);
		};
		const stamp = (part: Part, s: number) => {
			const { key, box, draw } = part;
			const level = levelOf(s);
			if (tooBig(box, level)) {
				draw(ctx, s);
				return;
			}
			inSightNow.push(part);
			let bitmap: ImageBitmap | OffscreenCanvas | undefined = kept.get(`${key}@${level}`);
			if (!bitmap && !moving && performance.now() < until) bitmap = keep(part, level);
			if (!bitmap) {
				unkept = true;
				for (const near of [level / 2, level * 2, level / 4, level * 4]) bitmap ??= kept.get(`${key}@${near}`);
				if (!bitmap) {
					draw(ctx, s);
					return;
				}
			}
			ctx.drawImage(bitmap, box.x0, box.y0, box.x1 - box.x0, box.y1 - box.y0);
		};
		// Those at zooms far from this one let go, so they do not pile up.
		let forgotAt = 0;
		const forget = (s: number) => {
			const level = levelOf(s);
			if (kept.size < 3000 || level === forgotAt) return;
			forgotAt = level;
			for (const key of kept.keys()) {
				const at = Number(key.slice(key.lastIndexOf('@') + 1));
				if (Math.abs(Math.log2(at / level)) > 1) {
					kept.get(key)!.close();
					kept.delete(key);
				}
			}
		};

		/* The whole of it, drawn once into a single image, nothing lit, when there
		   is nothing else to do; and, zoomed out so far that the image is as
		   sharp as the screen, drawn as that one image, with only what is lit,
		   held or looked at drawn over it. Zoomed out, the most is in sight,
		   and stamping every part and arrow of it each frame takes too long. */
		const OVERVIEW = 4096;
		const overviewAt = OVERVIEW / Math.max(box.width, box.height);
		let overview: ImageBitmap | null = null;
		let building = 0;
		const buildOverview = () => {
			cancelIdleCallback(building);
			const made = new OffscreenCanvas(Math.ceil(box.width * overviewAt), Math.ceil(box.height * overviewAt));
			const g = made.getContext('2d')!;
			g.setTransform(overviewAt, 0, 0, overviewAt, -box.x * overviewAt, -box.y * overviewAt);
			g.letterSpacing = `${spacing}px`;
			g.lineJoin = 'round';
			let whole = true;
			const todo: (() => void)[] = [
				() => {
					g.lineWidth = 1 / overviewAt;
					g.fillStyle = g.strokeStyle = ink.line;
					for (const e of edges) {
						g.fill(edgeShape.get(e)!);
						g.stroke(edgeShape.get(e)!);
					}
				},
				() => drawMilk(g, root, overviewAt / dpr),
				// A map's land; its cheeses are not drawn so far out, and its pins are drawn over it, as big as the zoom has them.
				...[...panels.keys()].filter((p) => p.map).map((p) => () => drawMap(g, p, p.x - p.w / 2, p.y + p.h / 2)),
				...everyPart().map((p) => () => {
					if (p.draw(g, overviewAt / dpr) === false) whole = false;
				}),
			].reverse();
			const step = (deadline: IdleDeadline) => {
				unlit = true;
				while (todo.length && (deadline.timeRemaining() > 2 || deadline.didTimeout)) todo.pop()!();
				unlit = false;
				if (todo.length) {
					building = requestIdleCallback(step, { timeout: 1000 });
					return;
				}
				overview?.close();
				overview = made.transferToImageBitmap();
				repaint();
				// A photograph or flag not yet in: built again once they are.
				if (!whole) building = window.setTimeout(buildOverview, 1500) as unknown as number;
			};
			building = requestIdleCallback(step, { timeout: 1000 });
		};
		signal.addEventListener('abort', () => {
			cancelIdleCallback(building);
			clearTimeout(building);
		});

		/* The map's card (see .milk-map-card): in the map's top left, a little
		   in from its edges; once the map is panned past that, held in the
		   pane's top left, under the search, as a sticky header is, until
		   the map's far edges push it out. Not shown while the map is too
		   small on the screen to hold it. */
		const mapCard = figure.querySelector<HTMLElement>('.milk-map-card')!;
		const mapped = [...panels.keys()].find((p) => p.map);
		// Its size and the search's foot, measured as it is first shown and as the pane changes size, not each frame.
		let cardSize: { w: number; h: number; roof: number } | null = null;
		let cardAt = '';
		const placeCard = () => {
			if (!mapped) return void (mapCard.hidden = true);
			const area = panelArea(mapped);
			const [x0, y0] = toPane(area.x0, area.y0);
			const [x1, y1] = toPane(area.x1, area.y1);
			const left = x0 * shownAt.k + shownAt.x;
			const top = y0 * shownAt.k + shownAt.y;
			const right = x1 * shownAt.k + shownAt.x;
			const bottom = y1 * shownAt.k + shownAt.y;
			const inset = 12;
			// Three of its 15rem across, at the least; hidden, it has no width of its own to go by.
			const hide = right - left < 720;
			if (mapCard.hidden !== hide) mapCard.hidden = hide;
			if (hide) return;
			if (!cardSize) {
				// Under the search where it is in the pane; at the pane's top where it has gone to the deck's tools.
				const under = figure.querySelector<HTMLElement>('.milk-search .milk-beasts') ?? figure.querySelector<HTMLElement>('.milk-search input');
				const roof = under ? under.getBoundingClientRect().bottom - canvas.getBoundingClientRect().top + inset : inset;
				cardSize = { w: mapCard.offsetWidth, h: mapCard.offsetHeight, roof };
			}
			const { w, h, roof } = cardSize;
			const x = Math.round(Math.min(Math.max(left + inset, inset), right - inset - w));
			const y = Math.round(Math.min(Math.max(top + inset, roof), bottom - inset - h));
			const to = `translate(${canvas.offsetLeft + x}px, ${canvas.offsetTop + y}px)`;
			if (to !== cardAt) mapCard.style.transform = cardAt = to;
		};
		signal.addEventListener('abort', () => (mapCard.hidden = true));

		/* Drawing it all, of what is in sight: the arrows, the lit ones over the
		   rest; the steps' words and tables; the pills; and the flags over them. */
		const paint = () => {
			ctx.setTransform(1, 0, 0, 1, 0, 0);
			ctx.clearRect(0, 0, canvas.width, canvas.height);
			const s = shownAt.k * fit;
			ctx.setTransform(dpr * s, 0, 0, dpr * s, dpr * (shownAt.k * offX + shownAt.x), dpr * (shownAt.k * offY + shownAt.y));
			ctx.letterSpacing = `${spacing}px`;
			ctx.imageSmoothingQuality = 'high';
			const a = fromScreen(0, 0);
			const b = fromScreen(paneW, paneH);
			const inSight = (r: Box) => r.x1 >= a.x && r.x0 <= b.x && r.y1 >= a.y && r.y0 <= b.y;
			placeCard();
			unkept = false;
			inSightNow = [];
			forget(s);

			// Zoomed out: the overview, and over it only what is lit, held or looked at.
			if (overview && s * dpr <= overviewAt) {
				ctx.drawImage(overview, box.x, box.y, box.width, box.height);
				until = performance.now() + 6;
				for (const part of pinParts(s)) if (inSight(part.box)) stamp(part, s);
				ctx.lineJoin = 'round';
				ctx.lineWidth = 1 / s;
				ctx.fillStyle = ctx.strokeStyle = ink.litLine;
				for (const e of lit) {
					ctx.fill(edgeShape.get(e)!);
					ctx.stroke(edgeShape.get(e)!);
				}
				if (stepShown) {
					drawStep(ctx, stepShown, s);
					if (rows(stepShown).length) drawTable(ctx, stepShown, s);
				}
				if (held && held !== root) {
					drawPill(ctx, held, s);
					if (held.regions?.length) drawFlags(ctx, held, s);
					if (held.note || held.unsure) drawInfo(ctx, held, s);
					if (held.protected) drawSeal(ctx, held, s);
					if (held.beasts?.length) drawBeasts(ctx, held, s);
				}
				return;
			}

			// The tree, set back until a product is looked at; its lines edged in a hairline of their own colour.
			ctx.lineJoin = 'round';
			ctx.lineWidth = 1 / s;
			for (const on of [false, true])
				for (const e of edges) {
					if (lit.has(e) !== on || !inSight(edgeBox.get(e)!)) continue;
					ctx.fillStyle = ctx.strokeStyle = on ? ink.litLine : ink.line;
					ctx.fill(edgeShape.get(e)!);
					ctx.stroke(edgeShape.get(e)!);
				}
			// Milk under the rest, the flags over every pill, as one reaches over the next pill up.
			if (inSight(pillBoxOf(root))) drawMilk(ctx, root, s);
			until = performance.now() + 6;
			for (const p of panels.keys()) if (p.map && inSight(panelArea(p))) drawTiles(p, s, a, b);
			parts ??= everyPart();
			for (const part of [...parts, ...pinParts(s)]) if (inSight(part.box)) stamp(part, s);
			// One held on a map, lit over its tile.
			if (held?.onMap && pillsShown(s)) for (const part of partsOf([held])) part.draw(ctx, s);

			// Some not yet kept at this zoom: on with them in the next frame; all of them: the zooms either side.
			if (moving) return;
			if (unkept) repaint();
			else warm();
		};
		// Drawn once a frame, however many times it is asked to be in one.
		let queued = false;
		const repaint = () => {
			if (queued) return;
			queued = true;
			requestAnimationFrame(() => {
				queued = false;
				if (!signal.aborted) paint();
			});
		};

		/* As big as the pane, in the screen's own pixels; and as the pane
		   changes size, the point that was in its middle kept in its middle. */
		const sizeTo = () => {
			const w = canvas.clientWidth;
			const h = canvas.clientHeight;
			const was = dpr;
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			// Tiles and parts are drawn in the screen's pixels: on a screen with more to them, drawn again.
			if (dpr !== was) {
				for (const tile of tiles.values()) tile.bitmap.close();
				tiles.clear();
				for (const bitmap of kept.values()) bitmap.close();
				kept.clear();
			}
			if (canvas.width !== Math.round(w * dpr) || canvas.height !== Math.round(h * dpr)) {
				canvas.width = Math.round(w * dpr);
				canvas.height = Math.round(h * dpr);
			}
			// Only a real change moves the picture: anything else would cut short a glide under way.
			if (!w || !h || (w === paneW && h === paneH)) return;
			cardSize = null;
			const middleWas = fromScreen(paneW / 2, paneH / 2);
			paneW = w;
			paneH = h;
			fitTo();
			const [px, py] = toPane(middleWas.x, middleWas.y);
			const k = shownAt.k;
			surface.call(zoomer.transform, zoomIdentity.translate(w / 2 - k * px, h / 2 - k * py).scale(k));
			paint();
		};
		const sizing = new ResizeObserver(sizeTo);
		signal.addEventListener('abort', () => sizing.disconnect());

		/* Looking at a product: pointing at it, or having clicked it, draws
		   every way it is made and everything made from it in the ink. A
		   click tells of it besides (see tell), and holds it so until it is
		   closed or another is clicked. */
		let held: Node | null = null;
		let lit = new Set<Edge>();
		const look = (n: Node | null) => {
			/* Its own lines, and on through any branch point at their far end,
			   which is no product of its own: pasteurised milk lights soured
			   milk and yoghurt past the point where "ferment" splits. */
			lit = new Set<Edge>();
			const reach = (from: Node, outward: boolean) => {
				for (const e of edges) {
					const next = outward ? (e.source === from ? e.target : null) : e.target === from ? e.source : null;
					if (!next) continue;
					lit.add(e);
					if (next.hub) reach(next, outward);
				}
			};
			if (n) {
				reach(n, true);
				reach(n, false);
			}
			parts = null;
			repaint();
		};

		/* What is under the pointer: a pill (milk a circle), or failing that
		   a step that tells of itself: its table, its words, or a wide unseen
		   band along its arrow. A flag or a photograph gives its credit. */
		const within = (r: Box, x: number, y: number) => x >= r.x0 && x <= r.x1 && y >= r.y0 && y <= r.y1;
		const pointedAt = (e: MouseEvent) => {
			const rect = canvas.getBoundingClientRect();
			const sx = e.clientX - rect.left;
			const sy = e.clientY - rect.top;
			const { x, y } = fromScreen(sx, sy);
			let hint = '';
			/* Only those near the pointer, their marks reaching a little past
			   their edges; a map's cheeses only once they are drawn. */
			const zoom = shownAt.k * fit;
			const near = shown.filter((d) => d === root || ((!d.onMap || pillsShown(zoom)) && Math.abs(x - d.x) <= d.w / 2 + d.h && Math.abs(y - d.y) <= d.h * 1.5));
			for (const d of near)
				if (d.regions?.length)
					for (const f of flagsOf(d)) if (Math.hypot(x - f.x, y - f.y) <= f.r) hint = d.regions.map((c) => countryName.of(c)).join(', ');
			for (const d of near)
				if (d.beasts?.length)
					for (const b of beastsAt(d)) if (Math.hypot(x - b.x, y - b.y) <= b.r) hint = `From ${d.beasts.map((m) => m.milk).join(' and ')} milk`;
			for (const d of near)
				if (d.protected) {
					const seal = sealOf(d);
					if (Math.hypot(x - seal.x, y - seal.y) <= seal.r) hint = SEAL_SAID[d.protected] ?? d.protected;
				}
			// A little more than the mark itself, to be tapped.
			const info = near.flatMap((d) => (d.note || d.unsure ? marksOf(d) : [])).find((m) => Math.hypot(x - m.x, y - m.y) <= m.r * 1.3) ?? null;
			let pill: Node | null = null;
			for (let i = near.length - 1; i >= 0 && !pill && !info; i--) {
				const d = near[i];
				const over = d === root ? Math.hypot(x - d.x, y - d.y) <= rootR : Math.abs(x - d.x) <= d.w / 2 && Math.abs(y - d.y) <= d.h / 2;
				if (!over) continue;
				pill = d;
				if (!hint && d.image && x <= d.x - d.w / 2 + picture(d)) hint = d.image.credit;
			}
			let step: Node | null = null;
			if (!pill && !info) {
				step =
					tabled.find((n) => told(n) && within(tableOf(n).area, x, y)) ??
					stepped.find((n) => told(n) && !rows(n).length && within(stepBox(n), x, y)) ??
					null;
				if (!step) {
					const s = shownAt.k * fit;
					ctx.setTransform(s, 0, 0, s, shownAt.k * offX + shownAt.x, shownAt.k * offY + shownAt.y);
					ctx.lineWidth = 14;
					step = hittable.find((e) => ctx.isPointInStroke(edgeLine.get(e)!, sx, sy))?.target ?? null;
				}
			}
			const s = shownAt.k * fit;
			// The one drawn last, over the rest, of those shown at this zoom.
			const pin =
				[...panels.keys()].flatMap((p) => (pillsShown(s) ? [] : pinsAt(p, s))).findLast((p) => {
					const { r, head } = pinAt(p, s);
					return Math.hypot(x - p.x, y - head) <= r * 1.1;
				}) ?? null;
			if (pin) {
				hint = `${pin.name}: ${pin.n} ${pin.n === 1 ? 'cheese' : 'cheeses'}`;
				return { pill: null, step: null, hint, info: null, pin };
			}
			return { pill, step, hint, info, pin: null };
		};
		/* A remark, said in a little tip over its mark: on hover, or held by a
		   tap until the next one anywhere; gone once the picture moves. */
		const tip = figure.querySelector<HTMLElement>('.milk-note')!;
		let tipped: Mark | null = null;
		let tipHeld = false;
		const showTip = (m: Mark | null, hold = false) => {
			tipped = m;
			tipHeld = !!m && hold;
			tip.hidden = !m;
			if (!m) return;
			tip.textContent = m.said;
			const { x, y, r } = m;
			const s = shownAt.k * fit;
			tip.style.left = `${canvas.offsetLeft + (x * fit + offX) * shownAt.k + shownAt.x}px`;
			tip.style.top = `${canvas.offsetTop + (y * fit + offY) * shownAt.k + shownAt.y + r * s}px`;
		};
		let pointing: { pill: Node | null; step: Node | null } = { pill: null, step: null };
		canvas.addEventListener(
			'pointermove',
			(e) => {
				if (e.pointerType !== 'mouse' || e.buttons) return;
				const { pill, step, hint, info } = pointedAt(e);
				if (!tipHeld && !sameMark(info, tipped)) showTip(info);
				if (pill !== pointing.pill) look(pill ?? held);
				if (step !== pointing.step && !heldStep) showStep(step);
				pointing = { pill, step };
				canvas.style.cursor = step || info || pill?.link ? 'pointer' : '';
				canvas.title = hint;
			},
			{ signal },
		);
		canvas.addEventListener(
			'pointerleave',
			() => {
				if (!tipHeld) showTip(null);
				if (pointing.pill) look(held);
				if (pointing.step && !heldStep) showStep(null);
				pointing = { pill: null, step: null };
			},
			{ signal },
		);
		canvas.addEventListener(
			'click',
			(e) => {
				const { pill, step, info, pin } = pointedAt(e);
				// A pin zooms into its country, to where its cheeses can be read.
				if (pin) return intoCountry(pin);
				// A remark's mark only says it, held.
				if (info) return showTip(sameMark(tipped, info) && tipHeld ? null : info, true);
				showTip(null);
				// The "…" for the many more tells of the product they are examples of.
				// One drawn again only goes to the product it is, lit, not told of.
				if (pill?.link) go(pill, true);
				else if (pill) tell(pill);
				else if (step) tellStep(step);
				else shut();
			},
			{ signal },
		);

		/* Looked round as a map is: the wheel or a pinch to zoom, a drag on the
		   ground or a node to pan, a double-click or double-tap to zoom in. */
		let stilled = 0;
		signal.addEventListener('abort', () => {
			clearTimeout(stilled);
			cancelIdleCallback(warming);
		});
		const zoomer = zoom<HTMLCanvasElement, unknown>()
			.scaleExtent([0.5, MAX_ZOOM])
			.on('zoom', (e) => {
				shownAt = e.transform;
				if (tipped) showTip(null);
				moving = true;
				clearTimeout(stilled);
				stilled = window.setTimeout(() => {
					moving = false;
					repaint();
				}, 150);
				repaint();
			});
		surface.call(zoomer);
		sizeTo();
		sizing.observe(canvas);
		paint();
		buildOverview();

		/* Finding a product: by its name, any of its other names, or an
		   example of it, without minding case or accents. What is found is
		   glided to and zoomed into until it reads, and held looked at, as a
		   tap holds it. An example too far down the list to be drawn finds
		   the product it is an example of. */
		const plain = (t: string) => t.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase();
		const name = (n: Node) => n.label.replace(/\n/g, ' ');
		const index: { said: string; plain: string; to: Node; hint: string }[] = [];
		for (const n of nodes) {
			// Found as the product it is drawn again of, not twice.
			if (n.hub || n.link) continue;
			const parent = treeParent.get(n);
			index.push({ said: name(n), plain: plain(name(n)), to: n, hint: n.example && parent ? `example of ${name(parent)}` : '' });
			for (const a of n.aka ?? []) index.push({ said: a, plain: plain(a), to: n, hint: `= ${name(n)}` });
		}
		// In the figure, or already moved up into a sidebar deck's column of
		// tools (data-deck-tool, see DeckPost), which it works the same from.
		const search = (figure.querySelector<HTMLDivElement>('.milk-search') ??
			document.querySelector<HTMLDivElement>('[data-deck-tools] .milk-search'))!;
		const field = search.querySelector('input')!;
		const list = search.querySelector('ul')!;
		let found: typeof index = [];
		let chosen = 0;
		// The list shown or not, and said to be.
		list.id = `${uid}-found`;
		field.setAttribute('aria-controls', list.id);
		const open = (on: boolean) => {
			list.hidden = !on;
			field.setAttribute('aria-expanded', String(on));
			if (on && found[chosen]) field.setAttribute('aria-activedescendant', `${list.id}-${chosen}`);
			else field.removeAttribute('aria-activedescendant');
		};
		const show = () => {
			list.replaceChildren(
				...found.map((r, i) => {
					const li = document.createElement('li');
					li.id = `${list.id}-${i}`;
					li.setAttribute('role', 'option');
					li.setAttribute('aria-selected', String(i === chosen));
					li.textContent = r.said;
					if (r.hint) {
						const hint = document.createElement('small');
						hint.textContent = r.hint;
						li.append(hint);
					}
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						go(r.to);
					});
					return li;
				}),
			);
			open(found.length > 0);
		};
		// Best first: the name starting with it, then a word in it, then anywhere.
		const rank = (r: (typeof index)[number], q: string) =>
			r.plain.startsWith(q) ? 0 : r.plain.split(/[\s(/,-]+/).some((w) => w.startsWith(q)) ? 1 : 2;
		field.addEventListener('input', () => {
			const q = plain(field.value.trim());
			const seen = new Set<string>();
			found = q
				? index
						.filter((r) => r.plain.includes(q))
						.sort((a, b) => rank(a, q) - rank(b, q) || a.said.length - b.said.length)
						.filter((r) => !seen.has(r.said + r.hint) && !!seen.add(r.said + r.hint))
						.slice(0, 8)
				: [];
			chosen = 0;
			show();
		}, { signal });
		field.addEventListener('keydown', (e) => {
			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				if (!found.length) return;
				chosen = (chosen + (e.key === 'ArrowDown' ? 1 : found.length - 1)) % found.length;
				show();
			} else if (e.key === 'Enter' && found[chosen]) {
				go(found[chosen].to);
			} else if (e.key === 'Escape') {
				field.value = '';
				found = [];
				show();
			} else return;
			e.preventDefault();
		}, { signal });
		field.addEventListener('blur', () => open(false), { signal });
		field.addEventListener('focus', () => open(found.length > 0), { signal });
		/* Where a narrow pane has no room for the card beside the picture, it
		   is the whole pane, and only a tap on a product opens it: finding one,
		   or pressing one named in the words, only goes to it. */
		const narrow = () => figure.clientWidth < 40 * parseFloat(getComputedStyle(document.documentElement).fontSize);
		/* Gone to, and told of unless `quiet`: a product named in the words
		   beside the picture is only glided to and lit, the words being the
		   telling. */
		const go = (n: Node, quiet = false) => {
			if (n.link) n = nodes.find((m) => m.id === n.link)!;
			open(false);
			field.blur();
			if (narrow() || quiet) {
				tell(null);
				held = n;
				look(n);
			} else tell(n);
			surface.transition().duration(750).call(zoomer.transform, zoomInto(n));
		};
		/* Zoomed until its pill is about this tall on the screen, and into
		   the middle of what the card leaves of the picture, as if that were
		   all of it; a kind with a ruler, long and low, until it is as wide as
		   most of that, so its ruler reads. */
		const zoomInto = (n: Node) => {
			// Its width, not where it is, which while it slides in is not yet where it will be.
			const left = card.classList.contains('is-open') ? card.offsetWidth : 0;
			const free = paneW - left;
			const k = Math.max(0.5, Math.min(MAX_ZOOM, n.scale ? Infinity : FOUND_HEIGHT / (n.h * fit), (0.8 * free) / (n.w * fit)));
			const [px, py] = toPane(n.x, n.y);
			return zoomIdentity.translate(left + free / 2 - k * px, paneH / 2 - k * py).scale(k);
		};

		/* Telling of a product, or an example, in a card over the picture:
		   its photograph and name, what else it is called, what it is, and
		   where it sits in the tree, each product named there a way to it. */
		const card = figure.querySelector<HTMLElement>('.milk-about')!;
		const cardBody = card.querySelector<HTMLElement>('.milk-about-body')!;
		const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
			const e = document.createElement(tag);
			if (cls) e.className = cls;
			if (text !== undefined) e.textContent = text;
			return e;
		};
		/* Where what is said is from: Wikipedia, read more on; its other
		   sources, named; or that it has none yet. */
		const sourcesOf = (said: Sourcing) => {
			if ('unsourced' in said) return el('p', 'milk-about-source', 'No source yet');
			const [only] = said.links;
			const wiki = said.links.length === 1 && /wikipedia\.org$/.test(new URL(only.url).hostname);
			const from = el('p', 'milk-about-source', wiki ? '' : said.links.length > 1 ? 'Sources: ' : 'Source: ');
			said.links.forEach(({ name, url }, i) => {
				if (i) from.append(', ');
				const a = el('a', '', wiki ? 'Read more on Wikipedia' : name);
				a.href = url;
				a.target = '_blank';
				a.rel = 'noopener';
				from.append(a);
			});
			return from;
		};
		const to = (n: Node) => {
			const b = el('button', 'milk-about-to', name(n));
			b.type = 'button';
			b.addEventListener('click', () => go(n));
			return b;
		};
		// What it is made from, past the branch point between.
		const parentOf = (n: Node) => {
			const p = treeParent.get(n);
			return p?.hub ? treeParent.get(p) : p;
		};
		// A row of the card's facts: what it says, and the things it names.
		// A span of days as it is said: days, weeks, months or years.
		const lasting = ([least, most]: [number, number]) => {
			const [per, unit] = most < 14 ? [1, 'days'] : most < 90 ? [7, 'weeks'] : most < 730 ? [30, 'months'] : [365, 'years'];
			const a = Math.round(least / per);
			const b = Math.round(most / per);
			return a === b ? `${a} ${unit}` : `${a}–${b} ${unit}`;
		};
		const fact = (term: string, ...parts: (Node | string | Node[])[]) => {
			const row = el('div', 'milk-about-fact');
			row.append(el('dt', '', term));
			const dd = el('dd');
			for (const part of parts) {
				if (typeof part === 'string') dd.append(part);
				else if (Array.isArray(part))
					part.forEach((k, i) => {
						if (i) dd.append(', ');
						dd.append(to(k));
					});
				else dd.append(to(part));
			}
			row.append(dd);
			return row;
		};
		const tell = (n: Node | null) => {
			held = n;
			look(n);
			card.classList.toggle('is-open', !!n);
			card.inert = !n;
			if (!n) return;
			card.setAttribute('aria-label', name(n));
			const top = el('header');
			if (n.image) {
				const img = el('img');
				img.src = n.image.src;
				img.alt = '';
				top.append(img);
			}
			const title = el('div');
			const p = parentOf(n);
			if (n.onMap) {
				const where = (n.regions ?? []).map((c) => countryName.of(c));
				if (n.area) where[0] = `${n.area}, ${where[0]}`;
				const place = where.join('; ') + (n.guessed ? ' (place estimated)' : '');
				title.append(el('p', 'milk-about-kind', n.family ? `${n.family} · ${place}` : place));
			}
			else if (n.example && p) {
				const kind = el('p', 'milk-about-kind', 'Example of ');
				kind.append(to(p));
				title.append(kind);
			}
			title.append(el('h3', '', name(n)));
			if (n.aka?.length) title.append(el('p', 'milk-about-aka', `Also known as ${n.aka.join(', ')}`));
			if (n.share !== undefined) {
				const pct = n.share >= 1 ? `${Math.round(n.share)}%` : n.share >= 0.1 ? `${n.share.toFixed(1)}%` : 'under 0.1%';
				const mt = n.shareMt! >= 1 ? `${Math.round(n.shareMt!)} Mt` : `${+(n.shareMt! * 1000).toPrecision(2)} thousand t`;
				title.append(el('p', 'milk-about-aka', `About ${mt} a year, ${pct} of the world’s milk by weight: an estimate. ${n.shareSources?.text ?? ''}`), sourcesOf(n.shareSources!));
			}
			top.append(title);
			top.classList.toggle('has-image', !!n.image);
			const parts: HTMLElement[] = [top];
			if (n.about) {
				parts.push(el('p', 'milk-about-text', n.about.text));
				parts.push(sourcesOf(n.about.sources));
			}
			/* A cheese in a panel has no arrow to write its table on: told here
			   instead, after where the panel puts it, with the rest of how it is
			   made and where that is from. */
			if ((n.axes && panelOf(n)) || n.onMap) {
				const how = n.how;
				const made = el('dl');
				if (n.axes) made.append(fact('Firmness', n.axes.firm), fact('Ripened', lasting(n.axes.days)));
				for (const { k, v } of [...(how?.table ?? []), ...(how?.facts ?? [])]) made.append(fact(k, v.split('\n').join(', ')));
				parts.push(made);
				if (how?.text) parts.push(el('p', 'milk-about-text', how.text));
				if (how?.sources) parts.push(sourcesOf(how.sources));
			}
			// What it is made from and into the picture shows
			// round it already; the card says only what the picture does not.
			const facts = el('dl');
			if (n.named?.length) {
				const drawn = new Map([...(children.get(n) ?? []), ...(paneled.get(n) ?? [])].filter((k) => k.example).map((k) => [k.label, k]));
				const row = fact('Examples');
				const dd = row.querySelector('dd')!;
				n.named.forEach((x, i) => {
					if (i) dd.append(', ');
					const k = drawn.get(x);
					dd.append(k ? to(k) : x);
				});
				facts.append(row);
			}
			if (facts.childElementCount) parts.push(facts);
			if (n.image) {
				const credit = el('p', 'milk-about-credit', 'Photo: ');
				const a = el('a', '', n.image.author);
				a.href = n.image.source;
				a.target = '_blank';
				a.rel = 'noopener';
				credit.append(a, `, ${n.image.license}`);
				parts.push(credit);
			}
			cardBody.replaceChildren(...parts);
			cardBody.scrollTop = 0;
		};
		/* Telling of a step, the arrow into a product: what it is made from
		   and how, the facts of it, and where they come from. */
		// The card shut, and the step held with it let go of.
		const shut = () => {
			tell(null);
			heldStep = null;
			showStep(null);
		};
		const tellStep = (n: Node) => {
			const p = treeParent.get(n)!;
			tell(null);
			held = n;
			look(n);
			heldStep = n;
			showStep(n);
			card.classList.add('is-open');
			card.inert = false;
			card.setAttribute('aria-label', n.step ?? name(n));
			const top = el('header');
			const title = el('div');
			const kind = el('p', 'milk-about-kind');
			kind.append(to(p.hub ? treeParent.get(p)! : p), ' → ');
			// A branch point has no name: what its arrow leads to, then.
			const into = n.hub ? (children.get(n) ?? []).filter((k) => !k.hub && !k.example) : [n];
			into.forEach((k, i) => kind.append(...(i ? [', '] : []), to(k)));
			// Under a ruler, its value along it.
			title.append(kind, el('h3', '', n.step ?? (p.scale && n.at != null ? `${n.at} ${p.scale.unit} ${p.scale.name}` : '')));
			top.append(title);
			const parts: HTMLElement[] = [top];
			const how = n.how;
			if (how?.text) parts.push(el('p', 'milk-about-text', how.text));
			const facts = el('dl');
			for (const { k, v } of how?.facts ?? []) facts.append(fact(k, v));
			if (facts.childElementCount) parts.push(facts);
			if (how?.sources) parts.push(sourcesOf(how.sources));
			cardBody.replaceChildren(...parts);
			cardBody.scrollTop = 0;
		};
		card.querySelector('.milk-about-close')!.addEventListener('click', shut, { signal });
		// A product named in the words beside it, pressed (see MilkLink).
		document.addEventListener(
			'milk:go',
			(e) => {
				const to = (e as CustomEvent<string>).detail;
				const n = nodes.find((n) => (n.example ? n.label === to : n.id === to));
				if (n) go(n, true);
				else console.warn(`MilkGraph: no product or drawn example ${to}`);
			},
			{ signal },
		);
		document.addEventListener('keydown', (e) => e.key === 'Escape' && held && e.target !== field && shut(), { signal });

		/* Focused on a product and everything made from it: framed, with a
		   margin, in what the pane has, and the product held looked at. */
		const focusOn = (id: string | null, glide: boolean) => {
			const n = id ? nodes.find((n) => n.id === id) : null;
			if (id && !n) console.warn(`MilkGraph: no product ${id} to focus on`);
			if (!n) {
				held = null;
				look(null);
				surface.transition().duration(glide ? 750 : 0).call(zoomer.transform, zoomIdentity);
				return;
			}
			const family = new Set([n]);
			for (let grew = true; grew; ) {
				grew = false;
				for (const e of edges)
					if (family.has(e.source) && !family.has(e.target)) {
						family.add(e.target);
						grew = true;
					}
			}
			held = n;
			look(n);
			// Nothing made from it: into it alone, as a link to it goes.
			if (family.size === 1) {
				surface.transition().duration(glide ? 750 : 0).call(zoomer.transform, zoomInto(n));
				return;
			}
			const all = [...family];
			const x0 = Math.min(...all.map((d) => d.x - d.w / 2));
			const x1 = Math.max(...all.map((d) => d.x + d.w / 2));
			const y0 = Math.min(...all.map((d) => d.y - d.h / 2));
			const y1 = Math.max(...all.map((d) => d.y + d.h / 2));
			const k = Math.max(0.5, Math.min(MAX_ZOOM, (0.9 * paneW) / (fit * (x1 - x0)), (0.9 * paneH) / (fit * (y1 - y0))));
			const [px, py] = toPane((x0 + x1) / 2, (y0 + y1) / 2);
			const to = zoomIdentity.translate(paneW / 2 - k * px, paneH / 2 - k * py).scale(k);
			surface.transition().duration(glide ? 750 : 0).call(zoomer.transform, to);
		};
		/* Into a country on the map: framed round its cheeses, at least as
		   far in as they can be read. */
		// Into a pin's cheeses: those of its country in its regions, or with none known if it stands for those.
		const intoCountry = (pin: Pin) => {
			const mine = [...paneled.values()].flat().filter((k) => k.onMap && k.place === pin.iso && pin.areas.includes(k.area));
			if (!mine.length) return;
			const x0 = Math.min(...mine.map((d) => d.x - d.w / 2));
			const x1 = Math.max(...mine.map((d) => d.x + d.w / 2));
			const y0 = Math.min(...mine.map((d) => d.y - d.h / 2));
			const y1 = Math.max(...mine.map((d) => d.y + d.h / 2));
			const read = 5 / (FONT * MAP_PILL * fit);
			const k = Math.min(MAX_ZOOM, Math.max(read, Math.min((0.9 * paneW) / (fit * (x1 - x0)), (0.9 * paneH) / (fit * (y1 - y0)))));
			const [px, py] = toPane((x0 + x1) / 2, (y0 + y1) / 2);
			surface.transition().duration(750).call(zoomer.transform, zoomIdentity.translate(paneW / 2 - k * px, paneH / 2 - k * py).scale(k));
		};
		if (figure.dataset.focus && !whole) focusOn(figure.dataset.focus, false);
		const host = figure.closest<HTMLElement>('[data-viz-phase]') ?? figure.closest<HTMLElement>('[data-viz-stage]');
		host?.addEventListener(
			'viz:props',
			(e) => {
				const p = (e as CustomEvent).detail ?? {};
				if ('focus' in p) focusOn(typeof p.focus === 'string' ? p.focus : null, true);
			},
			{ signal },
		);

	}

	eachPage((signal) => {
		for (const figure of document.querySelectorAll<HTMLElement>('[data-milk-graph]')) {
			const phase = figure.closest<HTMLElement>('[data-viz-phase]');
			const host = phase ?? figure.closest<HTMLElement>('[data-viz-stage]');
			/* What a card has asked it to focus on before it is drawn, kept for
			   it to open on (see focusOn). */
			host?.addEventListener(
				'viz:props',
				(e) => {
					const p = (e as CustomEvent).detail ?? {};
					if ('focus' in p) figure.dataset.focus = typeof p.focus === 'string' ? p.focus : '';
				},
				{ signal },
			);
			/* Laid out to the pane's shape, so not before the pane has one, nor
			   while its phase is out of sight: there it is not laid out (see
			   VizPhase), and would be measured wrong. Drawn when it is first shown. */
			let started = false;
			const start = () => {
				if (started) return true;
				if (phase && phase.dataset.vizActive !== 'true') return false;
				const { width, height } = figure.getBoundingClientRect();
				if (!width || !height) return false;
				started = true;
				// Once its font is in, as its words are measured on a canvas (see measure).
				Promise.all(FACES.map((face) => document.fonts.load(`${face} 13px ${SANS()}`))).then(() => {
					if (signal.aborted) return;
					const data = JSON.parse(figure.dataset.milkGraph!) as Graph;
					/* Drawn again from scratch when an animal is pressed, the
					   drawing before let go of. */
					let drawing = new AbortController();
					signal.addEventListener('abort', () => drawing.abort());
					draw(figure, AbortSignal.any([signal, drawing.signal]), data);
					// Under the search, wherever that is (see draw).
					const search = figure.querySelector('.milk-search') ?? document.querySelector('[data-deck-tools] .milk-search');
					const chips = [...(search?.querySelectorAll<HTMLButtonElement>('.milk-beasts button') ?? [])];
					for (const chip of chips)
						chip.addEventListener(
							'click',
							() => {
								chip.setAttribute('aria-pressed', String(chip.getAttribute('aria-pressed') !== 'true'));
								const milks = new Set(chips.filter((c) => c.getAttribute('aria-pressed') === 'true').map((c) => c.dataset.milk!));
								drawing.abort();
								drawing = new AbortController();
								draw(figure, AbortSignal.any([signal, drawing.signal]), only(data, milks), milks.size > 0);
							},
							{ signal },
						);
				});
				return true;
			};
			// A frame on, once the deck has said which phase is shown.
			requestAnimationFrame(() => {
				if (signal.aborted || start()) return;
				const watch = new ResizeObserver(() => start() && watch.disconnect());
				watch.observe(figure);
				phase?.addEventListener('viz:enter', () => start() && watch.disconnect(), { signal });
				signal.addEventListener('abort', () => watch.disconnect());
			});
		}
	});
</script>
