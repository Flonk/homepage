		author: 'Biswarup Ganguly',
		license: 'CC BY 3.0',
		source: 'https://commons.wikimedia.org/wiki/File:Pera_-_Sweet_-_Banke_Bihari_Mandir_Area_-_Vrindavan_-_2013-02-22_4784.JPG',
	},
	dulce: {
