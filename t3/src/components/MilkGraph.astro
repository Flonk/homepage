for (const [key, a] of [...Object.entries(about.products), ...Object.entries(about.examples)])
	if (!sourced(a)) console.warn(`MilkGraph: no source for what is said about ${key}`);
for (const name of Object.keys(about.examples)) if (!named.has(name)) throw new Error(`MilkGraph: about for unknown example ${name}`);

