		name: 'Fermented',
		hub: 'ferment',
		ids: ['soured', 'dickmilch', 'filmjolk', 'dahi', 'ymer', 'ymerWhey', 'cultureButtermilk', 'piima', 'ropy', 'ryazhenka', 'kefir', 'mildYoghurt', 'probioticYoghurt', 'probioticDrink', 'yoghurt', 'mishtiDoi', 'creamYoghurt', 'heatTreatedYoghurt', 'shanklish', 'zhentytsia', 'greek', 'greekWhey', 'ayran', 'fermButter', 'fermButtermilk', 'driedYoghurt', 'kishk', 'qaraqurut', 'dadiah', 'mursik', 'choormog', 'milletMilk', 'calpis'],
	},
	{ name: 'Alcohol', hub: 'make alcohol', ids: ['kumis', 'arkhi', 'arkhiGrades', 'stillCheese', 'blaand', 'wheyVodka', 'creamLiqueur'] },
	{
		name: 'Acid & heat-set',
		hub: 'set with acid',
		ids: ['curd', 'quark', 'cottageCheese', 'creamCheese', 'skyr', 'skyrWhey', 'sourMilkCheese', 'cookedCheese', 'mish', 'byaslag', 'eezgii', 'rushan', 'chhena', 'chhenaWhey', 'paneer', 'chhenaSweets', 'sweetCurd', 'cheesecake', 'plantCheese', 'buttermilkCheese', 'hardChhurpi'],
	},
	{
		name: 'Cheese',
		ids: ['rennetCurd', 'freshCheese', 'lacticCheese', 'soft', 'semiHard', 'hard', 'bloomy', 'blue', 'washed', 'alpine', 'cheddared', 'washedCurd', 'insect', 'tulum', 'processed', 'cheesePowder', 'grilling', 'pastaFilata', 'stracciatella', 'lumpCheese', 'steamedCheese', 'bryndza', 'sunDriedCheese', 'brined'],
	},
	{
		name: 'Whey',
		ids: ['sweetWhey', 'acidWhey', 'wheyCream', 'wheyButter', 'wheyCheese', 'prim', 'ricotta', 'wheyPowder', 'wpc', 'wpi', 'permeate', 'delactosedPermeate', 'demineralisedWhey', 'heatWheyProtein', 'microparticulatedWhey', 'milkSerumDrink', 'nativeWhey'],
	},
	{
		name: 'Sugars & proteins',
		hub: 'fractionate',
		ids: ['lactose', 'lactoseDerivatives', 'lactitol', 'lactobionicAcid', 'tagatose', 'milkMinerals', 'alphaLactalbumin', 'betaLactoglobulin', 'acidCasein', 'acidCaseinWhey', 'rennetCasein', 'caseinWhey', 'caseinate', 'lactoferrin', 'mpc', 'milkPermeate', 'mcc', 'mfgm'],
	},
	{ name: 'Materials', hub: 'make materials', ids: ['caseinGlue', 'beerLabelGlue', 'caseinPaint', 'galalith', 'lanital', 'blotto', 'wineFiningCasein', 'butterSculpture', 'litmusMilk', 'skimMilkAgar', 'milkSpray', 'caseinCoating'] },
	{
		name: 'Medicine',
		ids: ['lactulose', 'inhalers', 'glycomacropeptide', 'caseinHydrolysate', 'wheyHydrolysate', 'cppAcp', 'milkDrugs', 'travelan', 'lactotripeptide', 'lactoperoxidase', 'tabletLactose', 'donorMilk', 'ghrita'],
	},
	{ name: 'Colostrum', ids: ['colostrum', 'colostrumPudding', 'colostrumPowder'] },
];

// A product in no family, or in two, or a family naming one that is gone, is
// a mistake in the lists above: said at build time, not drawn wrong.
const groupOf = new Map<string, number>();
GROUPS.forEach(({ ids }, g) =>
	ids.forEach((id) => {
		if (!(id in NODES)) throw new Error(`MilkGraph: group ${GROUPS[g].name} names unknown ${id}`);
		if (groupOf.has(id)) throw new Error(`MilkGraph: ${id} is in two groups`);
		groupOf.set(id, g);
	}),
);
for (const id of Object.keys(NODES))
	if (id !== 'raw' && !groupOf.has(id)) throw new Error(`MilkGraph: ${id} is in no group`);

/**
 * Products made together by one step, from one parent: the step drawn as
 * one arrow out of the parent, split into each of them, its own words on
 * each part. Separating milk makes the cream and the skimmed milk at once,
 * not one and then the other, as churning cream makes the butter and the
 * liquid it leaves.
 */
/**
 * Kinds of one family's step: those of a family made by one kind of it
 * drawn as one branch off the family's hub, the kind's name on it, before
 * each splits off with its own step. Fermented milks by what ferments them
 * and how warm, after Robinson and Tamime: lactococci at room temperature,
 * yoghurt's bacteria warm. (Kefir, with yeasts besides, is alone in its kind
 * here, so its own step says so.) `how` is told of when the kind's arrow is
 * clicked, as a product's step is (see milk-steps.json).
 */
const KINDS: { step: string; ids: string[]; how: How }[] = [
	{
		step: 'mesophilic, 20–30 °C',
		ids: ['soured', 'dickmilch', 'filmjolk', 'dahi', 'ymer', 'cultureButtermilk', 'piima', 'ropy'],
		how: {
			facts: [
				{ k: 'Bacteria', v: 'Lactococcus lactis and its subspecies, often with Leuconostoc' },
				{ k: 'Temperature', v: '20–30 °C, room temperature' },
				{ k: 'Time', v: 'Most of a day, about 15–24 h' },
				{ k: 'Made', v: 'Soured milks, ropy milks, cultured buttermilk, sour cream' },
			],
			text: 'Lactococci grow best at room temperature, so they sour milk slowly and gently, into a soft set curd with a fresh, often buttery aroma. Where it is cool, as in northern Europe, milk left to stand sours this way, and the fermented milks there are mostly of this kind.',
			sources: [{ name: 'Bintsis & Papademas 2022, Fermentation 8:679', url: 'https://doi.org/10.3390/fermentation8120679' }, { name: 'Tetra Pak Dairy Processing Handbook, ch. 13 Fermented milk products', url: 'https://dairyprocessinghandbook.tetrapak.com/chapter/fermented-milk-products' }],
		},
	},
	{
		step: 'thermophilic, 40–45 °C',
		ids: ['yoghurt', 'mildYoghurt', 'probioticYoghurt', 'creamYoghurt', 'heatTreatedYoghurt'],
		how: {
			facts: [
				{ k: 'Bacteria', v: 'Streptococcus thermophilus with a Lactobacillus, in yoghurt L. bulgaricus' },
				{ k: 'Temperature', v: '40–45 °C' },
				{ k: 'Time', v: 'A few hours, about 3–5 h' },
				{ k: 'Made', v: 'Yoghurt, cream yoghurt, and yoghurts with other lactobacilli besides or instead' },
			],
			text: 'These bacteria grow best warm, so they sour milk fast and sharply, into a firmer gel. Where it is hot, from the Balkans and the Middle East to Central Asia, milk kept warm sours this way, and the fermented milks there are mostly of this kind.',
			sources: [{ name: 'Bintsis & Papademas 2022, Fermentation 8:679', url: 'https://doi.org/10.3390/fermentation8120679' }, { name: 'Tetra Pak Dairy Processing Handbook, ch. 13 Fermented milk products', url: 'https://dairyprocessinghandbook.tetrapak.com/chapter/fermented-milk-products' }, { name: 'Codex Standard for Fermented Milks (CXS 243-2003)', url: 'https://www.fao.org/input/download/standards/400/CXS_243e.pdf' }],
		},
	},
];
for (const [k, { ids }] of KINDS.entries())
	for (const id of ids) {
		if (!(id in NODES)) throw new Error(`MilkGraph: kind ${KINDS[k].step} names unknown ${id}`);
		if (KINDS.some((o, j) => j !== k && o.ids.includes(id))) throw new Error(`MilkGraph: ${id} is of two kinds`);
	}

const SPLITS: { from: string; step: string; ids: string[] }[] = [
	{ from: 'raw', step: 'separate', ids: ['rawCream', 'skimRaw'] },
	{ from: 'cream', step: 'churn', ids: ['butter', 'churn'] },
	{ from: 'cream', step: 'cook with flour, stir', ids: ['staka', 'stakovoutiro'] },
	{ from: 'butter', step: 'simmer until brown', ids: ['butterfat', 'gheeResidue'] },
	{ from: 'soured', step: 'churn', ids: ['fermButter', 'fermButtermilk'] },
	{ from: 'skimmed', step: 'set with rennet', ids: ['rennetCasein', 'caseinWhey'] },
	{ from: 'raw', step: 'set with rennet', ids: ['rennetCurd', 'sweetWhey'] },
	{ from: 'sweetWhey', step: 'ultrafilter', ids: ['wpc', 'permeate'] },
	{ from: 'permeate', step: 'crystallise', ids: ['lactose', 'delactosedPermeate'] },
	{ from: 'skimmed', step: 'ultrafilter', ids: ['mpc', 'milkPermeate'] },
	{ from: 'skimmed', step: 'microfilter', ids: ['mcc', 'nativeWhey'] },
	{ from: 'skimmed', step: 'ferment, drain', ids: ['ymer', 'ymerWhey'] },
	{ from: 'yoghurt', step: 'strain', ids: ['greek', 'greekWhey'] },
	{ from: 'curd', step: 'drain', ids: ['quark', 'acidWhey'] },
	{ from: 'curd', step: 'strain', ids: ['skyr', 'skyrWhey'] },
	{ from: 'pasteurised', step: 'curdle hot with acid', ids: ['chhena', 'chhenaWhey'] },
	{ from: 'skimmed', step: 'precipitate with acid', ids: ['acidCasein', 'acidCaseinWhey'] },
	{ from: 'cream', step: 'culture, ripen, churn', ids: ['culturedButter', 'culturedButtermilk'] },
	{ from: 'soured', step: 'distil', ids: ['arkhi', 'stillCheese'] },
];
for (const { from, ids } of SPLITS)
	for (const id of ids) if (NODES[id]?.from !== from) throw new Error(`MilkGraph: ${id} is split off ${from} but not made from it`);

/**
 * How close a product is to milk: the steps of making it, but a step that
 * only treats milk (heating it, homogenising it, skimming it, separating its
 * cream off) counts for less than one that turns it into something else. So
 * pasteurised milk sits nearer than yoghurt, and yoghurt nearer than the
 * cheese made from its curd. These are the products made by such a step; an
 * arrow into one of them is a light one.
 */
const TREATED = new Set([
	'certified', 'homogenised', 'pasteurised', 'fresh', 'esl', 'uht', 'sterilised',
	'skimRaw', 'semi', 'semiUht', 'skimmed', 'rawCream', 'cream',
]);
// What a light step counts for, against 1 for any other.
const LIGHT = 0.4;

/**
 * How much a product matters to how people eat and live, as a second pull
 * on how far out it sits: the everyday staples in close, the well known a
 * little further, and everything else, the regional and the curious, out
 * past them. A product in neither list is niche.
 */
const STAPLE = new Set([
	'pasteurised', 'homogenised', 'fresh', 'uht', 'semi', 'skimmed', 'milkPowder', 'skimmedPowder', 'evaporated', 'condensed',
	'rawCream', 'cream', 'whipping', 'culturedCream', 'sourCream', 'butter', 'butterfat', 'buttermilk',
	'soured', 'yoghurt', 'greek', 'kefir', 'iceCream',
	'curd', 'quark', 'paneer', 'rennetCurd', 'freshCheese', 'soft', 'semiHard', 'hard', 'pastaFilata', 'processed',
	'sweetWhey', 'wheyPowder', 'wpc', 'lactose',
]);
const KNOWN = new Set([
	'lacticCheese',
	'certified', 'esl', 'sterilised', 'colostrum', 'lactoseFree',
	'coffeeCream', 'double', 'clotted', 'saureSahne', 'schmand', 'cremeFraiche', 'mascarpone',
	'culturedButter', 'clarified', 'amf',
	'filmjolk', 'mildYoghurt', 'probioticYoghurt', 'probioticDrink', 'creamYoghurt', 'skyr', 'ayran', 'driedYoghurt', 'ryazhenka', 'fermButter', 'fermButtermilk', 'choormog', 'kumis',
	'chhena', 'chhenaSweets', 'cottageCheese', 'creamCheese', 'khoa', 'khoaSweets', 'dulce', 'kulfi', 'rabri', 'custard', 'milkChocolate',
	'bloomy', 'blue', 'washed', 'alpine', 'cheddared', 'washedCurd', 'brined', 'grilling', 'stracciatella',
	'acidWhey', 'ricotta', 'wheyCheese', 'wpi', 'acidCasein', 'caseinate',
	'lactulose', 'inhalers',
]);
for (const id of [...STAPLE, ...KNOWN])
	if (!(id in NODES)) throw new Error(`MilkGraph: significance names unknown ${id}`);

// Every parent named must be a product, and no product its own ancestor.
for (const [id, { from, alsoFrom = [] }] of Object.entries(NODES)) {
	// Under a ruler the arrow in has its value, not a step.
	const ruled = from !== undefined && !!NODES[from]?.scale;
	if (from !== undefined && !ruled && !NODES[id].step) throw new Error(`MilkGraph: ${id} has no step`);
	if (ruled !== (NODES[id].at !== undefined)) throw new Error(`MilkGraph: ${id} must have a value on a ruler if and only if it hangs from one`);
	/* Two at one value share its arrow; two nearly at one would hang one's
	   arrow down beside the other's. */
	const gap = (n: Product) => Math.abs(n.at! - NODES[id].at!);
	if (ruled && Object.entries(NODES).some(([o, n]) => o !== id && n.from === from && gap(n) > 0 && gap(n) < 1))
		throw new Error(`MilkGraph: ${id} is too near another on its ruler`);
	const { link } = NODES[id];
	if (link !== undefined && (!(link in NODES) || NODES[link].link)) throw new Error(`MilkGraph: ${id} links to ${link}, which is not a product`);
	for (const p of [from, ...alsoFrom])
		if (p !== undefined && !(p in NODES)) throw new Error(`MilkGraph: ${id} is made from unknown ${p}`);
	for (let at = from, seen = new Set([id]); at !== undefined; at = NODES[at].from) {
		if (seen.has(at)) throw new Error(`MilkGraph: ${id} is made from itself`);
		seen.add(at);
	}
}

/**
 * A product's `examples`, drawn as leaves under it: the first SHOWN of
 * them by name, then a last “…” for the many more. An example is not made from its
 * product, so its line has no step written on it and no arrowhead, and it
 * takes its product's family. (`aka` is the same product under other
 * names, and is not drawn.)
 */
// Every one of them, for now: the more the better. A number here draws that many and a “…” for the rest.
const SHOWN = Infinity;
// What is known of an example, or a cheese on the map, by its name.
const factsOf = (label: string) => ({
		image: EXAMPLE_IMAGES[label] && pictured(exampleFile(label), EXAMPLE_IMAGES[label]),
		about: about.examples[label] ?? (CHEESE[label] && cheeseAbout(CHEESE[label])),
		regions: regions[label] ?? (CHEESE[label]?.countries.length ? CHEESE[label].countries.slice(0, 4) : undefined),
		aka: EXAMPLE_AKA[label],
		note: EXAMPLE_NOTES[label],
		beasts: beastsOf(label) ?? (CHEESE[label] && CHEESE[label].milk.join() !== 'cow' && CHEESE[label].milk.length ? CHEESE[label].milk.map((m) => BEASTS[m as keyof typeof BEASTS]).filter(Boolean) : undefined),
		axes: EXAMPLE_AXES[label] ?? (CHEESE[label]?.firm && CHEESE[label].days ? { firm: CHEESE[label].firm!, days: CHEESE[label].days! } : undefined),
		protected: CHEESE[label]?.protected,
		unsure: UNSURE.has(label) ? UNSURE_SAID : undefined,
		step: steps[label]?.label,
		how: steps[label] ?? (CHEESE[label] && cheeseHow(CHEESE[label])),
});
const examples = Object.entries(NODES).flatMap(([kind, { examples: names = [] }]) =>
	(names.length > SHOWN ? [...names.slice(0, SHOWN), '…'] : names).map((label, i, all) => ({
		id: `${kind}:${i}`,
		label,
		kind,
		example: true,
		more: i === all.length - 1,
		rank: i,
		group: groupOf.get(kind) ?? -1,
		niche: 2,
		...factsOf(label),
	})),
);
/* The map's cheeses (see WORLD): each where it is made, the first of its
   countries; one with none known is left off. No step on its line, which
   is not drawn: the map is under rennet curd, as the panels are under
   their families. */
const atlas = WORLD.map((label) => ({ label, ...factsOf(label) }))
	.filter((x) => x.regions?.length)
	.map((x, i) => ({ ...x, id: `atlas:${i}`, kind: 'rennetCurd', example: true, onMap: true, place: x.regions![0], rank: i, group: groupOf.get('rennetCurd') ?? -1, niche: 2, step: undefined }));

interface Props {
	/** A product to open on, with everything made from it, framed and lit. */
	focus?: string;
}

const { focus } = Astro.props;

const graph = {
	light: LIGHT,
	groups: GROUPS.map(({ name, hub }) => ({ name, hub: hub ?? null })),
	splits: SPLITS,
	kinds: KINDS,
	nodes: Object.entries(NODES).map(([id, { label, step, scale, at, panel, map, below, link, note, aka = [], examples: named = [] }]) => ({
		id,
		label,
		// Not drawn, but found by the search: its other names, and its
		// examples past the ones drawn.
		aka,
		unshown: named.slice(SHOWN),
		image: IMAGES[link ?? id] && pictured(link ?? id, IMAGES[link ?? id]),
		about: about.products[link ?? id],
		regions: regions[link ?? id],
		how: steps[id],
		// All its examples, for the card that tells of it.
		named,
		step,
		scale,
		at,
		panel,
		map,
		below,
		link,
		note,
		beasts: beastsOf(link ?? id),
		group: groupOf.get(id) ?? -1,
		// 0 a staple, 1 well known, 2 niche.
		niche: STAPLE.has(id) ? 0 : KNOWN.has(id) ? 1 : 2,
	}))
		.concat(examples.map(({ kind, ...example }) => example) as any)
		.concat(atlas.map(({ kind, ...cheese }) => cheese) as any),
	links: Object.entries(NODES)
		.filter(([, { from }]) => from !== undefined)
		.map(([target, { from }]) => ({ source: from!, target, weight: TREATED.has(target) ? LIGHT : 1 }))
		.concat(examples.map(({ id, kind }) => ({ source: kind, target: id, weight: 1 })))
		.concat(atlas.map(({ id, kind }) => ({ source: kind, target: id, weight: 1 }))),
	// The world's outline, for the map under rennet curd (see milk-map.json).
	map: MAP,
};
---

<figure class="milk-graph" data-milk-graph={JSON.stringify(graph)} data-focus={focus}>
	<div class="milk-search" data-no-swipe data-deck-tool>
		<svg class="milk-search-icon" viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="6.75" cy="6.75" r="4.75"></circle>
			<path d="M10.25 10.25L14 14"></path>
		</svg>
		<input
			type="search"
			role="combobox"
			placeholder="Search in Diagram…"
			aria-label="Search in the diagram"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			spellcheck="false"
		/>
		<div class="milk-beasts" role="group" aria-label="Only what is made from the milk of">
			{
				herd.map(({ mark, milk }) => (
					<button type="button" aria-pressed="false" data-milk={milk} title={`${milk[0].toUpperCase()}${milk.slice(1)} milk`}>
						{mark}
					</button>
				))
			}
		</div>
		<ul role="listbox" hidden></ul>
	</div>
	<div class="milk-note" role="tooltip" hidden></div>
	<canvas class="milk-canvas" role="img" aria-label="Milk products and how each is made from another" data-no-swipe></canvas>
	<aside class="milk-about" data-no-swipe inert>
		<button type="button" class="milk-about-close" aria-label="Close">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4L12 12M12 4L4 12"></path></svg>
		</button>
		<div class="milk-about-body"></div>
	</aside>
</figure>

<style>
	.milk-graph {
		/* Wider than a picture is let be (see DeckViz): it is a whole map. */
		--viz-max: 80rem;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		position: relative;
	}

	/* The search: a small field in the top left, over the picture, and what
	   it finds in a list under it; as the pills are on a light ground, on
	   glass on a dark one. */
	.milk-search {
		--field: var(--pill);
		--field-rim: var(--pill-rim);
		--found: var(--pill);
		--found-on: color-mix(in oklab, var(--deck-ground), white 30%);
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 2;
		width: min(16rem, calc(100% - 1.5rem));
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	/* A magnifying glass at the field's left, in the words' quieter ink. */
	.milk-search-icon {
		position: absolute;
		top: calc(0.6em + 2px);
		left: 0.65em;
		width: 1.1em;
		height: 1.1em;
		fill: none;
		stroke: var(--deck-ink-dim);
		stroke-width: 1.6;
		stroke-linecap: round;
		pointer-events: none;
		/* Over the field, whose glass is a layer of its own. */
		z-index: 1;
	}
	.milk-search input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.45em 0.7em 0.45em 2.1em;
		font: inherit;
		color: var(--deck-ink);
		background: var(--field);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
		backdrop-filter: blur(8px);
		outline: none;
	}
	.milk-search input:focus {
		border-color: var(--flb);
	}
	/* The animals, a row of them under the field: pressed, the tree shows
	   only what is made from their milk; the rest faded while any is. */
	.milk-beasts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.35rem;
	}
	.milk-beasts button {
		padding: 0.1em 0.25em;
		font-size: 0.95rem;
		line-height: 1.2;
		background: var(--field);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
		backdrop-filter: blur(8px);
		cursor: pointer;
	}
	.milk-beasts button[aria-pressed='true'] {
		border-color: var(--deck-ink);
		box-shadow: inset 0 0 0 1px var(--deck-ink);
	}
	.milk-beasts:has([aria-pressed='true']) button[aria-pressed='false'] {
		opacity: 0.45;
	}
	.milk-search ul {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0.25rem 0;
		max-height: 16rem;
		overflow-y: auto;
		background: var(--found);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
	}
	:global(.deck-dark) .milk-search {
		--field: var(--viz-glass);
		--field-rim: var(--viz-glass-rim);
		--found: var(--ground-300);
		--found-on: var(--ground-400);
	}
	/* Written by the script as it finds things, so out of the scoping. */
	.milk-search :global(li) {
		padding: 0.4em 0.7em;
		color: var(--deck-ink);
		cursor: pointer;
	}
	.milk-search :global(li small) {
		display: block;
		color: var(--deck-ink-dim);
		font-size: 0.85em;
	}
	.milk-search :global(li[aria-selected='true']) {
		background: var(--found-on);
		color: var(--lit);
	}
	/* The graph's own colours, by the ground it is on (the post's `ground`).
	   On the light one, the pills stand out of it a little whiter, edged in
	   a faint dark line, and the arrows are darker than the pills, the ink
	   they are drawn in; a lit arrow is the ink itself. On the dark one, the
	   pills are a rung up the ground's ladder, edged in the FLB, and a lit
	   arrow is the accent. */
	.milk-graph {
		--pill: color-mix(in oklab, var(--deck-ground), white 70%);
		--pill-rim: rgb(0 0 0 / 0.14);
		--line: color-mix(in oklab, var(--deck-ink-dim) 70%, var(--deck-ground));
		--lit: var(--deck-ink);
	}
	:global(.deck-dark) .milk-graph {
		--pill: var(--ground-300);
		--pill-rim: var(--flb);
		--line: color-mix(in oklab, var(--deck-ink-dim) 55%, var(--deck-ground));
		--lit: var(--ink-accent);
	}

	/* The card telling of what was clicked: a panel on the pills' own white,
	   slid in over the left of the picture, edge to edge, top to bottom; most
	   of the pane where it is too narrow for the card and the picture side
	   by side (below). */
	.milk-graph {
		container-type: inline-size;
	}
	/* A remark, under its mark and centred on it: small, as a footnote is. */
	.milk-note {
		position: absolute;
		z-index: 2;
		transform: translateX(-50%);
		margin-top: 0.3rem;
		padding: 0.25rem 0.55rem;
		max-width: 16rem;
		color: var(--deck-ink);
		background: var(--pill);
		border: 1px solid var(--pill-rim);
		border-radius: var(--radius-medium);
