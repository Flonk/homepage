// What an example goes by besides, as a product's `aka`: found by the search and said on its card.
const EXAMPLE_AKA: Record<string, string[]> = {
	'Parmigiano Reggiano': ['Parmesan', 'Parmigiano'],
	'Jameed': ['Jameed balls', 'جميد'],
};
for (const name of Object.keys(EXAMPLE_AKA)) if (!named.has(name)) throw new Error(`MilkGraph: other names for unknown example ${name}`);

/**
 * How a step is done, told when its arrow is clicked: the facts of it
 * (milk, set, cultures, curd, shaping, salting, ripening, rind), what they do
 * to what is made, and the sources they are from: the product's own
 * specification where it has one. Kept in milk-steps.json, by product id,
 * and by name for an example, whose arrow gets its `label` written on it.
 */
/**
 * Where a regional product or example comes from: up to four countries, as
 * ISO codes, each drawn as its flag (public/assets/flags/). Made in more
 * places than that, it is not regional, and has none. Kept in
 * milk-regions.json, by product id, and by name for an example.
 */
const regions = REGIONS as Record<string, string[]>;
for (const [key, codes] of Object.entries(regions)) {
	if (!(key in NODES) && !named.has(key)) throw new Error(`MilkGraph: region for unknown ${key}`);
	if (codes.length < 1 || codes.length > 4 || codes.some((c) => !/^[A-Z]{2}$/.test(c)))
		throw new Error(`MilkGraph: ${key} has to come from one to four countries`);
}

// `table`: the few facts written under the arrow itself, a row each.
type How = {
	label?: string;
	table?: { k: string; v: string }[];
	facts?: { k: string; v: string }[];
	text?: string;
	sources?: { name: string; url: string }[];
};
const steps = STEPS as Record<string, How>;
for (const key of Object.keys(steps))
	if (!(key in NODES) && !named.has(key)) throw new Error(`MilkGraph: how unknown ${key} is made`);
const exampleFile = (name: string) =>
	`ex-${name.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
const pictured = (file: string, { file: what, author, license, source }: Picture) => ({
	src: `/assets/milk/${file}.webp`,
	credit: `${what} · ${author} · ${license}`,
	author,
	license,
	source,
});

/**
 * What each product and each example drawn is, shown when it is clicked: the
 * first paragraph of its Wikipedia article, with a link to it, or, for the
 * ones Wikipedia has none on, a paragraph written here from the source it
 * names. Kept in milk-about.json, by product id, and by name for an example.
 */
type About = { text: string; wiki?: string; source?: string; sourceName?: string };
const sourced = (a: About) => !!a.wiki || (!!a.source && !!a.sourceName);
const about = ABOUT as { products: Record<string, About>; examples: Record<string, About> };
for (const id of Object.keys(about.products)) if (!(id in NODES)) throw new Error(`MilkGraph: about for unknown ${id}`);
for (const id of Object.keys(NODES)) if (!about.products[id]) throw new Error(`MilkGraph: nothing said about ${id}`);
for (const [key, a] of [...Object.entries(about.products), ...Object.entries(about.examples)])
	if (!sourced(a)) console.warn(`MilkGraph: no source for what is said about ${key}`);
for (const name of Object.keys(about.examples)) if (!named.has(name)) throw new Error(`MilkGraph: about for unknown example ${name}`);

/**
 * The families, each given its own slice of the circle round milk, in the
 * order milk flows through them: the milks themselves, what is skimmed off
 * them, what is boiled down, soured, distilled, curdled, and what is left of
 * the curd, out to what industry, the workshop and medicine make of that,
 * and round again to colostrum beside the milks. Every product but milk is
 * in exactly one.
 *
 * A family with a `hub` is drawn as one branch where a parent has two or
 * more of it: a single arrow out of the parent, labelled with the hub, that
 * then splits into the family, each with its own step (pasteurised milk,
 * "ferment", then soured milk, kefir, yoghurt). A family without one already
 * starts at a product of its own (cream at raw cream, cheese at rennet curd).
 */
const GROUPS: { name: string; hub?: string; ids: string[] }[] = [
	{
		name: 'Milks',
		ids: ['certified', 'homogenised', 'pasteurised', 'fresh', 'esl', 'uht', 'sterilised', 'evaporated', 'milkPowder', 'bakedMilk', 'skimRaw', 'semi', 'semiUht', 'semiEvaporated', 'skimmed', 'skimmedEvaporated', 'skimmedPowder'],
	},
	{
		name: 'Creams',
		ids: ['rawCream', 'cream', 'clotted', 'creamGrades', 'coffeeCream', 'kaffeeobers', 'cremeDeLeite', 'halfAndHalf', 'cremeLegere', 'kaffeerahm', 'singleCream', 'lightCream', 'namaKurimu', 'mediaCrema', 'pannaDaCucina', 'schlagsahne', 'schlagobers', 'cremeFluide', 'vollrahm', 'thickenedCream', 'whipping', 'heavyCream', 'cremeDouble', 'vispgradde', 'doppelrahm', 'double', 'evaporatedCream', 'culturedCream', 'saureSahne', 'graddfil', 'sauerrahm', 'saurerHalbrahm', 'smetana', 'sourCream', 'tejfol', 'schmand', 'cremeFraiche', 'mascarpone', 'posset'],
	},
	{
		name: 'Butter & fat',
		ids: ['butter', 'culturedButter', 'mildButter', 'butterfat', 'clarified', 'amf', 'smen', 'bogButter', 'nitirKibbeh', 'churn', 'buttermilk'],
	},
	{
		name: 'Cooked & sweet',
		hub: 'cook down',
		ids: ['condensed', 'dulce', 'khoa', 'khoaSweets', 'rabri', 'kulfi', 'iceCream', 'gomme', 'junket'],
	},
	{
		name: 'Fermented',
		hub: 'ferment',
		ids: ['soured', 'ropy', 'ryazhenka', 'kefir', 'mildYoghurt', 'probioticDrink', 'yoghurt', 'mishtiDoi', 'creamYoghurt', 'greek', 'ayran', 'fermButtermilk', 'driedYoghurt', 'kishk', 'qaraqurut', 'dadiah', 'mursik', 'choormog'],
	},
	{ name: 'Alcohol', hub: 'make alcohol', ids: ['kumis', 'arkhi', 'arkhiGrades', 'stillCheese', 'blaand'] },
	{
		name: 'Acid & heat-set',
		hub: 'set with acid',
		ids: ['curd', 'quark', 'skyr', 'sourMilkCheese', 'cookedCheese', 'mish', 'eezgii', 'rushan', 'chhena', 'paneer', 'chhenaSweets', 'plantCheese', 'buttermilkCheese', 'hardChhurpi'],
	},
	{
		name: 'Cheese',
		ids: ['rennetCurd', 'freshCheese', 'soft', 'semiHard', 'hard', 'bloomy', 'blue', 'washed', 'alpine', 'cheddared', 'washedCurd', 'insect', 'tulum', 'processed', 'grilling', 'pastaFilata', 'stracciatella', 'bryndza', 'brined'],
	},
	{
		name: 'Whey',
		ids: ['sweetWhey', 'acidWhey', 'wheyCream', 'wheyButter', 'wheyCheese', 'prim', 'ricotta', 'wheyPowder', 'wpc', 'wpi', 'permeate'],
	},
	{
		name: 'Sugars & proteins',
		hub: 'fractionate',
		ids: ['lactose', 'lactoseDerivatives', 'acidCasein', 'rennetCasein', 'caseinate', 'lactoferrin'],
	},
	{ name: 'Materials', hub: 'make materials', ids: ['caseinGlue', 'beerLabelGlue', 'caseinPaint', 'galalith', 'lanital', 'blotto'] },
	{
		name: 'Medicine',
		ids: ['lactulose', 'inhalers', 'glycomacropeptide', 'caseinHydrolysate', 'cppAcp', 'milkDrugs', 'travelan'],
	},
	{ name: 'Colostrum', ids: ['colostrum', 'colostrumPudding', 'colostrumPowder'] },
];

// A product in no family, or in two, or a family naming one that is gone, is
// a mistake in the lists above: said at build time, not drawn wrong.
const groupOf = new Map<string, number>();
GROUPS.forEach(({ ids }, g) =>
	ids.forEach((id) => {
		if (!(id in NODES)) throw new Error(`MilkGraph: group ${GROUPS[g].name} names unknown ${id}`);
		if (groupOf.has(id)) throw new Error(`MilkGraph: ${id} is in two groups`);
		groupOf.set(id, g);
	}),
);
for (const id of Object.keys(NODES))
	if (id !== 'raw' && !groupOf.has(id)) throw new Error(`MilkGraph: ${id} is in no group`);

/**
 * Products made together by one step, from one parent: the step drawn as
 * one arrow out of the parent, split into each of them, its own words on
 * each part. Separating milk makes the cream and the skimmed milk at once,
 * not one and then the other, as churning cream makes the butter and the
 * liquid it leaves.
 */
const SPLITS: { from: string; step: string; ids: string[] }[] = [
	{ from: 'raw', step: 'separate', ids: ['rawCream', 'skimRaw'] },
	{ from: 'cream', step: 'churn', ids: ['butter', 'churn'] },
];
for (const { from, ids } of SPLITS)
	for (const id of ids) if (NODES[id]?.from !== from) throw new Error(`MilkGraph: ${id} is split off ${from} but not made from it`);

/**
 * How close a product is to milk: the steps of making it, but a step that
 * only treats milk (heating it, homogenising it, skimming it, separating its
 * cream off) counts for less than one that turns it into something else. So
 * pasteurised milk sits nearer than yoghurt, and yoghurt nearer than the
 * cheese made from its curd. These are the products made by such a step; an
 * arrow into one of them is a light one.
 */
const TREATED = new Set([
	'certified', 'homogenised', 'pasteurised', 'fresh', 'esl', 'uht', 'sterilised',
	'skimRaw', 'semi', 'semiUht', 'skimmed', 'rawCream', 'cream',
]);
// What a light step counts for, against 1 for any other.
const LIGHT = 0.4;

/**
 * How much a product matters to how people eat and live, as a second pull
 * on how far out it sits: the everyday staples in close, the well known a
 * little further, and everything else, the regional and the curious, out
 * past them. A product in neither list is niche.
 */
const STAPLE = new Set([
	'pasteurised', 'homogenised', 'fresh', 'uht', 'semi', 'skimmed', 'milkPowder', 'skimmedPowder', 'evaporated', 'condensed',
	'rawCream', 'cream', 'whipping', 'culturedCream', 'sourCream', 'butter', 'butterfat', 'buttermilk',
	'soured', 'yoghurt', 'greek', 'kefir', 'iceCream',
	'curd', 'quark', 'paneer', 'rennetCurd', 'freshCheese', 'soft', 'semiHard', 'hard', 'pastaFilata', 'processed',
	'sweetWhey', 'wheyPowder', 'wpc', 'lactose',
]);
const KNOWN = new Set([
	'certified', 'esl', 'sterilised', 'colostrum',
	'coffeeCream', 'double', 'clotted', 'saureSahne', 'schmand', 'cremeFraiche', 'mascarpone',
	'culturedButter', 'clarified', 'amf',
	'mildYoghurt', 'probioticDrink', 'creamYoghurt', 'skyr', 'ayran', 'driedYoghurt', 'ryazhenka', 'fermButtermilk', 'choormog', 'kumis',
	'chhena', 'chhenaSweets', 'khoa', 'khoaSweets', 'dulce', 'kulfi', 'rabri',
	'bloomy', 'blue', 'washed', 'alpine', 'cheddared', 'washedCurd', 'brined', 'grilling', 'stracciatella',
	'acidWhey', 'ricotta', 'wheyCheese', 'wpi', 'acidCasein', 'caseinate',
	'lactulose', 'inhalers',
]);
for (const id of [...STAPLE, ...KNOWN])
	if (!(id in NODES)) throw new Error(`MilkGraph: significance names unknown ${id}`);

// Every parent named must be a product, and no product its own ancestor.
for (const [id, { from, alsoFrom = [] }] of Object.entries(NODES)) {
	// Under a ruler the arrow in has its value, not a step.
	const ruled = from !== undefined && !!NODES[from]?.scale;
	if (from !== undefined && !ruled && !NODES[id].step) throw new Error(`MilkGraph: ${id} has no step`);
	if (ruled !== (NODES[id].at !== undefined)) throw new Error(`MilkGraph: ${id} must have a value on a ruler if and only if it hangs from one`);
	/* Two at one value share its arrow; two nearly at one would hang one's
	   arrow down beside the other's. */
	const gap = (n: Product) => Math.abs(n.at! - NODES[id].at!);
	if (ruled && Object.entries(NODES).some(([o, n]) => o !== id && n.from === from && gap(n) > 0 && gap(n) < 1))
		throw new Error(`MilkGraph: ${id} is too near another on its ruler`);
	for (const b of Object.keys(NODES[id].byproducts ?? {}))
		if (!(b in NODES)) throw new Error(`MilkGraph: ${id} leaves unknown ${b}`);
	for (const p of [from, ...alsoFrom])
		if (p !== undefined && !(p in NODES)) throw new Error(`MilkGraph: ${id} is made from unknown ${p}`);
	for (let at = from, seen = new Set([id]); at !== undefined; at = NODES[at].from) {
		if (seen.has(at)) throw new Error(`MilkGraph: ${id} is made from itself`);
		seen.add(at);
	}
}

/**
 * A product's `examples`, drawn as leaves under it: the first SHOWN of
 * them by name, then a last “…” for the many more. An example is not made from its
 * product, so its line has no step written on it and no arrowhead, and it
 * takes its product's family. (`aka` is the same product under other
 * names, and is not drawn.)
 */
const SHOWN = 5;
const examples = Object.entries(NODES).flatMap(([kind, { examples: names = [] }]) =>
	(names.length ? [...names.slice(0, SHOWN), '…'] : []).map((label, i, all) => ({
		id: `${kind}:${i}`,
		label,
		kind,
		example: true,
		more: i === all.length - 1,
		rank: i,
		group: groupOf.get(kind) ?? -1,
		niche: 2,
		image: EXAMPLE_IMAGES[label] && pictured(exampleFile(label), EXAMPLE_IMAGES[label]),
		about: about.examples[label],
		regions: regions[label],
		aka: EXAMPLE_AKA[label],
		step: steps[label]?.label,
		how: steps[label],
	})),
);

interface Props {
	/** A product to open on, with everything made from it, framed and lit. */
	focus?: string;
}

const { focus } = Astro.props;

const graph = {
	light: LIGHT,
	groups: GROUPS.map(({ name, hub }) => ({ name, hub: hub ?? null })),
	splits: SPLITS,
	nodes: Object.entries(NODES).map(([id, { label, step, byproducts, scale, at, below, aka = [], examples: named = [] }]) => ({
		id,
		label,
		// Not drawn, but found by the search: its other names, and its
		// examples past the ones drawn.
		aka,
		unshown: named.slice(SHOWN),
		image: IMAGES[id] && pictured(id, IMAGES[id]),
		about: about.products[id],
		regions: regions[id],
		how: steps[id],
		// All its examples, for the card that tells of it.
		named,
		step,
		byproducts,
		scale,
		at,
		below,
		group: groupOf.get(id) ?? -1,
		// 0 a staple, 1 well known, 2 niche.
		niche: STAPLE.has(id) ? 0 : KNOWN.has(id) ? 1 : 2,
	})).concat(examples.map(({ kind, ...example }) => example) as any),
	links: Object.entries(NODES)
		.filter(([, { from }]) => from !== undefined)
		.map(([target, { from }]) => ({ source: from!, target, weight: TREATED.has(target) ? LIGHT : 1 }))
		.concat(examples.map(({ id, kind }) => ({ source: kind, target: id, weight: 1 }))),
};
---

<figure class="milk-graph" data-milk-graph={JSON.stringify(graph)} data-focus={focus}>
	<div class="milk-search" data-no-swipe data-deck-tool>
		<svg class="milk-search-icon" viewBox="0 0 16 16" aria-hidden="true">
			<circle cx="6.75" cy="6.75" r="4.75"></circle>
			<path d="M10.25 10.25L14 14"></path>
		</svg>
		<input
			type="search"
			role="combobox"
			placeholder="Find…"
			aria-label="Find a product"
			aria-autocomplete="list"
			aria-expanded="false"
			autocomplete="off"
			spellcheck="false"
		/>
		<ul role="listbox" hidden></ul>
	</div>
	<svg role="img" aria-label="Milk products and how each is made from another" data-no-swipe>
		<defs>
			<marker id="milk-by" class="by-head" viewBox="0 0 8 8" refX="8" refY="4" markerWidth="6" markerHeight="6" orient="auto">
				<path d="M0 0L8 4L0 8z"></path>
			</marker>
			<!-- The chrome's grain, for milk: its tiles, kept their size on the screen however far in it is zoomed. -->
			<pattern id="milk-dots" class="grain" data-tile="26" patternUnits="userSpaceOnUse" width="26" height="26">
				<image href="/assets/chrome-dots.png" width="26" height="26"></image>
			</pattern>
			<pattern id="milk-noise" class="grain" data-tile="128" patternUnits="userSpaceOnUse" width="128" height="128">
				<image href="/assets/chrome-noise.png" width="128" height="128"></image>
			</pattern>
		</defs>
		<g class="view">
			<g class="edges"></g>
			<g class="hits"></g>
			<g class="steps"></g>
			<g class="tables"></g>
			<g class="nodes"></g>
			<g class="flags"></g>
			<g class="by"></g>
		</g>
	</svg>
	<aside class="milk-about" data-no-swipe inert>
		<button type="button" class="milk-about-close" aria-label="Close">
			<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4L12 12M12 4L4 12"></path></svg>
		</button>
		<div class="milk-about-body"></div>
	</aside>
</figure>

<style>
	.milk-graph {
		/* Wider than a picture is let be (see DeckViz): it is a whole map. */
		--viz-max: 80rem;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		position: relative;
	}

	/* The search: a small field in the top left, over the picture, and what
	   it finds in a list under it; as the pills are on a light ground, on
	   glass on a dark one. */
	.milk-search {
		--field: var(--pill);
		--field-rim: var(--pill-rim);
		--found: var(--pill);
		--found-on: color-mix(in oklab, var(--deck-ground), white 30%);
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 2;
		width: min(16rem, calc(100% - 1.5rem));
		font-family: var(--font-mono);
		font-size: 0.8rem;
	}
	/* A magnifying glass at the field's left, in the words' quieter ink. */
	.milk-search-icon {
		position: absolute;
		top: calc(0.6em + 2px);
		left: 0.65em;
		width: 1.1em;
		height: 1.1em;
		fill: none;
		stroke: var(--deck-ink-dim);
		stroke-width: 1.6;
		stroke-linecap: round;
		pointer-events: none;
		/* Over the field, whose glass is a layer of its own. */
		z-index: 1;
	}
	.milk-search input {
		box-sizing: border-box;
		width: 100%;
		padding: 0.45em 0.7em 0.45em 2.1em;
		font: inherit;
		color: var(--deck-ink);
		background: var(--field);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
		backdrop-filter: blur(8px);
		outline: none;
	}
	.milk-search input:focus {
		border-color: var(--flb);
	}
	.milk-search ul {
		list-style: none;
		margin: 0.25rem 0 0;
		padding: 0.25rem 0;
		max-height: 16rem;
		overflow-y: auto;
		background: var(--found);
		border: 1px solid var(--field-rim);
		border-radius: var(--radius-medium);
	}
	:global(.deck-dark) .milk-search {
		--field: var(--viz-glass);
		--field-rim: var(--viz-glass-rim);
		--found: var(--ground-300);
		--found-on: var(--ground-400);
	}
	/* Written by the script as it finds things, so out of the scoping. */
	.milk-search :global(li) {
		padding: 0.4em 0.7em;
		color: var(--deck-ink);
		cursor: pointer;
	}
	.milk-search :global(li small) {
		display: block;
		color: var(--deck-ink-dim);
		font-size: 0.85em;
	}
	.milk-search :global(li[aria-selected='true']) {
		background: var(--found-on);
		color: var(--lit);
	}
	/* The graph's own colours, by the ground it is on (the post's `ground`).
	   On the light one, the pills stand out of it a little whiter, edged in
	   a faint dark line, and the arrows are darker than the pills, the ink
	   they are drawn in; a lit arrow is the ink itself. On the dark one, the
	   pills are a rung up the ground's ladder, edged in the FLB, and a lit
	   arrow is the accent. */
	.milk-graph {
		--pill: color-mix(in oklab, var(--deck-ground), white 70%);
		--pill-rim: rgb(0 0 0 / 0.14);
		--line: color-mix(in oklab, var(--deck-ink-dim) 70%, var(--deck-ground));
		--lit: var(--deck-ink);
	}
	:global(.deck-dark) .milk-graph {
		--pill: var(--ground-300);
		--pill-rim: var(--flb);
		--line: color-mix(in oklab, var(--deck-ink-dim) 55%, var(--deck-ground));
		--lit: var(--ink-accent);
	}
	/* The product clicked, edged in the ink while it is told of. */
	.nodes :global(.node.is-chosen rect.rim) {
		stroke: var(--lit);
		stroke-width: 2px;
	}

	/* The card telling of what was clicked: a panel on the pills' own white,
	   slid in over the left of the picture, edge to edge, top to bottom; most
	   of the pane where it is too narrow for the card and the picture side
	   by side (below). */
	.milk-graph {
		container-type: inline-size;
	}
	.milk-about {
		position: absolute;
		top: 0;
		bottom: 0;
		left: 0;
		z-index: 3;
		box-sizing: border-box;
		width: min(23rem, 100%);
		color: var(--deck-ink);
		background: var(--pill);
		border-right: 1px solid var(--pill-rim);
		font-family: var(--font-sans);
		font-size: 0.85rem;
		line-height: 1.5;
		/* Out of sight to the left until opened, and gone once it is out. */
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform 0.25s ease,
			visibility 0s 0.25s;
	}
	.milk-about.is-open {
		transform: none;
		visibility: visible;
		box-shadow: 0.5rem 0 1.5rem rgb(0 0 0 / 0.1);
		transition: transform 0.25s ease;
	}
	@media (prefers-reduced-motion: reduce) {
		.milk-about,
		.milk-about.is-open {
			transition: none;
		}
	}
	/* Where the pane is too narrow for the card and the picture side by
	   side, the card takes most of it but not all: a strip of the picture
	   is left at its side to tap, which shuts it. */
	@container (max-width: 40rem) {
		.milk-about {
			width: 80%;
		}
	}
	/* What scrolls, under the close button, which stays put. */
	.milk-about-body {
		box-sizing: border-box;
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1rem 1.1rem 0.9rem;
	}
	.milk-about-close {
		position: absolute;
		top: 0.5rem;
		right: 0.5rem;
		z-index: 1;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0.35rem;
		color: var(--deck-ink-dim);
		background: none;
		border: 0;
		border-radius: var(--radius-medium);
		cursor: pointer;
	}
	.milk-about-close:hover {
		color: var(--deck-ink);
	}
	.milk-about-close svg {
		display: block;
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
