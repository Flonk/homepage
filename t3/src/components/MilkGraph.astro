		label: 'Skimmed milk\npowder',
		aka: ['Nonfat dry milk', 'Magermilchpulver'],
		examples: ['Milk chocolate', 'Infant formula', 'Food aid', 'Film-set cocaine'],
		from: 'skimmed',
		step: 'spray-dry',
	},

