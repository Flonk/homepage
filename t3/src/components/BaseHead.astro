---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import type { ImageMetadata } from 'astro';
import { ClientRouter } from 'astro:transitions';
import AeStorm from './memes/AeStorm.astro';
import { SITE_TITLE } from '../consts';
// Self-hosted prose face (see --font-prose). Bundled by Vite, so no CDN
// request and no dependency on whatever font the OS happens to default to.
//
// Declared here rather than through fontsource's own stylesheets, so that the
// latin files can be preloaded: fetched before anything is laid out, so that
// on most loads the faces are there for the first paint. `swap` for when they
// are not: drawn in the fallback first and redrawn once the face arrives.
// `optional` was tried, to stop every click redrawing the type when every
// click loaded a page; but a browser a beat slow with the file kept the
// fallback for good, and here the fallback is a monospace. Pages are swapped
// in place now (see ClientRouter below), so the faces load once a visit and
// the swap, if there is one, happens once.
import latin400 from '@fontsource/source-serif-4/files/source-serif-4-latin-400-normal.woff2?url';
import latin400i from '@fontsource/source-serif-4/files/source-serif-4-latin-400-italic.woff2?url';
import latin700 from '@fontsource/source-serif-4/files/source-serif-4-latin-700-normal.woff2?url';
import latin700i from '@fontsource/source-serif-4/files/source-serif-4-latin-700-italic.woff2?url';
import ext400 from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-400-normal.woff2?url';
import ext400i from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-400-italic.woff2?url';
import ext700 from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-700-normal.woff2?url';
import ext700i from '@fontsource/source-serif-4/files/source-serif-4-latin-ext-700-italic.woff2?url';
// The post tree's sans, Source Serif's companion, loaded the same way.
import sans400 from '@fontsource/source-sans-3/files/source-sans-3-latin-400-normal.woff2?url';
import sans700 from '@fontsource/source-sans-3/files/source-sans-3-latin-700-normal.woff2?url';
import sansExt400 from '@fontsource/source-sans-3/files/source-sans-3-latin-ext-400-normal.woff2?url';
import sansExt700 from '@fontsource/source-sans-3/files/source-sans-3-latin-ext-700-normal.woff2?url';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;

const LATIN = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD';
const LATIN_EXT = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const SERIF = 'Source Serif 4';
const SANS = 'Source Sans 3';
const faces = [
	{ family: SERIF, src: latin400, weight: 400, style: 'normal', range: LATIN, preload: true },
	{ family: SERIF, src: latin400i, weight: 400, style: 'italic', range: LATIN, preload: true },
	{ family: SERIF, src: latin700, weight: 700, style: 'normal', range: LATIN, preload: true },
	{ family: SERIF, src: latin700i, weight: 700, style: 'italic', range: LATIN, preload: true },
	{ family: SERIF, src: ext400, weight: 400, style: 'normal', range: LATIN_EXT, preload: false },
	{ family: SERIF, src: ext400i, weight: 400, style: 'italic', range: LATIN_EXT, preload: false },
	{ family: SERIF, src: ext700, weight: 700, style: 'normal', range: LATIN_EXT, preload: false },
	{ family: SERIF, src: ext700i, weight: 700, style: 'italic', range: LATIN_EXT, preload: false },
	{ family: SANS, src: sans400, weight: 400, style: 'normal', range: LATIN, preload: true },
	{ family: SANS, src: sans700, weight: 700, style: 'normal', range: LATIN, preload: true },
	{ family: SANS, src: sansExt400, weight: 400, style: 'normal', range: LATIN_EXT, preload: false },
	{ family: SANS, src: sansExt700, weight: 700, style: 'normal', range: LATIN_EXT, preload: false },
];
const fontFaces = faces
	.map(
		(face) =>
			`@font-face { font-family: '${face.family}'; font-style: ${face.style}; font-weight: ${face.weight}; font-display: swap; src: url(${face.src}) format('woff2'); unicode-range: ${face.range}; }`,
	)
	.join('\n');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{
	faces
		.filter((face) => face.preload)
		.map((face) => <link rel="preload" href={face.src} as="font" type="font/woff2" crossorigin />)
}
<style is:inline set:html={fontFaces} />

<!-- Pages are swapped in place rather than loaded, so the post tree and the
     header stay put between them. Every scripted component sets up through
     lib/page.ts because of it. -->
<ClientRouter />

<!-- Press ä, anywhere. -->
<AeStorm />
<link rel="icon" href="/favicon-32x32.png" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
