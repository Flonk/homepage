---
// A garish sticker slapped onto the front page, reading a different cheesy
// thing every few seconds. Nothing here informs anybody of anything; it is
// there because a blog called T3 INTERBLAG REAL-ESTATE ought to have one.
//
// The face is Lobster, self-hosted the same way the prose serif is (see
// BaseHead), so the sticker looks the same whether or not Google is reachable.
import '@fontsource/lobster/400.css';

// A 22-point starburst, the shape every discount sticker has ever been. Cut as
// a clip-path so the sunburst stripes underneath it get the jagged edge too.
// Cut round; the CSS squashes it to the sticker's proportions afterwards.
const POINTS = 22;
const starburst = Array.from({ length: POINTS * 2 }, (_, i) => {
	const r = i % 2 ? 37 : 50;
	const a = (Math.PI * i) / POINTS - Math.PI / 2;
	return `${(50 + r * Math.cos(a)).toFixed(2)}% ${(50 + r * Math.sin(a)).toFixed(2)}%`;
}).join(', ');
---

<button
	class="sticker"
	type="button"
	data-fortune-sticker
	aria-label="A sticker. Click it for another one."
>
	<span class="burst" aria-hidden="true"><span class="rays"></span></span>
	<span class="line" data-fortune-line></span>
</button>

<style define:vars={{ starburst }}>
	.sticker {
		/* Wider than it is tall. The words are a line of prose, not a monogram,
		   and a circle spends its height on the two or three characters that
		   reach the top and bottom of it. Worst on a phone, where the sticker is
		   as wide as the column and every row it wastes is a row to scroll past. */
		--sticker-w: 15rem;
		--squash: 0.74;
		/* The blue across the wheel from blog orange — oklch(78.74% 0.1715
		   69.12) — at the same lightness, so there is no brightness edge where
		   the stripes meet, only a hue one. That is the whole trick: equal L and
		   opposite hue is what makes them shimmer against each other, and it is
		   also what lets one outline colour carry the words over both.

		   It costs chroma. sRGB has no blue anywhere near that light with the
		   orange's 0.1715 in it; 0.113 is the entire gamut at this L and hue,
		   so the blue gives up saturation to keep the match. */
		--sticker-blue: oklch(78.74% 0.113 249.12);

		position: absolute;
		top: -1rem;
		right: -7rem;
		z-index: 3;

		width: var(--sticker-w);
		/* Derived, not calculated from the width: the width is a min() with a
		   percentage in it on a phone, and a percentage inside a height resolves
		   against a parent height that is not there — the whole calc drops to
		   auto and the sticker comes back square. */
		aspect-ratio: 1 / var(--squash);
		padding: 0;
		border: none;
		background: none;
		cursor: pointer;

		display: grid;
		place-items: center;
		/* Rays and words stack in the one cell. The row is pinned to the box
		   rather than left on auto, or the rays — which are deliberately taller
		   than the sticker before they are squashed — would size it themselves
		   and push everything below them down the page. */
		grid-template-areas: 'stack';
		grid-template-rows: 100%;

		/* Slapped on crooked, and it stays crooked. The wobble is the rays'
		   alone now — words that move are words you read twice. */
		transform: rotate(-11deg);
	}

	/* All three share the one cell. The rays animate, which makes them a
	   stacking context and would otherwise paint them over their own siblings,
	   so the order is spelled out. Grid items take z-index unpositioned. */
	.sticker > * {
		grid-area: stack;
	}

	.sticker:hover .rays {
		animation-play-state: paused;
	}

	.sticker:focus-visible {
		outline: 3px dashed var(--nord6);
		outline-offset: 6px;
	}

	/* The shadow hangs off this rather than off the sticker, so the words —
	   which are outlined already — are not given a second dark copy of
	   themselves thrown down the page. And it hangs off the still wrapper
	   rather than the rays, so it follows the turning silhouette while the
	   offset itself stays where it was put; on the rays it would swing round
	   with them. */
	.burst {
		z-index: 0;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		/* A hard one right under the edge, for the lift, and a big soft one
		   under that. The page is already nearly black, so the soft one has to
		   be near-opaque before it darkens anything at all. */
		filter: drop-shadow(0 14px 0 rgba(0, 0, 0, 0.4))
			drop-shadow(0 32px 28px rgba(0, 0, 0, 0.85));
	}

	/* The starburst, and there is nothing under the words but this: stripes of
	   blog orange and the blue opposite it, cut to points, turning slowly.

	   It is cut as a circle the full width of the sticker — overflowing the
	   short box on purpose — and squashed back into it from outside the
	   rotation, so the silhouette holds still while the spikes turn through it.
	   Squashing the shape instead would have the outline breathe as it went. */
	.rays {
		width: 100%;
		aspect-ratio: 1;
		clip-path: polygon(var(--starburst));
		background: repeating-conic-gradient(
			from 0deg,
			var(--accent) 0deg 9deg,
			var(--sticker-blue) 9deg 18deg
		);
		transform: scaleY(var(--squash));
		/* Both at once on the one element. They would overwrite each other on
		   `transform`, so the wobble is written in the standalone `rotate` and
		   `scale`, which the browser applies outside it — the squashed star
		   tilts and swells as a unit, and the spin goes on underneath. */
		animation:
			sticker-spin 24s linear infinite,
			sticker-wobble 3.4s ease-in-out infinite;
	}

	.line {
		z-index: 2;
		/* Narrow enough to stay inside the valleys between the spikes, a couple
		   of lines above and below the middle where the shape closes in. */
		width: 68%;
		font-family: 'Lobster', var(--font-mono);
		font-size: 1.25rem;
		line-height: 1.14;
		font-weight: 400;
		text-align: center;
		text-wrap: balance;
		hyphens: none;
		/* Outlined, because what is behind the words is orange under some of
		   them and blue under the rest, and no single fill reads over both.
		   Stroke first, so the outline sits behind the letter and not halfway
		   across it. */
		color: var(--nord6);
		-webkit-text-stroke: 4px var(--nordbg);
		paint-order: stroke fill;
	}

	/* Each new fortune lands like it was stamped there. */
	.sticker[data-stamping] .line {
		animation: sticker-stamp 0.34s cubic-bezier(0.2, 1.5, 0.4, 1);
	}

	@keyframes sticker-wobble {
		0%,
		100% {
			rotate: 0deg;
			scale: 1;
		}
		50% {
			rotate: 5deg;
			scale: 1.04;
		}
	}

	@keyframes sticker-spin {
		from {
			transform: scaleY(var(--squash)) rotate(0deg);
		}
		to {
			transform: scaleY(var(--squash)) rotate(360deg);
		}
	}

	@keyframes sticker-stamp {
		from {
			transform: scale(1.9);
			opacity: 0;
		}
		60% {
			transform: scale(0.94);
			opacity: 1;
		}
		to {
			transform: scale(1);
		}
	}

	/* Below the point where main stops having margins to spare, the sticker
	   comes in off the edge and shrinks rather than hanging off the viewport. */
	@media (max-width: 1080px) {
		.sticker {
			--sticker-w: 13rem;
			top: -2.5rem;
			/* Inside the wrapper here: hanging off would take the rotated
			   corners past the viewport on the narrow end of this range. */
			right: 0.5rem;
		}
		.line {
			font-size: 1.1rem;
		}
	}

	@media (max-width: 768px) {
		.sticker {
			/* In the flow and centred here, so it can take the column's width. */
			--sticker-w: min(16rem, 100%);
			position: static;
			display: grid;
			margin: 0.5rem auto 2rem;
		}
		.line {
			font-size: 1.2rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.rays,
		.sticker[data-stamping] .line {
			animation: none;
		}
	}
</style>

<script>
	// Cheesy things a sticker can say. Two of them are load-bearing: the orange
	// one is true, and the ä one is a promise the keydown handler below keeps.
	const FORTUNES = [
		'This blog was orange before it was cool',
		"Press 'ä' to 'ä'",
		'100% hand-typed characters',
		'Now with colours you can see!',
		'As seen on at least one screen',
		'No cookies. Not even the good ones.',
		'Prime interblag real-estate!',
		'Ask your doctor about OKLCH',
		'Zero (0) newsletters, forever',
		'Works on my machine',
		'Batteries not included',
		'Still under construction',
		'Warning: contains monospace',
		'Free with every visit!',
		'Best viewed in a browser',
		'Some assembly required',
	];

	// What it says the moment the promise is kept.
	const PAYOFF = 'ÄÄÄÄÄÄÄ!!!';

	const sticker = document.querySelector<HTMLElement>('[data-fortune-sticker]');
	const line = document.querySelector<HTMLElement>('[data-fortune-line]');
	if (sticker && line) {
		let shown = -1;

		function say(text: string) {
			line!.textContent = text;
			// Restarting a CSS animation needs the attribute to actually leave and
			// come back with a reflow in between.
			sticker!.removeAttribute('data-stamping');
			void sticker!.offsetWidth;
			sticker!.setAttribute('data-stamping', '');
		}

		// Never the same one twice running — a sticker that appears not to have
		// changed reads as broken rather than as coincidence.
		function next() {
			let i = shown;
			while (i === shown) i = Math.floor(Math.random() * FORTUNES.length);
			shown = i;
			say(FORTUNES[i]);
		}

		next();

		// It turns itself over. Waiting to be clicked would mean most readers
		// only ever see the one fortune they happened to load.
		let timer = window.setInterval(next, 6500);
		const restart = () => {
			clearInterval(timer);
			timer = window.setInterval(next, 6500);
		};

		sticker.addEventListener('click', () => {
			next();
			restart();
		});

		// --- the ä ---

		const GARISH = [
			'#ff2e88',
			'#ffa200',
			'#ffe600',
			'#00e5ff',
			'#7cff00',
			'#ff5e00',
			'#ff00ff',
			'#ffffff',
		];

		let storming = false;

		function storm() {
			if (storming) return;
			storming = true;

			const layer = document.createElement('div');
			layer.className = 'ae-storm';
			document.body.appendChild(layer);

			// They come out of the sticker, which is the thing that made the
			// promise, and carry on well past the far edge.
			const box = sticker!.getBoundingClientRect();
			const originX = box.left + box.width / 2;
			const originY = box.top + box.height / 2;
			const reach =
				Math.hypot(window.innerWidth, window.innerHeight) * 1.15;

			const running: Animation[] = [];
			for (let i = 0; i < 220; i++) {
				const glyph = document.createElement('span');
				glyph.textContent = 'ä';
				glyph.style.left = `${originX}px`;
				glyph.style.top = `${originY}px`;
				glyph.style.color = GARISH[i % GARISH.length];
				glyph.style.fontSize = `${1 + Math.random() * 6}rem`;
				layer.appendChild(glyph);

				const angle = Math.random() * Math.PI * 2;
				const distance = reach * (0.35 + Math.random() * 0.75);
				const spin = (Math.random() - 0.5) * 1440;
				const flight = 900 + Math.random() * 1500;

				// Two animations, because they want different clocks: the flight
				// is fast off the mark and coasting by the end, while the fade has
				// to stay out of the way until the last third — one eased curve
				// over both would have them washed out crossing mid-screen.
				running.push(
					glyph.animate(
						[
							{ transform: 'translate(-50%, -50%) scale(0.2) rotate(0deg)' },
							{
								transform: `translate(calc(-50% + ${Math.cos(angle) * distance}px), calc(-50% + ${Math.sin(angle) * distance}px)) scale(1) rotate(${spin}deg)`,
							},
						],
						{
							duration: flight,
							easing: 'cubic-bezier(0.12, 0.7, 0.3, 1)',
							fill: 'forwards',
						},
					),
				);
				glyph.animate([{ opacity: 1 }, { opacity: 0 }], {
					duration: flight * 0.35,
					delay: flight * 0.65,
					fill: 'forwards',
				});
			}

			say(PAYOFF);
			restart();

			Promise.allSettled(running.map((a) => a.finished)).then(() => {
				layer.remove();
				storming = false;
			});
		}

		addEventListener('keydown', (event) => {
			if (event.key !== 'ä' && event.key !== 'Ä') return;
			if (event.repeat || event.metaKey || event.ctrlKey || event.altKey) return;

			// Somebody typing ä into a field means the letter, not the fireworks.
			const target = event.target;
			if (
				target instanceof HTMLElement &&
				(target.isContentEditable ||
					target.closest('input, textarea, select'))
			) {
				return;
			}

			storm();
		});
	}
</script>

<style is:global>
	/* The storm layer lives on <body>, above everything, catching nothing. */
	.ae-storm {
		position: fixed;
		inset: 0;
		z-index: 999;
		pointer-events: none;
		overflow: hidden;
	}

	.ae-storm span {
		position: absolute;
		font-family: 'Lobster', var(--font-mono);
		line-height: 1;
		will-change: transform, opacity;
		text-shadow: 0 2px 0 rgba(0, 0, 0, 0.35);
	}
</style>
