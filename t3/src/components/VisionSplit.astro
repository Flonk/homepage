---
/**
 * One picture, twice: as it is, and as it looks to an eye short of one kind of
 * cone, with the join down the middle.
 *
 * Side by side rather than one after the other, because the point is not what
 * the second one looks like — on its own it looks perfectly plausible — but
 * what has stopped being different from what. A photograph is the honest place
 * to make that argument: the cone curves say the red and the green of these
 * leaves land on nearly the same pair of numbers, and here they are doing it.
 *
 * The filter is built from the same model as everything else in the series —
 * see dichromatMatrix in lib/spectrum.ts. An SVG filter interpolates in linear
 * light, which is the space that matrix is derived in, so the filter and the
 * canvases elsewhere agree rather than merely resemble each other.
 */
import { dichromatMatrix } from '../lib/spectrum';

interface Props {
	src: string;
	alt: string;
	/** Whose eye the right-hand side belongs to. */
	vision?: 'deuteranopia' | 'protanopia';
	/** Where the join sits, as a fraction of the width. */
	split?: number;
	/** Shown under the picture. Stock photographs generally need one. */
	credit?: string;
}

const { src, alt, vision = 'deuteranopia', split = 0.5, credit } = Astro.props;

const NAMES = { deuteranopia: 'Deuteranopia', protanopia: 'Protanopia' };
const at = Math.min(0.95, Math.max(0.05, split)) * 100;

/* A 3x3 on linear RGB becomes the 4x5 a filter wants, with the alpha row left
   alone: this changes which colours can be told apart, not what is opaque. */
const m = dichromatMatrix(vision);
const matrix = [
	m[0], m[1], m[2], 0, 0,
	m[3], m[4], m[5], 0, 0,
	m[6], m[7], m[8], 0, 0,
	0, 0, 0, 1, 0,
]
	.map((v) => Number(v.toFixed(6)))
	.join(' ');

// Unique per instance, so two of these on one page cannot take each other's.
const id = `vision-${vision}-${Math.random().toString(36).slice(2, 8)}`;
---

<figure class="split" style={`--at: ${at}%`}>
	<div class="split-frame">
		<img src={src} alt={alt} />
		{/* The same picture again, clipped to one side and put through the
		    filter. aria-hidden because it is the same photograph: there is
		    nothing here for a reader who cannot see it, and the alt text above
		    already said what it is. */}
		<img class="split-sim" src={src} alt="" aria-hidden="true" style={`filter: url(#${id})`} />
		<div class="split-line" aria-hidden="true"></div>
		<span class="split-tag split-tag-a">Normal</span>
		<span class="split-tag split-tag-b">{NAMES[vision]}</span>
	</div>
	{credit && <figcaption>{credit}</figcaption>}
</figure>

<svg class="split-defs" aria-hidden="true" focusable="false">
	<filter id={id} color-interpolation-filters="linearRGB">
		<feColorMatrix type="matrix" values={matrix} />
	</filter>
</svg>

<style>
	.split {
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		font-family: var(--font-mono);
	}

	.split-frame {
		position: relative;
		line-height: 0;
		max-width: 100%;
	}

	/* The site gives every img a border and an inch of padding. Neither belongs
	   on a picture that has another one laid exactly over it. */
	.split-frame img {
		display: block;
		max-width: 100%;
		max-height: 74cqh;
		width: auto;
		height: auto;
		padding: 0;
		border: 0;
		border-radius: var(--radius-tight);
	}

	.split-sim {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		clip-path: inset(0 0 0 var(--at));
	}

	.split-line {
		position: absolute;
		top: 0;
		bottom: 0;
		left: var(--at);
		width: 2px;
		margin-left: -1px;
		background: #fff;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.55);
	}

	.split-tag {
		position: absolute;
		bottom: 0.5rem;
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1;
		padding: 0.3em 0.55em;
		border-radius: var(--radius-tight);
		color: #f2f4f7;
		background: rgb(0 0 0 / 0.55);
		backdrop-filter: blur(2px);
	}

	.split-tag-a {
		left: 0.5rem;
	}

	.split-tag-b {
		right: 0.5rem;
	}

	.split figcaption {
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--deck-ink-dim, #7a7264);
		text-align: center;
	}

	/* Present only for the filter it carries. */
	.split-defs {
		position: absolute;
		width: 0;
		height: 0;
		overflow: hidden;
	}

	@container viz (max-width: 30rem) {
		.split-tag {
			font-size: 0.5rem;
		}
	}
</style>
