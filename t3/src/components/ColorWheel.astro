---
export interface Props {
  size?: number;
  chroma?: number;
  /** Lightness bounds (0–100%) for the wheel: center = maxLightness, edge = minLightness */
  minLightness?: number;
  maxLightness?: number;
  /** each entry is { c: chroma, h: hue-deg } */
  swatches?: { c: number; h: number }[];
  /** Accessible description of what this particular wheel shows. */
  label?: string;
}
const {
  size = 400,
  chroma = 0.22,
  minLightness = 0,
  maxLightness = 100,
  swatches = [],
  label = 'OKLCH colour wheel',
} = Astro.props;
---

<canvas
  data-oklch-wheel
  width={size}
  height={size}
  role="img"
  aria-label={label}
  data-chroma={chroma}
  data-min-lightness={minLightness}
  data-max-lightness={maxLightness}
  data-swatches={JSON.stringify(swatches)}></canvas>

<style>
  canvas[data-oklch-wheel] {
    border-radius: 50%;
    display: block;
    max-width: 100%;
    height: auto;
  }
</style>

<script>
  /*
   * One hoisted script paints every wheel on the page. It used to look up a
   * hardcoded `id`, which meant a second wheel on the same page was both
   * invalid HTML and never painted.
   */
  const wheels = document.querySelectorAll<HTMLCanvasElement>('canvas[data-oklch-wheel]');

  for (const canvas of wheels) {
    const ctx = canvas.getContext('2d');
    if (!ctx) continue;

    const D = canvas.width;
    const chrom = parseFloat(canvas.dataset.chroma ?? '0.22');
    const minL = parseFloat(canvas.dataset.minLightness ?? '0');
    const maxL = parseFloat(canvas.dataset.maxLightness ?? '100');
    const swatches: { c: number; h: number }[] = JSON.parse(
      canvas.dataset.swatches || '[]',
    );

    const cx = D / 2;
    const cy = D / 2;
    const radius = D / 2;

    // paint the OKLCH wheel stretched between maxL at center and minL at edge
    for (let y = 0; y < D; y++) {
      for (let x = 0; x < D; x++) {
        const dx = x - cx;
        const dy = y - cy;
        const r = Math.hypot(dx, dy);
        if (r > radius) continue;

        let hue = (Math.atan2(dy, dx) * 180) / Math.PI;
        if (hue < 0) hue += 360;

        const frac = r / radius; // 0 at center → 1 at edge
        const Lpct = maxL + (minL - maxL) * frac;
        const C = chrom * frac;

        ctx.fillStyle = `oklch(${Lpct}% ${C} ${hue}deg)`;
        ctx.fillRect(x, y, 1, 1);
      }
    }

    // overlay swatch markers, clamped to the ring
    const markerRadius = Math.max(4, D * 0.02);
    for (const { c, h } of swatches) {
      const frac = Math.min(Math.max(c / chrom, 0), 1);
      const r = frac * radius;
      const theta = ((((h % 360) + 360) % 360) * Math.PI) / 180;
      const x0 = cx + r * Math.cos(theta);
      const y0 = cy + r * Math.sin(theta);

      ctx.beginPath();
      ctx.arc(x0, y0, markerRadius, 0, 2 * Math.PI);
      ctx.lineWidth = 2;
      ctx.strokeStyle = 'black';
      ctx.stroke();
    }
  }
</script>
