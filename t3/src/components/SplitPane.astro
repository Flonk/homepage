---
// The editor's split every page is laid out in on a wide screen: the post tree
// on the left, whatever is open on the right, with tesbota's divider between
// them to drag. On a narrow screen there is room for one of the two, and
// `mode` says which:
//
//   post  the post; the tree is left out
//   home  the tree, which is what the home page is for
//   deck  the deck, which fills the whole of what it is given
import PostIndex from './PostIndex.astro';

interface Props {
	mode: 'post' | 'home' | 'deck';
	current?: string;
	// The tree folded unless the reader has unfolded it: for a series that wants the room.
	foldTree?: boolean;
}

const { mode, current, foldTree = false } = Astro.props;

// Font Awesome Free 6, "angles-left" (solid): https://fontawesome.com, CC BY 4.0.
const ANGLES =
	'M41.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 256 246.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160zm352-160l-160 160c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L301.3 256 438.6 118.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0z';
---

<script is:inline define:vars={{ foldTree }}>
	// The split is set before anything below paints, so a page never opens at
	// the default and then jumps to where the reader left it.
	try {
		const split = Number(localStorage.getItem('split-rem'));
		if (split >= 14 && split <= 40)
			document.documentElement.style.setProperty('--split', `${split}rem`);
		/* And the tree folded down to its bar, if that is how it was left; or,
		   on a page that folds it, unless the reader unfolded it. */
		const tree = localStorage.getItem('tree');
		if (tree === 'folded' || (foldTree && tree !== 'open')) document.documentElement.dataset.tree = 'folded';
	} catch {}
</script>

<div class:list={['split', `is-${mode}`]} data-fold-tree={foldTree || undefined}>
	<aside class="split-list" transition:persist="tree">
		<div class="pane-dots" aria-hidden="true"></div>
		<div class="tree-bar">
			<span class="tree-bar-label" aria-hidden="true">Posts</span>
			<button class="tree-fold" type="button" aria-label="Fold the posts away" title="Fold the posts away">
				<svg viewBox="0 0 448 512" aria-hidden="true"><path d={ANGLES} /></svg>
			</button>
		</div>
		<div class="pane-scroll">
			<PostIndex current={current} />
		</div>
	</aside>
	<div class="split-divider" title="drag to resize" aria-hidden="true"></div>
	<div class="split-main">
		<div class="pane-dots" aria-hidden="true"></div>
		<div class="pane-scroll">
			<slot />
		</div>
	</div>
</div>

<style>
	/* The grain on the panes and the page is drawn sharp at any density
	   (image-rendering on each, below), and that would pass down to every
	   picture in a post: so it stops at their children. First, so that a
	   pane's own setting, which is one of these children, wins over it. */
	.split > :global(*),
	.split-list > :global(*),
	.split-main > :global(*) {
		image-rendering: auto;
	}

	/* The page's own ground, below the header: the body has none, so that
	   the chrome and its grain show through it (see global.css). Positioned, so it
	   paints over that grain, and taking all the height under the header. On
	   a wide screen the gutter takes its place.

	   Its grain is laid on the box, never fixed to the window. The box never
	   moves, its panes scrolling inside it, so fixed would look no different;
	   but a phone draws a fixed background as a layer of its own, and through
	   a page change that layer was seen bare for a frame or two, the whole
	   page gone to grey static. */
	.split {
		position: relative;
		flex: 1 0 auto;
		background: url('/assets/grain.png') 0 0 / 128px 128px, var(--ground-100);
		image-rendering: pixelated;
	}

	/* Narrow: one thing at a time. */
	.split-divider,
	.split-list {
		display: none;
	}
	/* The home page on a narrow screen is the list, full width, its rows
	   running to the edges as they do beside a post. */
	.is-home .split-list {
		display: block;
	}
	@media (max-width: 1099px) {
		/* The home page here is the list laid out another way: newest, the
		   series to swipe through, then the rest (see PostIndex). */
		.is-home :global(.home-sections) {
			display: block;
		}
		.is-home :global(nav.tree > .nodes) {
			display: none;
		}
		/* The page under the header a sheet with its corners rounded, as the
		   content is on a wide screen: rounded by the chrome laid over them
		   (:root::before), and its ring (:root::after) following. Set on the
		   root, which both are drawn from. */
		:global(:root:has(.split)) {
			--content-radius: 13px;
		}
		.split {
			/* Exactly the screen under the header, so the chrome is always all
			   there, with the page scrolling inside it rather than the window: in
			   the pane that is showing, not this box, which only clips. The
			   scrollbar runs up under the chrome's corner with everything else. */
			height: calc(100dvh - var(--header-height) - var(--page-border) - var(--frame-bottom));
			display: flex;
			flex-direction: column;
			overflow: hidden;
		}
		.split-list,
		.split-main {
			flex: 1 1 auto;
			min-height: 0;
			overflow-y: auto;
			/* Its scrolling its own: run to the end, it does not hand the swipe on
			   to the page, which would only bounce and show the chrome under it. */
			overscroll-behavior: contain;
			/* Holds what is placed absolutely inside it, as on a wide screen. */
			position: relative;
		}
		.is-deck .split-main {
			overflow: hidden;
		}
	}
	.is-home .split-main {
		display: none;
	}
	/* The pane's dots are a wide-screen thing; on a narrow one the post is the
	   page, and the scrolling wrapper is no box at all. */
	.pane-dots {
		display: none;
	}
	.pane-scroll {
		display: contents;
	}
	/* The tree's fold is a wide-screen thing too: on a narrow one the tree is
	   either the page or not there. */
	.tree-bar {
		display: none;
	}

	/* A deck takes all the height there is, down a column. */
	.is-deck,
	.is-deck .split-main {
		flex: 1;
		min-height: 0;
		display: flex;
		flex-direction: column;
	}

	/* Wide: the tree on the left, the open thing on the right, split where
	   the divider was left, each scrolling on its own under the header. The
	   tree is as wide as the reader made it, however wide the window: 19rem
	   until it is moved, and never more than three fifths of the page. */
	@media (min-width: 1100px) {
		/* The content's corners are rounded a little under concentric with the
		   cards in it, set by eye: the full radius and gap reads as rounder than
		   the cards, an outer corner with that much room round it. The chrome
		   is laid over the page's corners (:root::before), so it seems to curve
		   in round the content, and its ring (see :root::after) follows. Set on
		   the root, which both are drawn from. */
		:global(:root:has(.split)) {
			/* In px rather than a bare 0, which would make every calc() it is added
			   to a length in invalid: the divider's place among them. */
			--split-pad: 0px;
			--split-gap: 0px;
			/* The tree's width: where the divider was left, or this. */
			--split-default: 19rem;
			--content-radius: 13px;
		}
		/* Two panes side by side, run right up to the chrome (--split-pad, which
		   is nothing for now) and to each other (--split-gap, nothing too): the
		   tree lies over the post and casts a soft shadow onto it (below).

		   The post has its own grain on its own pane rather than the page's,
		   still while the post scrolls over it, as the tree's is. */
		.split,
		.is-deck {
			display: grid;
			grid-template-columns: min(var(--split, var(--split-default)), 60%) minmax(0, 1fr);
			/* Folding the tree away and back (see the tree's bar, below) eased;
			   a drag of the divider follows the pointer as it is. */
			transition: grid-template-columns 0.28s cubic-bezier(0.3, 0, 0.2, 1);
			column-gap: var(--split-gap);
			background: var(--ground-100);
			/* Square, the chrome rounding it (see above); the panes run right up
			   to it, under the chrome's corners. */
			overflow: hidden;
			box-sizing: border-box;
			padding: var(--split-pad);
			position: relative;
			flex: none;
			height: calc(100dvh - var(--header-height) - var(--page-border) - var(--frame-bottom));
		}
		.split-list,
		.is-home .split-list {
			/* Its bar (below) on top, the tree scrolling under it. */
			display: flex;
			flex-direction: column;
			max-width: none;
			margin: 0;
			padding: 0;
			/* A frame that holds still, as the post's pane is: its dots (below)
			   stay where they are and the tree scrolls over them inside it. */
			position: relative;
			overflow: hidden;
			view-transition-name: tree;
			/* Its own corners rounded as the page's are. The page's are drawn over
			   it by the chrome (:root::before) and need nothing from it, but in a
			   page change the tree is lifted out above everything as a picture of
			   itself (see view transitions in global.css), over those corners;
			   square, it showed its own corner and scrollbar there for a moment. */
			border-radius: var(--content-radius) 0 0 var(--content-radius);
			/* Over the post, its shadow falling on it, rather than a line between. */
			z-index: 2;
			box-shadow:
				1px 0 0 var(--groove-cut),
				6px 0 18px -6px rgb(0 0 0 / 0.7);
			/* And a groove down where it meets the post: the light line its border,
			   the dark one just past it, over the post (the first shadow). */
			border-right: 1px solid var(--groove-edge);
		}
		/* Beside a post the tree is set back, a rung down both ladders from the
		   page: its ground and panel on --ground-300 and 400, its words on the
		   inks in between the page's. The tree is a PostIndex, which takes its
		   colours from --index-* where it is given them and from the page's
		   rungs where it is not; the open post's row is given the page's back,
		   so the one thing in the tree that should stand out does, at full
		   strength. */
		.split-list {
			--index-ground: var(--ground-300);
			--index-panel: var(--ground-400);
			--index-ink: var(--ink-200);
			--index-faint: var(--ink-600);
			/* Its type a size down from the post's, thirteen sixteenths. */
			--tree-text: 0.8125;
			/* The post's grain at three fifths of its strength, quieter here as
			   the tree is, and still while the tree scrolls over it. */
			background: url('/assets/grain-side.png') 0 0 / 128px 128px, var(--ground-300);
			image-rendering: pixelated;
		}
		.split-list :global(li[aria-current] > .row) {
			--index-panel: var(--ground-200);
			--index-ink: var(--ink-100);
			--index-faint: var(--ink-500);
		}
		/* The post's pane: a frame that holds still, with the page's grain and
		   dots on it (below), and the post scrolling over both inside it. */
		.split-main,
		.is-home .split-main {
			display: block;
			min-width: 0;
			position: relative;
			overflow: hidden;
			background: url('/assets/grain.png') 0 0 / 128px 128px, var(--ground-100);
			image-rendering: pixelated;
			/* What is open measures itself against this pane, not the window:
			   the prose breakout, and anything sized in cqw. */
			container-type: inline-size;
		}
		/* The chrome's dots, faint and still, on both panes: the same grid at the
		   same 17°, but laid on plainly rather than blended, which on a ground
		   this dark would leave nothing to see. A layer of its own, because a
		   background cannot be turned, cut oversize so that turned it still
		   fills the pane. */
		.pane-dots {
			display: block;
			position: absolute;
			inset: 0;
			overflow: hidden;
			pointer-events: none;
		}
		.pane-dots::before {
			content: '';
			position: absolute;
			inset: calc(-60% - 120px) -25%;
			transform: rotate(17deg);
			background: radial-gradient(circle, rgb(255 255 255 / 0.07) 0.4px, transparent 0.7px) 0 0 /
				2.5px 2.5px;
		}
		.pane-scroll {
			display: block;
			height: 100%;
			overflow-y: auto;
			overscroll-behavior: contain;
			/* Holds what is placed absolutely inside it, such as the copy of each
			   formula KaTeX keeps for screen readers, which would otherwise be
			   placed against the split and hang out below the window. Over the
			   dots, which come before it. */
			position: relative;
		}
		/* The tree's scrollbar on its left, out by the frame and away from the
		   post: a scroller laid out right to left puts its bar there, and the
		   tree inside it is set back to left to right. */
		.split-list .pane-scroll {
			direction: rtl;
		}
		.split-list .pane-scroll > :global(*) {
			direction: ltr;
		}
		.is-deck .split-main {
			display: flex;
		}
		.is-deck .split-main .pane-scroll {
			flex: 1;
			min-width: 0;
			display: flex;
			flex-direction: column;
			overflow: hidden;
		}
		/* tesbota's divider: nothing to see until the pointer finds it. */
		.split-divider {
			display: block;
			position: absolute;
			top: 0;
			bottom: 0;
			left: calc(var(--split-pad) + var(--split-gap) / 2 + min(var(--split, var(--split-default)), 60%));
			width: 0.6rem;
			transform: translateX(-50%);
			cursor: col-resize;
			touch-action: none;
			/* Over the tree, which lies over the post. */
			z-index: 3;
		}
		.split-divider:hover,
		.is-dragging .split-divider {
			background: linear-gradient(to right, transparent 45%, var(--ink-accent) 45% 55%, transparent 55%);
		}
		.is-dragging {
			cursor: col-resize;
			user-select: none;
			transition: none;
		}

		/* The tree's bar: open, a row along the top of the tree, the word for
		   what is under it on the left and the fold on the right, by the post;
		   folded, all that is left of the tree, a strip down the left with the
		   fold at its top, turned to unfold, and the word run down under it.
		   The state is on <html> (data-tree), set before the page paints and
		   kept through a swap (see the scripts). */
		.tree-bar {
			flex: none;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.5rem;
			height: 2.5rem;
			box-sizing: border-box;
			/* The word lined up with the rows' words under it. */
			padding: 0 0.5rem 0 1.25rem;
			/* Cut off from the tree by the tree's own groove (see PostIndex). */
			border-bottom: 1px solid var(--groove-cut);
			box-shadow: 0 1px 0 var(--groove-edge);
			background: rgb(0 0 0 / 0.25);
			/* Over the dots, which come before it. */
			position: relative;
		}
		.tree-bar-label {
			font-family: var(--font-mono);
			font-size: 0.7rem;
			letter-spacing: 0.15em;
			text-transform: uppercase;
			color: var(--ink-600);
			white-space: nowrap;
		}
		.tree-fold {
			display: grid;
			place-items: center;
			margin: 0;
			padding: 0.45rem;
			border: 0;
			border-radius: 6px;
			background: none;
			color: var(--ink-600);
			cursor: pointer;
			transition:
				color 0.15s,
				background-color 0.15s;
		}
		.tree-fold:hover,
		.tree-fold:focus-visible,
		:global(:root[data-tree='folded']) .split-list:hover .tree-fold {
			color: var(--ink-accent);
			background: rgb(0 0 0 / 0.45);
		}
		.tree-fold svg {
			display: block;
			width: 0.8rem;
			height: 0.8rem;
			fill: currentColor;
			transition: transform 0.28s cubic-bezier(0.3, 0, 0.2, 1);
		}
		.split-list .pane-scroll {
			flex: 1;
			min-height: 0;
			height: auto;
			transition:
				opacity 0.2s,
				visibility 0.2s;
		}

		/* Folded: the tree's column down to the bar, the tree faded out under
		   it and the divider gone, there being nothing to drag. The whole strip
		   unfolds it (see the scripts). */
		:global(:root[data-tree='folded']) .split {
			grid-template-columns: var(--tree-bar, 2.75rem) minmax(0, 1fr);
		}
		:global(:root[data-tree='folded']) .split-divider {
			display: none;
		}
		:global(:root[data-tree='folded']) .split-list {
			cursor: pointer;
		}
		:global(:root[data-tree='folded']) .split-list .pane-scroll {
			opacity: 0;
			visibility: hidden;
		}
		:global(:root[data-tree='folded']) .tree-bar {
			justify-content: center;
			padding: 0;
			border-bottom-color: transparent;
			box-shadow: none;
			background: none;
		}
		/* The word run down the strip under the fold. */
		:global(:root[data-tree='folded']) .tree-bar-label {
			position: absolute;
			top: calc(100% + 0.5rem);
			left: 50%;
			translate: -50% 0;
			writing-mode: vertical-rl;
		}
		:global(:root[data-tree='folded']) .tree-fold svg {
			transform: rotate(180deg);
		}

		@media (prefers-reduced-motion: reduce) {
			.split,
			.tree-fold svg,
			.split-list .pane-scroll {
				transition: none;
			}
		}
	}
</style>

<script>
	import { eachPage, keepOnRoot } from '../lib/page';

	// Drag the divider to move the split, the tree between 14rem and 40rem
	// wide (and never past three fifths of the page, as the style has it);
	// double-click it to put it back. Where it is left is kept for the next
	// page, in rem, so it is the same width in any window.
	const LEAST_REM = 14;
	const MOST_REM = 40;
	const rootFont = () => parseFloat(getComputedStyle(document.documentElement).fontSize) || 16;

	const place = (at: number, keep: boolean) => {
		document.documentElement.style.setProperty('--split', `${at}rem`);
		if (!keep) return;
		try {
			localStorage.setItem('split-rem', String(at));
		} catch {}
	};

	// Set on <html>, which a swap gives the next page's attributes.
	keepOnRoot('--split');

	// The tree folded to its bar or open: on <html> as data-tree, kept for the
	// next page, and put back on <html> as a swap takes it away, as --split is.
	const isFolded = () => document.documentElement.dataset.tree === 'folded';
	const labelFold = () => {
		const fold = document.querySelector<HTMLElement>('.tree-fold');
		if (!fold) return;
		const label = isFolded() ? 'Unfold the posts' : 'Fold the posts away';
		fold.setAttribute('aria-label', label);
		fold.setAttribute('title', label);
		fold.setAttribute('aria-expanded', String(!isFolded()));
	};
	const setFolded = (folded: boolean) => {
		if (folded) document.documentElement.dataset.tree = 'folded';
		else delete document.documentElement.dataset.tree;
		labelFold();
		try {
			// Unfolded kept too, so a page that folds the tree by default leaves it open.
			localStorage.setItem('tree', folded ? 'folded' : 'open');
		} catch {}
	};
	/* Folded on the next page as the reader left it, or, where they have not
	   said, as that page has it (see foldTree). */
	document.addEventListener('astro:before-swap', (e) => {
		let tree: string | null = null;
		try {
			tree = localStorage.getItem('tree');
		} catch {}
		const folds = !!e.newDocument.querySelector('.split[data-fold-tree]');
		const folded = tree ? tree === 'folded' : folds;
		const swap = e.swap;
		e.swap = () => {
			swap();
			if (folded) document.documentElement.dataset.tree = 'folded';
		};
	});
	// The fold, or anywhere on the strip once folded. The bar is kept with the
	// tree from one page to the next, so it is listened to once a visit, not
	// once a page.
	// The site's mark in the header, which goes home, unfolds it too: home is
	// the tree.
	document.addEventListener('click', (e) => {
		if (!(e.target instanceof Element)) return;
		if (e.target.closest('header h1 a')) setFolded(false);
		else if (e.target.closest('.tree-fold') || (isFolded() && e.target.closest('.split-list')))
			setFolded(!isFolded());
	});

	/* The tree is kept from one page to the next (transition:persist), but
	   the router lifts it out of the page while it swaps the rest, and out of
	   its pane it has no height to scroll in: it came back at the top, and
	   only got back down when the open file was brought into sight after.
	   So where it was is noted before the swap and put back straight after,
	   before the new page is shown. */
	const treeScroller = () => document.querySelector<HTMLElement>('.split-list .pane-scroll');
	let treeTop = 0;
	document.addEventListener('astro:before-swap', () => {
		treeTop = treeScroller()?.scrollTop ?? 0;
	});
	document.addEventListener('astro:after-swap', () => {
		const scroller = treeScroller();
		if (scroller) scroller.scrollTop = treeTop;
	});

	eachPage((signal) => {
		labelFold();
		const split = document.querySelector<HTMLElement>('.split');
		const divider = document.querySelector<HTMLElement>('.split-divider');
		if (!split || !divider) return;

		divider.addEventListener('pointerdown', (e) => {
			e.preventDefault();
			// Held, so a canvas or an embed under the pointer cannot take the drag.
			divider.setPointerCapture(e.pointerId);
			const rect = split.getBoundingClientRect();
			// Where it is now, whichever rule put it there.
			const tree = split.querySelector<HTMLElement>('.split-list');
			let last = (tree?.getBoundingClientRect().width ?? 0) / rootFont() || 19;
			split.classList.add('is-dragging');
			const move = (ev: PointerEvent) => {
				const most = Math.min(MOST_REM, (rect.width * 0.6) / rootFont());
				last = Math.min(most, Math.max(LEAST_REM, (ev.clientX - rect.left) / rootFont()));
				place(Math.round(last * 100) / 100, false);
			};
			const up = () => {
				window.removeEventListener('pointermove', move);
				window.removeEventListener('pointerup', up);
				split.classList.remove('is-dragging');
				place(last, true);
			};
			window.addEventListener('pointermove', move, { signal });
			window.addEventListener('pointerup', up, { signal });
		});

		divider.addEventListener('dblclick', () => {
			document.documentElement.style.removeProperty('--split');
			try {
				localStorage.removeItem('split-rem');
			} catch {}
		});
	});
</script>
