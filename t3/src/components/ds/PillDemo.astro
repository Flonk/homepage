---
import Pill from '../Pill.astro';
---

<div class="row" data-pill-demo>
	<Pill sides={['RGB', 'HSL', 'OKLCH']} label="Colour space" />
</div>

<script>
	// A switch that nobody has wired to anything still has to throw, or the
	// specimen is a picture of a switch. A press takes the next side and the
	// last one wraps, which is what a host with more than two of them does.
	for (const pill of document.querySelectorAll<HTMLElement>('[data-pill-demo] .pill')) {
		const sides = pill.querySelectorAll('.side').length;
		pill.addEventListener('click', () => {
			const at = (Number(pill.dataset.at ?? 0) + 1) % sides;
			pill.dataset.at = String(at);
			if (sides === 2) pill.setAttribute('aria-checked', String(at === 1));
		});
	}
</script>

<style>
	.row {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		align-items: center;
	}
</style>
