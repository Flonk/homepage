---
// Every colour the stylesheet names, by family, each family one strip. Derive,
// never transcribe: the families are read out of global.css by name, and each
// cell is painted with the token itself rather than a hex copied from it, so
// the accent's strip is whatever accent the page is wearing. What each one
// comes to is read off the painted cell in the browser (below).
import css from '../../styles/global.css?raw';

const declared = new Set([...css.matchAll(/^\s*--([a-z0-9-]+):/gm)].map(([, name]) => name));

// Touching cells are a ladder, read as one thing going in steps; cells apart
// are things side by side, each ringed in its own FLB. A ladder holds its
// chroma and hue and steps only its lightness, so that is all its cells say.
const FAMILIES = [
	{ label: 'accent', match: /^accent(-\d00)?$/, apart: false, ladder: false },
	{ label: 'ink', match: /^ink-\d00$/, apart: false, ladder: true },
	{ label: 'pointing ink', match: /^ink-(?!step)[a-z]+$/, apart: true, ladder: false },
	{ label: 'ground', match: /^ground-\d00$/, apart: true, ladder: true },
];

// How often each is used, counted where it is written as RadiusScale counts
// corners, the workbench's own components left out. A line declaring a token
// of the stylesheet's own (each rung from the first, each edge from its
// ground) is the palette working itself out, not a use.
const sheets = import.meta.glob('../../{components,layouts,pages,styles}/**/*.{astro,css}', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;
const uses = new Map<string, number>();
for (const [file, text] of Object.entries(sheets)) {
	if (file.includes('/ds/')) continue;
	for (const line of text.split('\n')) {
		if (file.includes('/styles/') && /^\s*--[a-z0-9-]+:/.test(line)) continue;
		for (const [, name] of line.matchAll(/var\(--([a-z0-9-]+)[,)]/g)) {
			uses.set(name, (uses.get(name) ?? 0) + 1);
		}
	}
}

const rows = FAMILIES.map((f) => ({
	...f,
	tokens: [...declared]
		.filter((name) => f.match.test(name))
		.map((name) => {
			const count = uses.get(name) ?? 0;
			// On the cell, only what tells it from the rest of its row; the
			// whole name is its title.
			const short = name.replace(/^(ink|ground|accent)-/, '');
			return { name, short, uses: `${count} ${count === 1 ? 'use' : 'uses'}` };
		}),
}));
---

<div class="palette" data-palette>
	{
		rows.map((row) => (
			<section class="family">
				<div class="label">{row.label}</div>
				<ol class:list={['strip', { apart: row.apart }]} data-ladder={row.ladder ? '' : undefined} style={`--cells: ${row.tokens.length}`}>
					{row.tokens.map((t) => (
						<li>
							<span class="cell" style={`--c: var(--${t.name})`} title={`--${t.name}`}>
								<span class="name">{t.short}</span>
								<span class="value" />
							</span>
							<span class="uses">{t.uses}</span>
						</li>
					))}
				</ol>
			</section>
		))
	}
</div>

<style>
	.palette {
		display: grid;
		gap: 1.75rem;
		margin-top: 1.25rem;
	}

	.label {
		margin: 0 0 0.5rem;
		font-family: var(--font-mono);
		font-size: var(--type-label);
		font-weight: normal;
		letter-spacing: var(--track-label);
		text-transform: uppercase;
		color: var(--ink-300);
	}

	.strip {
		display: grid;
		grid-template-columns: repeat(var(--cells), minmax(0, 1fr));
		margin: 0;
		padding: 0;
		list-style: none;
	}

	/* The words on a cell go black on a light one and white on a dark one,
	   switched at 0.6 lightness: the clamp is 0 or 1 and nothing between. */
	.cell {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		min-block-size: 4.5rem;
		padding: 0.4rem;
		box-sizing: border-box;
		background: var(--c);
		color: oklch(from var(--c) clamp(0, (0.6 - l) * 1000, 1) 0 0);
		font-family: var(--font-mono);
		border-block: 1px solid var(--flb);
	}

	/* A ladder: one FLB round the whole strip, not one each. */
	.strip:not(.apart) li:first-child .cell {
		border-inline-start: 1px solid var(--flb);
		border-start-start-radius: var(--radius-small);
		border-end-start-radius: var(--radius-small);
	}

	.strip:not(.apart) li:last-child .cell {
		border-inline-end: 1px solid var(--flb);
		border-start-end-radius: var(--radius-small);
		border-end-end-radius: var(--radius-small);
	}

	/* Apart: each its own flat colour, so each its own real border, itself a
	   fifth of the way to white. On a ground that is its --edge-N. */
	.apart {
		gap: 0.5rem;
	}

	.apart .cell {
		border: 1px solid oklch(from var(--c) calc(l + var(--lift) * (1 - l)) c h);
		border-radius: var(--radius-small);
	}

	.name {
		font-size: 0.85em;
	}

	.value {
		font-size: 0.58em;
		opacity: 0.8;
		min-block-size: 1.2em;
		white-space: nowrap;
		overflow: hidden;
	}

	.uses {
		display: block;
		margin-top: 0.35rem;
		padding-inline: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.6em;
		color: var(--ink-300);
	}

	@media (max-width: 720px) {
		.value {
			display: none;
		}
	}
</style>

<script>
	import { converter, parse } from 'culori';

	// What each cell comes to, as the browser painted it: for the accent's
	// family that is this post's accent, which no build could know.
	const toOklch = converter('oklch');
	function fill() {
		for (const cell of document.querySelectorAll<HTMLElement>('[data-palette] .cell')) {
			const o = toOklch(parse(getComputedStyle(cell).backgroundColor));
			const value = cell.querySelector('.value');
			if (!o || !value) continue;
			const full = `${o.l.toFixed(3)} ${o.c.toFixed(3)} ${(o.h ?? 0).toFixed(0)}`;
			value.textContent = cell.closest('[data-ladder]') ? o.l.toFixed(3) : full;
			cell.title = `${cell.title}: oklch(${full})`;
		}
	}
	document.addEventListener('astro:page-load', fill);
</script>
