---
// A ladder of the stylesheet's, --ink-* or --ground-*, read out of it the way
// Swatches reads the rest, and laid side by side so it reads as what it is:
// one colour going in even steps. Under each rung, how often it is used,
// counted where it is written as RadiusScale counts the corners.
import { converter } from 'culori';
import css from '../../styles/global.css?raw';

interface Props {
	name: 'ink' | 'ground';
}
const { name } = Astro.props;

const root = css.slice(css.indexOf(':root'), css.indexOf('\n}', css.indexOf(':root')));
const toOklch = converter('oklch');

// The workbench's own components are left out, as RadiusScale leaves them.
const sheets = import.meta.glob('../../{components,layouts,pages,styles}/**/*.{astro,css}', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;
const uses = new Map<string, number>();
for (const [file, text] of Object.entries(sheets)) {
	if (file.includes('/ds/')) continue;
	// Uses, not the ladder working itself out: a line declaring a token of the
	// stylesheet's own (each rung from the first, each edge from its ground)
	// is not a use of the rung it names.
	for (const line of text.split('\n')) {
		if (file.includes('/styles/') && /^\s*--[a-z0-9-]+:/.test(line)) continue;
		for (const [, rung] of line.matchAll(new RegExp(`var\\(--${name}-(\\d00)\\)`, 'g'))) {
			uses.set(rung, (uses.get(rung) ?? 0) + 1);
		}
	}
}

const RUNGS = [...root.matchAll(new RegExp(`--${name}-(\\d00):\\s*(#[0-9a-fA-F]{6})\\s*;`, 'g'))].map(
	([, rung, hex]) => {
		const l = toOklch(hex)!.l;
		const count = uses.get(rung) ?? 0;
		return {
			rung,
			hex,
			l: l.toFixed(3),
			ink: l > 0.6 ? 'var(--ground-200)' : 'var(--ink-100)',
			uses: `${count} ${count === 1 ? 'use' : 'uses'}`,
		};
	},
);
---

<ol class="ladder" style={`--rungs: ${RUNGS.length}`}>
	{
		RUNGS.map((r) => (
			<li>
				<span class="rung" style={`background: ${r.hex}; color: ${r.ink}`}>
					<span class="name">{r.rung}</span>
					<span class="value">{r.l}</span>
				</span>
				<span class="uses">{r.uses}</span>
			</li>
		))
	}
</ol>

<style>
	/* The rungs abreast, touching, so the steps read as a gradient and each
	   one as even as the next. One FLB round the whole strip, not one each:
	   it is one thing. */
	.ladder {
		display: grid;
		grid-template-columns: repeat(var(--rungs), 1fr);
		margin: 1.25rem 0 0;
		padding: 0;
		list-style: none;
	}

	.rung {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		block-size: 4.5rem;
		padding: 0.4rem;
		font-family: var(--font-mono);
		border-block: 1px solid var(--flb);
	}

	li:first-child .rung {
		border-inline-start: 1px solid var(--flb);
		border-start-start-radius: var(--radius-small);
		border-end-start-radius: var(--radius-small);
	}

	li:last-child .rung {
		border-inline-end: 1px solid var(--flb);
		border-start-end-radius: var(--radius-small);
		border-end-end-radius: var(--radius-small);
	}

	.name {
		font-size: 0.85em;
	}

	.value {
		font-size: 0.62em;
	}

	.uses {
		display: block;
		margin-top: 0.35rem;
		padding-inline: 0.2rem;
		font-family: var(--font-mono);
		font-size: 0.6em;
		color: var(--ink-300);
	}
</style>
