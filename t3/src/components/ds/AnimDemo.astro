---
import Pill from '../Pill.astro';
import VizTrack from '../VizTrack.astro';
import { BED_EDGE, REST_ON_PAGE } from './palette';

const BARS = ['One', 'Two', 'Three'];
---

<section
	class="glass group"
	data-anim-context
	style={`--track-rest: ${REST_ON_PAGE}; --track-edge: ${BED_EDGE}`}
>
	<div class="head">
		<p class="tag">data-anim-context</p>
		<Pill sides={['SHUTTLE', 'SINE']} label="Pacing" data-pace />
	</div>
	{BARS.map((label) => <VizTrack thumbs={1} labels={[label]} />)}
</section>

<script>
	import { contextFor, type Motion } from '../../lib/animate';
	import { shuttleAt } from '../../lib/shuttle';

	type TrackEl = HTMLElement & { track: { set(i: number, v: number): void } };

	const SECONDS = 7;
	const HOLD = 1;
	// Same round trip either way, so the pill changes the shape and nothing else.
	const CYCLE = SECONDS + 2 * HOLD;
	/** How long each pacing is shown before the pill throws itself. */
	const SHOW = 6;

	const group = document.querySelector<HTMLElement>('[data-anim-context]');
	const pace = group?.querySelector<HTMLElement>('[data-pace]');
	if (group && pace) {
		const ctx = contextFor(group);
		let sine = false;

		const show = (toSine: boolean) => {
			if (sine === toSine) return;
			sine = toSine;
			pace.dataset.at = toSine ? '1' : '0';
			pace.setAttribute('aria-checked', String(toSine));
		};

		/* The bars are `motion="none"`, so the walk is this file's rather than
		   each bar's — which is the other half of what a context is for: a host
		   with a path of its own joins the same clock, and a reader taking hold
		   of any bar holds the path too. */
		group.querySelectorAll<TrackEl>('[data-viz-track]').forEach((el, i) => {
			// A third of a cycle between them, so the group reads as one thing
			// moving rather than as three copies of one bar.
			const phase = i * (CYCLE / 3);
			const walk: Motion = {
				at: (t) =>
					sine
						? 0.5 - 0.5 * Math.cos((2 * Math.PI * (t + phase)) / CYCLE)
						: shuttleAt(t + phase, { seconds: SECONDS, hold: HOLD }),
				apply: (v) => el.track.set(0, v),
			};
			ctx.add(walk);
		});

		/* And the pill throws itself, on the same clock the bars are on — so a
		   hand on a bar stops the pacing changing underneath it, which is the
		   one thing that would make the two shapes impossible to tell apart. */
		ctx.add({
			at: (t) => Math.floor(t / SHOW) % 2,
			apply: (v) => show(v === 1),
		});

		pace.addEventListener('click', () => {
			show(!sine);
			// Long enough to watch the shape somebody just asked for.
			ctx.hold(SHOW * 2);
		});
	}
</script>

<style>
	.group {
		display: grid;
		gap: 1.25rem;
		padding: 1.25rem;
		/* Every bar here wears an edge, so every bar here needs a ring for it. */
		--track-border: 1px solid transparent;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.tag {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--text-quiet);
	}
</style>
