---
import Choice from '../Choice.astro';
import ColorSliders from '../ColorSliders.astro';
import Pill from '../Pill.astro';

/** Where the colour starts, in OKLCH. */
const START: [number, number, number] = [0.7, 0.16, 250];
const GAMUTS = ['sRGB', 'Display P3', 'Rec. 2020'];
---

<section class="glass panel" data-anim-context data-anim-demo>
	<div class="head">
		<p class="tag">data-anim-context</p>
		<Pill sides={['SHUTTLE', 'SINE', 'CHASE']} label="Pacing" data-pace />
	</div>

	<div class="row">
		<Choice class="gamut" options={GAMUTS} label="Gamut" data-gamut />
		<ColorSliders model="oklch" value={START} size="2rem" shared={false} data-sliders />
		<span class="swatch" data-swatch></span>
	</div>
</section>

<script>
	import { contextFor, type Motion } from '../../lib/animate';
	import { swatchCss, type Space, type Triple } from '../../lib/channels';
	import { chaseAt } from '../../lib/easing';
	import { shuttleAt, sineAt } from '../../lib/shuttle';

	type SlidersEl = HTMLElement & { sliders: { repaint(v: Triple): void } };

	const SECONDS = 7;
	const HOLD = 1;
	const CYCLE = SECONDS + 2 * HOLD;
	/** How long a pacing, and how long a gamut, before each throws itself. */
	const SHOW = 6;
	const STOPS = [1, 0, 0.65, 0.2];
	const SPACES: Space[] = ['srgb', 'p3', 'rec2020'];

	/* What each channel walks between, which is not the whole of what it can
	   hold. Lightness taken to either end puts the swatch at black or white for
	   a second or two, and takes the other two bars with it — every ramp here
	   is drawn for the lightness the colour is at. A band that stays a colour
	   is the one worth watching. */
	const WALK: [number, number][] = [
		[0.35, 0.9],
		[0, 0.3],
		[0, 360],
	];

	const panel = document.querySelector<HTMLElement>('[data-anim-demo]');
	const pace = panel?.querySelector<HTMLElement>('[data-pace]');
	const gamut = panel?.querySelector<HTMLElement>('[data-gamut]');
	const sliders = panel?.querySelector<SlidersEl>('[data-sliders]');
	const swatch = panel?.querySelector<HTMLElement>('[data-swatch]');

	if (panel && pace && gamut && sliders && swatch) {
		const ctx = contextFor(panel);
		const bars = [...sliders.querySelectorAll<HTMLElement & { track: { set(i: number, v: number): void } }>(
			'[data-viz-track]',
		)];
		const rows = [...gamut.querySelectorAll<HTMLButtonElement>('.row')];

		let pacing = 0;
		let mineUntil = 0;
		const mine = () => performance.now() < mineUntil;
		const claim = () => (mineUntil = performance.now() + SHOW * 2 * 1000);

		/* One motion for the three channels, because they are one colour between
		   them: three would be three clocks agreeing by luck, and the point of a
		   context is that they cannot disagree. */
		const walk: Motion = {
			at: (t) => t,
			apply: (t) => {
				const value = WALK.map((_, i) => {
					// A third of a cycle apart, so the three read as one colour
					// moving rather than as three bars doing the same thing.
					const u = t + (i * CYCLE) / 3;
					const at =
						pacing === 1
							? sineAt(u, { seconds: SECONDS, hold: HOLD })
							: pacing === 2
								? chaseAt(u, STOPS, CYCLE / STOPS.length)
								: shuttleAt(u, { seconds: SECONDS, hold: HOLD });
					const [lo, hi] = WALK[i];
					return lo + at * (hi - lo);
				}) as Triple;

				value.forEach((v, i) => bars[i]?.track.set(0, v));
				sliders.sliders.repaint(value);
				const { fill, edge } = swatchCss(value, (sliders.dataset.gamut ?? 'srgb') as Space);
				swatch.style.background = fill;
				swatch.style.borderColor = edge;
			},
		};
		ctx.add(walk);

		/* The pill and the menu throw themselves, on the same clock the colour
		   runs on — so a hand anywhere holds all three, and nothing changes
		   underneath somebody who is looking at it. */
		ctx.add({
			at: (t) => Math.floor(t / SHOW) % 3,
			apply: (v) => {
				if (mine() || pacing === v) return;
				pacing = v;
				pace.dataset.at = String(v);
			},
		});

		ctx.add({
			at: (t) => Math.floor(t / SHOW + 0.5) % SPACES.length,
			apply: (v) => {
				if (mine() || rows[v]?.getAttribute('aria-checked') === 'true') return;
				// Through the menu's own press, so it moves its knob and tells
				// anyone listening the same way a reader's press would.
				rows[v]?.click();
			},
		});

		gamut.addEventListener('choice:input', (event) => {
			const { index } = (event as CustomEvent).detail;
			sliders.dataset.gamut = SPACES[index];
		});

		pace.addEventListener('click', () => {
			pacing = (pacing + 1) % 3;
			pace.dataset.at = String(pacing);
			claim();
		});
		gamut.addEventListener('click', claim);
	}
</script>

<style>
	.panel {
		display: grid;
		gap: 1.5rem;
		padding: 1.25rem;
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.tag {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		color: var(--text-quiet);
	}

	/* The menu, the bars and the colour they are picking, left to right. */
	.row {
		display: flex;
		align-items: stretch;
		gap: 1.5rem;
		block-size: 11rem;
	}

	/* Its own height, not the row's: a menu is as tall as its options, and
	   stretching it only spreads them out. */
	.gamut {
		align-self: start;
	}

	/* One colour, edged in itself lifted — the same pair the bars are painted
	   from, which is what makes it the reading rather than a decoration. */
	.swatch {
		flex: 1 1 6rem;
		border-radius: var(--radius-large);
		border: 1px solid;
	}
</style>
