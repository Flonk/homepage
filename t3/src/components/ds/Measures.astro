---
// The lengths that are decided once and then meant everywhere. Written down
// rather than derived: unlike the tokens they are not all in one place to be
// read out of, and unlike the radii they are not a scale to be counted.
const MEASURES = [
	['--header-height', '5rem', "The orange block, and a deck post's T3 mark. One number so the two line up."],
	['--page-border', '2px', 'The accent frame. Full-viewport layouts subtract it from 100dvh.'],
	['main max-width', '720px', 'The column. Set in global.css, not a token.'],
	['body', '14px / 1.7', '15px under 720px. Prose bodies switch to the serif; everything else stays mono.'],
];
---

<table class="measures">
	<tbody>
		{
			MEASURES.map(([name, value, note]) => (
				<tr>
					<th>{name}</th>
					<td>{value}</td>
					<td class="note">{note}</td>
				</tr>
			))
		}
	</tbody>
</table>

<style>
	.measures {
		border-collapse: collapse;
		margin-top: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.9em;
	}

	.measures th,
	.measures td {
		text-align: left;
		vertical-align: top;
		padding: 0.4rem 1rem 0.4rem 0;
		border-bottom: 1px solid var(--edge);
	}

	.measures th {
		color: var(--nord8);
		font-weight: 400;
		white-space: nowrap;
	}

	.note {
		font-family: var(--font-prose);
		color: var(--text-quiet);
	}
</style>
