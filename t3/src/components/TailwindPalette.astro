---
/**
 * Tailwind's palette, and the same palette built rather than chosen.
 *
 * Since version 4 every colour Tailwind ships is written in the stylesheet as
 * an `oklch()` triple, which is worth showing on its own — this is not a
 * palette converted into the space to illustrate something, it is one that
 * arrives in it on a very large number of sites. But written in OKLCH is not
 * the same as generated in OKLCH, and this palette plainly was not. The steps
 * were picked by eye, family by family, and a row of 500s runs from L 80% at
 * the yellow to L 62% at the blue.
 *
 * So the switch rebuilds them, the way the pitch says you can: fix the hue,
 * and move the lightness slider. Every family gets the hue of its own 500 and
 * nothing else of its own — the lightness of each step and the chroma asked
 * for at each step are two ladders every family shares, so each row is the
 * same ramp turned to a different hue.
 *
 * The switch says HANDMADE rather than UNIFORM because uniform overclaims:
 * the lightness is exactly uniform, and the chroma cannot be. What a hue can
 * hold at a given lightness is a fact about sRGB, not a setting, so the rows
 * still differ in colourfulness — by no more than Tailwind's own rows do, but
 * they differ.
 *
 * The chroma ladder is one *ask* rather than one value: every family asks for
 * the same chroma at a given step — the most any of them spends there — and
 * takes what sRGB has if that is less. Asking for the most rather than the
 * average matters, because a shared lightness costs chroma: a hue is at its
 * most colourful at its own lightness, and holding all eight to one ladder
 * moves each of them off it. Asking high buys that back. The built palette
 * comes out at about nine tenths of the picked one's chroma, with no more
 * variation between rows than Tailwind has itself — while its lightness
 * variation, which runs to seventeen points at the 500s, goes to nothing.
 *
 * The ask has to taper with the ladder, which is the part that took three
 * goes. A flat ask, or the family's own 500 at every step, is a huge demand
 * up at L 92 where almost nothing is available — so each swatch got handed
 * its own hue's boundary instead, and those boundaries are 0.22 for lime and
 * 0.04 for blue. That is a row of 200s with the lime and the teal blazing and
 * the rest nearly grey. Holding every family down to what the *tightest* hue
 * can reach fixes the disagreement, but pays for it everywhere, and the point
 * of the card is that generating a palette costs you nothing.
 *
 * The Tailwind swatches are painted with their own `oklch()` values rather
 * than with sRGB worked out here, which is the one place this series does not
 * do its own colour maths. Several of the 400s and 500s ask for more chroma
 * than sRGB holds, and what a reader should meet is what their own screen
 * does with them.
 */
import { fitChroma } from '../lib/oklch';
import { TAILWIND, STEPS, oklch, type Family, type Shade } from '../lib/tailwind';

interface Props {
	/**
	 * Which families to show, by name, in this order. All of them by default,
	 * though a card wanting a point rather than a wall should pick a few.
	 */
	families?: string[];
	/** Name each row beside it. */
	labels?: boolean;
	/** Offer the switch. */
	toggle?: boolean;
	/**
	 * Seconds between the switch throwing itself. The card is making one point
	 * and it is a point you have to watch happen, so nobody should have to find
	 * the control to see it — the same reason the solids in part seven turn
	 * themselves over. Zero to leave it still.
	 */
	every?: number;
	/** Which side to start on. */
	mode?: 'tailwind' | 'handmade';
	/**
	 * Each swatch as the grey of its own lightness. The rows are families, so
	 * a column that is not one flat grey is a step that is not one lightness —
	 * which is the whole difference between the two sides of the switch.
	 */
	grey?: boolean;
	/** Seconds between one row arriving and the next. */
	stagger?: number;
}

const {
	families,
	labels = false,
	toggle = true,
	every = 4,
	mode = 'tailwind',
	grey = false,
	stagger = 0.03,
} = Astro.props;

const shown: Family[] = families
	? (families
			.map((n) => TAILWIND.find((f) => f.name === n))
			.filter(Boolean) as Family[])
	: TAILWIND;

/* One lightness ladder for everybody: what Tailwind uses at this step,
   averaged over the families on show. Averaged rather than invented so that
   the two sides of the switch sit at the same overall brightness — what
   changes between them is whether a step means one lightness, not how light
   the palette is. */
const ladder = STEPS.map((_, i) => shown.reduce((sum, f) => sum + f.shades[i].l, 0) / shown.length);

/* And one chroma ask per step: the most any family on show spends there.
   Every family asks for it and gets it, unless its own hue cannot hold that
   much at that lightness, in which case it gets what there is. It has to
   taper with the ladder — a flat ask up at L 92, where almost nothing is
   available, hands each swatch its own hue's boundary instead, and those run
   from 0.22 at the lime to 0.04 at the blue. */
const asked = STEPS.map((_, i) => Math.max(...shown.map((f) => f.shades[i].c)));

/* One hue per family, and the shared ladders. Nothing here is the step's own
   any more, which is the point: every row is the same ramp, and the only
   thing that tells them apart is the number that was fixed. */
const handmade = (family: Family, i: number): Shade => {
	const h = family.shades[STEPS.indexOf(500)].h;
	return { step: STEPS[i], l: ladder[i], c: fitChroma(ladder[i], asked[i], h), h };
};

/* Every label as wide as the longest, so the swatches all begin in the same
   place. Left to their own widths, each row would give up a different amount
   to its name and no two rows would line up. */
const label = Math.max(...shown.map((f) => f.name.length));
---

<figure
	class="palette"
	data-tailwind-palette
	data-mode={mode}
	data-every={every}
	data-grey={String(grey)}
	style={`--stagger: ${stagger}s; --steps: ${STEPS.length}; --families: ${shown.length}; --label: ${label}ch`}
>
	<div
		class="grid"
		role="img"
		aria-label={`${shown.length} families of ${STEPS.length} shades, every one of them an OKLCH colour`}
	>
		{
			shown.map((family, i) => (
				<div class="family" style={`--i: ${i}`}>
					{labels && <span class="name">{family.name}</span>}
					{family.shades.map((s, step) => {
						const u = handmade(family, step);
						return (
							<span
								class="swatch"
								style={[
									`--fill: ${oklch(s)}`,
									`--flat: ${oklch(u)}`,
									`--grey: oklch(${(s.l * 100).toFixed(1)}% 0 0)`,
									`--flat-grey: oklch(${(u.l * 100).toFixed(1)}% 0 0)`,
								].join('; ')}
							/>
						);
					})}
				</div>
			))
		}
	</div>

	{
		toggle && (
			<div class="controls">
				<button
					class="toggle"
					type="button"
					role="switch"
					aria-checked={mode === 'handmade' ? 'true' : 'false'}
					aria-label="Show the hand-built palette instead"
					data-swap
				>
					<span class="knob" aria-hidden="true" />
					<span class="side" data-side="tailwind" aria-hidden="true">
						TAILWIND
					</span>
					<span class="side" data-side="handmade" aria-hidden="true">
						HANDMADE
					</span>
				</button>
			</div>
		)
	}
</figure>

<style>
	.palette {
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.7rem;
		font-family: var(--font-mono);
		color: var(--deck-ink-dim, #8891a0);
	}

	/* One row per family, one column per step, and the rows keep coming — how
	   many families there are is the grid's business, not the layout's.

	   As tall as it is wide, per swatch: the rows share whatever height there
	   is and the columns whatever width, so a card showing eight families over
	   a whole pane gets swatches three times as wide as they are high. The cap
	   is the label column plus one row-height per step, which is what square
	   means here. Width, cap and centring all three — auto margins on a flex
	   item's cross axis switch its stretch off, which leaves the grid
	   shrink-wrapped around its labels. */
	.grid {
		flex: 1;
		align-self: stretch;
		display: flex;
		flex-direction: column;
		/* A pixel, not a fraction of one. At 0.2rem the gap was 3.2 device
		   pixels against swatches whose own widths land wherever the division
		   leaves them, so the lines between them rendered a pixel wider in some
		   places than others — which reads as uneven spacing rather than as a
		   grid. */
		gap: 1px;
		min-block-size: 0;
		inline-size: 100%;
		max-inline-size: calc(var(--label) + var(--steps) / var(--families) * 76cqh);
		margin-inline: auto;
	}

	.family {
		flex: 1 1 0;
		min-block-size: 0;
		display: flex;
		align-items: stretch;
		gap: 1px;
		/* Where each row comes in from, and how long it waits its turn. The
		   delay is the resting state's, so the palette builds on the way in and
		   leaves all at once rather than unbuilding itself backwards. */
		opacity: 0;
		transform: translateX(-0.5rem);
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.palette[data-shown='true'] .family {
		opacity: 1;
		transform: none;
		transition-delay: calc(var(--i) * var(--stagger));
	}

	.swatch {
		flex: 1 1 0;
		min-inline-size: 0;
		min-block-size: 0;
		border-radius: var(--radius-tight);
		background: var(--fill);
		/* Slow enough to read as one palette becoming another rather than as a
		   cut between two pictures. */
		transition: background-color 0.5s ease;
	}

	.palette[data-mode='handmade'] .swatch {
		background: var(--flat);
	}

	.palette[data-grey='true'] .swatch {
		background: var(--grey);
	}

	.palette[data-grey='true'][data-mode='handmade'] .swatch {
		background: var(--flat-grey);
	}

	.name {
		flex: none;
		/* The longest name plus a little: `ch` counts characters and the tracking
		   between them is extra, so an exact fit wraps the longest one. */
		inline-size: calc(var(--label) + 0.6em);
		padding-inline-end: 0.5em;
		white-space: nowrap;
		align-self: center;
		text-align: end;
		font-size: 0.7rem;
		line-height: 1;
		letter-spacing: 0.02em;
	}

	.controls {
		flex: none;
		margin-block-end: 1em;
	}

	/* The same smoked glass the other pictures put their controls on. */
	.toggle {
		position: relative;
		display: grid;
		grid-template-columns: 1fr 1fr;
		align-items: center;
		padding: 0.2rem;
		border: 0;
		border-radius: var(--radius-pill);
		background: var(--pill, rgb(12 14 17 / 0.62));
		box-shadow:
			inset 0 0 0 1px rgb(255 255 255 / 0.12),
			0 4px 16px rgb(0 0 0 / 0.15);
		backdrop-filter: blur(6px);
		font: inherit;
		font-size: 0.7rem;
		letter-spacing: 0.1em;
		color: inherit;
		cursor: pointer;
	}

	.knob {
		position: absolute;
		z-index: 0;
		inset: 0.2rem auto 0.2rem 0.2rem;
		width: calc(50% - 0.2rem);
		border-radius: var(--radius-pill);
		background: rgb(255 255 255 / 0.16);
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
		transition: transform 0.35s cubic-bezier(0.35, 0.1, 0.2, 1);
	}

	.palette[data-mode='handmade'] .knob {
		transform: translateX(100%);
	}

	.side {
		position: relative;
		z-index: 1;
		padding: 0.3rem 0.7rem;
		transition: color 0.35s ease;
	}

	.palette[data-mode='tailwind'] .side[data-side='tailwind'],
	.palette[data-mode='handmade'] .side[data-side='handmade'] {
		color: var(--deck-ink, #e6e9ef);
	}

	.toggle:focus-visible {
		outline: 2px solid var(--accent, #f7a800);
		outline-offset: 3px;
	}

	@container viz (max-width: 34rem) {
		.name {
			font-size: 0.6rem;
		}

		.toggle {
			font-size: 0.62rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.family,
		.swatch,
		.knob {
			transition: none;
		}
	}
</style>

<script>
	function initPalette(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ?? root.closest<HTMLElement>('[data-viz-stage]');
		const swap = root.querySelector<HTMLButtonElement>('[data-swap]');
		const still = matchMedia('(prefers-reduced-motion: reduce)');
		const AUTHORED = {
			mode: root.dataset.mode ?? 'tailwind',
			grey: root.dataset.grey === 'true',
			every: Number(root.dataset.every) || 0,
		};

		const setMode = (to: string) => {
			root.dataset.mode = to;
			swap?.setAttribute('aria-checked', String(to === 'handmade'));
		};

		const flip = () => setMode(root.dataset.mode === 'handmade' ? 'tailwind' : 'handmade');

		/* The switch throws itself, and stops dead while the card is off stage:
		   a deck three slides away should not be quietly ticking. A reader who
		   throws it themselves is not overruled a moment later — their click
		   restarts the clock, so the next turn is a full interval away. */
		let every = AUTHORED.every;
		let timer = 0;

		function stopTurning() {
			clearInterval(timer);
			timer = 0;
		}

		function startTurning() {
			stopTurning();
			if (every > 0 && !still.matches) timer = setInterval(flip, every * 1000);
		}

		swap?.addEventListener('click', () => {
			flip();
			startTurning();
		});

		/* From nothing, again. Two frames rather than one: the rows have to be
		   painted in their starting state before the class that moves them off it
		   lands, or the browser sees one style and there is no transition to run
		   — which is exactly what a reader coming back to the card would get. */
		let queued = 0;
		function replay() {
			cancelAnimationFrame(queued);
			if (still.matches) {
				root.dataset.shown = 'true';
				return;
			}
			root.dataset.shown = 'false';
			queued = requestAnimationFrame(() => {
				queued = requestAnimationFrame(() => {
					root.dataset.shown = 'true';
				});
			});
		}

		/* Staged from here as well as from viz:enter. A phase is rendered inactive
		   and only told otherwise by the deck's own script, so a reader arriving on
		   this card directly — a reload, a link with a number on the end — may have
		   this script run first, see an inactive phase, and wait for an arrival
		   that already happened. Parameters arrive either way. */
		host?.addEventListener('viz:props', (e) => {
			const p = ((e as CustomEvent).detail ?? {}) as Record<string, unknown>;
			setMode(typeof p.mode === 'string' ? p.mode : AUTHORED.mode);
			root.dataset.grey = String('grey' in p ? Boolean(p.grey) : AUTHORED.grey);
			every = 'every' in p ? Number(p.every) || 0 : AUTHORED.every;
			replay();
			startTurning();
		});

		host?.addEventListener('viz:enter', () => {
			replay();
			startTurning();
		});
		host?.addEventListener('viz:exit', () => {
			cancelAnimationFrame(queued);
			stopTurning();
			root.dataset.shown = 'false';
		});
		still.addEventListener('change', () => {
			replay();
			startTurning();
		});

		// Outside a deck, or already the card on screen: nothing will announce it.
		if (!host || host.dataset.vizActive !== 'false') {
			replay();
			startTurning();
		}
	}

	document.querySelectorAll<HTMLElement>('[data-tailwind-palette]').forEach(initPalette);
</script>
