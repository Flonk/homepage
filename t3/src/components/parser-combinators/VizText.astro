---
/**
 * A piece of raw text as the picture, and nothing else: the input a card is
 * about to parse, shown as it came, before any parser has touched it.
 *
 *   <VizText text={PING} />
 *
 * Set as code on the deck's ground, sized so its longest line fits the pane's
 * width and all its lines its height, whichever is tighter.
 */
interface Props {
	text: string;
}

const { text } = Astro.props;
const lines = text.split('\n');
const cols = Math.max(...lines.map((l) => l.length));
---

<figure class="viz-text" style={`--cols: ${cols}; --rows: ${lines.length}`}>
	<div class="fit">
		<code>{text}</code>
	</div>
</figure>

<style>
	.viz-text {
		box-sizing: border-box;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		margin: 0 0 1em;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	/* The box the type is fitted to. */
	.fit {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		container-type: size;
	}

	code {
		padding: 0;
		background: none;
		border: 0;
		font-family: var(--font-code);
		/* A monospace character is about 0.6em wide; a line, 1.5em tall. */
		font-size: min(1rem, calc(100cqi / (var(--cols) * 0.62)), calc(100cqh / (var(--rows) * 1.5)));
		line-height: 1.5;
		white-space: pre;
		color: var(--deck-ink, #e6e9ef);
	}
</style>
