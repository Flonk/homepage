---
/**
 * The visualization pane of a deck: declared once, shared by every card.
 *
 * Cards deliberately do not own their viz. If they did, two cards showing the
 * same thing would be two separate instances, and moving between them could
 * only ever cross-fade one into the other — never carry the same one across
 * with its state intact, and never hand it new parameters. So the viz lives
 * out here, and a card says only how it should be set up while that card is on
 * screen. Parameters are the whole interface:
 *
 *   <DeckViz><RgbCube /></DeckViz>
 *
 *   <DeckCard vizProps={{ lock: [1, 0, 0] }}>…</DeckCard>   reconfigure it
 *   <DeckCard>…</DeckCard>                                  change nothing
 *
 * Showing a different component is the same move, not a second mechanism: wrap
 * each one in a <VizPhase> and switch with the reserved `phase` parameter,
 * which is the one key DeckPost keeps for itself. Everything else is forwarded
 * to whatever is on stage.
 *
 *   <DeckViz>
 *     <VizPhase name="cube"><RgbCube /></VizPhase>
 *     <VizPhase name="gamut"><GamutSlice /></VizPhase>
 *   </DeckViz>
 *
 *   <DeckCard vizProps={{ phase: 'gamut' }}>…</DeckCard>    cross-fades
 *
 * A picture that belongs over the viz rather than instead of it is a third
 * thing again — see <VizImage>, switched with the reserved `overlay`.
 *
 * Whatever is on stage is capped at `--viz-max` and centred, so no picture
 * runs the whole width of a large screen. A visualization that genuinely needs
 * more room raises the property on itself rather than setting its own width;
 * that way the cap stays one number in one place. See the style below.
 *
 * A visualization is handed its parameters as the `detail` of a `viz:props`
 * event, and hears `viz:enter` / `viz:exit` as its phase comes and goes. All
 * three fire on the enclosing <VizPhase>, or on this element when there are
 * none — so a stage holding several pieces reaches all of them at once.
 *
 * `framed` sets the whole stage in a frame, so the line between it and the
 * text is plain to see: a gutter of the dark ground round a rounded panel a
 * shade lighter than the deck's ground, as <ChromePane fill="ground"> frames
 * a single picture. On the stage rather than round each phase, so the frame
 * holds still while the phases cross-fade inside it.
 *
 *   <DeckViz framed>…</DeckViz>
 */
interface Props {
	framed?: boolean;
}

const { framed = false } = Astro.props;
---

<div class:list={['deck-viz', framed && 'is-framed']} data-viz-stage>
	<slot />
</div>

<style>
	.deck-viz {
		grid-area: viz;
		min-width: 0;
		min-height: 0;
		/* How wide any one visualization may get, however much monitor there is.
		   The pane is a wide, shallow band, and a picture stretched the whole way
		   across a large screen stops being one thing to look at: the eye has to
		   travel to take it in, and every square viz — the cube, the wheel — is
		   left as an island in the middle of it anyway, because a square in a
		   shallow band is capped by the band's height whatever the width.

		   Set here rather than in each visualization so they all agree without
		   having to know about each other, and as a custom property so one that
		   genuinely needs more room can raise it on itself. */
		--viz-max: 42rem;
		/* A size container, so a visualization can lay itself out from the shape
		   of its own pane rather than the viewport. `size` rather than
		   `inline-size` because whether the pane is portrait or landscape is
		   the interesting question, and that needs both axes. */
		container: viz / size;
		/* One cell, so phases stack and can cross-fade. A lone visualization
		   simply fills it. */
		display: grid;
		grid-template: 'pane' minmax(0, 1fr) / minmax(0, 1fr);
		/* No bottom padding: a viz may run to the pane edge and be clipped by it. */
		padding: 1rem 1rem 0;
		overflow: hidden;
	}

	/* Framed: the panel drawn under the phases, inset by the gutter, which is
	   as wide as the page's frame (see ChromePane); the phases kept the same
	   room inside it as they have in the bare pane, and off its bottom edge. */
	.deck-viz.is-framed {
		--frame: var(--page-border, 4px);
		position: relative;
		isolation: isolate;
		padding: calc(var(--frame) + 1rem) calc(var(--frame) + 1rem) calc(var(--frame) + 0.5rem);
		background: var(--ground-200);
	}
	.deck-viz.is-framed::before {
		content: '';
		position: absolute;
		inset: var(--frame);
		z-index: -1;
		border-radius: calc(var(--content-radius, 13px) - 1px);
		/* The deck's ground, four percent toward white. */
		background: color-mix(in oklab, var(--deck-ground), white 4%);
		box-shadow: inset 0 0 0 1px var(--flb-subtle);
	}

	/* :global, because slotted children carry the caller's scope, not ours. */
	.deck-viz > :global(*) {
		grid-area: pane;
		min-width: 0;
		min-height: 0;
	}

	/* The cap, and the column it leaves centred in the pane. `width: 100%` with
	   auto margins rather than `justify-self: center`, which would shrink-wrap
	   the child instead of capping it — and a box sized to its contents, whose
	   contents are sized to it, has nothing to resolve against.

	   It lands on the visualization itself, never on a wrapper: a phase is
	   skipped here and caps its own child instead (see VizPhase), so that the
	   one box carrying the cap is the one that can lift it, by declaring
	   `--viz-max` on itself. A cap on the wrapper would be out of that reach.

	   Overlays are left out on purpose: <VizImage> shrink-wraps its picture and
	   centres itself, because the frame it draws has to be the picture's own
	   edge. It is already capped against the pane in `cq` units. */
	.deck-viz > :global(*:not([data-viz-overlay]):not([data-viz-phase])) {
		width: 100%;
		max-width: var(--viz-max);
		margin-inline: auto;
	}
</style>
