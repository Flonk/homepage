---
/**
 * An interactive RGB colour cube.
 *
 *   bars (R/G/B)  |  spinning cube  |  swatch
 *
 * A dot traces a Lissajous curve through the cube; the bars and the swatch show
 * the colour at the dot. The cube is opaque, so the dot is always drawn on top
 * and its opacity stands in for how much material is in front of it. Drag the cube to spin it — it keeps its momentum and
 * eases back to its ambient rotation. Move any bar and the dot stops tracing to
 * follow your input, resuming a few seconds after you stop.
 */
interface Props {
	/** Seconds of no input before the dot resumes its Lissajous curve. */
	idleResume?: number;
}

const { idleResume = 3 } = Astro.props;
---

<div class="rgb-cube" data-rgb-cube data-no-swipe data-idle-resume={idleResume}>
	<div class="bars" role="group" aria-label="Colour channels">
		<label class="bar" style="--channel: #f16d6d">
			<input type="range" min="0" max="255" value="128" aria-label="Red" />
			<span class="bar-key">R</span>
			<span class="bar-val">128</span>
		</label>
		<label class="bar" style="--channel: #7bd88f">
			<input type="range" min="0" max="255" value="128" aria-label="Green" />
			<span class="bar-key">G</span>
			<span class="bar-val">128</span>
		</label>
		<label class="bar" style="--channel: #6d9bf1">
			<input type="range" min="0" max="255" value="128" aria-label="Blue" />
			<span class="bar-key">B</span>
			<span class="bar-val">128</span>
		</label>
	</div>

	<div class="stage">
		<canvas data-canvas></canvas>
	</div>

	<div class="readout">
		{/* The colour readout: an S that bisects the pane diagonally, filling the
		    lower-right side. Reshape by editing this path — the viewBox is a flat
		    0-100 square stretched to the pane, so coordinates are percentages and
		    values past the edges simply run off frame.

		    It splits the pane in half at any size: the chord runs corner to
		    corner, which halves a rectangle, and the two control points sit
		    symmetrically about the centre (50,50), so the lobe the S adds on one
		    side is exactly the lobe it takes from the other. Keep that symmetry
		    when reshaping and the halving survives. */}
		<svg
			class="swatch"
			data-swatch
			viewBox="0 0 100 100"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<path
				d="M -10 112 C 48 88, 52 12, 110 -12 L 112 112 Z"
			></path>
		</svg>
		<span class="hex" data-hex>#808080</span>
	</div>
</div>

<style>
	.rgb-cube {
		/* ---- composition knobs ------------------------------------------
		   Everything about where things sit is here; nothing below needs
		   touching to re-arrange the picture. Percentages are of the viz pane.

		   The swatch's shape lives in its SVG path above, not here. */

		--pad-left: clamp(1rem, 10vw, 9rem); /* space before the bars */
		--pad-right: clamp(1rem, 8vw, 7rem); /* space after the cube */
		--bar-gap: clamp(0.75rem, 2vw, 1.75rem); /* bars to cube */
		--cube-scale: 0.55; /* cube size, as a fraction of the pane's short side */

		position: relative;
		display: flex;
		align-items: stretch;
		justify-content: center;
		padding: 0 var(--pad-right) 0 var(--pad-left);
		gap: var(--bar-gap);
		width: 100%;
		height: 100%;
		min-height: 0;
		box-sizing: border-box;
		font-family: var(--font-mono);
		/* The viz sits on a light ground (see --deck-ground), so its chrome is
		   inked dark rather than light. */
		--ink: #35302a;
		--ink-dim: #7a7264;
		--line: #b3a993;
		color: var(--ink);
	}

	/* --- channel bars --- */

	.bars {
		position: relative;
		z-index: 1;
		flex: none;
		display: flex;
		gap: 0.6rem;
		align-items: stretch;
		padding: 0.25rem 0;
	}

	.bar {
		display: grid;
		grid-template-rows: minmax(0, 1fr) auto auto;
		justify-items: center;
		gap: 0.3rem;
		min-height: 0;
	}

	/* Real range inputs, so keyboard and touch work. writing-mode makes them
	   vertical and direction:rtl puts the maximum at the top. The track is wider
	   than the thumb, so the thumb sits inside the bar rather than straddling it. */
	.bar input {
		writing-mode: vertical-lr;
		direction: rtl;
		appearance: none;
		-webkit-appearance: none;
		width: 2rem;
		height: 100%;
		min-height: 0;
		margin: 0;
		padding: 0;
		background: transparent;
		cursor: ns-resize;
		touch-action: none;
	}

	.bar input::-webkit-slider-runnable-track {
		width: 2rem;
		height: 100%;
		border-radius: 4px;
		border: 1px solid var(--line);
		background: linear-gradient(to top, #000, var(--channel));
	}

	.bar input::-moz-range-track {
		width: 2rem;
		height: 100%;
		border-radius: 4px;
		border: 1px solid var(--line);
		background: linear-gradient(to top, #000, var(--channel));
	}

	.bar input::-webkit-slider-thumb {
		appearance: none;
		-webkit-appearance: none;
		/* Spans the bar rather than sitting inside it. */
		width: 2rem;
		height: 0.5rem;
		margin-left: 0;
		border-radius: 2px;
		background: var(--ink);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.55);
	}

	.bar input::-moz-range-thumb {
		width: 2rem;
		height: 0.5rem;
		border: none;
		border-radius: 2px;
		background: var(--ink);
		box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.55);
	}

	.bar input:focus-visible::-webkit-slider-runnable-track {
		border-color: var(--accent);
	}

	.bar-key {
		font-size: 0.7rem;
		color: var(--ink-dim);
	}

	.bar-val {
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		color: var(--ink);
	}

	/* --- cube --- */

	.stage {
		position: relative;
		z-index: 1;
		flex: 1;
		min-width: 0;
		min-height: 0;
		display: flex;
	}

	.stage canvas {
		width: 100%;
		height: 100%;
		cursor: grab;
		touch-action: none;
	}

	.stage canvas:active {
		cursor: grabbing;
	}

	/* --- swatch --- */

	/* Out of flow, so the bars and cube can sit over it. */
	.readout {
		display: contents;
	}

	/* Only the top fifth clears the bottom of the pane. The rest is clipped by
	   the viz half, so it reads as a huge disc rising into frame. */
	/* Covers the whole pane, bleeding past .rgb-cube's padding so the S meets
	   the pane edges; the viz half clips it. */
	.swatch {
		position: absolute;
		z-index: 0;
		top: -1rem;
		right: -1rem;
		bottom: 0;
		left: -1rem;
		/* Sized explicitly, not by the insets: an svg carrying a viewBox is a
		   replaced element, so width/height:auto would give it the viewBox's own
		   1:1 ratio and render it square, dropping most of the S below the pane.
		   The extra rem covers .card-viz's padding, so the S meets the edges. */
		width: calc(100% + 2rem);
		height: calc(100% + 1rem);
		pointer-events: none;
	}

	.swatch path {
		fill: var(--swatch-color, #808080);
	}

	/* Bottom-left, so it is always over the beige rather than over the disc,
	   whose colour is anything at all. */
	.hex {
		position: absolute;
		z-index: 1;
		left: 0.75rem;
		bottom: 0.4rem;
		font-size: 0.75rem;
		color: var(--ink-dim);
		font-variant-numeric: tabular-nums;
		pointer-events: none;
	}

	/* ==== container queries ==============================================
	   These respond to the viz pane (see DeckCard), not the viewport, so the
	   cube lays itself out from the space it actually has. */

	/* Tighter pane: the bars give up width first — the cube is the point. */
	@container viz (max-width: 46rem) {
		.rgb-cube {
			--pad-left: 1rem;
			--pad-right: 1rem;
			--bar-gap: 0.9rem;
		}
		.bars {
			gap: 0.4rem;
		}
		.bar input,
		.bar input::-webkit-slider-runnable-track,
		.bar input::-webkit-slider-thumb,
		.bar input::-moz-range-track,
		.bar input::-moz-range-thumb {
			width: 1.25rem;
		}
	}

	@container viz (max-width: 30rem) {
		.rgb-cube {
			--pad-left: 0.6rem;
			--pad-right: 0.6rem;
			--bar-gap: 0.6rem;
		}
		.bar input,
		.bar input::-webkit-slider-runnable-track,
		.bar input::-webkit-slider-thumb,
		.bar input::-moz-range-track,
		.bar input::-moz-range-thumb {
			width: 0.9rem;
		}
		.bar-val {
			display: none;
		}
		.hex {
			display: none;
		}
	}

	/* Portrait pane: stack instead, and turn the bars on their side. A column
	   of vertical bars would eat the height the cube needs. */
	@container viz (max-aspect-ratio: 1 / 1) {
		.rgb-cube {
			flex-direction: column;
			align-items: stretch;
			padding: 0.5rem 0.75rem 0;
			gap: 0.5rem;
		}

		.bars {
			flex: none;
			flex-direction: column;
			gap: 0.35rem;
			width: 100%;
			padding: 0;
		}

		.bar {
			width: 100%;
			grid-template-rows: auto;
			grid-template-columns: auto minmax(0, 1fr) auto;
			align-items: center;
			gap: 0.45rem;
		}

		.bar-key {
			grid-column: 1;
			grid-row: 1;
		}
		.bar input {
			grid-column: 2;
			grid-row: 1;
		}
		.bar-val {
			grid-column: 3;
			grid-row: 1;
			min-width: 3ch;
			text-align: right;
		}

		.bar input {
			writing-mode: horizontal-tb;
			direction: ltr;
			width: 100%;
			height: 1rem;
			cursor: ew-resize;
		}

		.bar input::-webkit-slider-runnable-track,
		.bar input::-moz-range-track {
			width: 100%;
			height: 1rem;
			background: linear-gradient(to right, #000, var(--channel));
		}

		.bar input::-webkit-slider-thumb,
		.bar input::-moz-range-thumb {
			width: 0.45rem;
			height: 1rem;
			margin-left: 0;
		}

		.stage {
			flex: 1;
			min-height: 0;
		}

		.hex {
			display: none;
		}
	}
</style>

<script>
	type Quat = [number, number, number, number]; // x, y, z, w

	const IDENTITY: Quat = [0, 0, 0, 1];

	const qMul = (a: Quat, b: Quat): Quat => [
		a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
		a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
		a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
		a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2],
	];

	const qNorm = (q: Quat): Quat => {
		const l = Math.hypot(q[0], q[1], q[2], q[3]) || 1;
		return [q[0] / l, q[1] / l, q[2] / l, q[3] / l];
	};

	const qAxisAngle = (x: number, y: number, z: number, a: number): Quat => {
		const l = Math.hypot(x, y, z);
		if (!l || !a) return IDENTITY;
		const s = Math.sin(a / 2) / l;
		return [x * s, y * s, z * s, Math.cos(a / 2)];
	};

	/** Nudge `q` toward `target` by `t`, taking the short way round. */
	const qSlerp = (q: Quat, target: Quat, t: number): Quat => {
		let dot = q[0] * target[0] + q[1] * target[1] + q[2] * target[2] + q[3] * target[3];
		let to = target;
		if (dot < 0) {
			to = [-target[0], -target[1], -target[2], -target[3]];
			dot = -dot;
		}
		if (dot > 0.9995) {
			return qNorm([
				q[0] + (to[0] - q[0]) * t,
				q[1] + (to[1] - q[1]) * t,
				q[2] + (to[2] - q[2]) * t,
				q[3] + (to[3] - q[3]) * t,
			]);
		}
		const theta = Math.acos(dot);
		const s = Math.sin(theta);
		const wa = Math.sin((1 - t) * theta) / s;
		const wb = Math.sin(t * theta) / s;
		return qNorm([
			q[0] * wa + to[0] * wb,
			q[1] * wa + to[1] * wb,
			q[2] * wa + to[2] * wb,
			q[3] * wa + to[3] * wb,
		]);
	};

	/** 3x3 rotation matrix (column-major) from a quaternion. */
	const qMatrix = (q: Quat) => {
		const [x, y, z, w] = q;
		return [
			1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w),
			2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w),
			2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y),
		];
	};

	/* --- face textures ------------------------------------------------------
	   A face's colours never change, only where it is on screen. So each face is
	   rasterised once, pixel by pixel, into its own texture and then mapped onto
	   the projected face. That gives an exact gradient rather than the banded
	   approximation a grid of flat-shaded quads produced.

	   Under perspective a face projects to a general quadrilateral, which no
	   affine transform can hit, so each face is drawn as a K x K grid of texture
	   pieces. The corners of every piece are projected properly, so the face's
	   outline — and the cube's silhouette — stay exact; only the interpolation
	   inside a piece is approximated, and that error falls off as 1/K². Each
	   face is clipped to its own outline so the deliberate overlap between
	   pieces, which hides hairline seams, cannot spill past the edge.

	   Textures are identical for every instance, so they are built once and
	   shared. */
	const TEX = 128;
	const SUB = 8; // pieces per face edge; TEX must divide by this
	const STEP = TEX / SUB;
	const FACES: Array<{ axis: number; val: number }> = [];
	for (let axis = 0; axis < 3; axis++) for (const val of [0, 1]) FACES.push({ axis, val });

	let faceTex: HTMLCanvasElement[] | null = null;

	function buildFaceTextures() {
		if (faceTex) return faceTex;
		faceTex = FACES.map(({ axis, val }) => {
			const u = (axis + 1) % 3;
			const v = (axis + 2) % 3;
			const c = document.createElement('canvas');
			c.width = TEX;
			c.height = TEX;
			const g = c.getContext('2d')!;
			const img = g.createImageData(TEX, TEX);
			const d = img.data;
			for (let j = 0; j < TEX; j++) {
				for (let i = 0; i < TEX; i++) {
					const p = [0, 0, 0];
					p[axis] = val;
					p[u] = i / (TEX - 1);
					p[v] = j / (TEX - 1);
					const o = (j * TEX + i) * 4;
					d[o] = p[0] * 255;
					d[o + 1] = p[1] * 255;
					d[o + 2] = p[2] * 255;
					d[o + 3] = 255;
				}
			}
			g.putImageData(img, 0, 0);
			return c;
		});
		return faceTex;
	}

	/** Indices of the convex hull of a point set, counter-clockwise (monotone chain). */
	const convexHull = (xs: number[], ys: number[]) => {
		const idx = xs.map((_, i) => i).sort((a, b) => xs[a] - xs[b] || ys[a] - ys[b]);
		const cross = (o: number, a: number, b: number) =>
			(xs[a] - xs[o]) * (ys[b] - ys[o]) - (ys[a] - ys[o]) * (xs[b] - xs[o]);
		const lower: number[] = [];
		for (const i of idx) {
			while (lower.length >= 2 && cross(lower[lower.length - 2], lower[lower.length - 1], i) <= 0)
				lower.pop();
			lower.push(i);
		}
		const upper: number[] = [];
		for (let k = idx.length - 1; k >= 0; k--) {
			const i = idx[k];
			while (upper.length >= 2 && cross(upper[upper.length - 2], upper[upper.length - 1], i) <= 0)
				upper.pop();
			upper.push(i);
		}
		lower.pop();
		upper.pop();
		return lower.concat(upper);
	};

	function initCube(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const ctx = canvas.getContext('2d')!;
		const inputs = Array.from(root.querySelectorAll<HTMLInputElement>('input[type="range"]'));
		const vals = Array.from(root.querySelectorAll<HTMLElement>('.bar-val'));
		const swatch = root.querySelector<HTMLElement>('[data-swatch]')!;
		const hexOut = root.querySelector<HTMLElement>('[data-hex]')!;

		const IDLE_MS = (Number(root.dataset.idleResume) || 3) * 1000;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const textures = buildFaceTextures();


		/* ---- orientation ---------------------------------------------------
		   Ambient spin about a deliberately irregular axis, plus a user offset
		   that carries its own momentum and decays back to nothing. Keeping them
		   separate is what lets the cube take a throw and still come home. */
		const AMBIENT_AXIS = [0.35, 1, 0.22];
		const AMBIENT_RATE = 0.22; // rad/s
		// Start on a three-quarter view; face-on it just reads as a flat square.
		const BASE: Quat = qNorm(qMul(qAxisAngle(1, 0, 0, 0.46), qAxisAngle(0, 1, 0, -0.62)));
		let ambient = 0;
		let offset: Quat = IDENTITY;
		let velX = 0; // rad/s, from throwing the cube
		let velY = 0;
		let dragging = false;
		let pointerId: number | null = null;

		/* ---- the dot -------------------------------------------------------
		   Incommensurate frequencies, so the curve never quite repeats. */
		const FREQ = [0.031, 0.044, 0.027];
		const PHASE = [0, 1.7, 3.1];
		let t = 0;
		let manualUntil = 0;
		let manual = [0.5, 0.5, 0.5];
		let resumeFrom: number[] | null = null;
		let resumeAt = 0;
		let rgb = [0.5, 0.5, 0.5];
		let lastCss = '';

		const lissajous = (time: number) => [
			0.5 + 0.5 * Math.sin(time * FREQ[0] * Math.PI * 2 + PHASE[0]),
			0.5 + 0.5 * Math.sin(time * FREQ[1] * Math.PI * 2 + PHASE[1]),
			0.5 + 0.5 * Math.sin(time * FREQ[2] * Math.PI * 2 + PHASE[2]),
		];

		/* ---- input ---------------------------------------------------------- */

		inputs.forEach((input, i) => {
			input.addEventListener('input', () => {
				const at = performance.now();
				// Seed from the dot only when *entering* manual control. Re-seeding on
				// every event would lose any change made earlier in the same frame,
				// since `rgb` has not caught up yet.
				if (at >= manualUntil) manual = rgb.slice();
				manual[i] = Number(input.value) / 255;
				manualUntil = at + IDLE_MS;
				resumeFrom = null;
			});
		});

		canvas.addEventListener('pointerdown', (e) => {
			dragging = true;
			pointerId = e.pointerId;
			canvas.setPointerCapture(e.pointerId);
			velX = 0;
			velY = 0;
			e.preventDefault();
		});

		canvas.addEventListener('pointermove', (e) => {
			if (!dragging || e.pointerId !== pointerId) return;
			const k = 0.01;
			const dx = e.movementX * k;
			const dy = e.movementY * k;
			// Horizontal drag spins about the screen's vertical axis, and vice versa.
			offset = qNorm(qMul(qMul(qAxisAngle(0, 1, 0, dx), qAxisAngle(1, 0, 0, dy)), offset));
			velY = dx * 60;
			velX = dy * 60;
		});

		const endDrag = (e: PointerEvent) => {
			if (e.pointerId !== pointerId) return;
			dragging = false;
			pointerId = null;
		};
		canvas.addEventListener('pointerup', endDrag);
		canvas.addEventListener('pointercancel', endDrag);

		/* ---- sizing ---------------------------------------------------------- */

		let w = 0;
		let h = 0;
		let dpr = 1;
		let cubeScale = 0.5;
		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			cubeScale =
				parseFloat(getComputedStyle(root).getPropertyValue('--cube-scale')) || 0.5;
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = Math.max(1, Math.round(h * dpr));
		};
		new ResizeObserver(resize).observe(canvas);
		resize();

		/* ---- render loop ------------------------------------------------------ */

		// Distance from the eye to the origin, in cube-side units. Drives both the
		// projection and the ray used to measure material in front of the dot.
		const FOCAL = 3.4;
		let last = 0;
		const front = new Int32Array(6);
		const hullX: number[] = new Array(8).fill(0);
		const hullY: number[] = new Array(8).fill(0);

		function frame(now: number) {
			requestAnimationFrame(frame);

			// Other cards stay in the DOM but are invisible; don't burn frames.
			const card = root.closest<HTMLElement>('[data-card]');
			if (card && card.dataset.state && card.dataset.state !== 'active') return;
			if (!w || !h) return;

			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;

			// --- orientation
			if (!reduceMotion) ambient += AMBIENT_RATE * dt;
			if (!dragging) {
				const decay = Math.exp(-1.8 * dt);
				velX *= decay;
				velY *= decay;
				if (Math.abs(velX) > 1e-4 || Math.abs(velY) > 1e-4) {
					offset = qNorm(
						qMul(
							qMul(qAxisAngle(0, 1, 0, velY * dt), qAxisAngle(1, 0, 0, velX * dt)),
							offset,
						),
					);
				}
				offset = qSlerp(offset, IDENTITY, 1 - Math.exp(-1.1 * dt));
			}
			const m = qMatrix(
				qMul(
					qMul(
						offset,
						qAxisAngle(AMBIENT_AXIS[0], AMBIENT_AXIS[1], AMBIENT_AXIS[2], ambient),
					),
					BASE,
				),
			);

			// --- the dot
			if (!reduceMotion) t += dt;
			if (now < manualUntil) {
				rgb = manual;
				resumeFrom = null;
			} else {
				const target = lissajous(t);
				if (manualUntil) {
					// Ease out of manual control rather than snapping back.
					resumeFrom = rgb.slice();
					resumeAt = now;
					manualUntil = 0;
				}
				if (resumeFrom) {
					const k = Math.min(1, (now - resumeAt) / 800);
					const e = k * k * (3 - 2 * k);
					rgb = [
						resumeFrom[0] + (target[0] - resumeFrom[0]) * e,
						resumeFrom[1] + (target[1] - resumeFrom[1]) * e,
						resumeFrom[2] + (target[2] - resumeFrom[2]) * e,
					];
					if (k >= 1) resumeFrom = null;
				} else {
					rgb = target;
				}
			}

			// --- readouts, only touched when they actually change
			const r8 = Math.round(Math.min(1, Math.max(0, rgb[0])) * 255);
			const g8 = Math.round(Math.min(1, Math.max(0, rgb[1])) * 255);
			const b8 = Math.round(Math.min(1, Math.max(0, rgb[2])) * 255);
			const css = `rgb(${r8} ${g8} ${b8})`;
			if (css !== lastCss) {
				lastCss = css;
				root.style.setProperty('--swatch-color', css);
				hexOut.textContent =
					'#' + [r8, g8, b8].map((v) => v.toString(16).padStart(2, '0')).join('');
				const bytes = [r8, g8, b8];
				for (let i = 0; i < 3; i++) {
					vals[i].textContent = String(bytes[i]);
					if (document.activeElement !== inputs[i]) inputs[i].value = String(bytes[i]);
				}
			}

			// --- project (perspective)
			const scale = Math.min(w, h) * cubeScale;
			const cx = w / 2;
			const cy = h / 2;

			const vx = (x: number, y: number, z: number) =>
				m[0] * (x - 0.5) + m[3] * (y - 0.5) + m[6] * (z - 0.5);
			const vy = (x: number, y: number, z: number) =>
				m[1] * (x - 0.5) + m[4] * (y - 0.5) + m[7] * (z - 0.5);
			const pz = (x: number, y: number, z: number) =>
				m[2] * (x - 0.5) + m[5] * (y - 0.5) + m[8] * (z - 0.5);

			const px = (x: number, y: number, z: number) =>
				cx + vx(x, y, z) * scale * (FOCAL / (FOCAL - pz(x, y, z)));
			const py = (x: number, y: number, z: number) =>
				cy - vy(x, y, z) * scale * (FOCAL / (FOCAL - pz(x, y, z)));

			// --- which faces point at us. The solid is opaque and convex, so the
			// front-facing set never overlaps itself and needs no depth sorting.
			const camV = [0, 0, FOCAL];
			let nFront = 0;
			for (let f = 0; f < 6; f++) {
				const { axis, val } = FACES[f];
				const u = (axis + 1) % 3;
				const v = (axis + 2) % 3;
				const mid = [0.5, 0.5, 0.5];
				mid[axis] = val;
				const nModel = [0, 0, 0];
				nModel[axis] = val === 1 ? 1 : -1;
				// outward normal and centre, both in view space
				const nvx = m[0] * nModel[0] + m[3] * nModel[1] + m[6] * nModel[2];
				const nvy = m[1] * nModel[0] + m[4] * nModel[1] + m[7] * nModel[2];
				const nvz = m[2] * nModel[0] + m[5] * nModel[1] + m[8] * nModel[2];
				const cvx = vx(mid[0], mid[1], mid[2]);
				const cvy = vy(mid[0], mid[1], mid[2]);
				const cvz = pz(mid[0], mid[1], mid[2]);
				const facing =
					nvx * (camV[0] - cvx) + nvy * (camV[1] - cvy) + nvz * (camV[2] - cvz);
				if (facing <= 0) continue;
				front[nFront++] = f;
				void u;
				void v;
			}

			// --- how much cube sits between the dot and the camera.
			// Work in model space, where the cube is the unit box and the dot is
			// simply its own rgb. The camera is the view-space eye rotated back.
			const camM = [
				0.5 + m[2] * FOCAL,
				0.5 + m[5] * FOCAL,
				0.5 + m[8] * FOCAL,
			];
			const dm = [rgb[0] - camM[0], rgb[1] - camM[1], rgb[2] - camM[2]];
			let tEnter = 0;
			for (let a = 0; a < 3; a++) {
				if (Math.abs(dm[a]) < 1e-9) continue;
				const ta = (0 - camM[a]) / dm[a];
				const tb = (1 - camM[a]) / dm[a];
				tEnter = Math.max(tEnter, Math.min(ta, tb));
			}
			// t = 1 is the dot, so the remaining fraction is the material in front.
			const thickness = Math.max(0, 1 - tEnter) * Math.hypot(dm[0], dm[1], dm[2]);
			// Beer-Lambert-ish, with a floor so a deep dot stays findable.
			const dotAlpha = Math.max(0.16, Math.exp(-1.7 * thickness));

			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);
			ctx.imageSmoothingEnabled = true;
			ctx.imageSmoothingQuality = "high";
			ctx.globalAlpha = 1;

			// --- contact shadow. Fill the silhouette — the hull of the eight
			// projected corners — with a heavily blurred black, then paint the
			// opaque faces over the top. Only the bleed around the edges survives,
			// which reads as ambient occlusion for the cost of one extra fill.
			for (let i = 0; i < 8; i++) {
				const X = (i >> 0) & 1;
				const Y = (i >> 1) & 1;
				const Z = (i >> 2) & 1;
				hullX[i] = px(X, Y, Z);
				hullY[i] = py(X, Y, Z);
			}
			const hull = convexHull(hullX, hullY);
			// The shadow bleeds outward from the silhouette, and the canvas is the
			// only surface it can land on, so a blur wider than the gap to the
			// canvas edge gets sliced off square. Give it no more room than there
			// is, and it fades out instead of being cut.
			let gap = Infinity;
			for (const k of hull) {
				gap = Math.min(gap, hullX[k], w - hullX[k], hullY[k], h - hullY[k]);
			}
			const room = Math.max(0, gap - 1);
			ctx.save();
			ctx.shadowColor = "rgba(40, 30, 14, 0.55)";
			ctx.shadowBlur = Math.min(scale * 0.34, room * 0.8);
			ctx.shadowOffsetY = Math.min(scale * 0.09, room * 0.2);
			ctx.fillStyle = "#000";
			ctx.beginPath();
			for (let i = 0; i < hull.length; i++) {
				const k = hull[i];
				if (i === 0) ctx.moveTo(hullX[k], hullY[k]);
				else ctx.lineTo(hullX[k], hullY[k]);
			}
			ctx.closePath();
			ctx.fill();
			ctx.restore();

			for (let k = 0; k < nFront; k++) {
				const f = front[k];
				const { axis, val } = FACES[f];
				const u = (axis + 1) % 3;
				const v = (axis + 2) % 3;
				const at = (uu: number, vv: number) => {
					const p = [0, 0, 0];
					p[axis] = val;
					p[u] = uu;
					p[v] = vv;
					return p;
				};

				// clip to the face outline, so piece overlap cannot spill past it
				const q = [at(0, 0), at(1, 0), at(1, 1), at(0, 1)];
				ctx.save();
				ctx.beginPath();
				for (let c = 0; c < 4; c++) {
					const X = px(q[c][0], q[c][1], q[c][2]);
					const Y = py(q[c][0], q[c][1], q[c][2]);
					if (c === 0) ctx.moveTo(X, Y);
					else ctx.lineTo(X, Y);
				}
				ctx.closePath();
				ctx.clip();

				for (let i = 0; i < SUB; i++) {
					for (let j = 0; j < SUB; j++) {
						const u0 = i / SUB;
						const u1 = (i + 1) / SUB;
						const v0 = j / SUB;
						const v1 = (j + 1) / SUB;
						const p00 = at(u0, v0);
						const p10 = at(u1, v0);
						const p01 = at(u0, v1);
						const X0 = px(p00[0], p00[1], p00[2]);
						const Y0 = py(p00[0], p00[1], p00[2]);
						const ax = (px(p10[0], p10[1], p10[2]) - X0) / STEP;
						const ay = (py(p10[0], p10[1], p10[2]) - Y0) / STEP;
						const bx = (px(p01[0], p01[1], p01[2]) - X0) / STEP;
						const by = (py(p01[0], p01[1], p01[2]) - Y0) / STEP;
						const sxs = i * STEP;
						const sys = j * STEP;
						ctx.setTransform(
							dpr * ax, dpr * ay,
							dpr * bx, dpr * by,
							dpr * (X0 - ax * sxs - bx * sys),
							dpr * (Y0 - ay * sxs - by * sys),
						);
						// overdraw by half a texel; the clip keeps it inside the face
						ctx.drawImage(
							textures[f],
							sxs, sys, STEP, STEP,
							sxs - 0.5, sys - 0.5, STEP + 1, STEP + 1,
						);
					}
				}
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.restore();

				// face outline: adjacent faces share an edge colour exactly, so
				// without these the solid reads as a blob with no visible structure
				ctx.beginPath();
				for (let c = 0; c < 4; c++) {
					const X = px(q[c][0], q[c][1], q[c][2]);
					const Y = py(q[c][0], q[c][1], q[c][2]);
					if (c === 0) ctx.moveTo(X, Y);
					else ctx.lineTo(X, Y);
				}
				ctx.closePath();
				ctx.strokeStyle = "rgba(0,0,0,0.22)";
				ctx.lineWidth = 1;
				ctx.stroke();
			}

			// --- the dot, always on top. Its opacity stands in for how much of the
			// (now opaque) cube is in front of it.
			ctx.globalAlpha = dotAlpha;
			ctx.beginPath();
			ctx.arc(
				px(rgb[0], rgb[1], rgb[2]),
				py(rgb[0], rgb[1], rgb[2]),
				Math.max(4, scale * 0.038),
				0,
				Math.PI * 2,
			);
			ctx.fillStyle = "#000";
			ctx.fill();

			ctx.globalAlpha = 1;
		}

		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-rgb-cube]').forEach(initCube);
</script>
