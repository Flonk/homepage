---
/**
 * An interactive RGB colour cube.
 *
 *   bars (R/G/B)  |  spinning cube  |  swatch
 *
 * A dot traces a Lissajous curve through the cube; the bars and the swatch show
 * the colour at the dot. The cube is opaque, so the dot is always drawn on top
 * and its opacity stands in for how much material is in front of it. Drag the
 * cube to spin it — it keeps its momentum and eases back to its ambient
 * rotation. Move any bar and the dot stops tracing to follow your input,
 * resuming a few seconds after you stop.
 *
 * Rendered with WebGL, and deliberately without a 3D library: the point of the
 * picture is that the colours are right, and every engine worth using has a
 * colour-management and tone-mapping stage that would quietly rewrite them on
 * the way to the screen. Twelve triangles are not worth losing that control
 * over. See the shaders below for what does and does not happen to a value.
 */
interface Props {
	/**
	 * Seconds of no input before the dots resume their resting behaviour.
	 * Touching any thumb holds *both* ends still for this long, not just the one
	 * being moved: setting one colour against another is hard if the other keeps
	 * drifting while you do it.
	 */
	idleResume?: number;
	/** Ambient rotation. */
	spin?: boolean;
	/**
	 * Pin the dot at this colour, 0-1 per channel, instead of letting it trace.
	 * It eases there rather than jumping, and the bars still override it for a
	 * few seconds at a time.
	 */
	lock?: [number, number, number] | null;
	/**
	 * Visit the eight corners in random order instead of tracing the curve,
	 * holding each for this many seconds. Takes precedence over `lock`.
	 */
	tour?: number | null;
	/**
	 * Show a second colour: a second set of thumbs on each bar, a second dot in
	 * the cube, and the line between the two. The swatch becomes the gradient
	 * along that line, which is the point — a straight line through the cube is
	 * exactly a linear gradient between its ends.
	 */
	line?: boolean;
	/**
	 * Three lines through each dot, one along each axis and each spanning the
	 * cube, saying where the dot sits on all three channels at once. Off by
	 * default: it is a lot of extra ink for a card that is not making a point
	 * about coordinates.
	 */
	guides?: boolean;
}

/* The two ends are told apart by shape rather than by hue: solid for the first,
   hollow for the second. Colouring them would be a lie in a picture whose whole
   subject is which colour is where. */
import ColorSliders from './ColorSliders.astro';

/* Only the starting values now: what a channel bar looks like is
   ColorSliders' business. In a deck these are also the parameters a card can
   set, which is why they are named rather than written inline. */
const CHANNELS = [
	{ a: 128, b: 40 },
	{ a: 128, b: 200 },
	{ a: 128, b: 90 },
];

// Gradient ids are document-global, so more than one cube on a page would
// otherwise share — and fight over — the same one.
const gradId = `swatch-${Math.random().toString(36).slice(2, 9)}`;

/* These are the starting values. In a deck they are also the parameters a card
   can change with `vizProps` — see DeckViz for how that reaches the listener
   further down. */
const {
	idleResume = 5,
	spin = true,
	lock = null,
	tour = null,
	line = false,
	guides = false,
} = Astro.props;
---

<div
	class="rgb-cube"
	data-rgb-cube
	data-no-swipe
	data-idle-resume={idleResume}
	data-spin={String(spin)}
	data-lock={lock ? lock.join(',') : undefined}
	data-tour={tour ?? undefined}
	data-line={String(line)}
	data-guides={String(guides)}
>
	{/* One animation context for the three of them: they are one colour between
	    them, so taking hold of any one bar has to stop the other two as well.
	    See lib/animate. */}
	<ColorSliders
		class="bars"
		model="rgb"
		value={CHANNELS.map((ch) => ch.a) as [number, number, number]}
		value2={CHANNELS.map((ch) => ch.b) as [number, number, number]}
		single={!line}
		label="Colour channels"
	/>

	<div class="stage">
		<canvas data-canvas></canvas>
	</div>

	<div class="readout">
		{/* The colour readout: an S that bisects the pane diagonally, filling the
		    lower-right side. Reshape by editing this path — the viewBox is a flat
		    0-100 square stretched to the pane, so coordinates are percentages and
		    values past the edges simply run off frame.

		    It splits the pane in half at any size: the chord runs corner to
		    corner, which halves a rectangle, and the two control points sit
		    symmetrically about the centre (50,50), so the lobe the S adds on one
		    side is exactly the lobe it takes from the other. Keep that symmetry
		    when reshaping and the halving survives. */}
		<svg
			class="swatch"
			data-swatch
			viewBox="0 0 100 100"
			preserveAspectRatio="none"
			aria-hidden="true"
		>
			<defs>
				{/* Bottom-left to top-right: the diagonal the S itself runs along,
				    and the one whose two ends both land on filled area. The box's
				    other diagonal starts in the upper-left, which the shape leaves
				    empty, so half the ramp would go unseen. With one colour both
				    stops hold it and the fill is flat, so the single-ended case
				    needs no second code path. */}
				<linearGradient id={gradId} x1="0" y1="1" x2="1" y2="0">
					<stop offset="0" stop-color="var(--swatch-a, #808080)" />
					<stop offset="1" stop-color="var(--swatch-b, var(--swatch-a, #808080))" />
				</linearGradient>
			</defs>
			<path
				d="M -10 112 C 48 88, 52 12, 110 -12 L 112 112 Z"
				fill={`url(#${gradId})`}
			></path>
		</svg>
		<div class="readout-text">
			<span class="rgb-string" data-rgb>rgb(128 128 128)</span>
			<span class="rgb-string second" data-rgb-b hidden={!line}>rgb(128 128 128)</span>
		</div>
	</div>
</div>

<style>
	.rgb-cube {
		/* ---- composition knobs ------------------------------------------
		   Everything about where things sit is here; nothing below needs
		   touching to re-arrange the picture. Percentages are of the viz pane.

		   The swatch's shape lives in its SVG path above, not here. */

		--pad-left: clamp(1rem, 10vw, 9rem); /* space before the bars */
		--pad-right: clamp(1rem, 8vw, 7rem); /* space after the cube */
		--bar-gap: clamp(0.75rem, 2vw, 1.75rem); /* bars to cube */
		--cube-scale: 0.55; /* cube size, as a fraction of the pane's short side */

		/* Out from under DeckViz's cap on how wide a visualization may get. This
		   one is already capped where it counts — the cube is sized from the
		   pane's short side and the bars are fixed — and what the extra width
		   carries is the swatch, which is a ground for the picture rather than
		   part of it and is meant to run off the end of the pane. Cap the whole
		   composition and that ground acquires an edge in the middle of the
		   pane, which is worse than either extreme. */
		--viz-max: none;

		position: relative;
		display: flex;
		align-items: stretch;
		justify-content: center;
		padding: 0 var(--pad-right) 0 var(--pad-left);
		gap: var(--bar-gap);
		width: 100%;
		height: 100%;
		min-height: 0;
		box-sizing: border-box;
		font-family: var(--font-mono);
		/* Whichever way round the deck's ground is: the post picks the pair and
		   the picture reads them (see --deck-ink in DeckPost). */
		--ink: var(--deck-ink, #35302a);
		--ink-dim: var(--deck-ink-dim, #7a7264);
		--line: #b3a993;
		color: var(--ink);
	}

	/* --- channel bars --- */

	/* The controls, on a plate of their own. Three bars loose on the ground read
	   as part of the picture; on a panel they read as the thing you are allowed
	   to touch — and the marks, which are white and lit for the spectrum's sake,
	   have something to be white against.

	   Glass rather than a colour: the swatch behind runs under this plate, and
	   what should happen there is that the colour goes soft and carries on, not
	   that a lid is put on it. */
	.bars {
		position: relative;
		z-index: 1;
		flex: none;
		display: flex;
		gap: 0.9rem;
		align-items: stretch;
		box-sizing: border-box;
		margin: 1em 0;
		padding: 1em;
		border-radius: var(--radius-large);
		background: var(--viz-glass, rgb(255 255 255 / 0.06));
		box-shadow:
			inset 0 0 0 1px var(--viz-glass-rim, rgb(255 255 255 / 0.08)),
			0 4px 16px rgb(0 0 0 / 0.15);
		backdrop-filter: blur(6px);
		color: #e6e9ef;
	}

	/* The bar's cell: the track, and the channel's letter under it. What the
	   track looks like is set here as inherited properties rather than reached
	   for with a selector — see VizTrack. */

	/* Two of them, and now they do. The marks answer the two dots in the cube
	   beside them and are inked the same way round: the first solid and dark,
	   the second hollow — pale, with the dark line round it. Each carries the
	   other's colour as its outline, so both stay legible against a ramp that
	   runs from black to a bright channel, and the dark one is ringed in the
	   channel's own bright rather than in white, which would be the hardest
	   line on the bar. */
	/* The cube's own two inks, and only on the cards that carry two thumbs:
	   one thumb is the usual white one. The lifted ring the dark one wears is
	   the component's — the channel at its loudest, which is the same
	   --channel-lit this used to hand it by name. */
	.rgb-cube[data-line='true'] .bars {
		--track-ink: #f6f1e6;
		--track-ink-dark: #000;
	}

	/* --- cube --- */

	/* Square, so it is only as wide as the cube can actually be — the cube is
	   sized from the pane's short side, which is its height. Left to flex:1 the
	   stage would swallow all the spare width and centre the cube inside it,
	   pushing the bars away from it as the pane widens. */
	.stage {
		position: relative;
		z-index: 1;
		flex: 0 0 auto;
		aspect-ratio: 1;
		min-width: 0;
		min-height: 0;
		display: flex;
	}

	/* The contact shadow. The canvas is transparent outside the cube, so a
	   drop-shadow over its own alpha *is* the silhouette's shadow — no second
	   surface to draw it on, and it is clipped by the pane rather than by the
	   canvas box, so it fades out at tight sizes instead of being sliced off.
	   The two lengths are set from the cube's on-screen size by the script. */
	.stage canvas {
		width: 100%;
		height: 100%;
		cursor: grab;
		touch-action: none;
		filter: drop-shadow(
			0 var(--shadow-y, 6px) var(--shadow-blur, 18px)
				var(--viz-shadow, rgba(40, 30, 14, 0.55))
		);
	}

	.stage canvas:active {
		cursor: grabbing;
	}

	/* --- swatch --- */

	/* Out of flow, so the bars and cube can sit over it. */
	.readout {
		display: contents;
	}

	/* Only the top fifth clears the bottom of the pane. The rest is clipped by
	   the viz half, so it reads as a huge disc rising into frame. */
	/* Covers the whole pane, bleeding past .rgb-cube's padding so the S meets
	   the pane edges; the viz half clips it. */
	.swatch {
		position: absolute;
		z-index: 0;
		top: -1rem;
		right: -1rem;
		bottom: 0;
		left: -1rem;
		/* Sized explicitly, not by the insets: an svg carrying a viewBox is a
		   replaced element, so width/height:auto would give it the viewBox's own
		   1:1 ratio and render it square, dropping most of the S below the pane.
		   The extra rem covers .card-viz's padding, so the S meets the edges. */
		width: calc(100% + 2rem);
		height: calc(100% + 1rem);
		pointer-events: none;
	}

	/* Bottom-left, so it is always over the beige rather than over the disc,
	   whose colour is anything at all. */
	/* Bottom-right, which the S always fills, so this always sits on the colour
	   itself. Its ink flips between black and white for whichever gives more
	   contrast against that colour — see the render loop. */
	.readout-text {
		position: absolute;
		z-index: 1;
		right: 0.75rem;
		bottom: 0.4rem;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.05rem;
		pointer-events: none;
	}

	.rgb-string {
		font-size: 1.125rem;
		font-variant-numeric: tabular-nums;
		color: var(--readout-ink, #000);
	}

	/* Which reading belongs to which end, marked the way the dots are. */
	.rgb-cube[data-line='true'] .rgb-string::before {
		content: '\25CF\00A0';
	}

	.rgb-cube[data-line='true'] .rgb-string.second::before {
		content: '\25CB\00A0';
	}

	/* ==== container queries ==============================================
	   These respond to the viz pane (see DeckCard), not the viewport, so the
	   cube lays itself out from the space it actually has. */

	/* Tighter pane: the bars give up width first — the cube is the point. */
	@container viz (max-width: 46rem) {
		.rgb-cube {
			--pad-left: 1rem;
			--pad-right: 1rem;
			--bar-gap: 0.9rem;
		}
		.bars {
			gap: 0.4rem;
		}
	}

	@container viz (max-width: 30rem) {
		.rgb-cube {
			--pad-left: 0.6rem;
			--pad-right: 0.6rem;
			--bar-gap: 0.6rem;
		}
		.bar input {
			width: 0.9rem;
		}
		.bar input::-webkit-slider-runnable-track {
			width: 0.9rem;
		}
		.bar input::-webkit-slider-thumb {
			width: 0.9rem;
		}
		.bar input::-moz-range-track {
			width: 0.9rem;
		}
		.bar input::-moz-range-thumb {
			width: 0.9rem;
		}
		/* Would otherwise run off a pane this narrow. */
		.rgb-string {
			font-size: 0.85rem;
		}
	}

	/* Portrait pane: stack instead, and turn the bars on their side. A column
	   of vertical bars would eat the height the cube needs. */
	@container viz (max-aspect-ratio: 1 / 1) {
		.rgb-cube {
			flex-direction: column;
			align-items: stretch;
			padding: 0.5rem 0.75rem 0;
			gap: 0.5rem;
		}

		.bars {
			flex: none;
			flex-direction: column;
			gap: 0.35rem;
			width: 100%;
			padding: 0;
		}

		.bar {
			width: 100%;
			/* Lying down. The track takes its axis from these two properties, so
			   the bars turn horizontal with the minimum at the left — see VizTrack
			   for why it is a property rather than an inherited writing mode. */
			--track-flow: horizontal-tb;
			--track-dir: ltr;
		}

		.stage {
			flex: 1;
			aspect-ratio: auto;
			min-height: 0;
		}
	}
</style>

<script>
	import { contextFor } from '../lib/animate';
	import { approach } from '../lib/easing';
	import { rgbCss, type Rgb } from '../lib/rgb';
	type Quat = [number, number, number, number]; // x, y, z, w

	const IDENTITY: Quat = [0, 0, 0, 1];

	const qMul = (a: Quat, b: Quat): Quat => [
		a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
		a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
		a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
		a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2],
	];

	const qNorm = (q: Quat): Quat => {
		const l = Math.hypot(q[0], q[1], q[2], q[3]) || 1;
		return [q[0] / l, q[1] / l, q[2] / l, q[3] / l];
	};

	const qAxisAngle = (x: number, y: number, z: number, a: number): Quat => {
		const l = Math.hypot(x, y, z);
		if (!l || !a) return IDENTITY;
		const s = Math.sin(a / 2) / l;
		return [x * s, y * s, z * s, Math.cos(a / 2)];
	};

	/** Nudge `q` toward `target` by `t`, taking the short way round. */
	const qSlerp = (q: Quat, target: Quat, t: number): Quat => {
		let dot = q[0] * target[0] + q[1] * target[1] + q[2] * target[2] + q[3] * target[3];
		let to = target;
		if (dot < 0) {
			to = [-target[0], -target[1], -target[2], -target[3]];
			dot = -dot;
		}
		if (dot > 0.9995) {
			return qNorm([
				q[0] + (to[0] - q[0]) * t,
				q[1] + (to[1] - q[1]) * t,
				q[2] + (to[2] - q[2]) * t,
				q[3] + (to[3] - q[3]) * t,
			]);
		}
		const theta = Math.acos(dot);
		const s = Math.sin(theta);
		const wa = Math.sin((1 - t) * theta) / s;
		const wb = Math.sin(t * theta) / s;
		return qNorm([
			q[0] * wa + to[0] * wb,
			q[1] * wa + to[1] * wb,
			q[2] * wa + to[2] * wb,
			q[3] * wa + to[3] * wb,
		]);
	};

	/** 3x3 rotation matrix (column-major) from a quaternion. */
	const qMatrix = (q: Quat) => {
		const [x, y, z, w] = q;
		return [
			1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w),
			2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w),
			2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y),
		];
	};

	/* --- geometry -----------------------------------------------------------
	   The cube is the unit box, so a point's coordinates *are* its sRGB channel
	   values, and a corner's position is its own colour. That is the whole
	   reason this can be exact: give the GPU one colour per corner and its
	   perspective-correct interpolation reproduces the colour under every
	   fragment with no error at all. Colour is an affine function of position,
	   and affine functions are exactly what that interpolation reconstructs. No
	   textures, no subdivision, no seams. */
	const CORNERS = new Float32Array(24);
	for (let i = 0; i < 8; i++) {
		CORNERS[i * 3] = (i >> 0) & 1;
		CORNERS[i * 3 + 1] = (i >> 1) & 1;
		CORNERS[i * 3 + 2] = (i >> 2) & 1;
	}

	/* Corner indices per face, wound counter-clockwise seen from outside, so the
	   back half can simply be culled. Face f covers axis f>>1 at the low end
	   when f is even and the high end when it is odd. */
	const FACE_QUADS = [
		[0, 4, 6, 2], // -x
		[1, 3, 7, 5], // +x
		[0, 1, 5, 4], // -y
		[2, 6, 7, 3], // +y
		[0, 2, 3, 1], // -z
		[4, 5, 7, 6], // +z
	];

	const FACE_INDICES = new Uint16Array(36);
	FACE_QUADS.forEach((q, f) => {
		FACE_INDICES.set([q[0], q[1], q[2], q[0], q[2], q[3]], f * 6);
	});

	/* The twelve edges, each tagged with the two faces it belongs to: an edge is
	   visible exactly when at least one of them faces us, which is cheaper and
	   more exact than depth-testing lines that lie in the plane of a face. */
	const EDGES: Array<{ a: number; b: number; f0: number; f1: number }> = [];
	for (let axis = 0; axis < 3; axis++) {
		const u = (axis + 1) % 3;
		const v = (axis + 2) % 3;
		for (let i = 0; i < 8; i++) {
			if ((i >> axis) & 1) continue; // take each edge from its low end only
			EDGES.push({
				a: i,
				b: i | (1 << axis),
				f0: u * 2 + ((i >> u) & 1),
				f1: v * 2 + ((i >> v) & 1),
			});
		}
	}

	/* Six vertices per line: two triangles for a screen-space quad. aEnd picks
	   which endpoint, aSide which flank. Eight floats a vertex, so one line is
	   48 of them. */
	const LINE_STRIDE = 48;
	const LINE_PATTERN = [
		[0, -1], [1, -1], [1, 1],
		[0, -1], [1, 1], [0, 1],
	];

	/** Write one line's six vertices into `out`, starting at line `i`. */
	function writeLine(out: Float32Array, i: number, a: number[], b: number[]) {
		let o = i * LINE_STRIDE;
		for (const [end, side] of LINE_PATTERN) {
			out[o] = a[0]; out[o + 1] = a[1]; out[o + 2] = a[2];
			out[o + 3] = b[0]; out[o + 4] = b[1]; out[o + 5] = b[2];
			out[o + 6] = end; out[o + 7] = side;
			o += 8;
		}
	}

	const EDGE_VERTS = new Float32Array(EDGES.length * LINE_STRIDE);
	{
		const corner = (i: number) => [CORNERS[i * 3], CORNERS[i * 3 + 1], CORNERS[i * 3 + 2]];
		EDGES.forEach((e, i) => writeLine(EDGE_VERTS, i, corner(e.a), corner(e.b)));
	}

	/* The white lines painted over the opaque faces. The cube's own far edges
	   carry more weight than the guides through the dots, which are a reading
	   aid rather than part of the shape. */
	const WIRE_ALPHA = 0.35;
	const GUIDE_ALPHA = 0.2;

	/* Three guides a dot, and there can be two dots. */
	const GUIDES = 6;

	// Distance from the eye to the cube's centre, in cube-side units. Drives the
	// projection and the ray that measures how much material hides the dot.
	const FOCAL = 3.4;

	/* Where the infinite line through two colours enters and leaves the cube.
	   The picture's claim is that a line through the cube is a gradient, and
	   that does not stop being true past the two colours someone happened to
	   pick — so the line drawn is the whole chord, with the dots marking two
	   points on it. Both ends sit inside the box, so the returned span always
	   contains them. Null when the two coincide and there is no line to speak
	   of. */
	function chord(a: number[], b: number[]) {
		const d = [b[0] - a[0], b[1] - a[1], b[2] - a[2]];
		if (Math.hypot(d[0], d[1], d[2]) < 1e-6) return null;
		let s0 = -Infinity;
		let s1 = Infinity;
		for (let i = 0; i < 3; i++) {
			// Parallel to this pair of faces: it never crosses them.
			if (Math.abs(d[i]) < 1e-9) continue;
			const ta = (0 - a[i]) / d[i];
			const tb = (1 - a[i]) / d[i];
			s0 = Math.max(s0, Math.min(ta, tb));
			s1 = Math.min(s1, Math.max(ta, tb));
		}
		if (!(s1 > s0)) return null;
		return [
			[a[0] + d[0] * s0, a[1] + d[1] * s0, a[2] + d[2] * s0],
			[a[0] + d[0] * s1, a[1] + d[1] * s1, a[2] + d[2] * s1],
		];
	}

	/* --- shaders ------------------------------------------------------------
	   One projection, shared. The eye sits at (0, 0, FOCAL) looking down -z;
	   uScale already folds in the cube's on-screen size and the viewport's
	   aspect, so the clip-space divide is the only perspective step. */
	const PROJ = `
		uniform mat3 uRot;
		uniform vec2 uScale;
		vec4 proj(vec3 p) {
			vec3 v = uRot * (p - 0.5);
			return vec4(v.x * uScale.x, v.y * uScale.y, -v.z, ${FOCAL.toFixed(4)} - v.z);
		}
	`;

	const FACE_VS = `
		attribute vec3 aPos;
		varying vec3 vColor;
		${PROJ}
		void main() {
			vColor = aPos;
			gl_Position = proj(aPos);
		}
	`;

	/* The colour arrives exact and then has to survive being written to eight
	   bits a channel, which on a ramp this wide would show as a staircase of
	   flat bands. A sub-LSB dither scatters each pixel across the two nearest
	   representable values so the local average lands on the true colour: the
	   error stops being a visible contour and becomes noise below the level
	   anyone can see. */
	const FACE_FS = `
		precision highp float;
		varying vec3 vColor;
		void main() {
			float n = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
			gl_FragColor = vec4(vColor + (n - 0.5) / 255.0, 1.0);
		}
	`;

	/* Edges are expanded to quads here rather than drawn with gl.LINES, whose
	   width is capped at one device pixel almost everywhere — that would make
	   the outline coarser on ordinary displays and hairline-thin on dense ones. */
	const EDGE_VS = `
		attribute vec3 aP0;
		attribute vec3 aP1;
		attribute float aEnd;
		attribute float aSide;
		uniform vec2 uHalf;
		uniform float uWidth;
		${PROJ}
		void main() {
			vec4 c0 = proj(aP0);
			vec4 c1 = proj(aP1);
			vec2 s0 = c0.xy / c0.w * uHalf;
			vec2 s1 = c1.xy / c1.w * uHalf;
			vec2 d = s1 - s0;
			float len = length(d);
			// An edge pointing straight at the eye projects to a point; give it
			// an arbitrary direction rather than dividing by zero.
			vec2 dir = len > 1e-5 ? d / len : vec2(1.0, 0.0);
			vec2 nrm = vec2(-dir.y, dir.x);
			vec4 c = mix(c0, c1, aEnd);
			// Overhang by half a width at each end, so corners meet cleanly.
			vec2 s = mix(s0, s1, aEnd)
				+ (nrm * aSide + dir * (aEnd * 2.0 - 1.0)) * uWidth * 0.5;
			gl_Position = vec4(s / uHalf * c.w, c.z, c.w);
		}
	`;

	const EDGE_FS = `
		precision highp float;
		uniform vec4 uColor;
		void main() {
			gl_FragColor = vec4(uColor.rgb * uColor.a, uColor.a);
		}
	`;

	/* A screen-facing quad around the dot's projected centre; the fragment
	   shader carves the disc out of it, so the dot stays round and smooth-edged
	   whatever the cube is doing. */
	const DOT_VS = `
		attribute vec2 aCorner;
		uniform vec3 uDot;
		uniform vec2 uHalf;
		uniform float uRadius;
		varying vec2 vOffset;
		${PROJ}
		void main() {
			vec4 c = proj(uDot);
			vOffset = aCorner * uRadius;
			vec2 s = c.xy / c.w * uHalf + vOffset;
			gl_Position = vec4(s / uHalf * c.w, c.z, c.w);
		}
	`;

	/* One disc for both ends. The first is solid black; the second is a light
	   disc inside a dark rim of uRim pixels. Shape rather than hue, because
	   colouring the markers in a picture about which colour is where would
	   invite exactly the wrong reading. */
	const DOT_FS = `
		precision highp float;
		uniform float uCore;
		uniform float uRim;
		uniform vec3 uFill;
		uniform float uAlpha;
		varying vec2 vOffset;
		void main() {
			float d = length(vOffset);
			float outer = 1.0 - smoothstep(uCore - 0.75, uCore + 0.75, d);
			float inner = 1.0 - smoothstep(uCore - uRim - 0.75, uCore - uRim + 0.75, d);
			float a = uAlpha * outer;
			gl_FragColor = vec4(mix(vec3(0.0), uFill, inner) * a, a);
		}
	`;

	/* The line between the two ends. Same screen-space expansion as the cube's
	   edges, but its transparency is worked out per fragment rather than once
	   for the whole primitive: how deep the line sits changes along its length,
	   so a single alpha would be wrong nearly everywhere. */
	const LINK_VS = `
		attribute float aEnd;
		attribute float aSide;
		uniform vec3 uA;
		uniform vec3 uB;
		uniform vec2 uHalf;
		uniform float uWidth;
		varying vec3 vModel;
		${PROJ}
		void main() {
			vModel = mix(uA, uB, aEnd);
			vec4 c0 = proj(uA);
			vec4 c1 = proj(uB);
			vec2 s0 = c0.xy / c0.w * uHalf;
			vec2 s1 = c1.xy / c1.w * uHalf;
			vec2 d = s1 - s0;
			float len = length(d);
			vec2 dir = len > 1e-5 ? d / len : vec2(1.0, 0.0);
			vec2 nrm = vec2(-dir.y, dir.x);
			vec4 c = mix(c0, c1, aEnd);
			vec2 s = mix(s0, s1, aEnd) + nrm * aSide * uWidth * 0.5;
			gl_Position = vec4(s / uHalf * c.w, c.z, c.w);
		}
	`;

	/* The same slab test and the same falloff the dots use, so where the line
	   meets a dot the two agree exactly. */
	const LINK_FS = `
		precision highp float;
		uniform vec3 uCam;
		varying vec3 vModel;
		float enter(float o, float d) {
			if (abs(d) < 1e-6) return 0.0;
			return min((0.0 - o) / d, (1.0 - o) / d);
		}
		void main() {
			vec3 d = vModel - uCam;
			float tEnter = max(
				0.0,
				max(enter(uCam.x, d.x), max(enter(uCam.y, d.y), enter(uCam.z, d.z)))
			);
			float thickness = max(0.0, 1.0 - tEnter) * length(d);
			float a = max(0.16, exp(-1.7 * thickness));
			gl_FragColor = vec4(0.0, 0.0, 0.0, a);
		}
	`;

	type GL = WebGLRenderingContext | WebGL2RenderingContext;

	function compile(gl: GL, type: number, src: string) {
		const sh = gl.createShader(type)!;
		gl.shaderSource(sh, src);
		gl.compileShader(sh);
		if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
			throw new Error(gl.getShaderInfoLog(sh) || 'shader failed to compile');
		}
		return sh;
	}

	function program(gl: GL, vs: string, fs: string) {
		const p = gl.createProgram()!;
		gl.attachShader(p, compile(gl, gl.VERTEX_SHADER, vs));
		gl.attachShader(p, compile(gl, gl.FRAGMENT_SHADER, fs));
		gl.linkProgram(p);
		if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
			throw new Error(gl.getProgramInfoLog(p) || 'program failed to link');
		}
		return p;
	}

	function initCube(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		/* One bar per channel, each carrying both ends. See VizTrack for what a
		   host is allowed to say to one. */
		type TrackEl = HTMLElement & {
			track: { set(i: number, v: number): void; showThumb(i: number, on: boolean): void };
		};
		const bars = Array.from(root.querySelectorAll<TrackEl>('[data-viz-track]'));
		/* The one the bars are in, so "a reader is busy" is a single fact rather
		   than a timer in here and another in each bar. VizTrack calls hold() on
		   any grab; this only has to ask whether it is holding. */
		const ctx = contextFor(root.querySelector('[data-anim-context]') ?? root);
		const rgbOut = [
			root.querySelector<HTMLElement>('[data-rgb]')!,
			root.querySelector<HTMLElement>('[data-rgb-b]')!,
		];

		/* Multisampling handles the silhouette; the gradients inside need no help,
		   since every fragment is computed rather than resampled from a texture.
		   `alpha` so the beige ground shows through and the drop shadow CSS puts
		   under the canvas has a silhouette to work from. */
		const OPTS: WebGLContextAttributes = {
			alpha: true,
			antialias: true,
			depth: true,
			premultipliedAlpha: true,
			powerPreference: 'low-power',
		};
		const gl = (canvas.getContext('webgl2', OPTS) ||
			canvas.getContext('webgl', OPTS)) as GL | null;
		// Without WebGL there is nothing sensible to draw; the bars, the swatch
		// and the readout all still work.
		if (!gl) {
			canvas.style.display = 'none';
			return;
		}

		/* The channel values are sRGB code values and are written to the frame
		   buffer as-is: no lighting, no tone mapping, no transfer-function
		   round trip, nothing that could shift them. Widening to Display P3 later
		   is one line here — `gl.drawingBufferColorSpace = 'display-p3'` — after
		   which the same coordinates address the wider gamut instead. */
		if ('drawingBufferColorSpace' in gl) gl.drawingBufferColorSpace = 'srgb';

		const progFace = program(gl, FACE_VS, FACE_FS);
		const progEdge = program(gl, EDGE_VS, EDGE_FS);
		const progDot = program(gl, DOT_VS, DOT_FS);
		const progLink = program(gl, LINK_VS, LINK_FS);

		const bufCorners = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufCorners);
		gl.bufferData(gl.ARRAY_BUFFER, CORNERS, gl.STATIC_DRAW);

		const bufFaceIdx = gl.createBuffer();
		gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, bufFaceIdx);
		gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, FACE_INDICES, gl.STATIC_DRAW);

		const bufEdges = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufEdges);
		gl.bufferData(gl.ARRAY_BUFFER, EDGE_VERTS, gl.STATIC_DRAW);

		const bufQuad = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufQuad);
		gl.bufferData(
			gl.ARRAY_BUFFER,
			new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
			gl.STATIC_DRAW,
		);

		// Rewritten every frame: the guides move with the colours.
		const guideData = new Float32Array(GUIDES * LINE_STRIDE);
		const bufGuides = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufGuides);
		gl.bufferData(gl.ARRAY_BUFFER, guideData.byteLength, gl.DYNAMIC_DRAW);

		// Two triangles: a quad the line is stretched across in screen space.
		const bufLink = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufLink);
		gl.bufferData(
			gl.ARRAY_BUFFER,
			new Float32Array([0, -1, 1, -1, 1, 1, 0, -1, 1, 1, 0, 1]),
			gl.STATIC_DRAW,
		);

		const uni = (p: WebGLProgram, n: string) => gl.getUniformLocation(p, n);
		const U = {
			face: { rot: uni(progFace, 'uRot'), scale: uni(progFace, 'uScale') },
			edge: {
				rot: uni(progEdge, 'uRot'),
				scale: uni(progEdge, 'uScale'),
				half: uni(progEdge, 'uHalf'),
				width: uni(progEdge, 'uWidth'),
				color: uni(progEdge, 'uColor'),
			},
			dot: {
				rot: uni(progDot, 'uRot'),
				scale: uni(progDot, 'uScale'),
				half: uni(progDot, 'uHalf'),
				radius: uni(progDot, 'uRadius'),
				core: uni(progDot, 'uCore'),
				alpha: uni(progDot, 'uAlpha'),
				pos: uni(progDot, 'uDot'),
				rim: uni(progDot, 'uRim'),
				fill: uni(progDot, 'uFill'),
			},
			link: {
				rot: uni(progLink, 'uRot'),
				scale: uni(progLink, 'uScale'),
				half: uni(progLink, 'uHalf'),
				width: uni(progLink, 'uWidth'),
				a: uni(progLink, 'uA'),
				b: uni(progLink, 'uB'),
				cam: uni(progLink, 'uCam'),
			},
		};

		const A = {
			pos: gl.getAttribLocation(progFace, 'aPos'),
			p0: gl.getAttribLocation(progEdge, 'aP0'),
			p1: gl.getAttribLocation(progEdge, 'aP1'),
			end: gl.getAttribLocation(progEdge, 'aEnd'),
			side: gl.getAttribLocation(progEdge, 'aSide'),
			corner: gl.getAttribLocation(progDot, 'aCorner'),
			linkEnd: gl.getAttribLocation(progLink, 'aEnd'),
			linkSide: gl.getAttribLocation(progLink, 'aSide'),
		};

		/* Attribute arrays are global state, not per-program, so anything left
		   enabled by the previous draw would still be read by the next one. */
		const useAttribs = (locs: number[]) => {
			for (let i = 0; i < 4; i++) gl.disableVertexAttribArray(i);
			for (const l of locs) if (l >= 0) gl.enableVertexAttribArray(l);
		};

		gl.clearColor(0, 0, 0, 0);
		gl.depthFunc(gl.LESS);
		gl.frontFace(gl.CCW);
		gl.cullFace(gl.BACK);
		gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA); // sources are premultiplied

		/** sRGB relative luminance, for choosing readable ink over a colour. */
		const luminance = (r: number, g: number, b: number) => {
			const lin = (c: number) => {
				const v = c / 255;
				return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
			};
			return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
		};

		/* How long a reader's turn is held for. Kept as seconds and handed to the
		   bars, which are what actually count it out — see VizTrack and
		   lib/animate. */
		let idleSeconds = Number(root.dataset.idleResume) || 5;
		const tellBars = () => bars.forEach((b) => (b.dataset.idleResume = String(idleSeconds)));
		let spin = root.dataset.spin !== 'false';
		let lock: number[] | null = root.dataset.lock
			? root.dataset.lock.split(',').map(Number)
			: null;
		let tour: number | null = root.dataset.tour ? Number(root.dataset.tour) : null;
		let line = root.dataset.line === 'true';
		let guides = root.dataset.guides === 'true';
		/* How this was authored. A card's parameter set is complete rather than a
		   patch — the deck has already merged it onto the sets before it — so a
		   card that says nothing about a parameter is saying it should be back to
		   this, not that it should be left wherever the last card put it. */
		const AUTHORED = { idleSeconds, spin, lock, tour, line, guides };
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		/* The pane, or the phase of it, that this belongs to when it is inside a
		   deck. Parameters arrive there rather than here, so one event reaches
		   every piece a stage happens to hold. */
		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ??
			root.closest<HTMLElement>('[data-viz-stage]');
		// Only a stage split into phases can have an inactive one.
		const gate = root.closest<HTMLElement>('[data-viz-phase]');

		/* ---- orientation ---------------------------------------------------
		   Ambient spin about a deliberately irregular axis, plus a user offset
		   that carries its own momentum and decays back to nothing. Keeping them
		   separate is what lets the cube take a throw and still come home. */
		const AMBIENT_AXIS = [0.35, 1, 0.22];
		const AMBIENT_RATE = 0.055; // rad/s
		// Start on a three-quarter view; face-on it just reads as a flat square.
		const BASE: Quat = qNorm(qMul(qAxisAngle(1, 0, 0, 0.46), qAxisAngle(0, 1, 0, -0.62)));
		let ambient = 0;
		/* Where a reader has put it, and it stays there. This used to ease back
		   to nothing a moment after a drag, so every turn a reader gave the cube
		   was taken away from them again — spin it to see the far side and it
		   creeps back to the front. The throw still coasts to a stop, because
		   that is the velocity below and velocity decays; the orientation it
		   leaves behind does not. */
		let offset: Quat = IDENTITY;
		let velX = 0; // rad/s, from throwing the cube
		let velY = 0;
		let dragging = false;
		let pointerId: number | null = null;

		/* ---- the dots -------------------------------------------------------
		   Incommensurate frequencies, so a curve never quite repeats. Both ends
		   ride the same curve at different phases, so they stay well apart
		   without ever moving in step. Everything about an end is per-end, so
		   grabbing one bar's thumb leaves the other end alone. */
		const FREQ = [0.031, 0.044, 0.027];
		const PHASES = [
			[0, 1.7, 3.1],
			[2.4, 5.0, 0.9],
		];

		const makeEnd = (phase: number[]) => ({
			phase,
			rgb: [0.5, 0.5, 0.5],
			/* Where this end was when the hold began, and the channels a reader
			   has moved since. Two things rather than one, because they arrive in
			   an order nothing controls: the bar holds the context on pointerdown
			   and the value lands before the next frame, so a snapshot taken in
			   that frame would wipe what the reader had already said. */
			frozen: [0.5, 0.5, 0.5],
			override: [null, null, null] as (number | null)[],
			wasHeld: false,
			resumeFrom: null as number[] | null,
			resumeAt: 0,
			wasPinned: false,
		});

		const ends = PHASES.map(makeEnd);
		let t = 0;
		let lastCss = '';

		/* The corner tour. Corner i is just its own index in binary — bit 0 is
		   red, bit 1 green, bit 2 blue — which is the same correspondence the
		   cube is built from. Stepping by one to seven lands uniformly on one of
		   the seven corners that is not the current one, so a hop is never a
		   stay. */
		let tourIdx = -1;
		let tourAt = 0;
		let tourTarget: number[] | null = null;

		const nextCorner = () => {
			tourIdx =
				tourIdx < 0
					? Math.floor(Math.random() * 8)
					: (tourIdx + 1 + Math.floor(Math.random() * 7)) % 8;
			return [tourIdx & 1, (tourIdx >> 1) & 1, (tourIdx >> 2) & 1];
		};

		const lissajous = (time: number, phase: number[]) => [
			0.5 + 0.5 * Math.sin(time * FREQ[0] * Math.PI * 2 + phase[0]),
			0.5 + 0.5 * Math.sin(time * FREQ[1] * Math.PI * 2 + phase[1]),
			0.5 + 0.5 * Math.sin(time * FREQ[2] * Math.PI * 2 + phase[2]),
		];

		/* One end's colour for this frame. What the reader is doing with the bars
		   wins, then whatever the card pinned it to, then the curve. Coming off a
		   grab or a pin eases rather than snapping. */
		function stepEnd(
			end: (typeof ends)[number],
			resting: number[] | null,
			now: number,
			dt: number,
		) {
			if (ctx.held) {
				// The frame is the one place that can see the hold begin.
				if (!end.wasHeld) end.frozen = end.rgb.slice();
				end.wasHeld = true;
				end.rgb = [0, 1, 2].map((c) => end.override[c] ?? end.frozen[c]);
				end.resumeFrom = null;
				return;
			}
			if (resting) {
				// Chased rather than jumped to, so the dot is seen travelling, and
				// chased rather than tweened so the corner tour can move the target
				// out from under it without any of this needing to know. See
				// approach in lib/easing.
				end.resumeFrom = null;
				end.wasPinned = true;
				end.rgb = [0, 1, 2].map((c) => approach(end.rgb[c], resting[c], dt));
				return;
			}
			const target = lissajous(t, end.phase);
			if (end.wasHeld || end.wasPinned) {
				end.resumeFrom = end.rgb.slice();
				end.resumeAt = now;
				end.wasHeld = false;
				end.wasPinned = false;
				end.override = [null, null, null];
			}
			if (end.resumeFrom) {
				const k = Math.min(1, (now - end.resumeAt) / 800);
				const e = k * k * (3 - 2 * k);
				end.rgb = [
					end.resumeFrom[0] + (target[0] - end.resumeFrom[0]) * e,
					end.resumeFrom[1] + (target[1] - end.resumeFrom[1]) * e,
					end.resumeFrom[2] + (target[2] - end.resumeFrom[2]) * e,
				];
				if (k >= 1) end.resumeFrom = null;
			} else {
				end.rgb = target;
			}
		}

		/* ---- input ---------------------------------------------------------- */

		/* The holding itself is the bars' — they call hold() on the context all
		   three of them share, and the frame above reads it. What is left for
		   this is the easing: a resume that was already part-way through when a
		   reader took hold again should be dropped rather than finished. */
		const freeze = () => {
			for (const end of ends) end.resumeFrom = null;
		};

		tellBars();
		bars.forEach((bar, channel) => {
			// Taking hold of a thumb is enough to stop things, before any value has
			// changed — and with a keyboard there is no grab to hear about, so the
			// value itself has to lead to the same place.
			bar.addEventListener('pointerdown', () => freeze());
			bar.addEventListener('track:input', (e) => {
				const { index, value, fromReader } = (e as CustomEvent).detail;
				if (!fromReader) return;
				freeze();
				ends[index].override[channel] = value / 255;
			});
		});

		host?.addEventListener('viz:props', (e) => {
			const p = (e as CustomEvent).detail ?? {};
			spin = 'spin' in p ? p.spin !== false : AUTHORED.spin;
			idleSeconds = 'idleResume' in p ? Number(p.idleResume) || 5 : AUTHORED.idleSeconds;
			tellBars();
			if (!('lock' in p)) lock = AUTHORED.lock;
			else lock = Array.isArray(p.lock) ? p.lock.map(Number) : null;
			if (!('tour' in p)) tour = AUTHORED.tour;
			else tour = p.tour == null ? null : Number(p.tour);
			guides = 'guides' in p ? p.guides === true : AUTHORED.guides;
			const wantLine = 'line' in p ? p.line === true : AUTHORED.line;
			if (wantLine !== line) {
				line = wantLine;
				root.dataset.line = String(line);
				// Hidden rather than merely invisible, so the second end's thumbs
				// leave the tab order and the accessibility tree with it.
				for (const bar of bars) bar.track.showThumb(1, line);
				rgbOut[1].hidden = !line;
			}
		});
		// Coming back on stage after a long absence, the elapsed time is not a
		// step the animation should try to take.
		host?.addEventListener('viz:enter', () => {
			last = 0;
		});

		canvas.addEventListener('pointerdown', (e) => {
			dragging = true;
			pointerId = e.pointerId;
			canvas.setPointerCapture(e.pointerId);
			velX = 0;
			velY = 0;
			e.preventDefault();
		});

		canvas.addEventListener('pointermove', (e) => {
			if (!dragging || e.pointerId !== pointerId) return;
			const k = 0.01;
			const dx = e.movementX * k;
			const dy = e.movementY * k;
			// Horizontal drag spins about the screen's vertical axis, and vice versa.
			offset = qNorm(qMul(qMul(qAxisAngle(0, 1, 0, dx), qAxisAngle(1, 0, 0, dy)), offset));
			velY = dx * 60;
			velX = dy * 60;
		});

		const endDrag = (e: PointerEvent) => {
			if (e.pointerId !== pointerId) return;
			dragging = false;
			pointerId = null;
		};
		canvas.addEventListener('pointerup', endDrag);
		canvas.addEventListener('pointercancel', endDrag);

		/* ---- sizing ---------------------------------------------------------- */

		let w = 0;
		let h = 0;
		let dpr = 1;
		let cubeScale = 0.5;
		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			cubeScale =
				parseFloat(getComputedStyle(root).getPropertyValue('--cube-scale')) || 0.5;
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = Math.max(1, Math.round(h * dpr));
			gl.viewport(0, 0, canvas.width, canvas.height);
			// The contact shadow is a CSS drop-shadow over the canvas' own alpha,
			// so it tracks the silhouette exactly and is clipped by the pane rather
			// than by the canvas box. Its size still has to follow the cube's.
			const scale = Math.min(w, h) * cubeScale;
			canvas.style.setProperty('--shadow-blur', `${(scale * 0.34).toFixed(2)}px`);
			canvas.style.setProperty('--shadow-y', `${(scale * 0.09).toFixed(2)}px`);
		};
		new ResizeObserver(resize).observe(canvas);
		resize();

		/* A lost context leaves a blank canvas for good unless everything above is
		   rebuilt, so drop the guard flag and re-run init on restore. */
		canvas.addEventListener('webglcontextlost', (e) => {
			e.preventDefault();
			root.dataset.ready = 'lost';
		});
		canvas.addEventListener('webglcontextrestored', () => {
			delete root.dataset.ready;
			initCube(root);
		});

		/* ---- render loop ------------------------------------------------------ */

		let last = 0;
		const frontFacing = [false, false, false, false, false, false];

		function frame(now: number) {
			requestAnimationFrame(frame);

			// An unshown phase is still in the DOM; don't burn frames on it. With
			// no phases there is only one viz and it always runs.
			if (gate && gate.dataset.vizActive === 'false') return;
			if (!w || !h || root.dataset.ready !== 'true') return;

			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;

			// --- orientation
			if (!reduceMotion && spin) ambient += AMBIENT_RATE * dt;
			if (!dragging) {
				const decay = Math.exp(-1.8 * dt);
				velX *= decay;
				velY *= decay;
				if (Math.abs(velX) > 1e-4 || Math.abs(velY) > 1e-4) {
					offset = qNorm(
						qMul(
							qMul(qAxisAngle(0, 1, 0, velY * dt), qAxisAngle(1, 0, 0, velX * dt)),
							offset,
						),
					);
				}
			}
			const m = qMatrix(
				qMul(
					qMul(
						offset,
						qAxisAngle(AMBIENT_AXIS[0], AMBIENT_AXIS[1], AMBIENT_AXIS[2], ambient),
					),
					BASE,
				),
			);

			// --- the dots
			if (!reduceMotion) t += dt;
			/* Where the first end rests when nobody is touching the bars. A tour
			   only chooses the target; the easing is the one a lock uses, so
			   arriving somewhere looks the same however it was chosen. */
			if (tour) {
				if (!tourTarget || now >= tourAt) {
					tourAt = now + tour * 1000;
					tourTarget = nextCorner();
				}
			} else if (tourTarget) {
				tourTarget = null;
				tourIdx = -1;
			}
			stepEnd(ends[0], tourTarget ?? lock, now, dt);
			// The second end only ever traces; a card pins the first one.
			if (line) stepEnd(ends[1], null, now, dt);

			// --- readouts, only touched when they actually change
			const byte = (v: number) => Math.round(Math.min(1, Math.max(0, v)) * 255);
			const A8 = ends[0].rgb.map(byte);
			// With one end the gradient's two stops hold the same colour, so the
			// swatch is flat without the fill needing a second code path.
			const B8 = line ? ends[1].rgb.map(byte) : A8;
			const css = `${A8}|${B8}`;
			if (css !== lastCss) {
				lastCss = css;
				root.style.setProperty('--swatch-a', rgbCss(A8 as Rgb));
				root.style.setProperty('--swatch-b', rgbCss(B8 as Rgb));
				rgbOut[0].textContent = rgbCss(A8 as Rgb);
				rgbOut[1].textContent = rgbCss(B8 as Rgb);
				/* The readings sit in the bottom-right corner, which projects onto
				   the middle of a ramp running bottom-left to top-right — so it is
				   the halfway colour they have to hold up against, not either end.
				   Black and white contrast equally at luminance 0.179, which is
				   where the ink flips. */
				root.style.setProperty(
					'--readout-ink',
					luminance((A8[0] + B8[0]) / 2, (A8[1] + B8[1]) / 2, (A8[2] + B8[2]) / 2) >
						0.179
						? '#000'
						: '#fff',
				);
				for (let c = 0; c < 3; c++) {
					bars[c].track.set(0, A8[c]);
					bars[c].track.set(1, B8[c]);
				}
			}

			/* --- three guides through each dot, one along each axis and each
			   spanning the cube. Together they say where the dot sits on all three
			   channels at once, which is the reading a single point floating in a
			   solid cannot give you on its own. */
			const span = line ? chord(ends[0].rgb, ends[1].rgb) : null;
			let nGuides = 0;
			for (let e = 0; guides && e < (line ? 2 : 1); e++) {
				const P = ends[e].rgb;
				for (let w = 0; w < 3; w++) {
					const a = P.slice();
					const b = P.slice();
					a[w] = 0;
					b[w] = 1;
					writeLine(guideData, nGuides++, a, b);
				}
			}

			/* --- which faces point at us. A face's outward normal in view space is
			   its own column of the rotation, signed; its centre sits half a unit
			   along that same normal. Working the facing test through by hand, the
			   whole thing collapses to one comparison: under perspective a face is
			   visible exactly when its normal leans more than 1/(2·FOCAL) toward
			   the eye, which is why faces disappear a little before edge-on. */
			const scale = Math.min(w, h) * cubeScale;
			for (let f = 0; f < 6; f++) {
				const axis = f >> 1;
				const sign = f & 1 ? 1 : -1;
				frontFacing[f] = m[axis * 3 + 2] * sign > 0.5 / FOCAL;
			}

			/* --- how much cube sits between the dot and the camera. Work in model
			   space, where the cube is the unit box and the dot is simply its own
			   rgb. The camera is the view-space eye rotated back. */
			const camM = [0.5 + m[2] * FOCAL, 0.5 + m[5] * FOCAL, 0.5 + m[8] * FOCAL];
			const dotAlpha = (c: number[]) => {
				const dm = [c[0] - camM[0], c[1] - camM[1], c[2] - camM[2]];
				let tEnter = 0;
				for (let a = 0; a < 3; a++) {
					if (Math.abs(dm[a]) < 1e-9) continue;
					const ta = (0 - camM[a]) / dm[a];
					const tb = (1 - camM[a]) / dm[a];
					tEnter = Math.max(tEnter, Math.min(ta, tb));
				}
				// t = 1 is the dot, so the remaining fraction is material in front.
				const thickness = Math.max(0, 1 - tEnter) * Math.hypot(dm[0], dm[1], dm[2]);
				// Beer-Lambert-ish, with a floor so a deep dot stays findable.
				return Math.max(0.16, Math.exp(-1.7 * thickness));
			};

			// --- draw
			const sx = (FOCAL * scale) / (w / 2);
			const sy = (FOCAL * scale) / (h / 2);
			const halfX = canvas.width / 2;
			const halfY = canvas.height / 2;

			gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

			// Opaque and convex, so culling the back half is all the sorting needed.
			gl.enable(gl.DEPTH_TEST);
			gl.enable(gl.CULL_FACE);
			gl.disable(gl.BLEND);
			gl.useProgram(progFace);
			gl.uniformMatrix3fv(U.face.rot, false, m);
			gl.uniform2f(U.face.scale, sx, sy);
			useAttribs([A.pos]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufCorners);
			gl.vertexAttribPointer(A.pos, 3, gl.FLOAT, false, 12, 0);
			gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, bufFaceIdx);
			gl.drawElements(gl.TRIANGLES, 36, gl.UNSIGNED_SHORT, 0);

			/* Adjacent faces share their common edge's colours exactly, so with
			   nothing drawn over the joins the solid reads as a blob. */
			gl.disable(gl.DEPTH_TEST);
			gl.disable(gl.CULL_FACE);
			gl.enable(gl.BLEND);
			gl.useProgram(progEdge);
			gl.uniformMatrix3fv(U.edge.rot, false, m);
			gl.uniform2f(U.edge.scale, sx, sy);
			gl.uniform2f(U.edge.half, halfX, halfY);
			gl.uniform1f(U.edge.width, dpr);
			useAttribs([A.p0, A.p1, A.end, A.side]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufEdges);
			gl.vertexAttribPointer(A.p0, 3, gl.FLOAT, false, 32, 0);
			gl.vertexAttribPointer(A.p1, 3, gl.FLOAT, false, 32, 12);
			gl.vertexAttribPointer(A.end, 1, gl.FLOAT, false, 32, 24);
			gl.vertexAttribPointer(A.side, 1, gl.FLOAT, false, 32, 28);

			const seen = (e: number) =>
				frontFacing[EDGES[e].f0] || frontFacing[EDGES[e].f1];

			// The nine edges you could actually see, inked dark.
			gl.uniform4f(U.edge.color, 0, 0, 0, 0.22);
			for (let e = 0; e < EDGES.length; e++) {
				if (seen(e)) gl.drawArrays(gl.TRIANGLES, e * 6, 6);
			}

			/* And the three you could not, drawn over the solid in white. Nothing
			   is actually transparent here — the faces are opaque and this is
			   painted straight over them — but it reads as the far corner showing
			   through, which is the same fiction the dots use. */
			gl.uniform4f(U.edge.color, 1, 1, 1, WIRE_ALPHA);
			for (let e = 0; e < EDGES.length; e++) {
				if (!seen(e)) gl.drawArrays(gl.TRIANGLES, e * 6, 6);
			}

			// Same program, a fainter white, and a buffer that changes each frame.
			if (nGuides) {
				gl.uniform4f(U.edge.color, 1, 1, 1, GUIDE_ALPHA);
				gl.bindBuffer(gl.ARRAY_BUFFER, bufGuides);
				gl.bufferSubData(gl.ARRAY_BUFFER, 0, guideData.subarray(0, nGuides * 8 * 6));
				gl.vertexAttribPointer(A.p0, 3, gl.FLOAT, false, 32, 0);
				gl.vertexAttribPointer(A.p1, 3, gl.FLOAT, false, 32, 12);
				gl.vertexAttribPointer(A.end, 1, gl.FLOAT, false, 32, 24);
				gl.vertexAttribPointer(A.side, 1, gl.FLOAT, false, 32, 28);
				gl.drawArrays(gl.TRIANGLES, 0, nGuides * 6);
			}

			const core = Math.max(4, scale * 0.038) * dpr;

			// --- the line through the ends, under the dots that mark them
			if (span) {
				gl.useProgram(progLink);
				gl.uniformMatrix3fv(U.link.rot, false, m);
				gl.uniform2f(U.link.scale, sx, sy);
				gl.uniform2f(U.link.half, halfX, halfY);
				gl.uniform1f(U.link.width, Math.max(1.5, scale * 0.014) * dpr);
				gl.uniform3f(U.link.a, span[0][0], span[0][1], span[0][2]);
				gl.uniform3f(U.link.b, span[1][0], span[1][1], span[1][2]);
				gl.uniform3f(U.link.cam, camM[0], camM[1], camM[2]);
				useAttribs([A.linkEnd, A.linkSide]);
				gl.bindBuffer(gl.ARRAY_BUFFER, bufLink);
				gl.vertexAttribPointer(A.linkEnd, 1, gl.FLOAT, false, 8, 0);
				gl.vertexAttribPointer(A.linkSide, 1, gl.FLOAT, false, 8, 4);
				gl.drawArrays(gl.TRIANGLES, 0, 6);
			}

			// --- the dots, always on top. Opacity stands in for how much of the
			// (opaque) cube is in front of each.
			gl.useProgram(progDot);
			gl.uniformMatrix3fv(U.dot.rot, false, m);
			gl.uniform2f(U.dot.scale, sx, sy);
			gl.uniform2f(U.dot.half, halfX, halfY);
			gl.uniform1f(U.dot.radius, core + 1.0); // room for the soft edge
			gl.uniform1f(U.dot.core, core);
			useAttribs([A.corner]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufQuad);
			gl.vertexAttribPointer(A.corner, 2, gl.FLOAT, false, 8, 0);
			for (let e = line ? 1 : 0; e >= 0; e--) {
				const c = ends[e].rgb;
				gl.uniform3f(U.dot.pos, c[0], c[1], c[2]);
				gl.uniform1f(U.dot.alpha, dotAlpha(c));
				gl.uniform1f(U.dot.rim, e === 0 ? 0 : Math.max(1.5, core * 0.36));
				if (e === 0) gl.uniform3f(U.dot.fill, 0, 0, 0);
				else gl.uniform3f(U.dot.fill, 0.965, 0.945, 0.902);
				gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
			}
		}

		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-rgb-cube]').forEach(initCube);
</script>
