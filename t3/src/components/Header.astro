---
import T3Mark from './T3Mark.astro';
---

<div class="grain" aria-hidden="true" transition:persist="chrome-grain">
	<span class="dots"></span>
	<span class="wave"></span>
	<span class="noise"></span>
</div>
<header transition:persist="site-header">
	<nav>
		<h1>
			<a href="/"><span class="sr-only">T3 Blog</span><T3Mark inverted class="name-mark" /></a>
		</h1>
		{/* What is open and what it belongs to, where the page says so
		    (data-page-title, data-page-meta): filled in by the script below on
		    every page, because this header is kept from one page to the next and
		    so cannot be written with any one page's. */}
		<span class="page-meta" data-page-meta-slot></span>
		<span class="page-title" data-page-title-slot></span>
		<div class="social-links">
			<a href="https://github.com/flonk" target="_blank">
				<span class="sr-only">Go to Flonk's GitHub repo</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<a href="https://www.linkedin.com/in/florian-schindler-0b0093278/" target="_blank">
				<span class="sr-only">Go to Florian's LinkedIn profile</span>
				<svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		view-transition-name: site-header;
		/* Out over the frame at the top and both sides, so the dots run to the
		   edge of the window and the frame only goes round the page below. As
		   much taller as it is raised, and padded down by the same, so the page
		   under it and everything in it stays where it was. */
		margin: calc(-1 * var(--page-border)) calc(-1 * var(--page-border)) 0;
		padding: var(--page-border) calc(1em + var(--page-border)) 0;
		color: #000;
		/* Clear: the chrome is painted behind the whole page (see --chrome in
		   global.css) and its grain over that (see .grain), so the bar is the
		   chrome showing through. */
		/* Same height as a deck post's T3 square. */
		height: calc(var(--header-height) + var(--page-border));
		display: flex;
		align-items: center;
		box-sizing: border-box;
		position: relative;
		overflow: hidden;
	}
	/* The chrome's grain: the dots, their wave and the noise, over the chrome
	   wherever it shows, the bar and the frame and the corners curving round
	   the page. One layer across the whole window behind everything else,
	   which the header and the page then cover where they are.

	   Two things decide how it is built. Its layers blend with the chrome
	   under them, and a blend only reaches as far as the nearest stacking
	   context: so the layer is placed absolutely, which makes none, and never
	   fixed, which would make one and leave the dots blending with nothing.
	   And it is out of the flow, so it paints after the page's own ground;
	   everything meant to be over it is positioned and comes after it, the
	   header and the panes both.

	   Out over the frame by its width, from the body it is placed in. On a
	   narrow screen only as far down as the header, and so moving with it. */
	.grain {
		position: absolute;
		inset: calc(-1 * var(--page-border));
		overflow: hidden;
		pointer-events: none;
	}
	@media (max-width: 1099px) {
		.grain {
			bottom: auto;
			height: calc(var(--header-height) + var(--page-border));
		}
	}
	/* A fine grain of dots over the chrome, blended into it rather than laid on
	   top: each dot takes its colour from what is under it, so the glow going
	   round lights them up as it passes and the deep orange all but hides them.
	   The grid is set at 17° off square, which a background cannot be on its
	   own, so the layer is cut oversize and turned: by enough that, turned,
	   it still covers a window of any usual shape. */
	.dots,
	.wave {
		--grid: 2.5px;
		position: absolute;
		inset: calc(-60% - 120px) -25%;
		transform: rotate(17deg);
		mix-blend-mode: overlay;
		animation: grain-drift 1.6s steps(16) infinite;
	}
	.dots {
		background: radial-gradient(circle, rgb(255 255 255 / 0.55) 0.4px, transparent 0.7px) 0 0 /
			var(--grid) var(--grid);
	}
	/* The wave: the same grid with every dot swollen and brighter, seen only
	   through a soft band that sweeps across once in a while, so the grain
	   rises as it passes and settles behind it. Drifting with the grid it sits
	   on, so each swollen dot is one of the dots below. */
	.wave {
		background: radial-gradient(circle, rgb(255 255 255 / 0.9) 0.65px, transparent 1px) 0 0 /
			var(--grid) var(--grid);
		mask: linear-gradient(90deg, transparent, #000 45% 55%, transparent) no-repeat -70% 0 / 35% 100%;
		animation:
			grain-drift 1.6s steps(16) infinite,
			grain-wave 60s ease-in-out 6s infinite backwards;
	}
	/* One grid step along the grid's own axis, so the loop has no seam: in
	   sixteen steps of a sixth of a pixel, ten a second, too fine to see go
	   and a sixth of the frames a smooth slide would cost. The noise below is
	   stepped the same. */
	@keyframes grain-drift {
		to {
			transform: rotate(17deg) translateX(var(--grid));
		}
	}
	/* Across in eight seconds, then quiet for the rest of the minute: the first
	   one six seconds after the page loads, and one a minute after that. */
	@keyframes grain-wave {
		0% {
			mask-position: -70% 0;
		}
		13%,
		100% {
			mask-position: 170% 0;
		}
	}
	/* Held still while nobody is there: see the script below. */
	:global(.is-idle) :is(.dots, .wave, .noise) {
		animation-play-state: paused;
	}
	@media (prefers-reduced-motion: reduce) {
		.dots,
		.wave,
		.noise {
			animation: none;
		}
		.wave {
			display: none;
		}
	}
	/* Grain over the chrome: a tile of grey noise, every pixel its own,
	   blended in so softly that it is felt more than seen. Over the dots and
	   under the name. It creeps the other way from the dots, up and to the
	   left, though not straight back along their line: two tiles across for
	   one up, which brings the tile round onto itself so the loop has no seam.
	   Cut that much oversize to the right and below, so that moving it never
	   uncovers an edge, and moved as a whole, which costs no repaint. */
	.noise {
		--tile: 128px;
		position: absolute;
		inset: 0 calc(-2 * var(--tile)) calc(-1 * var(--tile)) 0;
		background: url('/assets/noise.png') 0 0 / var(--tile) var(--tile);
		mix-blend-mode: soft-light;
		opacity: 0.4;
		animation: noise-creep 240s steps(2400) infinite;
	}
	@keyframes noise-creep {
		to {
			transform: translate(calc(-2 * var(--tile)), calc(-1 * var(--tile)));
		}
	}
	nav {
		position: relative;
	}
	h1 {
		display: flex;
		margin: 0;
		/* What 1em came to before the body went to tesbota's smaller size, in
		   rem so that it follows the reader's own text size as the rest does. */
		font-size: 0.875rem;
	}
	/* The mark stands in the middle of the bar, whatever is at either end of
	   it; on a narrow screen with a page's title beside it, it keeps to the
	   left instead (below). */
	h1 {
		position: absolute;
		left: 50%;
		transform: translateX(-50%);
	}

	/* The site's mark for its name, a round button home: T3 cut out of a black
	   disc with the chrome showing through the letters (see T3Mark). */
	nav :global(.name-mark) {
		width: 2.1rem;
		/* A pixel above true centre, where it looks centred. */
		translate: 0 -1px;
	}

	/* The open page's title and what it belongs to, where the page has them:
	   on a narrow screen the title beside the mark, on a wide one the two
	   either side of it, the mark between them in the middle of the bar. */
	.page-meta {
		display: none;
	}
	.page-title {
		display: none;
	}
	@media (max-width: 1099px) {
		.page-title:not(:empty) {
			display: block;
			flex: 1;
			min-width: 0;
			margin: 0 1rem;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			font-size: 0.875rem;
			font-weight: 700;
		}
		/* With a title beside it, the button's own size and no wider, so as not
		   to reach over the title. */
		nav:has(.page-title:not(:empty)) h1 {
			position: static;
			transform: none;
		}
		nav:has(.page-title:not(:empty)) h1 a {
			margin: 0;
			padding: 0;
		}
	}
	@media (min-width: 1100px) {
		.page-meta:not(:empty),
		.page-title:not(:empty) {
			--beside: calc(50% + 1.05rem + 1rem);
			display: block;
			position: absolute;
			top: 50%;
			translate: 0 -50%;
			max-width: calc(100% - var(--beside) - 6rem);
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.page-meta:not(:empty) {
			right: var(--beside);
			text-align: right;
			font-size: var(--type-label);
			letter-spacing: var(--track-label);
			text-transform: uppercase;
			font-weight: 700;
		}
		.page-title:not(:empty) {
			left: var(--beside);
			font-size: 0.875rem;
			font-weight: 700;
		}
	}
	nav h1 a,
	nav h1 a.active {
		text-decoration: none;
		/* A box round the mark and nothing else, so it centres on the bar as the
		   title beside it does rather than sitting on a line of text. */
		display: flex;
		border-bottom: 0;
		/* A wide target round a short name: padded out over the bar and pulled
		   back by as much, so the name stays put and the space round it clicks. */
		padding: 1rem 12.8rem;
		margin: -1rem -12.8rem;
	}
	nav {
		width: 100%;
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 0.5em 0.5em;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		color: inherit;
	}
	nav a.active {
		text-decoration: none;
	}
	.social-links {
		margin-left: auto;
		align-items: center;
	}
	/* The name and the links grow a little under the pointer or the keyboard;
	   the links are a touch faded until then, the name never is. */
	h1 a,
	.social-links a {
		transition:
			opacity 0.15s ease,
			transform 0.15s ease;
	}
	.social-links a {
		opacity: 0.8;
	}
	h1 a:hover,
	h1 a:focus-visible,
	.social-links a:hover,
	.social-links a:focus-visible {
		opacity: 1;
		transform: scale(1.15);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
</style>

<script>
	/* The chrome's glow goes to the pointer while it is over the header,
	   and drifts back to its round when it leaves: this only says where the
	   pointer is and how hard to pull, and global.css eases the rest (see
	   --glow-pull). A mouse only, and not where motion is asked to be kept
	   down. Listened for on the document, because the header is kept from one
	   page to the next but a full load brings a new one. */
	const style = document.documentElement.style;
	const still = matchMedia('(prefers-reduced-motion: reduce)');
	const PULL = 1;

	let frame = 0;
	let over = false;
	let x = 50;
	let y = 20;

	const write = () => {
		frame = 0;
		style.setProperty('--glow-pull', String(over ? PULL : 0));
		if (over) {
			style.setProperty('--pointer-x', `${x}%`);
			style.setProperty('--pointer-y', `${y}%`);
		}
	};

	document.addEventListener('pointermove', (e) => {
		if (e.pointerType !== 'mouse' || still.matches) return;
		const now = e.target instanceof Element && !!e.target.closest('header');
		if (!now && !over) return;
		over = now;
		x = (e.clientX / innerWidth) * 100;
		y = (e.clientY / innerHeight) * 100;
		frame ||= requestAnimationFrame(write);
	});

	document.documentElement.addEventListener('pointerleave', () => {
		over = false;
		frame ||= requestAnimationFrame(write);
	});

	/* Idle: half a minute with nothing from the reader, not a move, a key, a
	   wheel or a scroll, and the chrome holds still, the turn and the grain
	   both, until the next sign of them. It costs nothing while it waits, and
	   a laptop left on the page is not kept awake by a gradient. */
	const IDLE_AFTER = 30_000;
	let idle = 0;
	let lastSeen = 0;
	const rest = () => document.documentElement.classList.add('is-idle');
	const seen = () => {
		const now = performance.now();
		if (now - lastSeen < 500 && idle) return;
		lastSeen = now;
		document.documentElement.classList.remove('is-idle');
		clearTimeout(idle);
		idle = setTimeout(rest, IDLE_AFTER);
	};
	for (const type of ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart']) {
		addEventListener(type, seen, { passive: true });
	}
	document.addEventListener('scroll', seen, { capture: true, passive: true });
	// A page swapped in starts awake: the swap takes the root's class with it.
	document.addEventListener('astro:page-load', seen);

	/* The grain is kept from one page to the next, which the router does by
	   taking it out of the old page and putting it into the new one; and an
	   element put back in starts its animations over. The noise would jump
	   back to where it began on every click, seen as a drift through the
	   cross-fade. So where each of its animations has got to is noted just
	   before the swap and put back just after, by animation and by layer. */
	const grainAnimations = () =>
		document.querySelector('.grain')?.getAnimations({ subtree: true }) ?? [];
	const keyOf = (animation: Animation) =>
		`${(animation as CSSAnimation).animationName} ${(animation.effect as KeyframeEffect | null)?.target?.className}`;
	let heldAt = new Map<string, CSSNumberish | null>();
	document.addEventListener('astro:before-swap', () => {
		heldAt = new Map(grainAnimations().map((animation) => [keyOf(animation), animation.currentTime]));
	});
	document.addEventListener('astro:after-swap', () => {
		for (const animation of grainAnimations()) {
			const at = heldAt.get(keyOf(animation));
			if (at != null) animation.currentTime = at;
		}
	});

	// The open page's title and what it belongs to into the header, or nothing
	// where it has none.
	document.addEventListener('astro:page-load', () => {
		const slot = document.querySelector('[data-page-title-slot]');
		if (slot) slot.textContent = document.querySelector('[data-page-title]')?.textContent?.trim() ?? '';
		const meta = document.querySelector('[data-page-meta-slot]');
		const parts = document.querySelector('[data-page-meta]')?.children ?? [];
		if (meta) meta.textContent = [...parts].map((part) => part.textContent?.trim()).filter(Boolean).join(' · ');
	});
</script>
