---
/**
 * A drop of raw milk under the microscope, laid over the glass: the fat as
 * globules drifting in the water, most of them three or four micrometres
 * across, each in its own thin membrane, and between them the casein
 * micelles, some thirty times smaller, as a fine dust.
 *
 *   <DeckViz>
 *     <MilkPour />
 *     <FatGlobules />
 *   </DeckViz>
 *
 *   <DeckCard vizProps={{ overlay: 'fat' }}>…</DeckCard>   show it
 *   <DeckCard vizProps={{ overlay: null }}>…</DeckCard>    put it away
 *
 * Drawn as a light microscope shows them: the globules round drops of oil,
 * lit from one side and edged dark where they bend the light, at different
 * depths in the drop, the nearer lying in front of the rest; the microscope
 * focused on the front of the drop, so that what is there is sharp and what
 * lies further back soft and pale.
 * An overlay as <VizImage> is one; see DeckPost.
 */
interface Props {
	/** The name cards show it by. */
	name?: string;
}

const { name = 'fat' } = Astro.props;
---

<figure class="fat" data-viz-overlay={name} data-viz-active="false" inert data-fat>
	<div class="lens">
		<canvas aria-hidden="true"></canvas>
		<div class="scale" aria-hidden="true"><span class="bar"></span>5 µm</div>
	</div>
	<figcaption>
		<span class="key"><span class="dot globule"></span>fat globule</span>
		<span class="key"><span class="dot micelle"></span>casein micelle</span>
	</figcaption>
</figure>

<style>
	.fat {
		place-self: center;
		position: relative;
		/* Over everything the glass puts up, as <VizImage> is. */
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		margin: 0;
		padding: 0.75rem;
		border-radius: var(--radius-large, 12px);
		background: color-mix(in oklab, var(--deck-ground) 85%, transparent);
		backdrop-filter: blur(6px);
		box-shadow:
			0 0 0 1px color-mix(in oklab, var(--deck-ink) 12%, transparent),
			0 0.75rem 2rem rgb(0 0 0 / 0.18);
		font-family: var(--font-sans);
		font-size: 0.75rem;
		color: var(--deck-ink);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.35s ease;
	}
	.fat[data-viz-active='true'] {
		opacity: 1;
	}
	/* Round, as a microscope's field is, and as big as the pane allows with
	   the key still under it. The water lit brightest in the middle, and
	   the field darkening towards its edge, as through an eyepiece. */
	.lens {
		position: relative;
		width: min(18rem, calc(100cqh - 5rem), calc(100cqw - 3rem));
		aspect-ratio: 1;
		border-radius: 50%;
		overflow: hidden;
		background: radial-gradient(circle at 45% 40%, #e6ecea, #d4dddd 55%, #bcc6c6);
		box-shadow: 0 0 0 3px color-mix(in oklab, var(--deck-ink) 70%, transparent);
	}
	.lens::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		box-shadow: inset 0 0 1.5rem 0.4rem rgb(40 50 50 / 0.35);
		pointer-events: none;
	}
	canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
	.scale {
		position: absolute;
		z-index: 1;
		left: 50%;
		bottom: 9%;
		transform: translateX(-50%);
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.15rem;
		font-size: 0.65rem;
		font-weight: 600;
		color: var(--deck-ink);
	}
	.bar {
		display: block;
		/* Set by the script to five micrometres on the canvas. */
		width: var(--five, 3rem);
		height: 3px;
		background: var(--deck-ink);
	}
	figcaption {
		display: flex;
		gap: 1rem;
		color: var(--deck-ink-dim);
	}
	.key {
		display: flex;
		align-items: center;
		gap: 0.35em;
	}
	.dot {
		width: 0.8em;
		height: 0.8em;
		border-radius: 50%;
	}
	.globule {
		background: radial-gradient(circle at 35% 35%, oklch(0.98 0.04 95), oklch(0.88 0.1 88) 60%, oklch(0.62 0.1 75));
	}
	.micelle {
		width: 0.35em;
		height: 0.35em;
		background: oklch(0.6 0.06 55);
	}
	@media (prefers-reduced-motion: reduce) {
		.fat {
			transition-duration: 0.01ms;
		}
	}
</style>

<script>
	import { eachPage } from '../lib/page';
	import { pixelRatio } from '../lib/canvas';

	/* The field, in micrometres across, and how many globules and micelles
	   are in it. */
	const FIELD = 30;
	const GLOBULES = 30;
	const MICELLES = 380;
	/* The focus, at the front of the drop (0 the front, 1 the back); and how
	   shallow it is: something this far behind it is as soft as it gets,
	   SOFTEST micrometres of blur, and has all but faded into the water. */
	const FOCUS = 0;
	const DEPTH_OF_FIELD = 0.8;
	const SOFTEST = 2.6;
	/* The large one, its centre outside the round field (radius FIELD / 2)
	   so that a cap of it 2.5 µm deep reaches in. */
	const BIG = (() => {
		const r = 7;
		const a = -Math.PI / 5;
		const d = FIELD / 2 + r - 2.5;
		return { x: FIELD / 2 + Math.cos(a) * d, y: FIELD / 2 + Math.sin(a) * d, r, depth: 0.3 };
	})();
	// How far out of focus something at a depth is, 0 sharp to 1 as soft as it gets.
	const defocus = (depth: number) => Math.min(1, Math.abs(depth - FOCUS) / DEPTH_OF_FIELD);

	/* A globule: where it is, how big, and its depth, 0 at the front of the
	   drop and 1 at its back; drawn once, as out of focus as it is. */
	type Globule = { x: number; y: number; r: number; depth: number; sprite?: HTMLCanvasElement };
	type Micelle = { x: number; y: number; r: number; depth: number };

	const random = (a: number, b: number) => a + Math.random() * (b - a);
	// Lognormal round a median of 3.5 µm across, as raw milk's globules are.
	const diameter = () =>
		Math.min(9, Math.max(0.8, 3.5 * Math.exp(0.45 * Math.sqrt(-2 * Math.log(Math.random() || 1e-9)) * Math.cos(2 * Math.PI * Math.random()))));

	function initFat(root: HTMLElement, signal: AbortSignal) {
		const canvas = root.querySelector('canvas')!;
		const ctx = canvas.getContext('2d')!;
		const lens = root.querySelector<HTMLElement>('.lens')!;
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		/* The far ones first, so the near ones lie over them. */
		const globules: Globule[] = Array.from({ length: GLOBULES }, () => ({
			x: random(0, FIELD),
			y: random(0, FIELD),
			r: diameter() / 2,
			depth: Math.random(),
		}))
			/* And one of the largest, fourteen micrometres across, always there
			   just off the field to the upper right, only an edge of it in view,
			   to show how large they get. It holds still: too big to be jostled. */
			.concat({ ...BIG })
			.sort((a, b) => b.depth - a.depth);
		const micelles: Micelle[] = Array.from({ length: MICELLES }, () => ({
			x: random(0, FIELD),
			y: random(0, FIELD),
			r: random(0.05, 0.15),
			depth: Math.random(),
		}));

		let w = 0;
		let dpr = 1;
		let px = 1;
		const pad = () => Math.ceil(SOFTEST * px * 2.5 + 4);
		/* A drop of oil as the light comes through it: brightest a little up
		   and left of its middle, deepening to its colour, edged dark where it
		   bends the light away, a glint of the lamp on it and the membrane a
		   fine darker line. Out of focus, soft and faint. Drawn once and
		   stamped, as blurring it afresh every frame is far too slow. */
		const paint = (g: Globule) => {
			const r = g.r * px;
			const size = Math.ceil((r + pad()) * 2);
			const m = size / 2;
			const a = defocus(g.depth);
			const blur = a * a * SOFTEST * px;
			// Soft ones need no more pixels than the screen's own.
			const res = a > 0.3 ? 1 : dpr;
			const sprite = g.sprite ?? document.createElement('canvas');
			sprite.width = sprite.height = Math.ceil(size * res);
			const c = sprite.getContext('2d')!;
			c.setTransform(res, 0, 0, res, 0, 0);
			c.filter = blur > 0.3 ? `blur(${blur}px)` : 'none';
			c.globalAlpha = 1 - a * 0.7;
			const body = c.createRadialGradient(m - r * 0.3, m - r * 0.3, r * 0.05, m, m, r);
			body.addColorStop(0, 'oklch(0.99 0.03 95)');
			body.addColorStop(0.55, 'oklch(0.9 0.1 90)');
			body.addColorStop(0.85, 'oklch(0.8 0.11 82)');
			body.addColorStop(1, 'oklch(0.55 0.09 72)');
			c.fillStyle = body;
			c.beginPath();
			c.arc(m, m, r, 0, Math.PI * 2);
			c.fill();
			c.strokeStyle = 'oklch(0.45 0.07 70 / 0.8)';
			c.lineWidth = Math.max(0.8, 0.1 * px);
			c.stroke();
			// The glint, in focus only.
			if (a < 0.35) {
				c.fillStyle = `rgb(255 255 255 / ${0.7 * (1 - a / 0.35)})`;
				c.beginPath();
				c.ellipse(m - r * 0.38, m - r * 0.4, r * 0.18, r * 0.11, -Math.PI / 4, 0, Math.PI * 2);
				c.fill();
			}
			g.sprite = sprite;
		};
		const resize = () => {
			dpr = pixelRatio();
			w = lens.getBoundingClientRect().width;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = canvas.width;
			px = w / FIELD;
			lens.style.setProperty('--five', `${5 * px}px`);
			for (const g of globules) paint(g);
			draw();
		};

		/* Jostled by the water, the small more than the large, as Brownian
		   motion goes, and round again at the edges. */
		const wrap = (v: number, r: number) => {
			const span = FIELD + 2 * r;
			return ((((v + r) % span) + span) % span) - r;
		};
		const jostle = (b: { x: number; y: number; r: number }, dt: number) => {
			const s = (0.9 / Math.sqrt(b.r + 0.1)) * Math.sqrt(dt);
			b.x = wrap(b.x + random(-s, s), b.r);
			b.y = wrap(b.y + random(-s, s), b.r);
		};

		/* The micelles in a few layers of depth, each drawn at once: in focus
		   fine dark points, out of it larger and fainter, till they are gone
		   into the water. */
		const LAYERS = 6;
		const draw = () => {
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, w);
			for (let layer = 0; layer < LAYERS; layer++) {
				const a = defocus((layer + 0.5) / LAYERS);
				if (a >= 0.95) continue;
				const spread = 1 + a * a * SOFTEST * 1.5;
				ctx.fillStyle = `oklch(0.5 0.05 55 / ${0.7 * (1 - a) ** 2})`;
				ctx.beginPath();
				for (const m of micelles) {
					if (Math.floor(m.depth * LAYERS) !== layer) continue;
					const r = Math.max(0.6, m.r * px) * spread;
					ctx.moveTo(m.x * px + r, m.y * px);
					ctx.arc(m.x * px, m.y * px, r, 0, Math.PI * 2);
				}
				ctx.fill();
			}
			for (const g of globules) {
				if (!g.sprite) continue;
				const size = (g.r * px + pad()) * 2;
				ctx.drawImage(g.sprite, g.x * px - size / 2, g.y * px - size / 2, size, size);
			}
		};
		const sizing = new ResizeObserver(resize);
		sizing.observe(lens);
		signal.addEventListener('abort', () => sizing.disconnect(), { once: true });
		resize();

		let last = 0;
		const frame = (now: number) => {
			if (signal.aborted) return;
			requestAnimationFrame(frame);
			if (reduceMotion || root.dataset.vizActive !== 'true') {
				last = 0;
				return;
			}
			const dt = last ? Math.min(0.1, (now - last) / 1000) : 0;
			last = now;
			if (!w) return;
			for (const g of globules) if (g.r < BIG.r) jostle(g, dt * 0.4);
			for (const m of micelles) jostle(m, dt);
			draw();
		};
		requestAnimationFrame(frame);
	}

	eachPage((signal) => {
		for (const root of document.querySelectorAll<HTMLElement>('[data-fat]')) initFat(root, signal);
	});
</script>
