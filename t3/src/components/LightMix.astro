---
/**
 * A few monochromatic lights with a handle each, and what they come to when
 * they arrive together.
 *
 * The point it exists to make is that the answer is often a colour that is
 * nowhere in the spectrum. Pink is the everyday case: everyone believes in it,
 * everyone has seen it, and no wavelength is it.
 *
 * Beside the mixture are the three numbers it comes to at the cones, which is
 * the whole of what leaves the eye. Read them and you can see why no
 * wavelength will do: the pattern pink makes — the two ends lit and the middle
 * behind them — is one the curves in part three never produce from a single
 * light, because M sits under L the whole way along.
 */
import { mixCones, mixRgb, wavelengthCss, type Light } from '../lib/spectrum';

interface Props {
	/** The lights, in nanometres, each with a share of its own full brightness. */
	lights?: Light[];
	/** The stretch of spectrum the handles run over. */
	from?: number;
	to?: number;
}

const {
	lights = [
		{ nm: 600, weight: 1 },
		{ nm: 470, weight: 0.6 },
		{ nm: 560, weight: 0.3 },
	],
	from = 400,
	to = 700,
} = Astro.props;

/* The rainbow behind the handles, built here rather than in the browser: it
   never changes, so there is nothing for a script to do with it. */
const STOPS = 60;
const bar = Array.from({ length: STOPS + 1 }, (_, i) => {
	const t = i / STOPS;
	return `${wavelengthCss(from + (to - from) * t)} ${(t * 100).toFixed(2)}%`;
}).join(', ');
---

<div
	class="mix"
	data-mix
	data-from={from}
	data-to={to}
	data-lights={JSON.stringify(lights)}
	style={`--bar: linear-gradient(to right, ${bar})`}
>
	<div class="mix-head">
		<figure class="mix-out">
			<div class="mix-disc" data-out></div>
			<figcaption>together</figcaption>
		</figure>

		{/* The same three, in the same order and the same colours, as part
		    three's graph — so the two can be read against each other. */}
		<dl class="tally" data-tally>
			<div class="tally-row" data-cone="s">
				<dt>S</dt>
				<dd><span class="tally-bar"><i data-bar="s"></i></span><b data-val="s">0.00</b></dd>
			</div>
			<div class="tally-row" data-cone="m">
				<dt>M</dt>
				<dd><span class="tally-bar"><i data-bar="m"></i></span><b data-val="m">0.00</b></dd>
			</div>
			<div class="tally-row" data-cone="l">
				<dt>L</dt>
				<dd><span class="tally-bar"><i data-bar="l"></i></span><b data-val="l">0.00</b></dd>
			</div>
		</dl>
	</div>

	<div class="mix-bar">
		{lights.map((light, i) => (
			<input
				class="mix-range"
				data-no-swipe
				data-light={i}
				type="range"
				min={from}
				max={to}
				step="1"
				value={light.nm}
				aria-label={`Light ${i + 1}, wavelength in nanometres`}
			/>
		))}
	</div>

	<div class="mix-legend" data-legend></div>
</div>

<style>
	.mix {
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: clamp(0.75rem, 4cqh, 2rem);
		padding: 0 1.5rem;
		font-family: var(--font-mono);
		--ink: var(--deck-ink, #35302a);
		--ink-dim: var(--deck-ink-dim, #7a7264);
		color: var(--ink);
	}

	.mix-head {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: clamp(1.5rem, 6cqw, 4rem);
	}

	.mix-out {
		margin: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.45rem;
	}

	.mix-disc {
		width: clamp(3rem, 22cqh, 6.5rem);
		aspect-ratio: 1;
		border-radius: 50%;
		background: #000;
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--ink) 22%, transparent),
			0 0 22px 2px rgb(0 0 0 / 0.35);
	}

	.mix-out figcaption {
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ink-dim);
	}

	.tally {
		margin: 0;
		display: grid;
		gap: 0.35rem;
		font-size: 0.9rem;
		font-variant-numeric: tabular-nums;
		--l: #ff6b6b;
		--m: #64d98a;
		--s: #6fa8ff;
	}

	.tally-row {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tally dt {
		width: 1ch;
		font-weight: 700;
	}

	.tally dd {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.tally-bar {
		display: block;
		width: clamp(4rem, 14cqw, 9rem);
		height: 0.45rem;
		border-radius: 2px;
		background: color-mix(in srgb, var(--ink) 14%, transparent);
		overflow: hidden;
	}

	.tally-bar i {
		display: block;
		height: 100%;
		width: 0;
		border-radius: 2px;
	}

	/* Ink on the letter, fill on the bar. Setting both on both paints each
	   letter out in a block of its own colour. */
	.tally-row[data-cone='l'] dt {
		color: var(--l);
	}

	.tally-row[data-cone='m'] dt {
		color: var(--m);
	}

	.tally-row[data-cone='s'] dt {
		color: var(--s);
	}

	.tally-row[data-cone='l'] .tally-bar i {
		background: var(--l);
	}

	.tally-row[data-cone='m'] .tally-bar i {
		background: var(--m);
	}

	.tally-row[data-cone='s'] .tally-bar i {
		background: var(--s);
	}

	.tally b {
		width: 4ch;
		font-weight: 400;
		color: var(--ink-dim);
	}

	/* The handles sit on the spectrum they are picking out of. */
	.mix-bar {
		position: relative;
		width: min(100%, 46rem);
		height: 1.1rem;
		border-radius: 3px;
		background: var(--bar);
	}

	.mix-range {
		position: absolute;
		inset: -0.55rem 0;
		width: 100%;
		margin: 0;
		padding: 0;
		appearance: none;
		-webkit-appearance: none;
		background: transparent;
		touch-action: none;
		/* Three of these lie on top of one another, so the input itself must be
		   transparent to the pointer and only its handle may catch it —
		   otherwise the last one declared would swallow every drag. */
		pointer-events: none;
	}

	.mix-range:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}

	/* Vendor pseudo-elements go in rules of their own: one browser not knowing
	   a selector throws out the whole rule. */
	.mix-range::-webkit-slider-thumb {
		-webkit-appearance: none;
		pointer-events: auto;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: var(--knob, #fff);
		border: 2px solid #fff;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.65);
		cursor: grab;
	}

	.mix-range::-moz-range-thumb {
		pointer-events: auto;
		width: 1.1rem;
		height: 1.1rem;
		border-radius: 50%;
		background: var(--knob, #fff);
		border: 2px solid #fff;
		box-shadow: 0 0 0 1px rgb(0 0 0 / 0.65);
		cursor: grab;
	}

	.mix-range::-webkit-slider-runnable-track {
		background: transparent;
	}

	.mix-range::-moz-range-track {
		background: transparent;
	}

	.mix-legend {
		display: flex;
		gap: 1.25rem;
		font-size: 0.7rem;
		font-variant-numeric: tabular-nums;
		color: var(--ink-dim);
	}

	.mix-legend :global(span) {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.mix-legend :global(i) {
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		box-shadow: 0 0 0 1px rgb(255 255 255 / 0.35);
	}

	@container viz (max-width: 30rem) {
		.tally {
			font-size: 0.7rem;
			gap: 0.25rem;
		}
		.mix-legend {
			gap: 0.7rem;
			font-size: 0.6rem;
		}
	}
</style>

<script>
	import { mixCones, mixRgb, wavelengthCss, type Light } from '../lib/spectrum';

	const CONES = [
		{ key: 's', at: 2 },
		{ key: 'm', at: 1 },
		{ key: 'l', at: 0 },
	] as const;

	function initMix(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const outEl = root.querySelector<HTMLElement>('[data-out]')!;
		const legendEl = root.querySelector<HTMLElement>('[data-legend]')!;
		const bars = Object.fromEntries(
			CONES.map((c) => [c.key, root.querySelector<HTMLElement>(`[data-bar='${c.key}']`)!]),
		);
		const vals = Object.fromEntries(
			CONES.map((c) => [c.key, root.querySelector<HTMLElement>(`[data-val='${c.key}']`)!]),
		);
		const ranges = Array.from(root.querySelectorAll<HTMLInputElement>('[data-light]'));

		const lights: Light[] = JSON.parse(root.dataset.lights ?? '[]');
		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ??
			root.closest<HTMLElement>('[data-viz-stage]');

		const AUTHORED = lights.map((l) => l.nm);

		const legend = lights.map(() => {
			const span = document.createElement('span');
			const dot = document.createElement('i');
			const text = document.createElement('em');
			text.style.fontStyle = 'normal';
			span.append(dot, text);
			legendEl.append(span);
			return { dot, text };
		});

		const render = () => {
			for (const [i, light] of lights.entries()) {
				const css = wavelengthCss(light.nm);
				ranges[i].style.setProperty('--knob', css);
				legend[i].dot.style.background = css;
				legend[i].text.textContent = `${Math.round(light.nm)} nm`;
			}

			const [r, g, b] = mixRgb(lights);
			outEl.style.background = `rgb(${r} ${g} ${b})`;

			/* Drawn against the strongest of the three, so what is shown is the
			   pattern between them, which is the part that carries the colour.
			   Their sizes together are brightness, and the disc is already
			   saying that. */
			const cones = mixCones(lights);
			const top = Math.max(cones[0], cones[1], cones[2], 1e-6);
			for (const c of CONES) {
				bars[c.key].style.width = `${((cones[c.at] / top) * 100).toFixed(1)}%`;
				vals[c.key].textContent = (cones[c.at] / top).toFixed(2);
			}
		};

		for (const [i, range] of ranges.entries()) {
			range.addEventListener('input', () => {
				lights[i].nm = Number(range.value);
				render();
			});
		}

		/* A card can move the lights; anything it leaves out goes back to how
		   this was authored. See DeckViz for the contract. */
		host?.addEventListener('viz:props', (e) => {
			const p = (e as CustomEvent).detail ?? {};
			const want = Array.isArray(p.lights) ? p.lights : null;
			for (const [i, light] of lights.entries()) {
				const nm = want && want[i] != null ? Number(want[i]) : AUTHORED[i];
				light.nm = Number.isFinite(nm) ? nm : AUTHORED[i];
				ranges[i].value = String(light.nm);
			}
			render();
		});

		render();
	}

	document.querySelectorAll<HTMLElement>('[data-mix]').forEach(initMix);
</script>
