---
import { codeToHtml } from 'shiki';

interface Props {
  n: number;
  question: string;
  children: any;
  multiline?: boolean;
  lang?: string;
}

const { n, question, multiline = true, lang = 'typescript' } = Astro.props;

let highlightedCode = question;
if (multiline && lang) {
  highlightedCode = await codeToHtml(question, {
    lang,
    theme: 'one-dark-pro',
  });
}
---

<div class="qa-wrapper">
  <div class="question">
    <div class="question-header">
      <strong class="question-label">Question {n}</strong>
      <button class="spoiler-button" aria-expanded="false" onclick="
        const content = this.closest('.qa-wrapper').querySelector('.spoiler-content');
        const isRevealed = content.classList.toggle('revealed');
        this.setAttribute('aria-expanded', String(isRevealed));
        this.textContent = isRevealed ? 'Hide solution' : 'Show solution';
      ">
        Show solution
      </button>
    </div>
    <div class="question-text">
      {multiline ? (
        <div class="question-code" set:html={highlightedCode} />
      ) : (
        <code>{question}</code>
      )}
    </div>
  </div>
  <div class="spoiler-content">
    <slot />
  </div>
</div>

<style>
  .qa-wrapper {
    /* One padding value for both halves, so the question and the revealed
       solution share a left edge. */
    --qa-pad: 1rem;

    /* Vertical margin only — a horizontal one would inset the box relative to
       the surrounding prose column and read as accidentally centred. */
    margin: 1.75em 0;
    border: 1px solid var(--edge-panel);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    overflow: hidden;
    background-color: color-mix(in srgb, var(--nord0) 35%, transparent);
  }

  @media (max-width: 768px) {
    .qa-wrapper {
      --qa-pad: 0.85rem;
      margin: 1.25em 0;
      border-radius: 0;
      border-right: none;
    }
  }

  .question {
    padding: var(--qa-pad);
  }

  .question-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }

  /* Chrome, not prose — stays monospace like the rest of the site's furniture. */
  .question-label {
    font-family: var(--font-mono, monospace);
    font-size: 0.95em;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--nord8);
  }

  .spoiler-button {
    font-family: var(--font-mono, monospace);
    font-size: 0.8em;
    color: var(--text-quiet);
    background-color: transparent;
    border: 1px solid var(--edge);
    border-radius: var(--radius-small);
    padding: 0.35em 0.9em;
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.15s ease,
      border-color 0.15s ease;
  }

  .spoiler-button:hover,
  .spoiler-button:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .question-text {
    margin: 0;
  }

  .spoiler-content {
    display: none;
    padding: var(--qa-pad);
    border-top: 1px solid var(--edge);
    background-color: rgba(0, 0, 0, 0.25);
  }

  .spoiler-content.revealed {
    display: block;
  }

  /* Nested prose brings its own margins, which would otherwise stack on top of
     the container padding and make the box look lopsided. */
  .spoiler-content > :global(:first-child) {
    margin-top: 0;
  }

  .spoiler-content > :global(:last-child) {
    margin-bottom: 0;
  }

  .question-code {
    margin: 0;
  }

  .question-code :global(pre),
  .spoiler-content :global(pre) {
    margin: 0.9rem 0;
    padding: 0.7rem 0.85rem;
    background-color: rgba(0, 0, 0, 0.35) !important;
    border: 1px solid var(--edge);
    border-radius: var(--radius-small);
    overflow-x: auto;
    font-family: var(--font-mono, monospace);
    font-size: 0.85em;
  }

  .question-code :global(pre) {
    margin: 0;
  }
</style>
