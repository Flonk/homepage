---
/**
 * The same two colours, run through more than one space, one above the other.
 *
 * A gradient's ends are given; the whole question is the route between them,
 * and a space is an answer to that question. Set two answers side by side and
 * the difference is the argument — which is why they stack rather than
 * appearing on separate cards. Two routes a reader has to remember between
 * slides is not a comparison, it is a memory test.
 *
 * Each band is a <GradientBand>, so the framing, the fallback for a browser
 * that cannot parse the interpolation syntax, the ends and the name set into
 * the corner all behave the same way as everywhere else in the series. What
 * this adds is only the stack, and which name goes on which band — a band
 * that does not say which space it is is half a picture.
 */
import GradientBand from './GradientBand.astro';

interface Props {
	/** The colour every band starts at. */
	from?: string;
	/** The colour they all end at. */
	to?: string;
	/**
	 * One band per entry, top to bottom: the CSS interpolation syntax and what
	 * to call it. The route a card is complaining about above the one it is
	 * recommending, which is the order a reader reads an argument in.
	 */
	spaces?: { space: string; name: string }[];
}

const {
	from = '#a3e635',
	to = '#164e63',
	spaces = [
		{ space: 'in srgb', name: 'sRGB' },
		{ space: 'in oklch', name: 'OKLCH' },
	],
} = Astro.props;
---

<div class="stack" data-gradient-stack>
	{
		spaces.map(({ space, name }) => (
			<div class="row">
				<GradientBand
					from={from}
					to={to}
					space={space}
					tag={name}
					label={`A gradient from ${from} to ${to}, interpolated in ${name}.`}
				/>
			</div>
		))
	}
</div>

<style>
	.stack {
		display: flex;
		flex-direction: column;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		font-family: var(--font-mono);
		color: var(--deck-ink-dim, #8891a0);
	}

	.row {
		flex: 1;
		min-block-size: 0;
		display: flex;
	}
</style>
