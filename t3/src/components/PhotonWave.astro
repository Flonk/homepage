---
/**
 * A photon oscillating up and down, drawing the sine wave it traces out
 * behind it as it goes.
 *
 * The camera travels with it, so the dot holds its place and the wave it has
 * already laid down streams away to the left. Nothing about the light differs
 * from watching the dot cross a fixed pane — it is the same motion from a
 * different seat — but it puts the thing you are meant to be looking at in one
 * place, and gets rid of the lap: the wave never has to wrap around and
 * overwrite itself at the edge.
 *
 * Everything on screen comes from two scale factors and nothing else: one for
 * space, one for time. Fix those and the wavelength, the travel speed and the
 * rate of the wiggle all follow, and they stay in step with each other the way
 * the real quantities do — light of every colour travels at the same speed, so
 * the rate the wave streams past never changes, and only the wave itself gets
 * longer or shorter.
 *
 * Along the top runs the spectrum itself, on a logarithmic axis from 1 MHz
 * to 10²¹ Hz, with a mark showing where the light being drawn sits on it. That
 * axis is the honest way to show fifteen decades at once, and it is what makes
 * the visible band come out as the two-percent slice it really is.
 *
 * The dot riding the wave is a picture, not a photon. A real photon has no
 * position wiggling about a line, and the wave is an amplitude of a field
 * rather than a displacement of anything; the height here carries no units at
 * all. What is faithful is the relationship between colour, wavelength and
 * frequency, which is the point of the card.
 */
interface Props {
	/**
	 * Frequency of the light, in terahertz. Visible light runs roughly 400 THz
	 * at the red end to 790 THz at the violet end.
	 */
	frequency?: number;
	/**
	 * Draw the wave in an approximation of the colour that light of this
	 * frequency looks like, rather than in white. Off by default: that colour is
	 * a claim about the eye rather than about the light, and a card is entitled
	 * to talk about wavelength and frequency before making it.
	 */
	spectral?: boolean;
	/**
	 * Run the frequency up and down between these two, in THz, instead of
	 * holding one — the whole spectrum going past rather than a sample of it.
	 * Low first. The sweep is geometric, so equal times cover equal ratios and
	 * it does not spend nearly all of itself at the top end, and it is weighted
	 * towards the bottom, because that is the end that needs the time.
	 *
	 * Both ends are limited by the drawing rather than by physics. At the top,
	 * above about 6000 THz, there are too few pixels of trace per wave to draw
	 * one. At the bottom the limit is not the frequency but the window: a wave
	 * has to fit in the pane to be seen as a wave at all, and the photon has to
	 * get through a turn of it while the sweep is down there. At 120 THz that
	 * is a 724px wave and a 4.2s turn — one whole wave on a laptop, and about
	 * two on a wide screen. An octave lower is a 1.4km-long wave arriving once
	 * every eight seconds, which no amount of dwelling can make visible.
	 *
	 * The readout keeps saying what is actually being shown.
	 */
	sweep?: [number, number];
	/** How long one round trip of the sweep takes, in seconds. */
	sweepSeconds?: number;
	/**
	 * Show the spectrum axis along the top, with a mark at the light being
	 * drawn. Not to be confused with `spectral`, which is about the colour of
	 * the wave rather than about this bar.
	 */
	spectrumBar?: boolean;
}

const {
	frequency = 545,
	spectral = false,
	sweep,
	sweepSeconds = 13,
	spectrumBar = true,
} = Astro.props;
---

<div
	class="photon"
	data-photon
	data-frequency={frequency}
	data-spectral={spectral ? 'true' : 'false'}
	data-sweep={sweep ? sweep.join(' ') : undefined}
	data-sweep-seconds={sweepSeconds}
	data-spectrum-bar={spectrumBar ? 'true' : 'false'}
>
	<canvas data-canvas></canvas>
	<div class="spectrum" data-spectrum>
		{/* The visible band is too narrow to letter, which is the point of it, so
		    its name is called out above the bar on a leader instead. */}
		<div class="spectrum-callout"><span data-spectrum-callout>Visible</span></div>
		<div class="spectrum-bar" data-spectrum-track>
			<div class="spectrum-mark" data-spectrum-mark></div>
		</div>
		<div class="spectrum-bands" data-spectrum-bands></div>
	</div>
	<div class="readout">
		<span data-light></span>
		<span class="dim" data-slowdown></span>
	</div>
</div>

<style>
	.photon {
		position: relative;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		font-family: var(--font-mono);
		/* Inherited from the deck, which knows whether this post's viz sits on
		   the light ground or the dark one; the fallbacks are the light pair, for
		   a use outside a deck. */
		--ink: var(--deck-ink, #35302a);
		--ink-dim: var(--deck-ink-dim, #7a7264);
		color: var(--ink);
	}

	.photon canvas {
		display: block;
		width: 100%;
		height: 100%;
	}

	/* Laid over the canvas along the top. The wave keeps to the middle half of
	   the pane, so the two do not meet. */
	.spectrum {
		position: absolute;
		top: 0.7rem;
		left: 1rem;
		right: 1rem;
		pointer-events: none;
		font-size: 0.62rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.spectrum[hidden] {
		display: none;
	}

	.spectrum-callout {
		position: relative;
		height: 1.15rem;
	}

	.spectrum-callout span {
		position: absolute;
		bottom: 0.35rem;
		transform: translateX(-50%);
		white-space: nowrap;
		color: var(--ink);
	}

	/* A leader down to the sliver the label belongs to, which is far too narrow
	   to letter and would be easy to mistake for a band boundary otherwise. */
	.spectrum-callout span::after {
		content: '';
		position: absolute;
		left: 50%;
		top: 100%;
		width: 1px;
		height: 0.35rem;
		background: currentColor;
		opacity: 0.55;
	}

	.spectrum-bar {
		position: relative;
		height: 0.85rem;
		border-radius: 2px;
		/* Filled in from the band table; see the script. */
		background: transparent;
	}

	/* Rides over the rainbow as well as over the dim bands, so it carries its
	   own dark outline rather than relying on contrast with what is behind. */
	.spectrum-mark {
		position: absolute;
		/* Standing proud of the bar at both ends, so that it reads as a mark
		   against the scale rather than as one more stripe of the rainbow. */
		top: -3px;
		bottom: -3px;
		width: 2px;
		margin-left: -1px;
		background: #fff;
		box-shadow:
			0 0 0 1px rgba(0, 0, 0, 0.75),
			0 0 7px 1px rgba(255, 255, 255, 0.45);
	}

	.spectrum-bands {
		position: relative;
		height: 1rem;
		margin-top: 0.3rem;
		color: var(--ink-dim);
	}

	/* :global, because these labels are made by the script, and so never carry
	   the attribute a scoped selector is compiled to look for. */
	.spectrum-bands :global(span) {
		position: absolute;
		top: 0;
		transform: translateX(-50%);
		white-space: nowrap;
	}

	.readout {
		position: absolute;
		right: 0.75rem;
		bottom: 0.4rem;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		gap: 0.05rem;
		font-size: 1.125rem;
		font-variant-numeric: tabular-nums;
		pointer-events: none;
	}

	.readout .dim {
		font-size: 0.8rem;
		color: var(--ink-dim);
	}

	@container viz (max-width: 30rem) {
		.readout {
			font-size: 0.85rem;
		}
		.readout .dim {
			font-size: 0.65rem;
		}
		.spectrum {
			left: 0.6rem;
			right: 0.6rem;
			font-size: 0.5rem;
			letter-spacing: 0.05em;
		}
	}
</style>

<script>
	/* ---- the two scales -------------------------------------------------
	   Space: how many screen pixels stand for a nanometre. Time: how much
	   slower than life this runs. Everything else is worked out from them, so
	   the picture stays self-consistent whatever frequency it is showing.

	   The slowdown is the number it is because of what it has to achieve.
	   Green light oscillates about 545 million million times a second; to see
	   that as a wiggle roughly once a second, the factor has to be around ten
	   to the fourteenth. Nothing smaller is in the running — at a factor of a
	   thousand it would still be flickering 545 billion times a second. */
	const C_NM_PER_S = 2.99792458e17; // the speed of light, in nanometres a second
	const SLOWDOWN = 5e14;
	const PX_PER_NM = 0.29;

	/* How much of the trace behind the dot is lit, and how finely that fade is
	   stepped. A couple of wavelengths' worth: enough to read as a trail, short
	   enough that it is clearly the dot dragging it. */
	const TAIL_PX = 280;
	const TAIL_STEP = 10;

	/* Where along the pane the photon sits. Off to the right, so that nearly all
	   of the width is given to the wave streaming back from it, with enough room
	   ahead for its glow. */
	const HEAD_FRAC = 0.72;

	/** How the slowdown is written out, once, rather than derived by eye. */
	const SLOWDOWN_TEXT = '5 × 10¹⁴';

	/* An approximate sRGB rendering of a single wavelength. It cannot be an
	   exact one: a pure spectral colour is outside what three fixed primaries
	   can mix, so every one of these is a nearest-available stand-in, and the
	   saturated ends are the furthest off. Which is, more or less, what this
	   series is about. */
	function wavelengthRgb(nm: number): [number, number, number] {
		let r = 0;
		let g = 0;
		let b = 0;
		if (nm >= 380 && nm < 440) {
			r = -(nm - 440) / 60;
			b = 1;
		} else if (nm < 490) {
			g = (nm - 440) / 50;
			b = 1;
		} else if (nm < 510) {
			g = 1;
			b = -(nm - 510) / 20;
		} else if (nm < 580) {
			r = (nm - 510) / 70;
			g = 1;
		} else if (nm < 645) {
			r = 1;
			g = -(nm - 645) / 65;
		} else if (nm <= 780) {
			r = 1;
		}
		// The eye's response tails off at both ends of the visible range.
		let fade = 1;
		if (nm >= 380 && nm < 420) fade = 0.3 + (0.7 * (nm - 380)) / 40;
		else if (nm > 700 && nm <= 780) fade = 0.3 + (0.7 * (780 - nm)) / 80;
		const enc = (v: number) => Math.round(255 * Math.pow(Math.max(0, v) * fade, 0.8));
		return [enc(r), enc(g), enc(b)];
	}

	/* ---- the spectrum axis ----------------------------------------------
	   Fifteen decades, so the axis has to be logarithmic; a linear one would
	   put everything below X-rays in the first pixel. The ends are chosen to
	   take in what the card talks about — AM radio at the bottom, gamma at the
	   top — and the visible band comes out as the two percent of it that it
	   really is, which is worth more than any amount of saying so.

	   Boundaries between bands are conventional rather than physical: nothing
	   happens to the light at 300 GHz. The visible band is the exception, and
	   it is set to 380–780nm, which is the range the colour approximation
	   above is defined over — so the rainbow runs to the ends of the band
	   rather than stopping short of them or running past into black.

	   The unlit bands are tinted rather than coloured, and the two either side
	   of the rainbow lean warm and cool: infrared is beyond red, ultraviolet is
	   beyond violet, and the names are only worth so much. */
	const SPECTRUM_LO_HZ = 1e6;
	const SPECTRUM_HI_HZ = 1e21;
	const BANDS: { name: string; to: number; tint: string | null }[] = [
		{ name: 'Radio', to: 3e8, tint: '#39404a' },
		{ name: 'Microwave', to: 3e11, tint: '#454d5a' },
		{ name: 'Infrared', to: 3.843e14, tint: '#5c3a33' },
		{ name: 'Visible', to: 7.889e14, tint: null },
		{ name: 'Ultraviolet', to: 3e16, tint: '#453569' },
		{ name: 'X-ray', to: 3e19, tint: '#4a5560' },
		{ name: 'Gamma', to: SPECTRUM_HI_HZ, tint: '#5e6773' },
	];

	/** Where a frequency in Hz falls along the axis, as a fraction of its width. */
	const spectrumPos = (hz: number) =>
		Math.log(hz / SPECTRUM_LO_HZ) / Math.log(SPECTRUM_HI_HZ / SPECTRUM_LO_HZ);

	/** A pair of frequencies in THz, low first, or null for anything else. */
	function parseSweep(v: unknown): [number, number] | null {
		const raw = typeof v === 'string' ? v.split(/[\s,]+/) : Array.isArray(v) ? v : null;
		if (!raw || raw.length !== 2) return null;
		const [a, b] = raw.map(Number);
		if (!(a > 0) || !(b > 0) || a === b) return null;
		return [Math.min(a, b), Math.max(a, b)];
	}

	function initPhoton(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const spectrumEl = root.querySelector<HTMLElement>('[data-spectrum]')!;
		const trackEl = root.querySelector<HTMLElement>('[data-spectrum-track]')!;
		const markEl = root.querySelector<HTMLElement>('[data-spectrum-mark]')!;
		const bandsEl = root.querySelector<HTMLElement>('[data-spectrum-bands]')!;
		const calloutEl = root.querySelector<HTMLElement>('[data-spectrum-callout]')!;
		const ctx = canvas.getContext('2d')!;
		const outLight = root.querySelector<HTMLElement>('[data-light]')!;
		const outSlow = root.querySelector<HTMLElement>('[data-slowdown]')!;
		outSlow.textContent = `time slowed ${SLOWDOWN_TEXT}`;

		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		/* The axis is fixed, so it is drawn once as a gradient and a row of
		   labels rather than redrawn per frame; only the mark moves. */
		(function buildSpectrum() {
			const stops: string[] = [];
			const pct = (hz: number) => spectrumPos(hz) * 100;
			let from = SPECTRUM_LO_HZ;
			for (const band of BANDS) {
				const a = pct(from);
				const z = pct(band.to);
				const mid = (a + z) / 2;
				if (band.tint) {
					// Hard stops at both edges, so the bands read as bands.
					stops.push(`${band.tint} ${a}%`, `${band.tint} ${z}%`);
					const label = document.createElement('span');
					label.textContent = band.name;
					label.style.left = `${mid}%`;
					bandsEl.append(label);
				} else {
					// Sampled geometrically, matching the axis, so the rainbow is not
					// bunched towards one end of its own band.
					const STEPS = 24;
					for (let i = 0; i <= STEPS; i++) {
						const t = i / STEPS;
						const hz = from * Math.pow(band.to / from, t);
						const nm = Math.min(780, Math.max(380, C_NM_PER_S / hz));
						const [r, g, b] = wavelengthRgb(nm);
						stops.push(`rgb(${r} ${g} ${b}) ${a + (z - a) * t}%`);
					}
					calloutEl.style.left = `${mid}%`;
				}
				from = band.to;
			}
			trackEl.style.background = `linear-gradient(to right, ${stops.join(', ')})`;
		})();

		/* Parameters arrive at the stage, or at the phase of it this belongs to;
		   see DeckViz. A card's set is complete rather than a patch, so anything
		   it leaves out goes back to how this was authored. */
		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ??
			root.closest<HTMLElement>('[data-viz-stage]');
		const gate = root.closest<HTMLElement>('[data-viz-phase]');

		const AUTHORED = Math.max(1, Number(root.dataset.frequency) || 545);
		const AUTHORED_SPECTRAL = root.dataset.spectral === 'true';
		const AUTHORED_SWEEP = parseSweep(root.dataset.sweep);
		const AUTHORED_BAR = root.dataset.spectrumBar !== 'false';
		const SWEEP_SECS = Math.max(1, Number(root.dataset.sweepSeconds) || 13);
		let wanted = AUTHORED;
		let spectral = AUTHORED_SPECTRAL;
		let showBar = AUTHORED_BAR;
		// Settled now rather than on the next frame: a pane that is not animating
		// still has to show the axis.
		const applyBar = () => {
			if (spectrumEl.hidden === showBar) spectrumEl.hidden = !showBar;
		};
		const placeMark = () => {
			const p = Math.min(1, Math.max(0, spectrumPos(freqThz * 1e12)));
			markEl.style.left = `${(p * 100).toFixed(3)}%`;
		};
		applyBar();
		// Eased rather than jumped, so a card changing the colour shows the wave
		// stretching into its new shape instead of cutting to it.
		let freqThz = AUTHORED;

		/* ---- the sweep ------------------------------------------------------
		   A round trip low → high → low, geometric in frequency and eased at
		   both turning points, driven by a clock of its own.

		   Bent towards the bottom of the range, because the two ends do not need
		   the same amount of time. A fast wave shows what it is in a fraction of
		   a second; a slow one has to travel most of the pane before there is a
		   whole wave to look at, and the photon takes seconds to turn over. An
		   even sweep leaves the low end as an arc that never resolves. */
		const SWEEP_BIAS = 2.2;

		let sweeping: [number, number] | null = null;
		let sweepT = 0;

		const sweepAt = (t: number, [lo, hi]: [number, number]) => {
			const ping = (1 - Math.cos((2 * Math.PI * t) / SWEEP_SECS)) / 2;
			return lo * Math.pow(hi / lo, Math.pow(ping, SWEEP_BIAS));
		};

		/* Where to start that clock so the sweep is passing through `f` on its
		   way up: the wave then carries on from whatever it was already doing
		   instead of snapping to the bottom of the range. */
		const sweepEntry = (f: number, [lo, hi]: [number, number]) => {
			const u = Math.min(1, Math.max(0, Math.log(f / lo) / Math.log(hi / lo)));
			const ping = Math.pow(u, 1 / SWEEP_BIAS);
			return (SWEEP_SECS / (2 * Math.PI)) * Math.acos(1 - 2 * ping);
		};

		const setSweep = (next: [number, number] | null) => {
			const same =
				(!next && !sweeping) ||
				(next && sweeping && next[0] === sweeping[0] && next[1] === sweeping[1]);
			if (same) return;
			if (next) sweepT = sweepEntry(freqThz, next);
			sweeping = next;
		};
		setSweep(AUTHORED_SWEEP);
		placeMark();

		host?.addEventListener('viz:props', (e) => {
			const p = (e as CustomEvent).detail ?? {};
			wanted = 'frequency' in p ? Math.max(1, Number(p.frequency) || AUTHORED) : AUTHORED;
			spectral = 'spectral' in p ? Boolean(p.spectral) : AUTHORED_SPECTRAL;
			setSweep('sweep' in p ? parseSweep(p.sweep) : AUTHORED_SWEEP);
			showBar = 'spectrumBar' in p ? Boolean(p.spectrumBar) : AUTHORED_BAR;
			applyBar();
		});

		/* ---- the trace ------------------------------------------------------
		   One height per column, written as the dot goes past. Kept rather than
		   recomputed so that changing the frequency leaves the wave already
		   drawn alone, and the new shape grows out of the old one. */
		let w = 0;
		let h = 0;
		let dpr = 1;
		let trace = new Float32Array(8);
		let headX = 0; // the photon's column, fixed
		let dist = 0; // total distance travelled, in css pixels
		let phase = 0;

		const amplitude = () => h * 0.24;
		const lambdaPx = () => (C_NM_PER_S / (freqThz * 1e12)) * PX_PER_NM;

		/** Height the dot had, or would have had, at column `d` of its travel. */
		const heightAt = (d: number) =>
			amplitude() * Math.sin(phase - (2 * Math.PI * (dist - d)) / lambdaPx());

		const writeSpan = (from: number, to: number) => {
			const L = trace.length;
			for (let d = Math.ceil(from); d <= Math.floor(to); d++) {
				trace[((d % L) + L) % L] = heightAt(d);
			}
		};

		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = Math.max(1, Math.round(h * dpr));
			headX = Math.round(w * HEAD_FRAC);
			// One slot per column behind the photon, and a few spare: the wave is
			// read a column early for the sub-pixel offset, and one column past
			// the head keeps the ring's ends from meeting on a visible sample.
			trace = new Float32Array(Math.max(8, headX + 4));
			// Lay down a full wave straight away, so the pane is never blank; the
			// dot's first pass then just runs along what is already there.
			writeSpan(dist - trace.length, dist);
		};
		new ResizeObserver(resize).observe(canvas);
		resize();

		let last = 0;
		host?.addEventListener('viz:enter', () => {
			last = 0;
		});

		function frame(now: number) {
			requestAnimationFrame(frame);
			if (gate && gate.dataset.vizActive === 'false') return;
			if (!w || !h) return;

			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;

			if (sweeping && !reduceMotion) {
				sweepT += dt;
				freqThz = sweepAt(sweepT, sweeping);
			} else if (freqThz !== wanted) {
				// Not while sweeping: the sweep is the frequency, and easing towards
				// a resting value at the same time would only drag against it.
				const k = 1 - Math.exp(-3 * dt);
				freqThz += (wanted - freqThz) * k;
				if (Math.abs(wanted - freqThz) < 0.01) freqThz = wanted;
			}

			const nm = C_NM_PER_S / (freqThz * 1e12);
			const [r, g, b] = wavelengthRgb(nm);
			const colour = spectral ? `rgb(${r} ${g} ${b})` : '#ffffff';

			if (!reduceMotion) {
				// Both follow from the scales: the wave streams past at a slowed,
				// magnified speed of light, and the photon turns over once per
				// wavelength that goes by.
				const speed = (C_NM_PER_S * PX_PER_NM) / SLOWDOWN;
				const was = dist;
				dist += speed * dt;
				phase += ((2 * Math.PI * freqThz * 1e12) / SLOWDOWN) * dt;
				writeSpan(was, dist);
			}

			const L = trace.length;
			const cy = h / 2;

			/* Screen column i shows the height the photon had `headX - i` pixels
			   of travel ago, so the whole wave slides left as `dist` grows. The
			   trace is written at whole pixels of travel; the fraction left over
			   is carried by shifting the drawn path, so the wave streams smoothly
			   rather than in pixel steps. */
			const D = Math.floor(dist);
			const sub = dist - D;
			const dotY = cy + amplitude() * Math.sin(phase);
			const at = (i: number) => {
				const d = D - headX + i;
				return trace[((d % L) + L) % L];
			};

			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			ctx.clearRect(0, 0, w, h);
			ctx.lineJoin = 'round';
			ctx.lineCap = 'round';
			ctx.strokeStyle = colour;
			ctx.lineWidth = 2.5;

			const stroke = (from: number, to: number) => {
				ctx.beginPath();
				for (let i = from; i <= to; i++) {
					const y = cy + at(i);
					const x = i - sub;
					if (i === from) ctx.moveTo(x, y);
					else ctx.lineTo(x, y);
				}
				// The trace is sampled at whole pixels of travel, so its last
				// sample is up to a pixel short of where the photon actually is.
				// Finish at the photon itself rather than near it.
				if (to === headX) ctx.lineTo(headX, dotY);
				ctx.stroke();
			};

			/* The whole wave at one strength, then a tail brightening into the
			   photon, which is what carries the sense of a trace being laid down.
			   The wave is drawn one column past its left edge so that the sub-pixel
			   shift cannot open a gap there. */
			ctx.globalAlpha = 0.45;
			stroke(-1, headX);

			for (let s = 0; s < TAIL_PX; s += TAIL_STEP) {
				const from = headX - s - TAIL_STEP;
				if (from < -1) break;
				// Squared, so it leans bright near the dot and tails off gently.
				const t = 1 - s / TAIL_PX;
				ctx.globalAlpha = 0.45 + 0.55 * t * t;
				stroke(from, headX - s);
			}
			ctx.globalAlpha = 1;

			// The photon, with a glow of its own colour. shadowBlur is in device
			// pixels and ignores the transform, so it is scaled by hand.
			ctx.save();
			ctx.shadowColor = colour;
			ctx.shadowBlur = 16 * dpr;
			ctx.fillStyle = colour;
			ctx.beginPath();
			ctx.arc(headX, dotY, 5, 0, Math.PI * 2);
			ctx.fill();
			ctx.restore();
			ctx.globalAlpha = 1;

			outLight.textContent = `${Math.round(nm)} nm · ${Math.round(freqThz)} THz`;

			if (showBar) placeMark();
		}

		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-photon]').forEach(initPhoton);
</script>
