---
/**
 * One card in a deck post: a visualization and the prose that explains it.
 *
 * The two halves live on opposite sides of the screen, but they are authored
 * together so the viz state sits next to the text describing it. That works
 * because the card itself is `display: contents` — it generates no box, so
 * .card-viz and .card-text become grid items of the deck directly and can be
 * placed into its "viz" and "text" areas independently.
 *
 *   <DeckCard>
 *     <ColorWheel slot="viz" ... />
 *
 *     ## Hue
 *     Hue is the angle around the wheel.
 *   </DeckCard>
 */
interface Props {
	/** Short label for the card, shown in the deck's progress dots tooltip. */
	label?: string;
}

const { label } = Astro.props;
---

<article class="deck-card" data-card data-card-label={label}>
	<div class="card-viz">
		<slot name="viz" />
	</div>
	<div class="card-text">
		<div class="card-text-inner prose deck-prose">
			<slot />
		</div>
	</div>
</article>

<style>
	/* No box of its own, so the two halves land in the deck grid directly. */
	.deck-card {
		display: contents;
	}

	.card-viz,
	.card-text {
		/* Every card occupies the same two cells; only the active one is shown. */
		min-width: 0;
		min-height: 0;
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.card-viz {
		grid-area: viz;
		/* A size container, so a visualization can lay itself out from the shape
		   of its own pane rather than the viewport. `size` rather than
		   `inline-size` because whether the pane is portrait or landscape is
		   the interesting question, and that needs both axes. */
		container: viz / size;
		display: flex;
		align-items: center;
		justify-content: center;
		/* No bottom padding: a viz may run to the pane edge and be clipped by it. */
		padding: 1rem 1rem 0;
		overflow: hidden;
		opacity: 0;
		pointer-events: none;
	}

	/* Whole components swap between cards, so they cross-fade rather than tween. */
	.deck-card[data-state='active'] .card-viz {
		opacity: 1;
		pointer-events: auto;
	}

	.card-text {
		grid-area: text;
		display: flex;
		justify-content: center;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1.5rem 1.5rem 0.5rem;
		opacity: 0;
		transform: translateX(2.5rem);
		pointer-events: none;
		visibility: hidden;
	}

	.deck-card[data-state='active'] .card-text {
		opacity: 1;
		transform: none;
		pointer-events: auto;
		visibility: visible;
	}

	/* Cards already read slide off to the left, so direction carries meaning. */
	.deck-card[data-state='before'] .card-text {
		transform: translateX(-2.5rem);
	}

	.card-text-inner {
		width: 100%;
	}

	/* The card is its own column; it must not also apply the page measure. */
	.card-text-inner :global(> :first-child) {
		margin-top: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.card-viz,
		.card-text {
			transition-duration: 0.01ms;
		}
	}
</style>
