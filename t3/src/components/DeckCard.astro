---
/**
 * One card in a deck post: the prose, and a note about what the visualization
 * should be doing while that prose is on screen.
 *
 * The viz itself lives in the deck's <DeckViz>, not in here, so that
 * consecutive cards share one instance instead of cross-fading between copies
 * of it. A card contributes only parameters, and the three things you might
 * want when moving forward all fall out of one rule — anything a card does not
 * mention it inherits from the card before it:
 *
 *   <DeckCard>…</DeckCard>                                nothing changes
 *   <DeckCard vizProps={{ lock: [1, 0, 0] }}>…</DeckCard> same viz, new setup
 *   <DeckCard vizProps={{ phase: 'gamut' }}>…</DeckCard>  a different component
 *
 * The card is `display: contents`, so it generates no box and .card-text
 * becomes a grid item of the deck directly, landing in its "text" area.
 */
interface Props {
	/**
	 * Parameters for the deck's visualization while this card is showing.
	 * Omit to leave it exactly as the previous card had it.
	 */
	vizProps?: Record<string, unknown>;
}

const { vizProps } = Astro.props;
---

<article
	class="deck-card"
	data-card
	data-viz-props={vizProps ? JSON.stringify(vizProps) : undefined}
>
	<div class="card-text">
		<div class="card-text-inner prose deck-prose">
			<slot />
		</div>
	</div>
</article>

<style>
	/* No box of its own, so the text lands in the deck grid directly. */
	.deck-card {
		display: contents;
	}

	.card-text {
		grid-area: text;
		/* Every card occupies the same cell; only the active one is shown. */
		min-width: 0;
		min-height: 0;
		display: flex;
		justify-content: center;
		/* Not stretched: a stretched item is forced to the container's height, so
		   its own bottom padding ends up behind the content overflowing it rather
		   than below it. Sized to its content, the padding is really at the end. */
		align-items: flex-start;
		overflow-y: auto;
		overscroll-behavior: contain;
		/* The card scrolls vertically; the horizontal axis belongs to the deck's
		   swipe. Left to itself the browser arbitrates the whole gesture and
		   cancels the pointer part-way through a sideways drag. */
		touch-action: pan-y pinch-zoom;
		/* Bottom spacing lives on the content below, not here: a scroll
		   container's end padding is left out of its scrollable area once the
		   overflow comes from a stretched flex item, so scrolling to the bottom
		   put the last line flat against the edge. */
		padding: 1.5rem 1.5rem 0;
		opacity: 0;
		transform: translateX(2.5rem);
		pointer-events: none;
		visibility: hidden;
		transition:
			opacity 0.35s ease,
			transform 0.35s ease;
	}

	.deck-card[data-state='active'] .card-text {
		opacity: 1;
		transform: none;
		pointer-events: auto;
		visibility: visible;
	}

	/* Cards already read slide off to the left, so direction carries meaning. */
	.deck-card[data-state='before'] .card-text {
		transform: translateX(-2.5rem);
	}

	.card-text-inner {
		width: 100%;
		padding-bottom: 1.5rem;
	}

	/* The card is its own column; it must not also apply the page measure. The
	   margins at both ends go, so the space above and below the text is the
	   padding and nothing else, and the two match. */
	.card-text-inner :global(> :first-child) {
		margin-top: 0;
	}

	.card-text-inner :global(> :last-child) {
		margin-bottom: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		.card-text {
			transition-duration: 0.01ms;
		}
	}
</style>
