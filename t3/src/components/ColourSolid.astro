---
/**
 * The RGB cube and the HSL cylinder, and the fact that they are the same
 * colours.
 *
 * Every point on the cube's surface has HSL saturation exactly 1 — a colour on
 * the surface has either a channel at 0 or one at 1, and either way the
 * formula lands on 1 — so the cube's skin and the HSL solid's skin hold the
 * same set of colours. What differs is where they are put. The six pure hues
 * sit at L = 0.5 in HSL, on one flat circle; on the cube they are six corners
 * of a *skew* hexagon, three of them a good deal nearer the black corner than
 * the other three. Yellow is not as far from black as blue is, and no amount
 * of arithmetic in HSL will admit it.
 *
 * So the morph is the argument. Tip the cube onto its black corner and the
 * white corner is straight up: that axis is already HSL's L. Flatten the skew
 * hexagon into a circle and the solid becomes the double cone, which is the
 * shape HSL's numbers actually describe if you plot saturation as a radius.
 * Then push the cones' slanted walls out to a straight cylinder, which is the
 * shape the sliders pretend it is: full saturation available at every
 * lightness, including at the two ends where there is nothing but black and
 * white to be had. The last step is the lie, and watching it happen is the
 * point of the card.
 *
 * Three phases, two seconds each, reversible. The geometry is one mesh with
 * two positions per vertex — where it is on the cube, and its (h, s, l) — and
 * the shader places it: the cube position as authored, the cone and the
 * cylinder computed from the angle and the height. Nothing is re-uploaded, so
 * the morph costs a uniform.
 *
 * Rendered in raw WebGL for the same reason RgbCube is: a colour here is a
 * position, and every engine worth the name has a tone-mapping stage that
 * would quietly rewrite it on the way to the screen.
 */
import Pill from './Pill.astro';
import { lighten, lightenRgb } from '../lib/oklch';
import { rgbCss, type Rgb } from '../lib/rgb';
import VizTrack from './VizTrack.astro';

/* HSL to sRGB, for the two places that need the numbers rather than a string:
   the hue bar's lifted edge here, and the same trick per frame in the script.
   The formula is CSS's own. */
const hslRgb = (h: number, s: number, l: number): Rgb => {
	const f = (n: number) => {
		const k = (n + h / 30) % 12;
		const a = (s / 100) * Math.min(l / 100, 1 - l / 100);
		return Math.round(255 * (l / 100 - a * Math.max(-1, Math.min(k - 3, 9 - k, 1))));
	};
	return [f(0), f(8), f(4)];
};

interface Props {
	/** Seconds of no input before the dot resumes tracing. */
	idleResume?: number;
	/** Ambient rotation. */
	spin?: boolean;
	/** Which solid to start on. */
	space?: 'rgb' | 'hsl';
	/**
	 * Offer the switch, and turn it back and forth by itself. Off for a card
	 * that has finished making the comparison and is now talking about one of
	 * the two solids: the shape stops changing under the reader, and there is
	 * no control inviting them to change it back.
	 */
	toggle?: boolean;
	/**
	 * The two-hue comparison: the sliders become two sets with saturation and
	 * lightness pinned, the solid grows a second dot, and a panel of swatches
	 * appears that can drop the colour out from under both of them. For the
	 * card whose point is that HSL's L is not a brightness.
	 */
	compare?: boolean;
	/** Where the two start, in degrees. Blue and yellow: the worst pair. */
	hues?: [number, number];
}

const {
	idleResume = 5,
	spin = true,
	space = 'rgb',
	toggle = true,
	compare = false,
	hues = [240, 60] as [number, number],
} = Astro.props;

/* Where the two start: full saturation, half lightness — the same for both,
   which is the claim the card is testing. All three bars move, on both sides,
   because the interesting thing a reader can do here is break the premise and
   watch what happens to the pair of greys. */
const START = [100, 50];

// Gradient ids are document-global, so two of these on a page would share one.
const gradId = `solid-${Math.random().toString(36).slice(2, 9)}`;


const RGB = [
	{ name: 'Red', ramp: '#f16d6d' },
	{ name: 'Green', ramp: '#7bd88f' },
	{ name: 'Blue', ramp: '#6d9bf1' },
];

/* The hue bar carries the whole wheel; the other two are repainted from the
   colour the dot is on, because a saturation scale means nothing without the
   hue it is a saturation of. See paintHsl in the script. */
const HUES = [0, 60, 120, 180, 240, 300, 360];
const HUE_RAMP = `linear-gradient(to top, ${HUES.map((d) => `hsl(${d} 100% 50%)`).join(', ')})`;
/* And the same wheel lifted a fifth of the way to white, for the edge: the
   bar's own colour all along its length rather than one flat line laid over
   it. See lighten in lib/oklch, and the cube's channel bars for the pattern. */
const HUE_EDGE = `linear-gradient(to top, ${HUES.map((d) =>
	rgbCss(lightenRgb(hslRgb(d, 100, 50), 0.2)),
).join(', ')})`;

const HSL = [
	{ name: 'Hue', letter: 'H', max: 360, backdrop: HUE_RAMP, edge: HUE_EDGE },
	{
		name: 'Saturation',
		letter: 'S',
		max: 100,
		backdrop: 'linear-gradient(to top, #808080, #f00)',
		// Repainted from the colour on show, edge and all: see the render loop.
		edge: null,
	},
	{
		name: 'Lightness',
		letter: 'L',
		max: 100,
		backdrop: 'linear-gradient(to top, #000, #f00, #fff)',
		edge: null,
	},
];
---

<div
	class="solid"
	data-colour-solid
	data-no-swipe
	data-idle-resume={idleResume}
	data-spin={String(spin)}
	data-space={space}
	data-toggle-shown={String(toggle)}
	data-compare={String(compare)}
	data-grey="false"
>
	{/* One context for all six bars: they are one colour between them, so a
	    grab on any of them stops the dot for everybody. See lib/animate. */}
	<div class="rig" data-anim-context>
		{/* One panel per colour: the swatch it comes to, and the three numbers
		    that got it there. Two of them side by side is the comparison — the
		    same three sliders, the same L, and two things that are not the same
		    brightness at all. */}
		<div class="slot" data-slot="pair" data-open={String(compare)}>
		<div class="sets">
		{[0, 1].map((set) => (
				<div
					class="plate set"
					role="group"
					aria-label={`Colour ${set + 1}`}
					data-plate={`set-${set}`}
				>
					<div class="bars">
						{HSL.map((ch, c) => (
							<div class="bar" style={ch.edge && `--track-edge: ${ch.edge}`}>
								<VizTrack
									upright
									size="1.1rem"
									backdrop={ch.backdrop}
									thumbs={1}
									values={[c === 0 ? hues[set] : START[c - 1]]}
									min={0}
									max={ch.max}
									step={1}
									labels={[`${ch.name}, colour ${set + 1}`]}
								/>
								<span class="bar-name" aria-hidden="true">
									{ch.letter}
								</span>
							</div>
						))}
					</div>
					<div class="disc" data-disc={set} aria-hidden="true" />
				</div>
		))}
		</div>
		</div>

		<div class="slot" data-slot="rgb" data-open={String(!compare)}>
		<div class="plate rgb" role="group" aria-label="Red, green and blue" data-plate="rgb">
			{
				RGB.map((ch) => (
					<div
						class="bar"
						style={`--track-edge: linear-gradient(to top, ${lighten('#000000', 0.2)}, ${lighten(ch.ramp, 0.2)})`}
					>
						<VizTrack
							upright
							size="1.5rem"
							backdrop={`linear-gradient(to top, #000, ${ch.ramp})`}
							thumbs={1}
							values={[128]}
							min={0}
							max={255}
							step={1}
							labels={[ch.name]}
						/>
						<span class="bar-name" aria-hidden="true">
							{ch.name[0]}
						</span>
					</div>
				))
			}
		</div>
		</div>

		<div class="middle">
			<div class="stage">
				<canvas data-canvas></canvas>
			</div>

			{/* The switch, and the only control that is not a slider. role=switch
			    with both names showing: what it is set to has to be readable at a
			    glance beside a shape that is halfway between the two. */}
			<div class="controls">
				<p class="readout" data-readout>rgb(128 128 128)</p>
				<div class="switch space">
					<Pill
						class="toggle"
						sides={['RGB', 'HSL']}
						at={space === 'hsl' ? 1 : 0}
						label="Colour space"
						data-toggle
						inert={!toggle}
					/>
				</div>
				{/* Under the solid, because what it takes the colour out of is the
				    solid as much as the two swatches. */}
				<div class="switch grey">
					<Pill
						class="toggle"
						sides={['COLOUR', 'GREY']}
						label="Drop the colour"
						data-grey-toggle
						inert={!compare}
					/>
				</div>
			</div>
		</div>

		<div class="slot" data-slot="hsl" data-open={String(!compare)}>
		<div class="plate hsl" role="group" aria-label="Hue, saturation and lightness" data-plate="hsl">
			{
				HSL.map((ch) => (
					<div class="bar" style={ch.edge && `--track-edge: ${ch.edge}`}>
						<VizTrack
							upright
							size="1.5rem"
							backdrop={ch.backdrop}
							thumbs={1}
							values={[0]}
							min={0}
							max={ch.max}
							step={1}
							labels={[ch.name]}
						/>
						<span class="bar-name" aria-hidden="true">
							{ch.letter}
						</span>
					</div>
				))
			}
		</div>
		</div>
	</div>

	{/* The colour on show, as a field rather than a chip: an S that bisects the
	    pane diagonally and fills the lower-right side. The viewBox is a flat
	    0-100 square stretched to the pane, so the coordinates are percentages
	    and anything past the edges simply runs off frame.

	    It halves the pane at any size: the chord runs corner to corner, and the
	    two control points sit symmetrically about the centre, so the lobe the S
	    adds on one side is exactly the lobe it takes from the other. Keep that
	    symmetry when reshaping and the halving survives. */}
	<svg class="swoosh" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
		<defs>
			{/* Bottom-left to top-right: the diagonal the S itself runs along, and
			    the one whose two ends both land on filled area. With one colour
			    both stops hold it and the field is flat, so the single-colour
			    cards need no second code path. */}
			<linearGradient id={gradId} x1="0" y1="1" x2="1" y2="0">
				<stop offset="0" stop-color="var(--swatch-a, #808080)" />
				<stop offset="1" stop-color="var(--swatch-b, var(--swatch-a, #808080))" />
			</linearGradient>
		</defs>
		<path d="M -10 112 C 48 88, 52 12, 110 -12 L 112 112 Z" fill={`url(#${gradId})`}></path>
	</svg>
</div>

<style>
	.solid {
		/* The two plates are fixed-width and the stage takes the rest, so the
		   shape stays in the middle whichever set of bars is lit. */
		--viz-max: none;
		/* How much of the stage's shorter side the solid fills. A property
		   rather than a number in the script, because how much room there is
		   depends on the arrangement, and the arrangement is a container query:
		   on a phone the stage has the whole width and most of the height, and
		   a size picked for a wide shallow band leaves the shape marooned. */
		--solid-scale: 0.52;
		position: relative;
		display: flex;
		align-items: stretch;
		justify-content: center;
		width: 100%;
		height: 100%;
		min-width: 0;
		min-height: 0;
		box-sizing: border-box;
		font-family: var(--font-mono);
		color: var(--deck-ink-dim, #8891a0);
	}

	/* Over the swoosh, both of them. */
	.rig {
		position: relative;
		z-index: 1;
	}

	/* Covers the whole pane, bleeding past the pane's own padding so the S meets
	   its edges; the viz half clips it. Sized explicitly rather than by the
	   insets: an svg carrying a viewBox is a replaced element, so an auto width
	   would give it the viewBox's 1:1 ratio and render it square. */
	.swoosh {
		position: absolute;
		z-index: 0;
		top: -1rem;
		right: -1rem;
		bottom: 0;
		left: -1rem;
		width: calc(100% + 2rem);
		height: calc(100% + 1rem);
		pointer-events: none;
	}

	/* The air between a plate and the solid is carried by the plate rather than
	   by the row, because a gap belongs to a row whatever is in it: with the
	   left plate closed to nothing there would still be a gap holding its
	   place, and the whole composition would sit off-centre by it. As a margin
	   on the slot it closes when the slot does. */
	.rig {
		--rig-gap: clamp(0.5rem, 2.5%, 2rem);
		flex: 1;
		min-width: 0;
		min-height: 0;
		display: flex;
		align-items: stretch;
		justify-content: center;
	}

	/* Both plates hold their space whether or not they are the live one: a set
	   of bars that folded away would move the shape sideways every time the
	   switch was thrown, and the shape is what a reader is watching. */
	/* Three bars on a plate of their own. Loose on the ground they would read as
	   part of the picture; on a panel they read as the thing you are allowed to
	   touch — and the marks, white and lit for the spectrum's sake, have
	   something to be white against. A wash of white over whatever is behind it
	   rather than a colour of its own, with the ground blurred underneath: the
	   swoosh runs under the right-hand plate, and the panel wants to read as
	   glass over the colour rather than as a lid on it. */
	.plate {
		flex: none;
		display: flex;
		gap: 0.75rem;
		align-items: stretch;
		box-sizing: border-box;
		margin: 1em 0;
		padding: 1em;
		border-radius: var(--radius-large);
		transition:
			opacity 0.45s ease,
			padding 0.45s ease;
		background: var(--plate, var(--viz-glass, rgb(255 255 255 / 0.06)));
		/* The lit rim, and a soft shadow under the pane so the glass sits above
		   the colour rather than in it. */
		box-shadow:
			inset 0 0 0 1px var(--viz-glass-rim, rgb(255 255 255 / 0.08)),
			0 4px 16px rgb(0 0 0 / 0.15);
		backdrop-filter: blur(6px);
	}

	/* The set that is not being used is left legible but plainly out of play —
	   dimmed and desaturated rather than hidden, so a reader can see that the
	   same colour has a reading in both spaces. The plate itself keeps its
	   ground; it is the bars that go quiet, not the panel they are on. */
	.plate .bar {
		transition:
			opacity 0.45s ease,
			filter 0.45s ease;
	}

	.solid[data-space='hsl'] .plate.rgb .bar,
	.solid[data-space='rgb'] .plate.hsl .bar {
		opacity: 0.3;
		filter: saturate(0.4);
	}

	/* With the switch gone the card is about one space and not the pair of
	   them, so the other set of bars goes rather than sitting there greyed —
	   there is nothing left to compare it to, and nothing a reader could do
	   about it.

	   It closes rather than disappearing, because a card change is a move
	   between two arrangements and not a cut between two pictures. A flex item
	   cannot be transitioned from its own width to nothing — `auto` is not a
	   length, so there is no pair of values to interpolate — so each plate sits
	   in a one-cell grid and it is the cell that closes, from 1fr to 0fr. The
	   solid slides across to the middle as it goes, because the layout is doing
	   the animating rather than something drawn on top of it. */
	/* minmax(0, …) rather than a bare fr, on both states. A bare `1fr` is
	   `minmax(auto, 1fr)`, and that auto minimum is the item's min-content
	   width — which for a panel with a width of its own is that width. So the
	   swatch panel's cell never closed: it sat there at its full size on every
	   card, holding a hundred-odd pixels between the channel bars and the
	   solid, which is what "the sliders are strangely far from the action"
	   was. Only the panels without a width of their own were collapsing. */
	.slot {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		min-width: 0;
		min-height: 0;
		transition:
			grid-template-columns 0.45s ease,
			margin 0.45s ease;
	}

	.slot[data-slot='pair'],
	.slot[data-slot='rgb'] {
		margin-inline-end: var(--rig-gap);
	}

	.slot[data-slot='hsl'] {
		margin-inline-start: var(--rig-gap);
	}

	/* Both the thing in the cell and the panels inside it: a cell told it may
	   be zero wide still cannot squeeze an item whose own minimum is its
	   content, and the comparison card puts a wrapper between the two. */
	.slot > *,
	.slot .plate {
		min-inline-size: 0;
		overflow: hidden;
	}

	/* Open or shut is one attribute, written by the script — which is the only
	   thing that knows the whole answer: whether the card offers the switch,
	   which space the morph has reached, and whether this is the comparison
	   card at all. Working it out in selectors meant one rule per combination,
	   and a combination missed is a plate that never leaves. */
	.slot[data-open='false'] {
		grid-template-columns: minmax(0, 0fr);
		margin-inline: 0;
	}

	/* Padding is not compressible, so a cell of no width still holds a plate
	   two ems wide until this goes with it. */
	.slot[data-open='false'] .plate {
		opacity: 0;
		padding-inline: 0;
	}

	/* The switch closes the same way, on the other axis. */
	.switch {
		display: grid;
		grid-template-rows: 1fr;
		transition: grid-template-rows 0.45s ease;
	}

	/* One of the two is showing at a time: the space switch on the cards that
	   are about the pair of solids, the colour switch on the one that is about
	   a pair of colours. */
	.solid[data-toggle-shown='false'] .switch.space,
	.solid[data-compare='true'] .switch.space,
	.solid:not([data-compare='true']) .switch.grey {
		grid-template-rows: 0fr;
	}

	.solid[data-toggle-shown='false'] .switch.space > .toggle,
	.solid[data-compare='true'] .switch.space > .toggle,
	.solid:not([data-compare='true']) .switch.grey > .toggle {
		opacity: 0;
		padding-block: 0;
	}

	/* Two colours and no one colour, so the reading has nothing it could say.
	   The field behind does: it runs from one to the other. */
	.solid[data-compare='true'] .readout {
		opacity: 0;
	}

	.swoosh {
		transition: opacity 0.45s ease;
	}

	.bar {
		min-width: 0;
		min-height: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.4rem;
		--track-border: 1px solid transparent;
		--track-radius: 4px;
	}

	/* A colour and the three numbers that make it, on one panel: the swatch at
	   the top where the eye lands, the bars under it. As wide as three bars
	   need and no wider — the two panels are there to be read against each
	   other, and width between them is width between the two colours. */
	/* The two panels, one above the other, sharing the height between them.
	   Side by side they read as a sequence — first this colour, then that one;
	   stacked they read as a pair, which is what they are. */
	.sets {
		display: flex;
		flex-direction: column;
		min-block-size: 0;
		gap: 0.6rem;
		margin: 1em 0;
	}

	.plate.set {
		flex: 1;
		min-block-size: 0;
		align-items: center;
		gap: 1em;
		margin: 0;
		padding: 0.8em;
	}

	/* Sized by what is in it, not by what is left over. The panel has no width
	   of its own any more — it is the disc plus these — so a flex basis of zero
	   here asks for a share of free space in a box that has none, and three
	   bars come out no bars wide. */
	.plate.set .bars {
		flex: 0 0 auto;
		align-self: stretch;
		display: flex;
		gap: 0.5rem;
		align-items: stretch;
		justify-content: center;
	}

	/* The lifted-luminance ring the rest of the series edges things with: the
	   swatch's own colour taken a fifth of the way to white, so the edge is
	   the colour rather than a line drawn round it.

	   Sized on one axis and one only: given a height by the column it sits in,
	   the aspect ratio can no longer have the width, and a definite height with
	   a capped width is an oval. Given the width, the ratio takes the height. */
	.disc {
		flex: 0 0 auto;
		/* Sized against the pane rather than against the panel it is in. A
		   percentage here is a percentage of a height that is still being
		   worked out, and a browser asked how wide the panel wants to be has to
		   answer without one — so it left the disc out of the sum, the panel
		   came out disc-wide, and the bars were clipped off the end of it. */
		block-size: 22cqh;
		max-block-size: 100%;
		aspect-ratio: 1;
		box-sizing: border-box;
		/* Level with the bars beside it rather than with the panel. A bar is its
		   track and then its letter, so the tracks' middle sits half a letter
		   above the panel's middle; this margin is that letter, and centring a
		   box with it puts the swatch back on the tracks' line. */
		margin-block-end: calc(0.4rem + 0.75rem);
		border: 0.2rem solid var(--edge, transparent);
		border-radius: 50%;
		background: var(--fill, #808080);
		/* Slow enough to read as one colour becoming another rather than as a
		   cut, which would let a reader believe two different swatches were
		   being shown. */
		transition:
			background-color 0.45s ease,
			border-color 0.45s ease;
	}

	.bar-name {
		flex: none;
		font-size: 0.75rem;
		line-height: 1;
		letter-spacing: 0.08em;
		color: #000;
	}

	.middle {
		flex: 0 1 auto;
		min-width: 0;
		min-height: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding-block: 0.5rem;
	}

	/* Square, so the middle column is only as wide as the solid can actually
	   be — its size comes from the pane's short side, which is the height. Left
	   to fill the row it would swallow every spare pixel and centre a small
	   shape in the middle of it, pushing the two plates out to the edges. */
	.stage {
		flex: 1;
		aspect-ratio: 1;
		min-width: 0;
		min-height: 0;
		display: flex;
	}

	/* The contact shadow is a drop-shadow over the canvas' own alpha, so it is
	   the silhouette's shadow whatever shape the silhouette currently is. */
	.stage canvas {
		width: 100%;
		height: 100%;
		cursor: grab;
		touch-action: none;
		filter: drop-shadow(
			0 var(--shadow-y, 6px) var(--shadow-blur, 18px) var(--viz-shadow, rgb(0 0 0 / 0.55))
		);
	}

	.stage canvas:active {
		cursor: grabbing;
	}

	.controls {
		flex: none;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.35rem;
	}

	/* Two names and a knob that slides between them. The knob is the moving
	   part rather than the labels, so the switch reads the same way a physical
	   one does — the thing that travels is the thing you threw. */
	/* The same glass the bars are on, but smoked rather than clear. It stands
	   under the solid, in the middle of the pane, which is where the swoosh is
	   at its brightest — and a white wash there leaves two pale words on a pale
	   ground. Dark, it is legible over anything the dot can be. */
	/* Over the switch, under the solid, in the middle of the pane — which the S
	   fills, so the reading sits on the colour it is a reading of. Its ink flips
	   between black and white for whichever gives more contrast against that
	   colour; see the render loop. */
	.readout {
		margin: 0;
		font-size: 1.125rem;
		font-variant-numeric: tabular-nums;
		/* Three numbers on one line or the reading is two readings. */
		white-space: nowrap;
		color: var(--readout-ink, #000);
		pointer-events: none;
	}

	@container viz (max-width: 30rem) {
		.readout {
			font-size: 0.85rem;
		}
	}

	/* ==== container queries ==============================================
	   These answer to the visualization's own pane, not the viewport: the deck
	   gives it a wide shallow band whose height is a fraction of the window, so
	   a phone and a laptop differ here mostly in width. Width is what these are
	   written against, and the one aspect-ratio rule at the end is for the odd
	   pane that really is taller than it is wide. */

	@container viz (max-width: 46rem) {
		.rig {
			--rig-gap: 0.5rem;
		}

		.plate {
			gap: 0.4rem;
			padding: 0.6rem;
		}
	}

	/* A phone. Side by side, the controls and the solid are each too narrow to
	   be worth having, so the pane stops being a row and becomes two: every
	   control in one short band across the top, and the solid underneath with
	   the whole width to itself.

	   A grid rather than a wrapped row, because what the second line needs is
	   all the height that is left, and wrapping only ever splits the spare
	   space evenly between its lines. `display: contents` on the middle column
	   drops its two children into this grid, so the switch can sit between the
	   two sets of bars while the stage goes underneath them both.

	   The bars need a height in this arrangement. Standing up, a track takes
	   its length from whatever contains it, and a row of the grid sized to its
	   contents contains nothing of any height at all. */
	@container viz (max-width: 34rem) {
		/* Five columns, three of them the band and one spare at each end. The
		   band is centred by the two spares rather than by `justify-content`,
		   which would centre the tracks themselves and leave the stage — which
		   spans them — as narrow as the controls above it. */
		.rig {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto auto auto minmax(0, 1fr);
			grid-template-rows: auto minmax(0, 1fr);
			align-items: center;
			gap: 0.45rem;
		}

		.middle {
			display: contents;
		}

		.slot[data-slot='pair'],
		.slot[data-slot='rgb'] {
			grid-area: 1 / 2;
		}

		.controls {
			grid-area: 1 / 3;
		}

		.slot[data-slot='hsl'] {
			grid-area: 1 / 4;
		}

		/* A shut slot has no width here, but its contents still have a height,
		   and a row sized to its tallest item was being held open by a panel
		   nobody can see. */
		.slot[data-open='false'] {
			block-size: 0;
		}

		/* Stretched, not centred: the row above wants its items centred on each
		   other, but this one has to take the whole of the row it is in. Left to
		   `align-items`, it was sized to its contents — and a canvas' contents
		   are its intrinsic 300 by 150, which is where a solid barely a third of
		   the pane came from.

		   Zero wide with a minimum of the full area, for the same reason on the
		   other axis: an item spanning all three columns hands its intrinsic
		   width to the tracks it spans, and that intrinsic width is the canvas'
		   300 again — which the two side columns then padded themselves out
		   with. Zero contributes nothing; the minimum fills the area once the
		   tracks are settled. */
		.stage {
			grid-area: 2 / 1 / 3 / 6;
			align-self: stretch;
			inline-size: 0;
			min-inline-size: 100%;
			aspect-ratio: auto;
		}

		.slot {
			margin-inline: 0;
		}

		.plate {
			margin: 0;
			padding: 0.5rem;
			gap: 0.3rem;
		}

		.plate.rgb,
		.plate.hsl {
			block-size: min(7rem, 26cqh);
		}

		/* Two panels of bars is a taller band than three bars alone, and every
		   pixel it takes is one the solid under it does not get. */
		.sets {
			margin: 0;
			gap: 0.4rem;
			block-size: min(9rem, 34cqh);
		}

		.plate.set {
			padding: 0.4rem;
			gap: 0.5em;
		}

		.disc {
			block-size: 12cqh;
		}

		.bar {
			--track-size: 0.85rem;
		}

		.bar-name {
			font-size: 0.65rem;
		}

		/* Up here it sits on the ground rather than on the colour, so it takes
		   the deck's ink instead of flipping against a field it is not over. */
		.readout {
			font-size: 0.7rem;
			color: var(--deck-ink, #e6e9ef);
		}

		/* Pill takes both of these as custom properties; see components/Pill. */
		.switch {
			--pill-size: 0.7rem;
			--pill-pad: 0.55rem;
		}

		/* Room to be big in, now that the stage has the width and most of the
		   height rather than a square cut out of a shallow band. */
		.solid {
			--solid-scale: 0.66;
		}
	}


	/* A band with almost no height in it — a phone held sideways, where the
	   deck gives the picture a couple of hundred pixels and the text the rest.
	   Everything that is not the reading itself goes: the letters under the
	   bars, the colour reading under the solid, and most of the padding. What
	   is left is thin, but a bar you can see the thumb on beats a labelled bar
	   you cannot. */
	@container viz (max-height: 14rem) {
		.plate {
			margin: 0.4rem 0;
			padding: 0.4rem;
		}

		.sets {
			margin: 0.4rem 0;
			gap: 0.4rem;
		}

		.plate.set {
			gap: 0.5em;
			padding: 0.35rem;
		}

		.bar-name,
		.readout {
			display: none;
		}

		.bar {
			gap: 0;
		}

		.controls {
			gap: 0.25rem;
		}

		/* The swatch carried the letters' height as a margin so it would sit on
		   the tracks' line; with no letters there is no line to come off. */
		.disc {
			margin-block-end: 0;
		}
	}

	/* A pane genuinely taller than it is wide *and* with width to spare, which
	   the deck's own layout makes rare. Everything stacks and the bars lie
	   down; the slots close downward, so the air between them is the column's
	   gap rather than the inline margins, which would only push a full-width
	   plate off the side.

	   The width floor matters: a narrow pane is usually taller than it is wide
	   as well, and both sets of rules would then be in play — one asking for a
	   column of full-width plates and the other for a band of upright bars over
	   the solid. The band is the better answer whenever width is what is
	   short, so this one stands aside for it. */
	@container viz (min-width: 34rem) and (max-aspect-ratio: 1 / 1) {
		.rig {
			flex-direction: column;
			gap: 0.4rem;
		}

		.slot {
			grid-template-columns: none;
			grid-template-rows: minmax(0, 1fr);
			transition:
				grid-template-rows 0.45s ease,
				margin 0.45s ease;
			inline-size: 100%;
			margin-inline: 0;
		}

		.slot[data-slot='rgb'],
		.slot[data-slot='hsl'],
		.slot[data-slot='pair'] {
			margin-inline: 0;
		}

		.slot[data-open='false'] {
			grid-template-rows: minmax(0, 0fr);
		}

		.plate {
			flex: none;
			margin: 0;
			inline-size: 100%;
		}

		/* The channel plates become a column of lying-down bars. The comparison
		   panels keep their row — a swatch beside its own three numbers is the
		   whole shape of that card — and only the bars inside them turn. */
		.plate.rgb,
		.plate.hsl {
			flex-direction: column;
			gap: 0.3rem;
		}

		.sets {
			margin: 0.4rem 0;
		}

		.plate.set .bars {
			flex: 1;
			min-inline-size: 0;
			flex-direction: column;
			gap: 0.3rem;
		}

		/* Lying down. The track takes its axis from these two properties, so
		   the bars turn horizontal with the minimum at the left — see VizTrack
		   for why it is a property rather than an inherited writing mode. */
		.bar {
			flex-direction: row;
			gap: 0.5rem;
			--track-flow: horizontal-tb;
			--track-dir: ltr;
		}

		.bar-name {
			order: -1;
			inline-size: 1ch;
		}

		.middle {
			flex: 1;
			min-block-size: 0;
		}
	}
</style>

<script>
	import { contextFor } from '../lib/animate';
	import { lightenRgb } from '../lib/oklch';
	import { rgbCss, type Rgb } from '../lib/rgb';

	type Quat = [number, number, number, number];

	const IDENTITY: Quat = [0, 0, 0, 1];

	const qMul = (a: Quat, b: Quat): Quat => [
		a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1],
		a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0],
		a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3],
		a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2],
	];

	const qNorm = (q: Quat): Quat => {
		const l = Math.hypot(q[0], q[1], q[2], q[3]) || 1;
		return [q[0] / l, q[1] / l, q[2] / l, q[3] / l];
	};

	const qAxisAngle = (x: number, y: number, z: number, a: number): Quat => {
		const l = Math.hypot(x, y, z);
		if (!l || !a) return IDENTITY;
		const s = Math.sin(a / 2) / l;
		return [x * s, y * s, z * s, Math.cos(a / 2)];
	};

	const qSlerp = (q: Quat, target: Quat, t: number): Quat => {
		let dot = q[0] * target[0] + q[1] * target[1] + q[2] * target[2] + q[3] * target[3];
		let to = target;
		if (dot < 0) {
			to = [-target[0], -target[1], -target[2], -target[3]];
			dot = -dot;
		}
		if (dot > 0.9995) {
			return qNorm([
				q[0] + (to[0] - q[0]) * t,
				q[1] + (to[1] - q[1]) * t,
				q[2] + (to[2] - q[2]) * t,
				q[3] + (to[3] - q[3]) * t,
			]);
		}
		const theta = Math.acos(dot);
		const s = Math.sin(theta);
		const wa = Math.sin((1 - t) * theta) / s;
		const wb = Math.sin(t * theta) / s;
		return qNorm([
			q[0] * wa + to[0] * wb,
			q[1] * wa + to[1] * wb,
			q[2] * wa + to[2] * wb,
			q[3] * wa + to[3] * wb,
		]);
	};

	const qMatrix = (q: Quat) => {
		const [x, y, z, w] = q;
		return [
			1 - 2 * (y * y + z * z), 2 * (x * y + z * w), 2 * (x * z - y * w),
			2 * (x * y - z * w), 1 - 2 * (x * x + z * z), 2 * (y * z + x * w),
			2 * (x * z + y * w), 2 * (y * z - x * w), 1 - 2 * (x * x + y * y),
		];
	};

	/** Linear light back to an sRGB code value: the transfer curve, forwards. */
	const encode = (v: number) =>
		v <= 0.0031308 ? 12.92 * v : 1.055 * Math.pow(Math.max(0, v), 1 / 2.4) - 0.055;

	/** sRGB relative luminance, for choosing readable ink over a colour. */
	const luminance = (r: number, g: number, b: number) => {
		const lin = (c: number) => {
			const v = c / 255;
			return v <= 0.04045 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
		};
		return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
	};

	/* --- colour ------------------------------------------------------------
	   HSL both ways, in the sRGB sense CSS means. Hue is kept as a turn rather
	   than degrees, because everything downstream wants an angle. */

	function hslToRgb(h: number, s: number, l: number): [number, number, number] {
		const f = (n: number) => {
			const k = (n + h * 12) % 12;
			const a = s * Math.min(l, 1 - l);
			return l - a * Math.max(-1, Math.min(k - 3, 9 - k, 1));
		};
		return [f(0), f(8), f(4)];
	}

	function rgbToHsl(r: number, g: number, b: number): [number, number, number] {
		const max = Math.max(r, g, b);
		const min = Math.min(r, g, b);
		const l = (max + min) / 2;
		const d = max - min;
		if (d < 1e-9) return [0, 0, l];
		const s = d / (1 - Math.abs(2 * l - 1));
		let h: number;
		if (max === r) h = ((g - b) / d) % 6;
		else if (max === g) h = (b - r) / d + 2;
		else h = (r - g) / d + 4;
		h /= 6;
		return [h - Math.floor(h), s, l];
	}

	/* --- the frame the HSL solids are built in ------------------------------
	   Their axis is the cube's own black-to-white diagonal, and their equator
	   passes through the six pure hues where they already are, so the morph
	   moves each vertex as little as it can. The cube is [0,1]^3 and the eye is
	   set up around its centre, so everything is written about that centre.

	   E1 points at red's position on the equator, E2 is a quarter turn on in
	   the direction hue counts — so red, yellow, green come round in order. */
	const S3 = Math.sqrt(3);
	const UP = [1 / S3, 1 / S3, 1 / S3];
	const E1 = [2 / Math.sqrt(6), -1 / Math.sqrt(6), -1 / Math.sqrt(6)];
	const E2 = [0, 1 / Math.SQRT2, -1 / Math.SQRT2];
	/** The pure hues' distance from the axis: that is the equator's radius. */
	const RADIUS = Math.sqrt(2 / 3);
	/** Black corner to white corner. */
	const HEIGHT = S3;

	/** Standing the diagonal up: black at the bottom, white straight above it. */
	const TIP: Quat = qAxisAngle(-1, 0, 1, Math.acos(1 / S3));

	/* --- mesh ---------------------------------------------------------------
	   A grid in (hue, lightness) at full saturation. That grid is the cube's
	   whole surface — every point of it has saturation 1 — and it is the cone's
	   and the cylinder's whole wall as well, so one set of vertices is all
	   three shapes.

	   The divisions are chosen so no quad ever straddles a fold: six hues, so
	   the cube's six vertical edges fall on grid lines, and an even number of
	   lightness steps, so the equator does too. Inside a fold the surface is
	   planar and colour is affine in position, which is what the GPU's
	   interpolation reconstructs exactly — the cube comes out as exact as the
	   twelve-triangle one in RgbCube. */
	const HN = 96; // multiple of 6
	const LN = 24; // even
	const FLOATS = 6; // cube position, then h s l

	const solid: number[] = [];
	const solidIdx: number[] = [];

	const vertex = (h: number, s: number, l: number) => {
		const [r, g, b] = hslToRgb(h, s, l);
		solid.push(r, g, b, h, s, l);
		return solid.length / FLOATS - 1;
	};

	/* The wall. */
	for (let li = 0; li <= LN; li++) {
		for (let hi = 0; hi <= HN; hi++) vertex(hi / HN, 1, li / LN);
	}
	for (let li = 0; li < LN; li++) {
		for (let hi = 0; hi < HN; hi++) {
			const a = li * (HN + 1) + hi;
			const b = a + 1;
			const c = a + HN + 1;
			const d = c + 1;
			solidIdx.push(a, c, d, a, d, b);
		}
	}

	/* The two caps: rings from the axis out to the rim, at l = 0 and l = 1.
	   Both are a single colour — black and white — so they are invisible as
	   colour and only ever seen as shape: nothing at all on the cube, where
	   they are the two corners, a point on the cone, and a disc once the
	   cylinder has opened them out. */
	for (const l of [0, 1]) {
		const inner = solid.length / FLOATS;
		for (let hi = 0; hi <= HN; hi++) vertex(hi / HN, 0, l);
		const outer = solid.length / FLOATS;
		for (let hi = 0; hi <= HN; hi++) vertex(hi / HN, 1, l);
		for (let hi = 0; hi < HN; hi++) {
			solidIdx.push(inner + hi, outer + hi, outer + hi + 1);
			solidIdx.push(inner + hi, outer + hi + 1, inner + hi + 1);
		}
	}

	const SOLID_VERTS = new Float32Array(solid);
	const SOLID_INDEX = new Uint16Array(solidIdx);

	/* --- the wireframe ------------------------------------------------------
	   The cube's twelve edges, said in (hue, lightness): three from black up to
	   a primary, three from a secondary up to white, and six round the
	   equator — which on the cube is the skew hexagon and in HSL is a flat
	   circle. Subdivided, because a straight line between two points on the
	   cube has to arrive as an arc on the cylinder. */
	const LINE_PATTERN = [
		[0, -1], [1, -1], [1, 1],
		[0, -1], [1, 1], [0, 1],
	];
	const EDGE_FLOATS = 14;

	const wire: number[] = [];
	/* Cut at exactly the mesh's own divisions. A line lying on a curved
	   surface is a chord between its endpoints, and a chord across a wider
	   span than the facet under it sinks below that facet in the middle — which
	   the depth test then hides, and the wireframe comes out dashed. Sharing
	   the divisions makes every segment lie in the facet it is drawn on. */
	const strut = (h0: number, l0: number, h1: number, l1: number, seg: number) => {
		for (let i = 0; i < seg; i++) {
			const at = (k: number) => {
				const f = k / seg;
				const h = h0 + (h1 - h0) * f;
				const l = l0 + (l1 - l0) * f;
				return [...hslToRgb(h, 1, l), h, 1, l];
			};
			const a = at(i);
			const b = at(i + 1);
			for (const [end, side] of LINE_PATTERN) wire.push(...a, ...b, end, side);
		}
	};

	/* Three sets, drawn separately because they do not all belong to all three
	   shapes. The lines that say what a cube is are not the lines that say what
	   a cylinder is, and a wireframe carried across unchanged would be claiming
	   the cylinder has six slanted edges — which is exactly the thing HSL is
	   being accused of pretending. So each set fades in over the shape it
	   describes and out of the one it does not. */
	const segments = () => wire.length / EDGE_FLOATS / 6;
	const group = (build: () => void) => {
		const start = segments();
		build();
		return { start, count: segments() - start };
	};

	/* The cube's six slanted edges — three up from black to a primary, three on
	   up from a secondary to white. They are the zigzag, and the zigzag is what
	   the cone flattens away. */
	const DIAGONALS = group(() => {
		for (let k = 0; k < 6; k++) {
			const h = k / 6;
			if (k % 2 === 0) strut(h, 0, h, 0.5, LN / 2);
			else strut(h, 0.5, h, 1, LN / 2);
		}
	});

	/* The six edges round the middle: a skew hexagon on the cube and a flat
	   circle on the cone, which is the same six lines and the whole argument. */
	const EQUATOR = group(() => {
		for (let k = 0; k < 6; k++) strut(k / 6, 0.5, (k + 1) / 6, 0.5, HN / 6);
	});

	/* The cylinder's two rims. On the cube and the cone these are the black and
	   white corners — a circle of no radius at all — so there is nothing to see
	   until the cones open out and put a lid on each end. */
	const RIMS = group(() => {
		for (const l of [0, 1]) {
			for (let k = 0; k < 6; k++) strut(k / 6, l, (k + 1) / 6, l, HN / 6);
		}
	});

	const WIRE_VERTS = new Float32Array(wire);

	const FOCAL = 3.4;

	/* --- shaders ------------------------------------------------------------
	   One place where a vertex is put. `shape` takes the cube position and the
	   (h, s, l) and returns where that vertex is at the current point of the
	   morph: 0 is the cube, 1 the double cone, 2 the cylinder. */
	const PLACE = `
		uniform mat3 uRot;
		uniform vec2 uScale;
		uniform float uMorph;
		const vec3 UP = vec3(${UP.map((v) => v.toFixed(8)).join(', ')});
		const vec3 E1 = vec3(${E1.map((v) => v.toFixed(8)).join(', ')});
		const vec3 E2 = vec3(${E2.map((v) => v.toFixed(8)).join(', ')});
		vec3 shape(vec3 cube, vec3 hsl) {
			float a = hsl.x * 6.28318531;
			vec3 radial = E1 * cos(a) + E2 * sin(a);
			vec3 axis = vec3(0.5) + UP * ((hsl.z - 0.5) * ${HEIGHT.toFixed(8)});
			// The cone gives up radius toward both ends; the cylinder does not,
			// which is exactly the claim HSL's saturation slider makes.
			vec3 cone = axis + radial * (hsl.y * (1.0 - abs(2.0 * hsl.z - 1.0)) * ${RADIUS.toFixed(8)});
			vec3 tube = axis + radial * (hsl.y * ${RADIUS.toFixed(8)});
			return uMorph <= 1.0 ? mix(cube, cone, uMorph) : mix(cone, tube, uMorph - 1.0);
		}
		vec4 proj(vec3 p) {
			vec3 v = uRot * (p - 0.5);
			return vec4(v.x * uScale.x, v.y * uScale.y, -v.z, ${FOCAL.toFixed(4)} - v.z);
		}
	`;

	const SOLID_VS = `
		attribute vec3 aPos;
		attribute vec3 aHsl;
		varying vec3 vColor;
		${PLACE}
		void main() {
			vColor = aPos;
			gl_Position = proj(shape(aPos, aHsl));
		}
	`;

	/* A sub-LSB dither, so a ramp this wide does not band on an eight-bit
	   frame buffer: each pixel is scattered across the two nearest values and
	   the local average lands on the colour that was computed. */
	const SOLID_FS = `
		precision highp float;
		varying vec3 vColor;
		uniform float uGrey;
		/* The same grey the swatches use, and it has to be the same or the card
		   is comparing two different claims: undo the transfer curve, take the
		   luminance the eye actually reports, put the curve back. Averaging the
		   three channels instead — which is what everyone reaches for — would
		   make yellow and blue far closer than they are, and closer is exactly
		   the thing being argued against. */
		vec3 toLinear(vec3 c) {
			return mix(c / 12.92, pow((c + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
		}
		float toSrgb(float v) {
			return v <= 0.0031308 ? 12.92 * v : 1.055 * pow(v, 1.0 / 2.4) - 0.055;
		}
		void main() {
			float y = dot(toLinear(vColor), vec3(0.2126, 0.7152, 0.0722));
			vec3 shown = mix(vColor, vec3(toSrgb(y)), uGrey);
			float n = fract(sin(dot(gl_FragCoord.xy, vec2(12.9898, 78.233))) * 43758.5453);
			gl_FragColor = vec4(shown + (n - 0.5) / 255.0, 1.0);
		}
	`;

	/* Lines are expanded to screen-space quads rather than drawn with gl.LINES,
	   whose width is capped at one device pixel nearly everywhere. */
	const WIRE_VS = `
		attribute vec3 aP0;
		attribute vec3 aH0;
		attribute vec3 aP1;
		attribute vec3 aH1;
		attribute float aEnd;
		attribute float aSide;
		uniform vec2 uHalf;
		uniform float uWidth;
		${PLACE}
		/* A hair further out from the middle than the surface it is drawn on.
		   A line and the face under it are the same depth to within a rounding
		   error, and the depth test then keeps whichever won that round — facet
		   by facet, which is what turns a wireframe into a dashed one. All three
		   of these shapes are convex, so outward is reliably nearer. */
		vec3 lift(vec3 p) {
			return vec3(0.5) + (p - vec3(0.5)) * 1.006;
		}
		void main() {
			vec4 c0 = proj(lift(shape(aP0, aH0)));
			vec4 c1 = proj(lift(shape(aP1, aH1)));
			vec2 s0 = c0.xy / c0.w * uHalf;
			vec2 s1 = c1.xy / c1.w * uHalf;
			vec2 d = s1 - s0;
			float len = length(d);
			vec2 dir = len > 1e-5 ? d / len : vec2(1.0, 0.0);
			vec2 nrm = vec2(-dir.y, dir.x);
			vec4 c = mix(c0, c1, aEnd);
			vec2 s = mix(s0, s1, aEnd)
				+ (nrm * aSide + dir * (aEnd * 2.0 - 1.0)) * uWidth * 0.5;
			gl_Position = vec4(s / uHalf * c.w, c.z, c.w);
		}
	`;

	const WIRE_FS = `
		precision highp float;
		uniform vec4 uColor;
		void main() {
			gl_FragColor = vec4(uColor.rgb * uColor.a, uColor.a);
		}
	`;

	/* A screen-facing quad around the dot's projected centre; the fragment
	   shader carves the disc out of it, so it stays round whatever the solid is
	   doing. */
	const DOT_VS = `
		attribute vec2 aCorner;
		uniform vec3 uDot;
		uniform vec3 uDotHsl;
		uniform vec2 uHalf;
		uniform float uRadius;
		varying vec2 vOffset;
		${PLACE}
		void main() {
			vec4 c = proj(shape(uDot, uDotHsl));
			vOffset = aCorner * uRadius;
			vec2 s = c.xy / c.w * uHalf + vOffset;
			gl_Position = vec4(s / uHalf * c.w, c.z, c.w);
		}
	`;

	const DOT_FS = `
		precision highp float;
		uniform float uCore;
		uniform float uAlpha;
		varying vec2 vOffset;
		void main() {
			float a = uAlpha * (1.0 - smoothstep(uCore - 0.75, uCore + 0.75, length(vOffset)));
			gl_FragColor = vec4(0.0, 0.0, 0.0, a);
		}
	`;

	type GL = WebGLRenderingContext | WebGL2RenderingContext;

	function compile(gl: GL, type: number, src: string) {
		const sh = gl.createShader(type)!;
		gl.shaderSource(sh, src);
		gl.compileShader(sh);
		if (!gl.getShaderParameter(sh, gl.COMPILE_STATUS)) {
			throw new Error(gl.getShaderInfoLog(sh) || 'shader failed to compile');
		}
		return sh;
	}

	function program(gl: GL, vs: string, fs: string) {
		const p = gl.createProgram()!;
		gl.attachShader(p, compile(gl, gl.VERTEX_SHADER, vs));
		gl.attachShader(p, compile(gl, gl.FRAGMENT_SHADER, fs));
		gl.linkProgram(p);
		if (!gl.getProgramParameter(p, gl.LINK_STATUS)) {
			throw new Error(gl.getProgramInfoLog(p) || 'program failed to link');
		}
		return p;
	}

	function initSolid(root: HTMLElement) {
		if (root.dataset.ready === 'true') return;
		root.dataset.ready = 'true';

		const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
		const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]')!;
		const readout = root.querySelector<HTMLElement>('[data-readout]')!;
		type TrackEl = HTMLElement & {
			track: {
				set(i: number, v: number): void;
				backdrop(css: string): void;
				edge(css: string): void;
			};
		};
		const pick = (which: string) =>
			Array.from(
				root.querySelectorAll<TrackEl>(`[data-plate='${which}'] [data-viz-track]`),
			);
		const rgbBars = pick('rgb');
		const hslBars = pick('hsl');
		const ctx = contextFor(root.querySelector('[data-anim-context]') ?? root);

		const host =
			root.closest<HTMLElement>('[data-viz-phase]') ??
			root.closest<HTMLElement>('[data-viz-stage]');
		const gate = root.closest<HTMLElement>('[data-viz-phase]');
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

		let idleSeconds = Number(root.dataset.idleResume) || 5;
		const tellBars = () =>
			[...rgbBars, ...hslBars].forEach((b) => (b.dataset.idleResume = String(idleSeconds)));
		// Six, in document order: set one's H, S, L, then set two's.
		const pairBars = Array.from(
			root.querySelectorAll<TrackEl>("[data-plate^='set-'] [data-viz-track]"),
		);
		const discs = Array.from(root.querySelectorAll<HTMLElement>('[data-disc]'));
		// Not [data-grey] — that is the root's own state, and the root is not a
		// descendant of itself only by luck of how querySelector works.
		const greyBtn = root.querySelector<HTMLButtonElement>('[data-grey-toggle]')!;
		const slots = Array.from(root.querySelectorAll<HTMLElement>('[data-slot]'));
		const slotFor = (name: string) => slots.find((el) => el.dataset.slot === name)!;

		let spin = root.dataset.spin !== 'false';
		let turning = root.dataset.toggleShown !== 'false';
		let comparing = root.dataset.compare === 'true';
		/* One set's colour, as h/s/l from 0 to 1. Read back off the bars every
		   frame rather than remembered here, so a drag, a keypress and a card's
		   parameters all arrive by the same door and none of them can disagree
		   with what is on screen. */
		const hslOf = (set: number): number[] => [
			(pairBars[set * 3]?.track.get(0) ?? 0) / 360,
			(pairBars[set * 3 + 1]?.track.get(0) ?? 100) / 100,
			(pairBars[set * 3 + 2]?.track.get(0) ?? 50) / 100,
		];
		const AUTHORED = {
			idleSeconds,
			spin,
			space: root.dataset.space ?? 'rgb',
			turning,
			comparing,
			hues: [hslOf(0)[0] * 360, hslOf(1)[0] * 360],
		};
		tellBars();

		/* ---- the morph ------------------------------------------------------
		   One number from 0 to 3: the tip, then the cone, then the cylinder, two
		   seconds each. It walks toward whichever end the switch is set to, so
		   throwing the switch halfway through simply turns it round — there is
		   no state to unwind and nothing to cancel. */
		const PHASES = 3;
		const SECONDS = 2;
		let stage = AUTHORED.space === 'hsl' ? PHASES : 0;
		let want = stage;
		const ease = (t: number) => t * t * (3 - 2 * t);

		const setSpace = (to: 'rgb' | 'hsl') => {
			want = to === 'hsl' ? PHASES : 0;
			toggle.setAttribute('aria-checked', String(to === 'hsl'));
			toggle.dataset.at = to === 'hsl' ? '1' : '0';
			if (reduceMotion) stage = want;
		};

		/* ---- the switch throws itself, while there is a switch --------------
		   The card is making one point and it is a point you have to watch
		   happen, so nobody has to find the control to see it: a short pause on
		   arrival to let the cube be a cube, then over, and back and forth from
		   there. Counted in the frame loop rather than on a timer, so it stops
		   dead while the phase is off stage and starts again where it left off
		   — a deck three cards away should not be quietly flipping.

		   A reader who throws it themselves is not overruled a moment later:
		   their click restarts the clock, so the next automatic turn is a full
		   interval away. Left alone entirely under reduced motion, where a
		   picture that rearranges itself unasked is the thing being avoided. */
		const FIRST = 2;
		const EVERY = 15;
		let sinceFlip = 0;
		let firstFlip = true;

		const flip = () => setSpace(want === PHASES ? 'rgb' : 'hsl');

		toggle.addEventListener('click', () => {
			sinceFlip = 0;
			firstFlip = false;
			flip();
		});

		/* ---- the colour, taken away and given back -------------------------
		   Three seconds each way, on the frame loop like the other switch, so it
		   holds still while the card is off stage. The point of the card is a
		   comparison a reader cannot make while the hue is there to distract
		   them, and the way to make it is to keep removing it. */
		const GREY_EVERY = 3;
		let grey = false;
		let sinceGrey = 0;
		/* What the shader is actually showing, which follows `grey` rather than
		   equalling it: the swatches cross-fade in CSS and the solid has to
		   arrive with them, or the card reads as two separate events. */
		let greyMix = 0;

		const setGrey = (on: boolean) => {
			grey = on;
			root.dataset.grey = String(on);
			greyBtn.setAttribute('aria-checked', String(on));
			greyBtn.dataset.at = on ? '1' : '0';
		};

		greyBtn.addEventListener('click', () => {
			sinceGrey = 0;
			setGrey(!grey);
		});

		/* ---- orientation ----------------------------------------------------
		   Three rotations, innermost first: the tip, which stands the solid's
		   black-to-white diagonal up; the ambient turn about that same upright
		   axis; and a fixed tilt toward the viewer so we are looking slightly
		   down on it.

		   The order is what makes the tip mean anything. Spin about the object's
		   own axis and a cylinder turns on the spot; spin about some axis of the
		   camera's and it wobbles, and the cube's diagonal — which the whole
		   card is about — never actually points up the screen. In cube mode the
		   same three give the plain turning cube, because before the tip the
		   solid's up axis is simply the green one. */
		const AMBIENT_RATE = 0.055;
		const TILT: Quat = qAxisAngle(1, 0, 0, 0.42);
		// Not square-on to start with: a face-on cube reads as a flat square.
		let ambient = -0.62;
		/* Where a reader has put it, and it stays there. The offset used to ease
		   back to nothing a moment after a drag, which meant every turn a reader
		   gave the solid was taken away from them again — they would spin it to
		   see the far side and watch it creep back to the front. It keeps the
		   orientation instead, and the ambient turn carries on from there. A
		   throw still coasts to a stop: that is the velocity below, which decays;
		   the position it leaves behind does not. */
		let offset: Quat = IDENTITY;
		let velX = 0;
		let velY = 0;
		let dragging = false;
		let pointerId: number | null = null;

		/* ---- the dot --------------------------------------------------------
		   The same incommensurate wander RgbCube's takes, so the colour on show
		   is never quite a colour it has shown before. */
		const FREQ = [0.031, 0.044, 0.027];
		const PHASE = [0, 1.7, 3.1];
		let t = 0;
		let rgb = [0.5, 0.5, 0.5];
		let frozen = rgb.slice();
		let overrideRgb: (number | null)[] = [null, null, null];
		let overrideHsl: (number | null)[] = [null, null, null];
		let wasHeld = false;
		let resumeFrom: number[] | null = null;
		let resumeAt = 0;

		const wander = (time: number) =>
			FREQ.map((f, i) => 0.5 + 0.5 * Math.sin(time * f * Math.PI * 2 + PHASE[i]));

		/* A reader's turn. Whichever set of bars they took hold of wins, and the
		   other set is only told the answer: a saturation the reader has set is
		   the fact, and the three RGB numbers follow from it rather than the
		   other way round. */
		function readerColour() {
			if (!wasHeld) {
				frozen = rgb.slice();
				wasHeld = true;
			}
			if (overrideHsl.some((v) => v !== null)) {
				const base = rgbToHsl(frozen[0], frozen[1], frozen[2]);
				const hsl = base.map((v, i) => overrideHsl[i] ?? v);
				return hslToRgb(hsl[0], hsl[1], hsl[2]);
			}
			return [0, 1, 2].map((c) => overrideRgb[c] ?? frozen[c]);
		}

		const freeze = () => (resumeFrom = null);

		rgbBars.forEach((bar, channel) => {
			bar.addEventListener('pointerdown', freeze);
			bar.addEventListener('track:input', (e) => {
				const { value, fromReader } = (e as CustomEvent).detail;
				if (!fromReader) return;
				freeze();
				overrideHsl = [null, null, null];
				overrideRgb[channel] = value / 255;
			});
		});

		hslBars.forEach((bar, channel) => {
			bar.addEventListener('pointerdown', freeze);
			bar.addEventListener('track:input', (e) => {
				const { value, fromReader } = (e as CustomEvent).detail;
				if (!fromReader) return;
				freeze();
				overrideRgb = [null, null, null];
				overrideHsl[channel] = channel === 0 ? value / 360 : value / 100;
			});
		});

		for (const bar of pairBars) bar.addEventListener('pointerdown', freeze);

		/* The deck hands over the first card's parameters as it starts. That is
		   not a change from anything — it is what the page was asked for — so the
		   solid is simply already that shape. Reloading on the cylinder should
		   not play the reader a transformation they have not asked to see. */
		let firstProps = true;

		host?.addEventListener('viz:props', (e) => {
			const p = (e as CustomEvent).detail ?? {};
			spin = 'spin' in p ? p.spin !== false : AUTHORED.spin;
			idleSeconds = 'idleResume' in p ? Number(p.idleResume) || 5 : AUTHORED.idleSeconds;
			tellBars();
			turning = 'toggle' in p ? p.toggle !== false : AUTHORED.turning;
			comparing = 'compare' in p ? p.compare === true : AUTHORED.comparing;
			root.dataset.compare = String(comparing);
			// The comparison is a fact about one solid; there is nothing to switch.
			if (comparing) turning = false;
			toggle.inert = !turning;
			greyBtn.inert = !comparing;
			root.dataset.toggleShown = String(turning);
			const hues = Array.isArray(p.hues) ? (p.hues as unknown[]).map(Number) : AUTHORED.hues;
			if (comparing) {
				hues.forEach((h, i) => pairBars[i * 3]?.track.set(0, h));
				setGrey(false);
				sinceGrey = 0;
			}
			setSpace(
				(comparing ? 'hsl' : 'space' in p ? p.space : AUTHORED.space) === 'hsl' ? 'hsl' : 'rgb',
			);
			if (firstProps) {
				firstProps = false;
				stage = want;
			}
			/* Every card gets the same lead-in: whatever the last one was in the
			   middle of, this one starts by letting the reader see where it is. */
			sinceFlip = 0;
			firstFlip = true;
		});
		/* Arriving, the card starts on the cube whatever state it was left in:
		   the sequence is meant to be seen from the beginning, and the reset
		   happens under the phase's own fade. */
		host?.addEventListener('viz:enter', () => {
			last = 0;
			sinceFlip = 0;
			firstFlip = true;
			want = AUTHORED.space === 'hsl' ? PHASES : 0;
			stage = want;
			toggle.setAttribute('aria-checked', String(want === PHASES));
		});

		canvas.addEventListener('pointerdown', (e) => {
			dragging = true;
			pointerId = e.pointerId;
			canvas.setPointerCapture(e.pointerId);
			velX = 0;
			velY = 0;
			e.preventDefault();
		});

		canvas.addEventListener('pointermove', (e) => {
			if (!dragging || e.pointerId !== pointerId) return;
			const k = 0.01;
			const dx = e.movementX * k;
			const dy = e.movementY * k;
			offset = qNorm(qMul(qMul(qAxisAngle(0, 1, 0, dx), qAxisAngle(1, 0, 0, dy)), offset));
			velY = dx * 60;
			velX = dy * 60;
		});

		const endDrag = (e: PointerEvent) => {
			if (e.pointerId !== pointerId) return;
			dragging = false;
			pointerId = null;
		};
		canvas.addEventListener('pointerup', endDrag);
		canvas.addEventListener('pointercancel', endDrag);

		/* ---- gl ------------------------------------------------------------- */
		const OPTS: WebGLContextAttributes = {
			alpha: true,
			antialias: true,
			depth: true,
			premultipliedAlpha: true,
			powerPreference: 'low-power',
		};
		const gl = (canvas.getContext('webgl2', OPTS) ||
			canvas.getContext('webgl', OPTS)) as GL | null;
		if (!gl) {
			canvas.style.display = 'none';
			return;
		}
		if ('drawingBufferColorSpace' in gl) gl.drawingBufferColorSpace = 'srgb';

		const progSolid = program(gl, SOLID_VS, SOLID_FS);
		const progWire = program(gl, WIRE_VS, WIRE_FS);
		const progDot = program(gl, DOT_VS, DOT_FS);

		const bufSolid = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufSolid);
		gl.bufferData(gl.ARRAY_BUFFER, SOLID_VERTS, gl.STATIC_DRAW);

		const bufIndex = gl.createBuffer();
		gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, bufIndex);
		gl.bufferData(gl.ELEMENT_ARRAY_BUFFER, SOLID_INDEX, gl.STATIC_DRAW);

		const bufWire = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufWire);
		gl.bufferData(gl.ARRAY_BUFFER, WIRE_VERTS, gl.STATIC_DRAW);

		const bufQuad = gl.createBuffer();
		gl.bindBuffer(gl.ARRAY_BUFFER, bufQuad);
		gl.bufferData(
			gl.ARRAY_BUFFER,
			new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
			gl.STATIC_DRAW,
		);

		const uni = (p: WebGLProgram, n: string) => gl.getUniformLocation(p, n);
		const U = {
			solid: {
				rot: uni(progSolid, 'uRot'),
				scale: uni(progSolid, 'uScale'),
				morph: uni(progSolid, 'uMorph'),
				grey: uni(progSolid, 'uGrey'),
			},
			wire: {
				rot: uni(progWire, 'uRot'),
				scale: uni(progWire, 'uScale'),
				morph: uni(progWire, 'uMorph'),
				half: uni(progWire, 'uHalf'),
				width: uni(progWire, 'uWidth'),
				color: uni(progWire, 'uColor'),
			},
			dot: {
				rot: uni(progDot, 'uRot'),
				scale: uni(progDot, 'uScale'),
				morph: uni(progDot, 'uMorph'),
				half: uni(progDot, 'uHalf'),
				radius: uni(progDot, 'uRadius'),
				core: uni(progDot, 'uCore'),
				alpha: uni(progDot, 'uAlpha'),
				pos: uni(progDot, 'uDot'),
				hsl: uni(progDot, 'uDotHsl'),
			},
		};

		const A = {
			pos: gl.getAttribLocation(progSolid, 'aPos'),
			hsl: gl.getAttribLocation(progSolid, 'aHsl'),
			p0: gl.getAttribLocation(progWire, 'aP0'),
			h0: gl.getAttribLocation(progWire, 'aH0'),
			p1: gl.getAttribLocation(progWire, 'aP1'),
			h1: gl.getAttribLocation(progWire, 'aH1'),
			end: gl.getAttribLocation(progWire, 'aEnd'),
			side: gl.getAttribLocation(progWire, 'aSide'),
			corner: gl.getAttribLocation(progDot, 'aCorner'),
		};

		/* Attribute arrays are global state rather than per-program, so anything
		   the last draw left enabled would still be read by the next one. */
		const useAttribs = (locs: number[]) => {
			for (let i = 0; i < 8; i++) gl.disableVertexAttribArray(i);
			for (const l of locs) if (l >= 0) gl.enableVertexAttribArray(l);
		};

		gl.clearColor(0, 0, 0, 0);
		gl.frontFace(gl.CCW);
		gl.blendFunc(gl.ONE, gl.ONE_MINUS_SRC_ALPHA);

		/* ---- sizing ---------------------------------------------------------- */
		let w = 0;
		let h = 0;
		let dpr = 1;
		let scale = 0.52;
		const resize = () => {
			dpr = Math.min(window.devicePixelRatio || 1, 2);
			scale = parseFloat(getComputedStyle(root).getPropertyValue('--solid-scale')) || 0.52;
			const r = canvas.getBoundingClientRect();
			w = r.width;
			h = r.height;
			canvas.width = Math.max(1, Math.round(w * dpr));
			canvas.height = Math.max(1, Math.round(h * dpr));
			gl.viewport(0, 0, canvas.width, canvas.height);
			const size = Math.min(w, h) * scale;
			canvas.style.setProperty('--shadow-blur', `${(size * 0.34).toFixed(2)}px`);
			canvas.style.setProperty('--shadow-y', `${(size * 0.09).toFixed(2)}px`);
		};
		/* Noted here, done in the frame — never both in the observer.

		   Setting canvas.width clears the drawing buffer, and a resize
		   observation is delivered after the frame's animation callbacks and
		   before paint: resize in here and the buffer this frame paints is the
		   empty one, with the drawing that filled it thrown away a moment
		   earlier. Still for a still layout, but the plates beside this one
		   close over half a second, and for that half second the canvas is
		   resized every frame — which is to say cleared every frame, and the
		   solid simply is not there. */
		let stale = true;
		new ResizeObserver(() => (stale = true)).observe(canvas);
		resize();

		canvas.addEventListener('webglcontextlost', (e) => {
			e.preventDefault();
			root.dataset.ready = 'lost';
		});
		canvas.addEventListener('webglcontextrestored', () => {
			delete root.dataset.ready;
			initSolid(root);
		});

		/* What the saturation and lightness bars are showing, for a given
		   colour: each is a scale of the *other two* numbers, so both are
		   repainted whenever any of the three moves. A saturation ramp that is
		   not this hue at this lightness is a ramp of some other colour.

		   Each comes with its edge, which is the same stops lifted a fifth of
		   the way to white — the fake border every bar in the series wears. It
		   is here rather than at the two call sites because it was at one of
		   them and not the other, which is exactly the bug that produces. */
		const chip = (h: number, sat: number, light: number) =>
			hslToRgb(h / 360, sat / 100, light / 100).map((v) => v * 255) as Rgb;
		const ramp = (stops: Rgb[]) =>
			`linear-gradient(to top, ${stops.map((c) => rgbCss(c)).join(', ')})`;

		function paintScales(bars: TrackEl[], H: number, S: number, L: number) {
			const sat = [chip(H, 0, L), chip(H, 100, L)];
			const lit = [chip(H, S, 0), chip(H, S, 50), chip(H, S, 100)];
			bars[1]?.track.backdrop(ramp(sat));
			bars[1]?.track.edge(ramp(sat.map((c) => lightenRgb(c, 0.2))));
			bars[2]?.track.backdrop(ramp(lit));
			bars[2]?.track.edge(ramp(lit.map((c) => lightenRgb(c, 0.2))));
		}

		/* The swatches, their lifted rings, and each set's own two backdrops.
		   The grey is the colour's relative luminance put back through the sRGB
		   curve — which is to say, the grey that is genuinely as bright as the
		   colour was, rather than the average of three channels that everybody's
		   first guess reaches for. */
		let lastPair = '';

		function paintPair(colours: { rgb: number[]; hsl: number[] }[]) {
			const key = `${colours.map((c) => c.hsl.map((v) => v.toFixed(4)).join()).join('|')}|${grey}`;
			if (key === lastPair) return;
			lastPair = key;
			colours.forEach((c, i) => {
				const shown = c.rgb.map((v) => Math.round(v * 255)) as Rgb;
				const y = Math.round(255 * encode(luminance(shown[0], shown[1], shown[2])));
				const fill = grey ? ([y, y, y] as Rgb) : shown;
				discs[i].style.setProperty('--fill', rgbCss(fill));
				discs[i].style.setProperty('--edge', rgbCss(lightenRgb(fill, 0.2)));
				/* And the field behind everything runs between the two, greyed
				   with them — so the card's point is made once more at the size
				   of the whole pane. */
				root.style.setProperty(i === 0 ? '--swatch-a' : '--swatch-b', rgbCss(fill));

				paintScales(
					pairBars.slice(i * 3, i * 3 + 3),
					Math.round(c.hsl[0] * 360) % 360,
					Math.round(c.hsl[1] * 100),
					Math.round(c.hsl[2] * 100),
				);
			});
		}

		/* ---- render ---------------------------------------------------------- */
		let last = 0;
		let lastSaid = '';
		let lastPainted = '';

		function frame(now: number) {
			requestAnimationFrame(frame);
			if (gate && gate.dataset.vizActive === 'false') return;
			if (stale) {
				stale = false;
				resize();
			}
			if (!w || !h || root.dataset.ready !== 'true') return;

			const dt = last ? Math.min(0.05, (now - last) / 1000) : 0.016;
			last = now;

			// --- the morph, and what the page is calling the current space
			if (!reduceMotion && turning) {
				sinceFlip += dt;
				if (sinceFlip >= (firstFlip ? FIRST : EVERY)) {
					sinceFlip = 0;
					firstFlip = false;
					flip();
				}
			}
			if (stage !== want) {
				const step = dt / SECONDS;
				stage = want > stage ? Math.min(want, stage + step) : Math.max(want, stage - step);
			}
			/* Each phase eases in and out on its own, so the three of them read as
			   three moves rather than one long slide. */
			const seg = Math.min(PHASES - 1, Math.floor(stage));
			const eased = seg + ease(stage - seg);
			const tip = Math.min(1, eased);
			const morph = Math.max(0, eased - 1);
			/* How far each phase has got, for everything that has to follow them:
			   which lines belong to the shape on screen, and how far back the eye
			   has to stand to keep it in frame. */
			const flattened = Math.min(1, morph);
			const opened = Math.max(0, morph - 1);
			/* The bars change hands as the cone opens into the cylinder — the
			   moment the picture stops being about the cube. */
			const space = stage > 1.5 ? 'hsl' : 'rgb';
			if (root.dataset.space !== space) root.dataset.space = space;

			/* Which plates are in play. Everything that decides it is known here
			   and nowhere else — whether the card offers the switch, how far the
			   morph has got, whether this is the comparison at all — so it is
			   settled here and written out as one attribute a stylesheet can
			   close a slot on. */
			const open: Record<string, boolean> = {
				pair: comparing,
				rgb: !comparing && (turning || space === 'rgb'),
				hsl: !comparing && (turning || space === 'hsl'),
			};
			for (const name in open) {
				const slot = slotFor(name);
				const on = String(open[name]);
				if (slot.dataset.open !== on) slot.dataset.open = on;
			}

			// --- orientation
			if (!reduceMotion && spin) ambient += AMBIENT_RATE * dt;
			if (!dragging) {
				const decay = Math.exp(-1.8 * dt);
				velX *= decay;
				velY *= decay;
				if (Math.abs(velX) > 1e-4 || Math.abs(velY) > 1e-4) {
					offset = qNorm(
						qMul(
							qMul(qAxisAngle(0, 1, 0, velY * dt), qAxisAngle(1, 0, 0, velX * dt)),
							offset,
						),
					);
				}
			}
			const m = qMatrix(
				qMul(
					qMul(qMul(offset, TILT), qAxisAngle(0, 1, 0, ambient)),
					qSlerp(IDENTITY, TIP, tip),
				),
			);

			// --- the colour on show
			if (!reduceMotion) t += dt;
			// Roughly the swatches' own 0.45s, and framerate-independent.
			greyMix += ((grey ? 1 : 0) - greyMix) * (1 - Math.exp(-dt / 0.16));
			if (comparing && !reduceMotion) {
				sinceGrey += dt;
				if (sinceGrey >= GREY_EVERY) {
					sinceGrey = 0;
					setGrey(!grey);
				}
			}
			if (ctx.held) {
				rgb = readerColour();
				resumeFrom = null;
			} else {
				const target = wander(t);
				if (wasHeld) {
					resumeFrom = rgb.slice();
					resumeAt = now;
					wasHeld = false;
					overrideRgb = [null, null, null];
					overrideHsl = [null, null, null];
				}
				if (resumeFrom) {
					const k = Math.min(1, (now - resumeAt) / 800);
					const e = ease(k);
					rgb = resumeFrom.map((v, i) => v + (target[i] - v) * e);
					if (k >= 1) resumeFrom = null;
				} else {
					rgb = target;
				}
			}
			rgb = rgb.map((v) => Math.min(1, Math.max(0, v)));
			const hsl = rgbToHsl(rgb[0], rgb[1], rgb[2]);

			/* The comparison card's two colours are simply what its two hue bars
			   say, at the saturation and lightness the card has pinned. Nothing
			   wanders, so there is nothing for a reader's turn to interrupt. */
			const pair = comparing
				? [0, 1].map((i) => {
						const c = hslOf(i);
						return { rgb: hslToRgb(c[0], c[1], c[2]), hsl: c };
					})
				: null;
			if (pair) paintPair(pair);

			// --- readouts, touched only when they actually change
			const A8 = rgb.map((v) => Math.round(v * 255)) as Rgb;
			const H = Math.round(hsl[0] * 360) % 360;
			const S = Math.round(hsl[1] * 100);
			const L = Math.round(hsl[2] * 100);
			const said = `${space}|${A8}|${H} ${S} ${L}`;
			if (!comparing && said !== lastSaid) {
				lastSaid = said;
				readout.textContent = space === 'hsl' ? `hsl(${H} ${S}% ${L}%)` : rgbCss(A8);
				root.style.setProperty('--swatch-a', rgbCss(A8));
				root.style.setProperty('--swatch-b', rgbCss(A8));
				/* Black and white contrast equally at luminance 0.179, which is
				   where the reading's ink flips over. */
				root.style.setProperty(
					'--readout-ink',
					luminance(A8[0], A8[1], A8[2]) > 0.179 ? '#000' : '#fff',
				);
				for (let c = 0; c < 3; c++) rgbBars[c].track.set(0, A8[c]);
				hslBars[0].track.set(0, H);
				hslBars[1].track.set(0, S);
				hslBars[2].track.set(0, L);
			}
			/* The saturation and lightness bars are repainted from the colour the
			   dot is on: a saturation scale is a scale of *this* hue, and a
			   grey-to-grey bar would say nothing at all. Kept apart from the
			   readout above because a gradient is an expensive thing to restate,
			   and these two only move when the whole degree does. */
			const painted = `${H} ${S} ${L}`;
			if (!comparing && painted !== lastPainted) {
				lastPainted = painted;
				paintScales(hslBars, H, S, L);
			}

			/* --- draw. Standing the solid on its black corner makes it taller
			   than it was lying flat — a cube is √3 across its diagonal and √2
			   across a face — so the eye pulls back by that ratio as it tips, and
			   the picture keeps the frame it had rather than growing out of it. */
			const size = (Math.min(w, h) * scale) / (1 + 0.225 * tip) * (1 - 0.3 * opened);
			const sx = (FOCAL * size) / (w / 2);
			const sy = (FOCAL * size) / (h / 2);
			const halfX = canvas.width / 2;
			const halfY = canvas.height / 2;

			gl.clear(gl.COLOR_BUFFER_BIT | gl.DEPTH_BUFFER_BIT);

			/* Opaque, and not always convex on the way between two shapes, so the
			   depth buffer does the sorting rather than a face-facing test. The
			   offset pushes the solid a hair back so the wireframe drawn on the
			   surface is not left fighting it. */
			gl.enable(gl.DEPTH_TEST);
			gl.depthFunc(gl.LESS);
			gl.disable(gl.CULL_FACE);
			gl.disable(gl.BLEND);
			/* Enough of a push that a line lying exactly on the surface wins
			   cleanly. At one unit the two were within a rounding error of each
			   other and the wireframe came out dashed. */
			gl.enable(gl.POLYGON_OFFSET_FILL);
			gl.polygonOffset(2, 4);
			gl.useProgram(progSolid);
			gl.uniformMatrix3fv(U.solid.rot, false, m);
			gl.uniform2f(U.solid.scale, sx, sy);
			gl.uniform1f(U.solid.morph, morph);
			gl.uniform1f(U.solid.grey, greyMix);
			useAttribs([A.pos, A.hsl]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufSolid);
			gl.vertexAttribPointer(A.pos, 3, gl.FLOAT, false, 24, 0);
			gl.vertexAttribPointer(A.hsl, 3, gl.FLOAT, false, 24, 12);
			gl.bindBuffer(gl.ELEMENT_ARRAY_BUFFER, bufIndex);
			gl.drawElements(gl.TRIANGLES, SOLID_INDEX.length, gl.UNSIGNED_SHORT, 0);
			gl.disable(gl.POLYGON_OFFSET_FILL);

			/* The wireframe, twice: the part in front of the solid inked dark, and
			   the part behind it painted over in white. Nothing is transparent —
			   the surface is opaque and this is drawn straight on top — but it
			   reads as the far side showing through, which is the fiction that
			   makes a solid legible as a shape. */
			gl.enable(gl.BLEND);
			gl.useProgram(progWire);
			gl.uniformMatrix3fv(U.wire.rot, false, m);
			gl.uniform2f(U.wire.scale, sx, sy);
			gl.uniform1f(U.wire.morph, morph);
			gl.uniform2f(U.wire.half, halfX, halfY);
			gl.uniform1f(U.wire.width, dpr);
			useAttribs([A.p0, A.h0, A.p1, A.h1, A.end, A.side]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufWire);
			const stride = EDGE_FLOATS * 4;
			gl.vertexAttribPointer(A.p0, 3, gl.FLOAT, false, stride, 0);
			gl.vertexAttribPointer(A.h0, 3, gl.FLOAT, false, stride, 12);
			gl.vertexAttribPointer(A.p1, 3, gl.FLOAT, false, stride, 24);
			gl.vertexAttribPointer(A.h1, 3, gl.FLOAT, false, stride, 36);
			gl.vertexAttribPointer(A.end, 1, gl.FLOAT, false, stride, 48);
			gl.vertexAttribPointer(A.side, 1, gl.FLOAT, false, stride, 52);

			/* Neither pass writes depth. Both draw the same lines, and the first
			   of them would otherwise leave its own depth behind for the second
			   to be tested against — a comparison between a line and itself,
			   which comes out differently pixel by pixel. Tested against the
			   surface alone, every fragment belongs to exactly one pass. */
			gl.depthMask(false);
			for (const [set, alpha] of [
				[DIAGONALS, 1 - flattened],
				[EQUATOR, 1 - opened],
				[RIMS, opened],
			] as const) {
				if (alpha <= 0.004) continue;
				gl.depthFunc(gl.GREATER);
				gl.uniform4f(U.wire.color, 1, 1, 1, 0.32 * alpha);
				gl.drawArrays(gl.TRIANGLES, set.start * 6, set.count * 6);
				gl.depthFunc(gl.LEQUAL);
				gl.uniform4f(U.wire.color, 0, 0, 0, 0.22 * alpha);
				gl.drawArrays(gl.TRIANGLES, set.start * 6, set.count * 6);
			}

			/* The dot, the same way: solid where it is in front of the surface and
			   faint where the solid is over it. Depth rather than a thickness
			   calculation, because "how much material is in front of this" has no
			   one formula across three shapes — and the reading, which is that a
			   colour deep inside is a colour you cannot see the outside of, is the
			   same either way. */
			const core = Math.max(4, size * 0.04) * dpr;
			gl.useProgram(progDot);
			gl.uniformMatrix3fv(U.dot.rot, false, m);
			gl.uniform2f(U.dot.scale, sx, sy);
			gl.uniform1f(U.dot.morph, morph);
			gl.uniform2f(U.dot.half, halfX, halfY);
			gl.uniform1f(U.dot.radius, core + 1);
			gl.uniform1f(U.dot.core, core);
			useAttribs([A.corner]);
			gl.bindBuffer(gl.ARRAY_BUFFER, bufQuad);
			gl.vertexAttribPointer(A.corner, 2, gl.FLOAT, false, 8, 0);
			for (const dot of pair ?? [{ rgb, hsl }]) {
				gl.uniform3f(U.dot.pos, dot.rgb[0], dot.rgb[1], dot.rgb[2]);
				gl.uniform3f(U.dot.hsl, dot.hsl[0], dot.hsl[1], dot.hsl[2]);
				gl.depthFunc(gl.GREATER);
				gl.uniform1f(U.dot.alpha, 0.2);
				gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
				gl.depthFunc(gl.LEQUAL);
				gl.uniform1f(U.dot.alpha, 1);
				gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
			}
			gl.depthMask(true);
		}

		requestAnimationFrame(frame);
	}

	document.querySelectorAll<HTMLElement>('[data-colour-solid]').forEach(initSolid);
</script>
