---
// The workbench. Not linked from anywhere and kept out of the sitemap (see
// astro.config) — it is for whoever is building the site, not for whoever is
// reading it.
//
// The rule for this page: derive, never transcribe. Every token below is read
// out of global.css at build time and every number beside it is computed from
// that value, so the page cannot drift from the site the way a hand-kept
// swatch sheet does. If a colour here is wrong, global.css is wrong.
import { converter, formatHex } from 'culori';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import VizTrack from '../components/VizTrack.astro';
import Specimen from '../components/ds/Specimen.astro';
import { lighten } from '../lib/oklch';
// The stylesheet as text, inlined by the bundler at build time. Reading it off
// disk instead would be reading it from wherever the build happens to have put
// itself, which is not where the source is.
import css from '../styles/global.css?raw';

// Only the hex-valued custom properties in the first :root block. Anything
// that is a stack, a length or a shadow is not a swatch and belongs in the
// measures table further down.
const root = css.slice(css.indexOf(':root'), css.indexOf('\n}', css.indexOf(':root')));
const tokens = [...root.matchAll(/--([a-z0-9-]+):\s*(#[0-9a-fA-F]{3,8})\s*;/g)]
	.map(([, name, hex]) => ({ name, hex }))
	// The edges are derived from the palette rather than part of it, and the hex
	// in the stylesheet is only what they fall back to where relative colour
	// syntax is missing — listing it here would be the page telling a colour it
	// does not paint. They are in Patterns instead.
	.filter((t) => !t.name.startsWith('edge'));

const toOklch = converter('oklch');
const swatch = (t: { name: string; hex: string }) => {
	const o = toOklch(t.hex)!;
	return {
		name: t.name,
		hex: t.hex,
		// The value as it would be written, not as a table of parts. A neutral
		// has no hue to report, and culori says so with undefined; 0 is the
		// convention for writing one down.
		oklch: `oklch(${(o.l * 100).toFixed(2)}% ${o.c.toFixed(3)} ${(o.h ?? 0).toFixed(2)})`,
		// Which way the words have to go to be read on it.
		ink: o.l > 0.6 ? '#14161a' : '#eceff4',
		// The same edge the bars wear: the swatch's own colour a fifth of the
		// way to white. A real border, because a flat colour has nothing for an
		// edge to follow — the two-layer version is for a ramp, and it is in
		// the pattern below.
		edge: lighten(t.hex, 0.2),
	};
};

const by = (name: string) => tokens.find((t) => t.name === name)!;

// The two that are the site: what it is made of, and what it points with.
const SITE = ['nordbg', 'accent'].map((n) => swatch(by(n)));
// Everything else, in the order the stylesheet declares it.
const REST = tokens.filter((t) => !['nordbg', 'accent'].includes(t.name)).map(swatch);

/* Every corner the site rounds, counted where it is written. The row that
   used to be here said "4px / 8px / 12px", which was three of the fourteen
   values then in use — a hand-kept list, and out of date the day after it was
   written. This one is read from the source with the rest of the page, so it
   is also the check that the scale holds: anything here that is not one of
   the tokens is a corner somebody typed instead of choosing.

   Its own styles and the specimen frame are left out. A workbench is not the
   site, and its corners should not be counted as if they were. */
const sheets = import.meta.glob('../{components,layouts,pages,styles}/**/*.{astro,css}', {
	query: '?raw',
	import: 'default',
	eager: true,
}) as Record<string, string>;

const STEPS = ['small', 'medium', 'large', 'pill'];
const counts = new Map(STEPS.map((n) => [n, 0]));
for (const [file, text] of Object.entries(sheets)) {
	if (file.includes('designsystem') || file.includes('/ds/')) continue;
	for (const [, name] of text.matchAll(/border-radius:\s*var\(--radius-([a-z]+)\)/g)) {
		if (counts.has(name)) counts.set(name, counts.get(name)! + 1);
	}
}
// In scale order, not by how popular each turned out to be.
const RADII = STEPS.map((n) => [`--radius-${n}`, counts.get(n)!] as const);

// The measures that are decided once and then meant everywhere.
const MEASURES = [
	['--header-height', '5rem', "The orange block, and a deck post's T3 mark. One number so the two line up."],
	['--page-border', '2px', 'The accent frame. Full-viewport layouts subtract it from 100dvh.'],
	['main max-width', '720px', 'The column. Set in global.css, not a token.'],
	['body', '14px / 1.7', '15px under 720px. Prose bodies switch to the serif; everything else stays mono.'],
];

// --- the FLB ------------------------------------------------------------

const LIFT = 0.2;

// A flat colour's edge is one colour, so it is a border and there is nothing
// clever about it.
const SOLIDS = [
	{ name: '--nord0', hex: '#2e3440' },
	{ name: '--accent', hex: '#ffa200' },
	{ name: '--viz-dark', hex: '#14161a' },
].map((c) => ({ ...c, edge: lighten(c.hex, LIFT) }));

const REAL_CSS = `background: var(--nord0);
border: 1px solid <that colour, lifted>;`;

// A hue wheel laid out flat, and the same wheel lifted for the ring around
// it — built here the way the cube's channel bars and the solid's hue bar
// build theirs, out of `lighten`.
const toRgb = converter('rgb');
const VIZ_DARK = '#14161a';
const HUES = Array.from({ length: 25 }, (_, i) => i * 15);
const hueHex = (d: number) => formatHex(toRgb({ mode: 'hsl', h: d, s: 1, l: 0.5 })!);
const HUE_RAMP = `linear-gradient(to right, ${HUES.map(hueHex).join(', ')})`;
const HUE_EDGE = `linear-gradient(to right, ${HUES.map((d) => lighten(hueHex(d), LIFT)).join(', ')})`;

// A bar with no backdrop shows its rest colour, which is white at 16%. Over
// the dark stage that composites to this, and the bar is handed it flat: a
// see-through bed lets the ring show through the whole of itself rather than
// only around the edge, because the layer over it hides nothing. Opaque, the
// edge is an edge again — and it can be lifted off the colour the bed actually
// ends up being rather than off one of its halves.
const REST_ON_DARK = formatHex({
	mode: 'rgb',
	...(([r, g, b]) => ({ r, g, b }))(
		[1, 3, 5].map((i) => {
			const v = parseInt(VIZ_DARK.slice(i, i + 2), 16) / 255;
			return 0.16 + 0.84 * v;
		}) as [number, number, number],
	),
});
const BED_EDGE = lighten(REST_ON_DARK, LIFT);

const FAKE_CSS = `background:
  <the ramp> padding-box,        /* stops at the inner edge */
  <the ramp, lifted> border-box; /* only the ring is left for it */
box-sizing: border-box;
border: 1px solid transparent;   /* reserves the ring, paints nothing */`;

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Design system — T3" description="The site's tokens and components, on one page." />
		<meta name="robots" content="noindex, nofollow" />
		<style>
			.ds h2 + p,
			.ds > p {
				max-width: 62ch;
				color: var(--text-quiet);
				opacity: 0.75;
			}

			/* Swatches ------------------------------------------------------ */

			.swatches + .swatches {
				margin-top: 2rem;
			}

			/* Wide enough that the oklch string never has to break. */
			.swatches {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(13rem, 1fr));
				gap: 1rem;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}

			/* One rectangle of the colour with its own name on it, which is also
			   the only honest test of a colour: whether anything can be read on it. */
			.swatches li {
				padding: 2.6rem 0.7rem 0.6rem;
				/* The bars' radius, so a rectangle on this page is cornered the
				   same as a rectangle anywhere else on the site. */
				/* An FLB is one pixel, here and everywhere. */
				border: 1px solid;
				border-radius: var(--radius-small);
			}

			.name {
				display: block;
				font-size: 0.85em;
			}

			/* Same ink as the name. Fading it left the dark swatches with a grey
			   second line, which is a third colour nobody asked for. */
			.value {
				display: block;
				font-size: 0.68em;
				white-space: nowrap;
			}

			/* Measures ------------------------------------------------------ */

			table.measures {
				border-collapse: collapse;
				margin-top: 1.25rem;
				font-size: 0.9em;
			}

			table.measures th,
			table.measures td {
				text-align: left;
				vertical-align: top;
				padding: 0.4rem 1rem 0.4rem 0;
				border-bottom: 1px solid var(--edge);
			}

			table.measures th {
				color: var(--nord8);
				font-weight: 400;
				white-space: nowrap;
			}

			table.measures td:last-child {
				color: var(--text-quiet);
				opacity: 0.75;
			}

			/* Every rounding in the site, at the size it is written for: small
			   enough that 2px and 4px are still telling apart. */
			.radii {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(7rem, 1fr));
				gap: 1rem;
				margin: 1.25rem 0 0;
				padding: 0;
				list-style: none;
			}

			.corner {
				display: block;
				block-size: 2.2rem;
				background: var(--nord0);
				border: 1px solid var(--edge-panel);
				margin-bottom: 0.4rem;
			}

			/* The FLB ------------------------------------------------------- */

			/* The edge is a custom property the bar reads off whatever it is
			   inside, and the ring it shows through has to be asked for: a bar
			   with no border has nowhere to put one. */
			.flb-bar {
				--track-border: 1px solid transparent;
			}

			.flb-row {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
			}

			.solid {
				flex: 1 1 8rem;
				block-size: 4.5rem;
				border-radius: var(--radius-large);
				border: 1px solid;
			}

			.type-sample p {
				max-width: 62ch;
			}

			.type-sample .prose {
				font-family: var(--font-prose);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="ds">
				<h1>Design system</h1>
				<h2>Colour</h2>
				<ul class="swatches">
					{
						SITE.map((c) => (
							<li style={`background: ${c.hex}; color: ${c.ink}; border-color: ${c.edge}`}>
								<span class="name">--{c.name}</span>
								<span class="value">{c.oklch}</span>
							</li>
						))
					}
				</ul>
				<ul class="swatches">
					{
						REST.map((c) => (
							<li style={`background: ${c.hex}; color: ${c.ink}; border-color: ${c.edge}`}>
								<span class="name">--{c.name}</span>
								<span class="value">{c.oklch}</span>
							</li>
						))
					}
				</ul>

				<h2>Measures</h2>
				<p>Decided once, and then meant everywhere.</p>
				<table class="measures">
					<tbody>
						{
							MEASURES.map(([name, value, note]) => (
								<tr>
									<th>{name}</th>
									<td>{value}</td>
									<td>{note}</td>
								</tr>
							))
						}
					</tbody>
				</table>

				<h3>Radius</h3>
				<ul class="radii">
					{
						RADII.map(([value, count]) => (
							<li>
								<span class="corner" style={`border-radius: var(${value})`} />
								<span class="name">{value}</span>
								<span class="value">
									{count} {count === 1 ? 'use' : 'uses'}
								</span>
							</li>
						))
					}
				</ul>

				<h2>OKLCH</h2>

				<div>Use OKLCH for everything.</div>

				<h2>FLB</h2>

				<div>Any border on an object should be an <em>FLB</em> (fake luminosity border).</div>

				<Specimen
					name="On a flat colour"
					note="If the element is a flat color, its border can be a real CSS border; same color but 20% lighter."
					code={REAL_CSS}
				>
					<div class="flb-row">
						{
							SOLIDS.map((c) => (
								<div
									class="solid"
									style={`background: ${c.hex}; border-color: ${c.edge}`}
								/>
							))
						}
					</div>
				</Specimen>

				<Specimen
					name="On a ramp"
					note="If the content is a gradient or some other sort of non-solid colour, the border must be emulated to show a fake 1px ring of the same colour, 20% lighter, around the element."
					code={FAKE_CSS}
					ground="dark"
				>
					<div class="flb-bar" style={`--track-edge: ${HUE_EDGE}; --track-radius: var(--radius-large)`}>
						<VizTrack thumbs={0} fill={false} size="2.5rem" backdrop={HUE_RAMP} />
					</div>
				</Specimen>

				<h2>Components</h2>

				<Specimen
					name="VizTrack"
					note="The bar everything in the colour series is built on: an axis with something painted along it, one or two thumbs, and a walk that runs on its own until a reader takes hold of it. With a backdrop it shows the ramp; without one it fills up to the thumb."
					code={`<VizTrack thumbs={1} labels={['Value']} />
<VizTrack thumbs={1} backdrop={ramp} size="2rem" labels={['Hue']} />
<VizTrack thumbs={2} labels={['Low', 'High']} />

/* the edge is the host's to set, and needs a ring to show through */
--track-border: 1px solid transparent;
--track-edge: <the bed's colour, lifted>;`}
					ground="dark"
				>
					<div
						class="stack flb-bar"
						style={`--track-rest: ${REST_ON_DARK}; --track-edge: ${BED_EDGE}`}
					>
						<VizTrack thumbs={1} labels={['Value']} />
						<div style={`--track-edge: ${HUE_EDGE}`}>
							<VizTrack thumbs={1} backdrop={HUE_RAMP} size="2rem" labels={['Hue']} />
						</div>
						<VizTrack thumbs={2} labels={['Low', 'High']} />
					</div>
				</Specimen>

				<h2>Type</h2>
				<Specimen
					name="The two voices"
					note="Monospace is the site talking: nav, headings, the post index, code. Long-form prose bodies are the only thing that switches, to the serif, and they say so by carrying .prose."
				>
					<div class="type-sample">
						<h4>A heading, which wears its own hashes</h4>
						<p>
							Default voice. Body copy at 14px on 1.7, in <code>--font-mono</code>,
							the colour of <code>--text</code>.
						</p>
						<p class="prose">
							And the prose voice, <code>--font-prose</code>, which is Source Serif
							4 and self-hosted. This is what a post body is set in and the only
							place the serif appears.
						</p>
						<blockquote>A quote takes the accent down its left edge.</blockquote>
					</div>
				</Specimen>
			</section>
		</main>
	</body>
</html>
