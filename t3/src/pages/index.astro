---
import { getCollection, render } from 'astro:content';
import BlogPost from '../layouts/BlogPost.astro';

// Beside the list on a wide screen: the newest prose post that is out by the
// time the site is built. A deck is a full screen of its own and does not fit
// in half of one. A post dated later than the build is left to the list,
// which shows it once its day comes.
const builtAt = Date.now();
const [latest] = (await getCollection('blog'))
	.filter((post) => !post.data.hidden && post.data.format !== 'deck')
	.filter((post) => post.data.pubDate.valueOf() <= builtAt)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const { Content } = await render(latest);
---

<BlogPost {...latest.data} id={latest.id} home>
	<Content />
</BlogPost>
