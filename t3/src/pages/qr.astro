---
const maps = "https://maps.app.goo.gl/31KjsJZ35394Z9QM9";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The tattoo works!</title>
    <style is:global>
      html, body { margin: 0; }
      body {
        min-height: 100vh;
        font-family: "Comic Sans MS", "Comic Sans", "Chalkboard SE", "Comic Neue", cursive;
        color: #fff;
        background:
          radial-gradient(circle at 20% 30%, #fff 0 1px, transparent 2px) 0 0 / 37px 41px,
          radial-gradient(circle at 70% 60%, #ff0 0 1px, transparent 2px) 0 0 / 53px 47px,
          radial-gradient(circle at 40% 80%, #0ff 0 1px, transparent 2px) 0 0 / 61px 59px,
          #10002b;
        animation: drift 40s linear infinite;
        overflow-x: hidden;
        cursor: crosshair;
      }
      @keyframes drift { to { background-position: 370px 410px, -530px 470px, 610px -590px, 0 0; } }
      .marquee { background: #ff00c8; color: #ff0; font-weight: bold; padding: 4px 0; border-bottom: 3px ridge #ff0;
                 font-family: Impact, "Arial Black", sans-serif; letter-spacing: 2px; }
      main { max-width: 640px; margin: 0 auto; padding: 16px; text-align: center; }
      h1 { font-family: Impact, "Arial Black", sans-serif; font-size: clamp(2.6rem, 13vw, 5rem); line-height: .95; margin: 18px 0 6px;
           background: linear-gradient(90deg, #f00, #f90, #ff0, #0f0, #0ff, #00f, #f0f, #f00); background-size: 200% 100%;
           -webkit-background-clip: text; background-clip: text; color: transparent;
           animation: rainbow 2s linear infinite, wobble 1.2s ease-in-out infinite; filter: drop-shadow(3px 3px 0 #000); }
      @keyframes rainbow { to { background-position: 200% 0; } }
      @keyframes wobble { 50% { transform: rotate(-2deg) scale(1.04); } }
      .blink { animation: blink 1s steps(1) infinite; }
      @keyframes blink { 50% { visibility: hidden; } }
      .sub { font-size: 1.2rem; color: #0ff; text-shadow: 2px 2px #f0f; }
      .box { border: 5px ridge #ffd700; background: #000080; margin: 22px 0; padding: 14px; box-shadow: 8px 8px 0 #ff00c8; }
      .box h2 { margin: 0 0 8px; color: #ff0; font-size: 1.6rem; text-decoration: underline wavy #f0f; }
      .martina { font-family: Impact, "Arial Black", sans-serif; font-size: clamp(2.2rem, 11vw, 3.6rem); color: #ff0;
                 text-shadow: 3px 3px 0 #f00, 6px 6px 0 #00f; letter-spacing: 3px; animation: wobble 1.6s ease-in-out infinite; }
      .studio { font-size: 1.5rem; color: #7fff00; }
      .addr { color: #ffb6ff; }
      .go { display: inline-block; margin-top: 12px; padding: 12px 18px; font-size: 1.2rem; font-weight: bold; color: #000;
            background: linear-gradient(#ff0, #f90); border: 4px outset #ff0; text-decoration: none; animation: pulse .8s ease-in-out infinite; }
      .go:active { border-style: inset; }
      @keyframes pulse { 50% { transform: scale(1.08); } }
      table { margin: 0 auto; border: 3px outset #c0c0c0; background: #c0c0c0; color: #000; font-family: "Times New Roman", serif; }
      td { border: 2px inset #c0c0c0; padding: 4px 10px; text-align: left; }
      .construct { margin: 22px 0; padding: 10px; color: #000; font-weight: bold;
                   background: repeating-linear-gradient(45deg, #ff0 0 16px, #000 16px 32px); }
      .construct span { background: #ff0; padding: 2px 8px; }
      .counter { display: inline-flex; gap: 2px; margin-top: 6px; }
      .counter b { background: #000; color: #0f0; font-family: "Courier New", monospace; font-size: 1.4rem; padding: 2px 5px; border: 1px solid #0f0; }
      .ring a { color: #0ff; }
      footer { font-size: .8rem; color: #aaa; margin: 26px 0 40px; line-height: 1.6; }
      .sparkle { position: fixed; pointer-events: none; font-size: 16px; animation: fall 1s linear forwards; z-index: 9; }
      @keyframes fall { to { transform: translateY(40px) rotate(180deg); opacity: 0; } }
    </style>
  </head>
  <body>
    <div class="marquee">
      <marquee scrollamount="7">★★★ WELCOME 2 THE OFFICIAL QR TATTOO HOMEPAGE ★★★ U JUST SCANNED SOMEBODYS ARM ★★★ INKED BY MARTINA @ IKIGAI TATTOO STUDIO FIRENZE ★★★ THE TATTOO WORKS ★★★</marquee>
    </div>
    <main>
      <h1>THE TATTOO WORKS!!!</h1>
      <p class="sub"><span class="blink">✨ NEW ✨</span> u just scanned an actual human arm 💪📱</p>

      <div class="box">
        <h2>~*~ THE ARTIST ~*~</h2>
        <div>this lil masterpiece was inked by</div>
        <div class="martina">MARTINA</div>
        <div class="studio">🌸 IKIGAI TATTOO STUDIO 🌸</div>
        <div class="addr">Via Maurizio Bufalini 1r, 50122 Firenze 🇮🇹</div>
        <a class="go" href={maps}>📍 GO GET TATTOOED BY MARTINA 📍</a>
      </div>

      <div class="box">
        <h2>why martina RULEZ</h2>
        <table>
          <tr><td>✅</td><td>steady hands</td></tr>
          <tr><td>✅</td><td>lines so clean a phone can read them</td></tr>
          <tr><td>✅</td><td>QR code still scans (u are here!!)</td></tr>
          <tr><td>✅</td><td>ikigai = reason for being (look it up)</td></tr>
          <tr><td>✅</td><td>florence 🍕🍷🎨</td></tr>
        </table>
      </div>

      <div class="construct"><span>🚧 THIS SITE IS UNDER CONSTRUCTION 4EVER 🚧</span></div>

      <div>you are visitor #</div>
      <div class="counter" id="counter"></div>

      <p class="ring">◄ <a href="#" onclick="alert('the webring has been down since 2003'); return false;">prev</a> | 🔥 FIRENZE INK WEBRING 🔥 | <a href="#" onclick="alert('the webring has been down since 2003'); return false;">next</a> ►</p>

      <footer>
        best viewed in Netscape Navigator 4.0 at 800x600<br />
        made with ♥ in notepad.exe<br />
        © 1999 no rights reserved
      </footer>
    </main>
    <script is:inline>
      const digits = String(Math.floor(Date.now() / 7000) % 1000000).padStart(7, "0");
      document.getElementById("counter").innerHTML = [...digits].map((d) => `<b>${d}</b>`).join("");
      const bits = ["✨", "⭐", "💖", "🌸", "💫"];
      let last = 0;
      const sparkle = (x, y) => {
        const now = Date.now();
        if (now - last < 40) return;
        last = now;
        const s = document.createElement("span");
        s.className = "sparkle";
        s.textContent = bits[Math.floor(Math.random() * bits.length)];
        s.style.left = x + "px";
        s.style.top = y + "px";
        document.body.appendChild(s);
        setTimeout(() => s.remove(), 1000);
      };
      addEventListener("pointermove", (e) => sparkle(e.clientX, e.clientY));
      addEventListener("touchmove", (e) => sparkle(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
    </script>
  </body>
</html>
