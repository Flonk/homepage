<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>The tattoo works!</title>
    <style is:global>
      html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
      video { position: fixed; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    </style>
  </head>
  <body>
    <video id="v" src="/qr/rickroll.mp4" poster="/qr/rickroll.jpg" autoplay playsinline loop preload="auto"></video>
    <script is:inline>
      const v = document.getElementById("v");
      const gestures = ["pointerup", "touchend", "click", "keydown"];
      const loud = () => {
        v.muted = false;
        v.play().catch(() => {});
        for (const e of gestures) removeEventListener(e, loud);
      };
      v.play().catch(() => {
        v.muted = true;
        v.play().catch(() => {});
        for (const e of gestures) addEventListener(e, loud, { passive: true });
      });
    </script>
  </body>
</html>
