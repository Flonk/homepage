								"name": "Lactococcus lactis subsp. lactis",
								"kind": "bacterium",
								"does": [
									"acid"
								]
							},
							{
								"name": "Lactococcus lactis subsp. cremoris",
								"kind": "bacterium",
								"does": [
									"acid"
								]
							},
							{
								"name": "Penicillium camemberti",
								"kind": "mould",
								"does": [
