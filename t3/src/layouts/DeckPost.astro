---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import CommentButton from '../components/CommentButton.astro';
import SeriesMenu from '../components/SeriesMenu.astro';
import SplitPane from '../components/SplitPane.astro';
import type { SeriesLink } from '../series';

type Props = CollectionEntry<'chapters'>['data'] & {
	// Where the deck is (see src/site.ts).
	href: string;
	// The title where it stands alone, in the browser's tab: a numbered
	// chapter's with its series and number ("Colour #1: The RGB Cube").
	fullTitle?: string;
	// For a numbered chapter, its series' name and which part it is, said once
	// over the title, which is its own.
	series?: string;
	part?: string;
	prevPart?: SeriesLink;
	nextPart?: SeriesLink;
	seriesParts?: SeriesLink[];
};

const {
	href,
	fullTitle,
	part,
	title,
	description,
	pubDate,
	series,
	hn,
	ground,
	deckSplit = 50,
	deckLayout = 'stacked',
	accent,
	chromeShift,
	chromeGrain,
	prevPart,
	nextPart,
	seriesParts = [],
	hidden,
} = Astro.props;
// The post's colour on <html>, where the chrome is worked out from it.
const own = [accent && `--accent: ${accent}`, chromeShift != null && `--chrome-shift: ${chromeShift}`]
	.filter(Boolean)
	.join('; ');
---

<html lang="en" style={own || undefined} data-grain={chromeGrain}>
	<head>
		<BaseHead title={fullTitle ?? title} description={description} />
		{hidden && <meta name="robots" content="noindex, nofollow" />}
		<link
			href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
			rel="stylesheet"
		/>
	</head>

	<body class:list={['deck-page', ground === 'dark' && 'deck-dark']}>
		{/* Under the site's header like any other post, beside the tree on a
		    wide screen; on a narrow one the deck's title goes up into the
		    header in place of its own masthead. */}
		<div class="deck-site-header">
			<Header />
		</div>
		<SplitPane mode="deck" current={href}>
			<main class="deck-main">
				<div class="deck-head">
					<a class="deck-home" href="/" aria-label="Back to the home page">T3</a>
					<div class="deck-headings">
						<div class="deck-meta" data-page-meta>
							{series && <span class="deck-series">{series}{part && ` #${part}`}</span>}
							<span class="deck-date"><FormattedDate date={pubDate} /></span>
						</div>
						<h1 class="deck-title" data-page-title>{title || fullTitle}</h1>
					</div>
				</div>
	
				<!-- Every card renders into these two areas; only the active one shows. -->

				<div
					class:list={['deck', deckLayout === 'sidebar' && 'is-sidebar']}
					data-deck
					style={`--deck-split: ${deckSplit}%`}
				>
					<div class="deck-ground" aria-hidden="true"></div>
					{deckLayout === 'sidebar' && <div class="deck-tools" data-deck-tools></div>}
					<slot />
					<div class="deck-divider" title="drag to resize" aria-hidden="true" data-no-swipe>
						<svg class="deck-handle" viewBox="0 0 16 16"><path d="M4.5 6.5 8 3l3.5 3.5M4.5 9.5 8 13l3.5-3.5" /></svg>
					</div>
				</div>
				<script is:inline>
					// Where the reader left this deck's split, and a sidebar deck's
					// column, set before it paints, so it never opens at the post's own
					// and then jumps.
					try {
						const deck = document.currentScript.previousElementSibling;
						const split = Number(localStorage.getItem(`deck-split:${location.pathname}`));
						if (split >= 20 && split <= 80) deck.style.setProperty('--deck-drag', `${split}%`);
						const col = Number(localStorage.getItem(`deck-col:${location.pathname}`));
						if (col > 0) deck.parentElement.style.setProperty('--deck-col', `${col}px`);
					} catch {}
				</script>
	
				<nav class="deck-nav" aria-label="Card navigation">
					{/* The rest of the series, where the tree is not beside the deck. */}
					{series && seriesParts.length > 1 && (
						<div class="deck-series-menu">
							<SeriesMenu series={series} parts={seriesParts} current={href} />
						</div>
					)}
					{/* At the ends of the deck the arrows have nowhere left to go, which
					    is exactly where the rest of the series is. Real links rather
					    than buttons that navigate, so they open in a new tab, show their
					    target on hover, and are read as links. */}
					{prevPart && (
						<a class="deck-arrow deck-jump" data-deck-jump-prev href={prevPart.href} hidden>
							&#8249; Part {prevPart.part}
						</a>
					)}
					<button type="button" class="deck-arrow" data-deck-prev aria-label="Previous card">
						&#8249;
					</button>
					{/* A dot per card stops scaling somewhere around a dozen; the count
					    reads the same at five cards or fifty. */}
					<span class="deck-counter" data-deck-counter aria-live="polite"></span>
					<button type="button" class="deck-arrow" data-deck-next aria-label="Next card">
						&#8250;
					</button>
					{nextPart && (
						<a
							class="deck-arrow deck-jump deck-jump-on"
							data-deck-jump-next
							href={nextPart.href}
							hidden
						>
							Go to part {nextPart.part} &#8250;
						</a>
					)}
					{hn && (
						<div class="deck-comment">
							<CommentButton href={hn} />
						</div>
					)}
				</nav>
			</main>
		</SplitPane>

		<style>
			/* The deck fills the viewport exactly. A definite `height` rather than
			   `min-height` — the flex/grid chain below needs a definite size to
			   divide, otherwise the rows size to their content and push the nav
			   off-screen. */
			.deck-page {
				--deck-ground: var(--ink-100);
				--deck-ink: #35302a;
				--deck-ink-dim: #7a7264;
				/* Where it can be, the light ground and its ink worked out from
				   the post's accent, as the chrome round the page is: near white
				   and near black in the post's own hue, kept close to grey so a
				   picture on it is not tinted. The colours above are what stays
				   where this is not understood. */
				--deck-ground: oklch(from var(--accent) 0.94 min(c, 0.012) h);
				--deck-ink: oklch(from var(--accent) 0.3 min(c, 0.02) h);
				--deck-ink-dim: oklch(from var(--accent) 0.55 min(c, 0.02) h);
				--deck-eyebrow: var(--ink-accent);
				/* The surface a visualization puts its controls on: a pane of
				   glass over whatever is behind it, which may be the ground and
				   may be a field of colour the picture itself has painted. What
				   the glass is smoked with is the one thing that has to turn over
				   with the ground — a white wash on a dark ground and a dark one
				   on a light ground, so the panel is always the thing in front.
				   The marks on the bars are white either way. */
				--viz-glass: rgb(12 14 17 / 0.62);
				--viz-glass-rim: rgb(255 255 255 / 0.12);
				--viz-shadow: rgba(40, 30, 14, 0.55);
				/* Minus the accent frame :root draws around the page, which sits
				   outside body's box and would otherwise overflow the viewport. */
				height: calc(100dvh - var(--page-border) - var(--frame-bottom));
				overflow: hidden;
			}

			/* The other ground. The masthead and the viz are one surface, so the
			   ink has to turn over with them — a post picks the pair, not just the
			   colour behind the picture. A visualization inside reads the same
			   tokens, and so needs to know nothing about which post it is in. */
			.deck-page.deck-dark {
				--deck-ground: var(--ground-200);
				--deck-ink: #e6e9ef;
				--deck-ink-dim: #8891a0;
				--deck-eyebrow: var(--ink-accent);
				--viz-glass: rgb(255 255 255 / 0.06);
				--viz-glass-rim: rgb(255 255 255 / 0.08);
				--viz-shadow: rgb(0 0 0 / 0.55);
			}

			.deck-main {
				flex: 1;
				min-height: 0;
				display: flex;
				flex-direction: column;
				max-width: none;
				width: 100%;
				margin: 0;
				padding: 0;
				/* A visualization sized in cqw measures the deck, which is the whole
				   window on a phone and the right pane beside the tree. */
				container-type: inline-size;
			}

			/* The site's header over every deck, with what the deck's own masthead
			   said up in it instead (see Header, data-page-title and data-page-meta):
			   the masthead stays in the page only to be read from, never shown. */
			.deck-site-header {
				display: block;
				flex: none;
			}
			.deck-main .deck-head {
				display: none;
			}

			/* No padding of its own — the home mark butts against the page edge and
			   the headings carry the inset instead. The masthead shares the ground of
			   the visualization below it, with no rule between, so they read as one
			   surface. */
			.deck-head {
				--home-size: var(--header-height);
				flex: none;
				display: flex;
				align-items: flex-start;
				min-height: var(--home-size);
				padding: 0;
				background: var(--deck-ground);
			}

			.deck-ground {
				grid-area: viz;
				background: var(--deck-ground);
			}

			/* Stands in for the site header: the only way back out of the deck.
			   Both dimensions come from one token rather than being derived from
			   the header band, so it stays square whatever the title does. */
			.deck-home {
				flex: none;
				width: var(--home-size);
				height: var(--home-size);
				display: grid;
				place-items: center;
				border-radius: 0;
				background-color: var(--accent);
				color: var(--ground-100);
				font-family: var(--font-mono);
				font-size: 1rem;
				font-weight: 700;
				letter-spacing: 0.04em;
				/* letter-spacing is added after the last glyph too, which drags the
				   text off-centre; pull it back by the same amount. */
				text-indent: 0.04em;
				text-decoration: none;
				transition: filter 0.15s ease;
			}

			.deck-home:hover,
			.deck-home:focus-visible {
				color: var(--ground-100);
				filter: brightness(1.15);
			}

			.deck-headings {
				min-width: 0;
				padding: 0.85rem 1.5rem 0.7rem 1rem;
			}

			/* Editorial rather than terminal: the deck is aimed at readers who are
			   not programmers, so its masthead uses the prose serif too. */
			.deck-meta {
				display: flex;
				align-items: baseline;
				gap: 0.75rem;
				font-family: var(--font-prose);
				font-size: 0.8rem;
			}

			.deck-series {
				color: var(--deck-eyebrow);
				letter-spacing: 0.14em;
				text-transform: uppercase;
			}

			.deck-date {
				color: var(--deck-ink-dim);
				letter-spacing: 0.03em;
			}

			.deck-title {
				color: var(--deck-ink);
				font-family: var(--font-prose);
				font-size: 1.6rem;
				font-weight: 700;
				letter-spacing: -0.01em;
				margin: 0.15rem 0 0;
				line-height: 1.2;
			}

			/* The two halves. minmax(0,1fr) so a tall viz cannot push the text
			   pane off-screen; each half scrolls internally instead. */
			.deck {
				flex: 1;
				min-height: 0;
				display: grid;
				grid-template-areas: 'viz' 'text';
				/* The picture's share of the height, --deck-at: where the reader
				   dragged the line (--deck-drag), or else the deck's own, which
				   depends on the screen (below). */
				grid-template-rows: minmax(0, var(--deck-at, 50%)) minmax(0, 1fr);
				position: relative;
				/* The cards waiting off to either side are invisible, not out of
				   the layout, so the 2.5rem they are translated by is real
				   overflow. Desktop never shows it — body's overflow:hidden is
				   propagated to the viewport, which clips it away — but a phone
				   reads a page wider than its viewport as one to shrink to fit,
				   and the whole deck zoomed out and could be panned around.
				   Clipped here, where the cards actually slide. `clip` rather
				   than `hidden`: this is not a scroll port and must not become
				   one, or a stray swipe could scroll the deck sideways. */
				overflow: clip;
			}

			/* On a narrow screen half a phone is not enough for every picture: one
			   with a band of sliders under it would be left a solid the size of a
			   stamp. Such a visualization says so with `data-viz-tall`, and while it
			   is the one on stage the picture takes three fifths and the text,
			   which scrolls anyway, the rest. Moved rather than cut, at the pace
			   the cards slide. A wide screen has the height already. Where the
			   reader has dragged the line, it stays where they put it. */
			@media (max-width: 1099px) {
				.deck {
					--deck-at: var(--deck-drag, 50%);
					transition: grid-template-rows 0.35s ease;
				}
				.deck:has(.deck-viz > [data-viz-tall]),
				.deck:has([data-viz-active='true'] [data-viz-tall]) {
					--deck-at: var(--deck-drag, 60%);
				}
				.deck.is-dragging {
					transition: none;
				}
			}

			@media (max-width: 1099px) and (prefers-reduced-motion: reduce) {
				.deck {
					transition: none;
				}
			}

			/* The line between the picture and the text is the reader's to move,
			   as the tree's is (see SplitPane): dragged, the picture takes
			   --deck-drag of the height, between a fifth and four fifths, and the
			   text the rest. Double-click puts it back.

			   On a phone a drag across the deck turns the card, so the line is
			   taken only by a handle in its middle, drawn plainly so it can be
			   found: a dark disc on the groove, ringed in the FLB, with a chevron
			   each way on it, and room round it for a thumb. */
			.deck-divider {
				position: absolute;
				top: var(--deck-at, 50%);
				left: 50%;
				width: 3rem;
				height: 3rem;
				display: grid;
				place-items: center;
				transform: translate(-50%, -50%);
				touch-action: none;
				/* Over both halves and the cards sliding through them. */
				z-index: 3;
			}
			.deck-handle {
				box-sizing: border-box;
				width: 2rem;
				height: 2rem;
				padding: 0.4rem;
				border-radius: 50%;
				background: var(--ground-100);
				border: 1px solid var(--flb);
				box-shadow: 0 2px 8px rgb(0 0 0 / 0.4);
				fill: none;
				stroke: var(--ink-300);
				stroke-width: 1.75;
				stroke-linecap: round;
				stroke-linejoin: round;
			}
			.deck.is-dragging .deck-handle {
				stroke: var(--ink-accent);
			}
			/* On a wide screen, the post's own split (deckSplit, half unless set)
			   where the reader has not dragged it, and the whole line to drag,
			   nothing to see until the pointer finds it. */
			@media (min-width: 1100px) {
				.deck {
					--deck-at: var(--deck-drag, var(--deck-split, 50%));
				}
				.deck-handle {
					display: none;
				}
				.deck-divider {
					left: 0;
					right: 0;
					width: auto;
					display: block;
					height: 0.6rem;
					transform: translateY(-50%);
					cursor: row-resize;
				}
				.deck-divider:hover,
				.deck.is-dragging .deck-divider {
					background: linear-gradient(
						to bottom,
						transparent 45%,
						var(--ink-accent) 45% 55%,
						transparent 55%
					);
				}
				.deck.is-dragging {
					cursor: row-resize;
					user-select: none;
				}
			}

			/* Named areas so DeckCard's halves can be placed independently. */
			/* The groove between the viz and the card, the tree's own (see
			   --groove-cut): the cut, and its light edge just under it. */
			.deck::before {
				content: '';
				grid-area: text;
				z-index: 1;
				border-top: 1px solid var(--groove-cut);
				box-shadow: 0 1px 0 var(--groove-edge);
				align-self: start;
				width: 100%;
			}

			.deck-tools {
				display: none;
			}
			/* The sidebar layout (deckLayout), on a wide screen: the text down a
			   column on the left, as wide as Milk's detail panel until the reader
			   drags its edge (--deck-col, on .deck-main so the controls under it
			   follow), the picture all the rest, and the groove between them
			   running down. The card's controls go down into the foot of the
			   column, so the picture runs to the bottom as well, and the card's
			   words leave room for them at their end. */
			@media (min-width: 1100px) {
				.deck-main:has(> .deck.is-sidebar) {
					position: relative;
				}
				.deck-main:has(> .deck.is-sidebar) > .deck-nav {
					position: absolute;
					left: 0;
					bottom: 0;
					width: var(--deck-col, 23rem);
					box-sizing: border-box;
					z-index: 2;
				}
				/* And the card's words in the middle of the column's height: by
				   auto margins, which centre it while it fits and are nothing once
				   it is longer, so a long card still starts at its top and scrolls. */
				.deck.is-sidebar :global(.card-text-inner) {
					padding-bottom: 5rem;
					margin-block: auto;
				}
				/* And the picture's own controls, a search say, up at the head of
				   the column over the card's words, which start below them: what
				   a visualization marks data-deck-tool is moved here (see the
				   script), and back into the picture on a narrow screen. */
				.deck-tools {
					display: block;
					grid-area: text;
					align-self: start;
					z-index: 2;
					padding: 1rem 1.5rem 0;
				}
				.deck .deck-tools > :global([data-deck-tool]) {
					position: relative;
					inset: auto;
					width: 100%;
					/* Out of the picture, a tool is on the column's dark ground, not
					   the picture's: the deck's inks are the column's here, and the
					   search's field and list (MilkGraph's names for them) the
					   tree's panels, edged in the subtle FLB. */
					--deck-ink: var(--ink-100);
					--deck-ink-dim: var(--ink-500);
					--lit: var(--ink-100);
					--field: var(--ground-300);
					--field-rim: var(--flb-subtle);
					--found: var(--ground-300);
					--found-on: var(--ground-400);
				}
				.deck.is-sidebar:has(.deck-tools > *) :global(.card-text) {
					padding-top: 4.25rem;
				}
				.deck.is-sidebar {
					grid-template-areas: 'text viz';
					grid-template-columns: var(--deck-col, 23rem) minmax(0, 1fr);
					grid-template-rows: minmax(0, 1fr);
				}
				.deck.is-sidebar::before {
					border-top: 0;
					border-right: 1px solid var(--groove-cut);
					box-shadow: 1px 0 0 var(--groove-edge);
					align-self: stretch;
					justify-self: end;
					width: 0;
				}
				/* Its edge the line to drag, as the stacked deck's is, but across. */
				.deck.is-sidebar .deck-divider {
					top: 0;
					bottom: 0;
					left: var(--deck-col, 23rem);
					right: auto;
					width: 0.6rem;
					height: auto;
					transform: translateX(-50%);
					cursor: col-resize;
				}
				.deck.is-sidebar .deck-divider:hover,
				.deck.is-sidebar.is-dragging .deck-divider {
					background: linear-gradient(
						to right,
						transparent 45%,
						var(--ink-accent) 45% 55%,
						transparent 55%
					);
				}
				.deck.is-sidebar.is-dragging {
					cursor: col-resize;
				}
			}

			.deck-nav {
				position: relative;
				flex: none;
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1rem;
				padding: 0.6rem 1rem;
				/* The same groove over the controls. */
				border-top: 1px solid var(--groove-cut);
				box-shadow: inset 0 1px 0 var(--groove-edge);
				background-color: color-mix(in srgb, var(--ground-200) 35%, transparent);
			}

			.deck-series-menu,
			.deck-comment {
				position: absolute;
				top: 50%;
				translate: 0 -50%;
			}
			.deck-series-menu {
				left: 1rem;
			}
			.deck-comment {
				right: 1rem;
			}
			/* The tree beside a wide deck holds the rest of the series; the
			   discussion has nowhere else to be, so its button stays. */
			@media (min-width: 1100px) {
				.deck-series-menu {
					display: none;
				}
			}

			.deck-arrow {
				font-family: var(--font-mono);
				font-size: 1.1rem;
				line-height: 1;
				color: var(--ink-300);
				background: transparent;
				border: 1px solid var(--edge-100);
				border-radius: var(--radius-medium);
				padding: 0.3em 0.75em;
				cursor: pointer;
				transition:
					color 0.15s ease,
					border-color 0.15s ease;
			}

			.deck-arrow:hover:not(:disabled),
			.deck-arrow:focus-visible {
				color: var(--ink-accent);
				border-color: var(--ink-accent);
			}

			.deck-arrow:disabled {
				opacity: 0.3;
				cursor: default;
			}

			/* Wider than an arrow, because it carries words. */
			.deck-jump {
				text-decoration: none;
				white-space: nowrap;
				font-size: 0.8rem;
				padding: 0.45em 0.9em;
			}

			/* The one that carries the reader onward is the only coloured thing
			   down here, so it reads as the way out rather than another arrow. */
			.deck-jump-on {
				background-color: var(--accent);
				border-color: var(--accent);
				color: var(--ground-100);
				font-weight: 700;
			}

			.deck-jump-on:hover,
			.deck-jump-on:focus-visible {
				color: var(--ground-100);
				filter: brightness(1.15);
			}

			/* display:none from [hidden] loses to anything setting display, and the
			   arrows are inline-block by way of being buttons. */
			.deck-arrow[hidden] {
				display: none;
			}

			/* The only position indicator now, so it carries a little more weight
			   than it did beside the dots. Wide enough for two-digit counts, so
			   the arrows do not shift as the number grows. */
			.deck-counter {
				font-family: var(--font-mono);
				font-size: 0.8rem;
				color: var(--ink-300);
				min-width: 7ch;
				text-align: center;
			}

			@media (max-width: 720px) {
				.deck-headings {
					padding: 0.65rem 1rem 0.55rem 0.8rem;
				}
				.deck-title {
					font-size: 1.1rem;
				}
			}
		</style>

		<script>
			import { eachPage } from '../lib/page';

			type CardEl = HTMLElement;

			// Drag the line between the picture and the text to move it; double-
			// click it to let go of it again, back to the deck's own. Kept per deck,
			// on the deck itself, since each post has its own to go back to. On a
			// wide screen a sidebar deck's line is the column's edge, and moves
			// across: the column's width, in pixels, between a narrow column and
			// three fifths of the deck.
			eachPage((signal) => {
				const deck = document.querySelector<HTMLElement>('[data-deck]');
				const divider = deck?.querySelector<HTMLElement>('.deck-divider');
				if (!deck || !divider) return;
				const key = `deck-split:${location.pathname}`;

				const place = (at: number, keep: boolean) => {
					deck.style.setProperty('--deck-drag', `${at}%`);
					if (!keep) return;
					try {
						localStorage.setItem(key, String(at));
					} catch {}
				};
				const release = () => {
					deck.style.removeProperty('--deck-drag');
					main.style.removeProperty('--deck-col');
					try {
						localStorage.removeItem(key);
						localStorage.removeItem(colKey);
					} catch {}
				};
				const main = deck.parentElement!;
				const colKey = `deck-col:${location.pathname}`;
				const wideScreen = matchMedia('(min-width: 1100px)');
				const across = () => deck.classList.contains('is-sidebar') && wideScreen.matches;
				const placeCol = (px: number, keep: boolean) => {
					main.style.setProperty('--deck-col', `${px}px`);
					if (!keep) return;
					try {
						localStorage.setItem(colKey, String(Math.round(px)));
					} catch {}
				};

				// A sidebar deck's tools: what the picture marks data-deck-tool goes up
				// into the column on a wide screen, and back where it was when the
				// screen narrows. Moved, not copied, so it keeps whatever the
				// picture's own script has hung on it.
				const tools = deck.querySelector<HTMLElement>('[data-deck-tools]');
				if (tools) {
					const wide = matchMedia('(min-width: 1100px)');
					const homes = [...deck.querySelectorAll<HTMLElement>('[data-deck-tool]')].map((el) => ({
						el,
						parent: el.parentElement!,
						next: el.nextSibling,
					}));
					const settle = () => {
						for (const { el, parent, next } of homes)
							if (wide.matches) tools.append(el);
							else parent.insertBefore(el, next);
					};
					settle();
					wide.addEventListener('change', settle, { signal });
				}

				// The inline script after the deck does this on the page landed on;
				// a page swapped in has it done here, before it is shown.
				try {
					const kept = Number(localStorage.getItem(key));
					if (kept >= 20 && kept <= 80) place(kept, false);
					const col = Number(localStorage.getItem(colKey));
					if (col > 0) placeCol(col, false);
				} catch {}

				divider.addEventListener('pointerdown', (e) => {
					e.preventDefault();
					// Held, so a canvas under the pointer cannot take the drag.
					divider.setPointerCapture(e.pointerId);
					const rect = deck.getBoundingClientRect();
					// Where it is now, whichever rule put it there.
					const viz = deck.querySelector<HTMLElement>('.deck-viz');
					const sideways = across();
					const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
					let last = sideways
						? (viz ? viz.getBoundingClientRect().left - rect.left : 23 * rem)
						: viz
							? (viz.getBoundingClientRect().height / rect.height) * 100
							: 50;
					deck.classList.add('is-dragging');
					const move = (ev: PointerEvent) => {
						if (sideways) {
							last = Math.min(rect.width * 0.6, Math.max(16 * rem, ev.clientX - rect.left));
							placeCol(last, false);
						} else {
							last = Math.min(80, Math.max(20, ((ev.clientY - rect.top) / rect.height) * 100));
							place(last, false);
						}
					};
					const up = () => {
						window.removeEventListener('pointermove', move);
						window.removeEventListener('pointerup', up);
						window.removeEventListener('pointercancel', up);
						deck.classList.remove('is-dragging');
						if (sideways) placeCol(last, true);
						else place(last, true);
					};
					window.addEventListener('pointermove', move, { signal });
					window.addEventListener('pointerup', up, { signal });
					window.addEventListener('pointercancel', up, { signal });
				});

				divider.addEventListener('dblclick', release);
			});

			// Once for every page with a deck, which under the client router is not the
			// same as once: see lib/page.ts.
			eachPage((signal) => {

				const deck = document.querySelector<HTMLElement>('[data-deck]');
				const cards = deck
					? Array.from(deck.querySelectorAll<CardEl>('[data-card]'))
					: [];

				if (deck && cards.length) {
					const prevBtn = document.querySelector<HTMLButtonElement>('[data-deck-prev]');
					const nextBtn = document.querySelector<HTMLButtonElement>('[data-deck-next]');
					const jumpPrev = document.querySelector<HTMLElement>('[data-deck-jump-prev]');
					const jumpNext = document.querySelector<HTMLElement>('[data-deck-jump-next]');
					const counter = document.querySelector<HTMLElement>('[data-deck-counter]');

					let index = 0;

					/* ---- deep links ---------------------------------------------------
					   The card number lives in the fragment, so any card can be linked
					   to directly. replaceState rather than pushState: a deck can run to
					   twenty cards, and making Back walk out of it one card at a time
					   would trap the reader inside the post. */
					const clamp = (n: number) => Math.max(0, Math.min(cards.length - 1, n));

					const fromHash = () => {
						const n = Number(location.hash.slice(1));
						return Number.isInteger(n) && n > 0 ? clamp(n - 1) : null;
					};

					function syncHash() {
						// Card one is the post itself, and keeps the bare URL.
						const base = location.pathname + location.search;
						// The router keeps its own record in the entry's state, so that stays.
						history.replaceState(history.state, '', index === 0 ? base : `${base}#${index + 1}`);
					}

					const linked = fromHash();
					if (linked !== null) index = linked;

					/* ---- the visualization ------------------------------------------
					   A card contributes parameters, not a viz of its own. Anything it
					   does not mention it inherits from the card before it, which makes
					   "leave it exactly as it is" the default and the cheapest thing
					   that can happen on a card change. Resolving the chain once, going
					   forward, means a card looks the same whichever direction you
					   arrive from. */
					const stage = deck.querySelector<HTMLElement>('[data-viz-stage]');
					const phases = stage
						? Array.from(stage.querySelectorAll<HTMLElement>('[data-viz-phase]'))
						: [];
					/* Overlays differ from phases in that they do not replace the viz,
					   they sit over it — so any number can be declared but only the one
					   a card names is shown, and whatever is underneath keeps running. */
					const overlays = stage
						? Array.from(stage.querySelectorAll<HTMLElement>('[data-viz-overlay]'))
						: [];

					const vizPlan = (() => {
						// Seeded with the deck's starting phase, so the set is never
						// missing one. Complete sets are what make going backwards work:
						// card four still has to know it wants the cube, even though it
						// was card five that switched away to something else.
						let acc: Record<string, unknown> = phases.length
							? { phase: phases[0].dataset.vizPhase }
							: {};
						return cards.map((card) => {
							// Merged onto what came before, not substituted for it, so a
							// card can change one parameter without restating the rest.
							if (card.dataset.vizProps) {
								acc = { ...acc, ...JSON.parse(card.dataset.vizProps) };
							}
							return JSON.stringify(acc);
						});
					})();

					let phaseName: string | null = null;
					let applied: string | null = null;

					/* Straight to the phase the starting card asks for — which is not
					   necessarily the first one, if the reader arrived on a deep link. */
					/* A phase out of sight is put to sleep once it has faded out (see
					   VizPhase): not laid out, painted or resized, so that nothing in
					   it does any work while the pane changes size, as it does every
					   frame the posts beside it fold away. Woken before it is shown,
					   when anything in it that watches its size hears it once. */
					const FADE = 400;
					const asleep = new WeakMap<HTMLElement, number>();
					const sleep = (el: HTMLElement, after: number) => {
						clearTimeout(asleep.get(el));
						asleep.set(
							el,
							window.setTimeout(() => {
								if (el.dataset.vizActive === 'false') el.dataset.vizAsleep = '';
							}, after),
						);
					};
					const wake = (el: HTMLElement) => {
						clearTimeout(asleep.get(el));
						delete el.dataset.vizAsleep;
					};
					if (phases.length) {
						phaseName = JSON.parse(vizPlan[index]).phase ?? null;
						for (const el of phases) {
							const on = el.dataset.vizPhase === phaseName;
							el.dataset.vizActive = String(on);
							el.inert = !on;
							if (!on) sleep(el, 0);
						}
					}

					function showPhase(name: string) {
						if (name === phaseName) return;
						phaseName = name;
						for (const el of phases) {
							const on = el.dataset.vizPhase === name;
							const was = el.dataset.vizActive === 'true';
							if (on) wake(el);
							else if (was) sleep(el, FADE);
							el.dataset.vizActive = String(on);
							el.inert = !on;
							if (was !== on) {
								el.dispatchEvent(new CustomEvent(on ? 'viz:enter' : 'viz:exit'));
							}
						}
					}

					function renderViz() {
						const props = vizPlan[index];
						// Byte-identical to the card before: do not touch the viz at all.
						if (props === applied) return;
						applied = props;
						// `phase` and `overlay` are the deck's; every other key belongs
						// to the viz.
						const { phase, overlay, ...rest } = JSON.parse(props) as Record<
							string,
							unknown
						>;
						if (phases.length && typeof phase === 'string') showPhase(phase);
						for (const el of overlays) {
							const on = el.dataset.vizOverlay === overlay;
							el.dataset.vizActive = String(on);
							el.inert = !on;
						}
						const host = phases.length
							? phases.find((el) => el.dataset.vizPhase === phaseName)
							: stage;
						host?.dispatchEvent(new CustomEvent('viz:props', { detail: rest }));
					}

					function render() {
						cards.forEach((card, i) => {
							const state = i === index ? 'active' : i < index ? 'before' : 'after';
							card.dataset.state = state;
							// Keep off-screen cards out of the tab order and the a11y tree.
							const text = card.querySelector<HTMLElement>('.card-text');
							if (text) text.inert = i !== index;
						});
						renderViz();
						if (counter) counter.textContent = `${index + 1} / ${cards.length}`;
						// For the tree, which lists the cards under the post (see TreeSlides).
						document.dispatchEvent(new CustomEvent('deck:card', { detail: { index } }));
						/* At an end, hand over to the neighbouring part if there is one;
						   otherwise the arrow just greys out as before. */
						const atStart = index === 0;
						const atEnd = index === cards.length - 1;
						if (jumpPrev) jumpPrev.hidden = !atStart;
						if (jumpNext) jumpNext.hidden = !atEnd;
						if (prevBtn) {
							prevBtn.hidden = atStart && !!jumpPrev;
							prevBtn.disabled = atStart;
						}
						if (nextBtn) {
							nextBtn.hidden = atEnd && !!jumpNext;
							nextBtn.disabled = atEnd;
						}
					}

					function go(next: number) {
						const clamped = clamp(next);
						if (clamped === index) return;
						index = clamped;
						render();
						syncHash();
					}

					// Someone editing the fragment, or following a link to another card
					// of the post they are already reading.
					window.addEventListener('hashchange', () => {
						const n = fromHash();
						if (n === null) return;
						go(n);
						syncHash(); // a number past the end becomes the card it landed on
					}, { signal });

					// A card chosen in the tree, of this deck.
					document.addEventListener('deck:go', (e) => {
						go((e as CustomEvent<{ index: number }>).detail.index);
					}, { signal });

					prevBtn?.addEventListener('click', () => go(index - 1));
					nextBtn?.addEventListener('click', () => go(index + 1));

					document.addEventListener('keydown', (e) => {
						if (e.metaKey || e.ctrlKey || e.altKey) return;
						const target = e.target as HTMLElement | null;
						if (target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName)) return;
						if (e.key === 'ArrowRight') { go(index + 1); }
						else if (e.key === 'ArrowLeft') { go(index - 1); }
						else if (e.key === 'Home') { go(0); }
						else if (e.key === 'End') { go(cards.length - 1); }
						else return;
						e.preventDefault();
					}, { signal });

					/* Swipe. A pointer gesture only becomes a swipe once it is clearly
					   horizontal, so vertical scrolling inside a card and ordinary text
					   selection both still work. */
					let startX = 0;
					let startY = 0;
					/* The last position a move actually reported. `pointercancel` — which
					   a touch gesture may well end with — carries no useful coordinates,
					   so reading the direction off the end event turned every swipe into
					   a forward one. */
					let lastX = 0;
					let pointerId: number | null = null;
					let swiping = false;

					deck.addEventListener('pointerdown', (e) => {
						if (e.button !== 0) return;
						// A viz that handles its own drags (the RGB cube, sliders) opts out,
						// otherwise rotating it sideways would also flip the card.
						if ((e.target as HTMLElement)?.closest?.('[data-no-swipe]')) return;
						startX = e.clientX;
						startY = e.clientY;
						lastX = e.clientX;
						pointerId = e.pointerId;
						swiping = false;
					});

					deck.addEventListener('pointermove', (e) => {
						if (pointerId !== e.pointerId) return;
						const dx = e.clientX - startX;
						const dy = e.clientY - startY;
						lastX = e.clientX;
						if (!swiping) {
							if (Math.abs(dx) < 12 || Math.abs(dx) <= Math.abs(dy)) return;
							swiping = true;
							deck.setPointerCapture(e.pointerId);
						}
						const active = cards[index]?.querySelector<HTMLElement>('.card-text');
						if (!active) return;
						// Resist dragging past the ends.
						const atEdge =
							(dx > 0 && index === 0) || (dx < 0 && index === cards.length - 1);
						active.style.transition = 'none';
						active.style.transform = `translateX(${dx * (atEdge ? 0.25 : 1)}px)`;
					});

					function endSwipe(e: PointerEvent) {
						if (pointerId !== e.pointerId) return;
						const active = cards[index]?.querySelector<HTMLElement>('.card-text');
						if (active) {
							active.style.transition = '';
							active.style.transform = '';
						}
						if (swiping) {
							const dx = lastX - startX;
							const threshold = Math.min(120, deck!.clientWidth * 0.15);
							if (dx <= -threshold) go(index + 1);
							else if (dx >= threshold) go(index - 1);
						}
						pointerId = null;
						swiping = false;
					}

					deck.addEventListener('pointerup', endSwipe);
					deck.addEventListener('pointercancel', endSwipe);

					render();
					/* Rewrite a card number past the end to the card actually shown. A
					   fragment that is not a card number is left alone rather than
					   claimed — it may well be a heading anchor, and the deck only owns
					   the ones it recognises. */
					if (fromHash() !== null) syncHash();
				}
			});
		</script>
	</body>
</html>
